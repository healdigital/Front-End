---
import OrganismPagination from './organisms/Pagination.astro';

interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl?: string;
  routeStyle?: 'nested' | 'direct';
}

const { currentPage, totalPages, baseUrl = '', routeStyle = 'nested' } = Astro.props;
---

<div class="mt-12 mb-8">
  <OrganismPagination
    currentPage={currentPage}
    totalPages={totalPages}
    baseUrl={baseUrl}
    routeStyle={routeStyle}
  />
</div>

---
interface Props {
  url?: string;
  title?: string;
  class?: string;
}

const {
  url = Astro.url.href,
  title = 'Découvrez cet article',
  class: className,
} = Astro.props;

const shareLinks = [
  { icon: 'fab fa-facebook-f', label: 'Facebook', platform: 'facebook' },
  { icon: 'fab fa-pinterest-p', label: 'Pinterest', platform: 'pinterest' },
  { icon: 'fab fa-whatsapp', label: 'WhatsApp', platform: 'whatsapp' },
  { icon: 'fab fa-linkedin-in', label: 'LinkedIn', platform: 'linkedin' },
  { icon: 'far fa-envelope', label: 'Email', platform: 'email' },
];
---

<div
  class:list={['social-share', className]}
  aria-label="Partager cet article"
  data-social-share
  data-share-url={url}
  data-share-title={title}
>
  {shareLinks.map((link) => (
    <a
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      class="social-share-link"
      aria-label={`Partager sur ${link.label}`}
      title={`Partager sur ${link.label}`}
      data-share-platform={link.platform}
    >
      <i class={link.icon} aria-hidden="true"></i>
    </a>
  ))}

  <button
    type="button"
    class="social-share-link"
    data-copy-link
    data-copy-value={url}
    aria-label="Copier le lien de l’article"
    title="Copier le lien"
  >
    <i class="far fa-copy" aria-hidden="true"></i>
  </button>
  <span class="social-share-feedback sr-only" data-copy-feedback aria-live="polite"></span>
</div>

<style>
  .social-share {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
  }

  .social-share-link {
    border: 0;
    padding: 0;
    background: transparent;
    color: #7b7365;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    font-size: 1.15rem;
    line-height: 1;
    box-shadow: none;
    appearance: none;
  }

  .social-share-link:hover,
  .social-share-link:focus-visible {
    color: var(--lcdb-accent);
    outline: none;
    transform: translateY(-1px);
  }
</style>

<script>
  const buildShareHref = (platform, currentUrl, currentTitle) => {
    switch (platform) {
      case 'facebook':
        return `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`;
      case 'pinterest':
        return `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(currentUrl)}&description=${encodeURIComponent(currentTitle)}`;
      case 'whatsapp':
        return `https://api.whatsapp.com/send?text=${encodeURIComponent(`${currentTitle} ${currentUrl}`)}`;
      case 'linkedin':
        return `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`;
      case 'email':
        return `mailto:?subject=${encodeURIComponent(currentTitle)}&body=${encodeURIComponent(currentUrl)}`;
      default:
        return currentUrl;
    }
  };

  const setupSocialShare = () => {
    document.querySelectorAll('[data-social-share]').forEach((root) => {
      const rawShareUrl = root.getAttribute('data-share-url') || '';
      const currentUrl = rawShareUrl
        ? new URL(rawShareUrl, window.location.origin).toString()
        : window.location.href;
      const currentTitle =
        root.getAttribute('data-share-title') ||
        document.title ||
        'Découvrez cet article';
      const feedback = root.querySelector('[data-copy-feedback]');

      root.querySelectorAll('[data-share-platform]').forEach((link) => {
        if (!(link instanceof HTMLAnchorElement)) return;
        const platform = link.getAttribute('data-share-platform') || '';
        link.href = buildShareHref(platform, currentUrl, currentTitle);
      });

      const copyButton = root.querySelector('[data-copy-link]');
      if (!(copyButton instanceof HTMLButtonElement) || copyButton.dataset.shareReady === 'true') {
        return;
      }

      copyButton.dataset.shareReady = 'true';
      copyButton.setAttribute('data-copy-value', currentUrl);
      copyButton.addEventListener('click', async () => {
        const value = copyButton.getAttribute('data-copy-value') || currentUrl;
        if (!value) return;

        try {
          await navigator.clipboard.writeText(value);
          const previousLabel = copyButton.getAttribute('aria-label') || 'Copier le lien';
          copyButton.setAttribute('aria-label', 'Lien copié');
          if (feedback instanceof HTMLElement) {
            feedback.textContent = 'Lien copié';
          }
          window.setTimeout(() => {
            copyButton.setAttribute('aria-label', previousLabel);
            if (feedback instanceof HTMLElement) {
              feedback.textContent = '';
            }
          }, 1500);
        } catch (error) {
          console.error('Unable to copy article link:', error);
        }
      });
    });
  };

  setupSocialShare();
  document.addEventListener('astro:page-load', setupSocialShare);
</script>

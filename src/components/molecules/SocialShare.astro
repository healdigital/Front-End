---
import Icon from '../ui/Icon.astro';

/**
 * Props for the `SocialShare` molecule.
 */
interface Props {
  /** Canonical URL shared on social platforms. */
  url?: string;
  /** Message used in social post text and email subject. */
  title?: string;
  /** Optional utility classes applied to the wrapper. */
  class?: string;
}

const { url = Astro.url.href, title = 'Check this out!', class: className } = Astro.props;

const shareLinks = [
  {
    name: 'facebook-f',
    label: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
    color: 'hover:text-[#1877F2]'
  },
  {
    name: 'pinterest-p',
    label: 'Pinterest',
    href: `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&description=${encodeURIComponent(title)}`,
    color: 'hover:text-[#E60023]'
  },
  {
    name: 'envelope',
    label: 'Email',
    href: `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(url)}`,
    color: 'hover:text-primary-turquoise'
  }
];
---

<div class:list={["flex items-center gap-4", className]}>
  {shareLinks.map(link => (
    <a 
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      class={`text-text-secondary transition-colors duration-300 ${link.color}`}
      aria-label={`Share on ${link.label}`}
    >
      <Icon name={link.name} size="lg" />
    </a>
  ))}
</div>

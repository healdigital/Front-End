---
interface Props {
  url?: string;
  title?: string;
  class?: string;
}

const {
  url = Astro.url.href,
  title = 'Découvrez cet article',
  class: className,
} = Astro.props;

const shareLinks = [
  { icon: 'fab fa-facebook-f', label: 'Facebook', platform: 'facebook' },
  { icon: 'fab fa-pinterest-p', label: 'Pinterest', platform: 'pinterest' },
  { icon: 'far fa-envelope', label: 'Email', platform: 'email' },
];
---

<div
  class:list={['social-share', className]}
  aria-label="Partager cet article"
  data-social-share
  data-share-url={url}
  data-share-title={title}
>
  {shareLinks.map((link) => (
    <a
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      class="social-share-link"
      aria-label={`Partager sur ${link.label}`}
      title={`Partager sur ${link.label}`}
      data-share-platform={link.platform}
    >
      <i class={link.icon} aria-hidden="true"></i>
    </a>
  ))}
</div>

<style>
  .social-share {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
  }

  .social-share-link {
    border: 0;
    padding: 0;
    background: transparent;
    color: #7b7365;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    font-size: 0.9rem;
    line-height: 1;
    box-shadow: none;
    appearance: none;
  }

  .social-share-link:hover,
  .social-share-link:focus-visible {
    color: var(--lcdb-accent);
    outline: none;
    transform: translateY(-1px);
  }
</style>

<script>
  const buildShareHref = (platform, currentUrl, currentTitle) => {
    switch (platform) {
      case 'facebook':
        return `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`;
      case 'pinterest':
        return `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(currentUrl)}&description=${encodeURIComponent(currentTitle)}`;
      case 'email':
        return `mailto:?subject=${encodeURIComponent(currentTitle)}&body=${encodeURIComponent(currentUrl)}`;
      default:
        return currentUrl;
    }
  };

  const setupSocialShare = () => {
    document.querySelectorAll('[data-social-share]').forEach((root) => {
      const rawShareUrl = root.getAttribute('data-share-url') || '';
      const currentUrl = rawShareUrl
        ? new URL(rawShareUrl, window.location.origin).toString()
        : window.location.href;
      const currentTitle =
        root.getAttribute('data-share-title') ||
        document.title ||
        'Découvrez cet article';

      root.querySelectorAll('[data-share-platform]').forEach((link) => {
        if (!(link instanceof HTMLAnchorElement)) return;
        const platform = link.getAttribute('data-share-platform') || '';
        link.href = buildShareHref(platform, currentUrl, currentTitle);
      });
    });
  };

  setupSocialShare();
  document.addEventListener('astro:page-load', setupSocialShare);
</script>

---
interface Props {
  loadAds?: boolean;
}

const { loadAds = false } = Astro.props;

const mediavineScriptSrc = import.meta.env.PUBLIC_MEDIAVINE_SCRIPT_SRC;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

{loadAds && mediavineScriptSrc && (
  <>
    <link rel="preconnect" href="https://scripts.mediavine.com" />
    <link rel="dns-prefetch" href="//scripts.mediavine.com" />
    <script is:inline>
      window.__lcdbClubMember = (function () {
        try {
          var raw = document.cookie.split('; ').find(function (row) {
            return row.indexOf('lcdb_club=') === 0;
          });
          if (!raw) return false;
          var token = raw.split('=').slice(1).join('=');
          var parts = token.split('.');
          if (parts.length !== 3) return false;
          var payloadPart = parts[1].replace(/-/g, '+').replace(/_/g, '/');
          var padding = payloadPart.length % 4;
          if (padding) payloadPart += '='.repeat(4 - padding);
          var payload = JSON.parse(atob(payloadPart));
          if (!payload || !payload.exp || payload.exp < Math.floor(Date.now() / 1000)) return false;
          if (payload.iss !== 'atelier-lacuisinedebernard.com') return false;
          document.documentElement.setAttribute('data-club-member', 'true');
          return true;
        } catch {
          return false;
        }
      })();
    </script>
    <script is:inline define:vars={{ mediavineScriptSrc }}>
      if (!window.__lcdbClubMember && !document.querySelector('script[data-lcdb-mediavine="true"]')) {
        var mediavineScript = document.createElement('script');
        mediavineScript.type = 'text/javascript';
        mediavineScript.async = true;
        mediavineScript.src = mediavineScriptSrc;
        mediavineScript.setAttribute('data-noptimize', '1');
        mediavineScript.setAttribute('data-cfasync', 'false');
        mediavineScript.setAttribute('data-lcdb-mediavine', 'true');
        document.head.appendChild(mediavineScript);
      }
    </script>
  </>
)}

{gaMeasurementId && (
  <>
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="//www.googletagmanager.com" />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
    <script is:inline define:vars={{ gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', gaMeasurementId);
    </script>
  </>
)}

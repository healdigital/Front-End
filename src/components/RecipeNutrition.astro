---
interface NutritionInfo {
  calories?: number;
  protein?: number;
  carbs?: number;
  fat?: number;
  fiber?: number;
  sugar?: number;
  sodium?: number;
  cholesterol?: number;
  vitamin_a?: number;
  vitamin_c?: number;
  calcium?: number;
  iron?: number;
}

interface Props {
  nutrition?: NutritionInfo;
  servings?: number;
  title?: string;
}

const { nutrition = {}, servings = 1, title = 'Informations nutritionnelles' } = Astro.props;

const dailyValues = {
  calories: 2000,
  protein: 50,
  carbs: 300,
  fat: 78,
  fiber: 28,
  sodium: 2300,
  cholesterol: 300,
  vitamin_a: 900,
  vitamin_c: 90,
  calcium: 1300,
  iron: 18,
};

const getDvPercent = (nutrient: keyof typeof dailyValues, value: number) => {
  const reference = dailyValues[nutrient];
  return reference ? Math.round((value / reference) * 100) : 0;
};

const perServing = (value?: number) => {
  if (!value) return null;
  return value / Math.max(servings, 1);
};
---

{nutrition && Object.keys(nutrition).length > 0 ? (
  <section class="recipe-nutrition" aria-labelledby="recipe-nutrition-title">
    <h2 id="recipe-nutrition-title" class="nutrition-title">{title}</h2>

    <div class="nutrition-content">
      <section class="nutrition-section">
        <h3 class="section-title">Par portion</h3>
        <div class="nutrition-grid">
          {perServing(nutrition.calories) && (
            <article class="nutrition-item">
              <p class="nutrition-label">Calories</p>
              <p class="nutrition-value">{Math.round(perServing(nutrition.calories) || 0)}</p>
              <p class="nutrition-unit">kcal</p>
            </article>
          )}
          {perServing(nutrition.protein) && (
            <article class="nutrition-item">
              <p class="nutrition-label">Protéines</p>
              <p class="nutrition-value">{(perServing(nutrition.protein) || 0).toFixed(1)}</p>
              <p class="nutrition-unit">g</p>
              <p class="nutrition-percent">{getDvPercent('protein', perServing(nutrition.protein) || 0)}% AJR</p>
            </article>
          )}
          {perServing(nutrition.carbs) && (
            <article class="nutrition-item">
              <p class="nutrition-label">Glucides</p>
              <p class="nutrition-value">{(perServing(nutrition.carbs) || 0).toFixed(1)}</p>
              <p class="nutrition-unit">g</p>
              <p class="nutrition-percent">{getDvPercent('carbs', perServing(nutrition.carbs) || 0)}% AJR</p>
            </article>
          )}
          {perServing(nutrition.fat) && (
            <article class="nutrition-item">
              <p class="nutrition-label">Lipides</p>
              <p class="nutrition-value">{(perServing(nutrition.fat) || 0).toFixed(1)}</p>
              <p class="nutrition-unit">g</p>
              <p class="nutrition-percent">{getDvPercent('fat', perServing(nutrition.fat) || 0)}% AJR</p>
            </article>
          )}
        </div>
      </section>

      {(nutrition.fiber || nutrition.sugar || nutrition.sodium || nutrition.cholesterol) && (
        <section class="nutrition-section">
          <h3 class="section-title">Autres repères</h3>
          <div class="nutrition-rows">
            {perServing(nutrition.fiber) && (
              <div class="nutrition-row">
                <span class="nutrition-row-label">Fibres</span>
                <span class="nutrition-row-value">
                  {(perServing(nutrition.fiber) || 0).toFixed(1)} g
                  <small>{getDvPercent('fiber', perServing(nutrition.fiber) || 0)}% AJR</small>
                </span>
              </div>
            )}
            {perServing(nutrition.sugar) && (
              <div class="nutrition-row">
                <span class="nutrition-row-label">Sucres</span>
                <span class="nutrition-row-value">{(perServing(nutrition.sugar) || 0).toFixed(1)} g</span>
              </div>
            )}
            {perServing(nutrition.sodium) && (
              <div class="nutrition-row">
                <span class="nutrition-row-label">Sodium</span>
                <span class="nutrition-row-value">
                  {Math.round(perServing(nutrition.sodium) || 0)} mg
                  <small>{getDvPercent('sodium', perServing(nutrition.sodium) || 0)}% AJR</small>
                </span>
              </div>
            )}
            {perServing(nutrition.cholesterol) && (
              <div class="nutrition-row">
                <span class="nutrition-row-label">Cholestérol</span>
                <span class="nutrition-row-value">
                  {Math.round(perServing(nutrition.cholesterol) || 0)} mg
                  <small>{getDvPercent('cholesterol', perServing(nutrition.cholesterol) || 0)}% AJR</small>
                </span>
              </div>
            )}
          </div>
        </section>
      )}

      {(nutrition.vitamin_a || nutrition.vitamin_c || nutrition.calcium || nutrition.iron) && (
        <section class="nutrition-section">
          <h3 class="section-title">Vitamines et minéraux</h3>
          <div class="nutrition-grid-small">
            {perServing(nutrition.vitamin_a) && (
              <article class="vitamin-item">
                <p class="vitamin-label">Vitamine A</p>
                <p class="vitamin-percent">{getDvPercent('vitamin_a', perServing(nutrition.vitamin_a) || 0)}%</p>
              </article>
            )}
            {perServing(nutrition.vitamin_c) && (
              <article class="vitamin-item">
                <p class="vitamin-label">Vitamine C</p>
                <p class="vitamin-percent">{getDvPercent('vitamin_c', perServing(nutrition.vitamin_c) || 0)}%</p>
              </article>
            )}
            {perServing(nutrition.calcium) && (
              <article class="vitamin-item">
                <p class="vitamin-label">Calcium</p>
                <p class="vitamin-percent">{getDvPercent('calcium', perServing(nutrition.calcium) || 0)}%</p>
              </article>
            )}
            {perServing(nutrition.iron) && (
              <article class="vitamin-item">
                <p class="vitamin-label">Fer</p>
                <p class="vitamin-percent">{getDvPercent('iron', perServing(nutrition.iron) || 0)}%</p>
              </article>
            )}
          </div>
        </section>
      )}
    </div>

    <p class="nutrition-disclaimer">
      Les apports journaliers de référence sont calculés sur une base moyenne de 2&nbsp;000 kcal par jour.
    </p>
  </section>
) : null}

<style>
  .recipe-nutrition {
    margin: 2.5rem 0;
    padding: 2rem;
    border: 1px solid var(--lcdb-border);
    border-radius: 12px;
    background: linear-gradient(180deg, #f8f5ee 0%, #fbfaf6 100%);
  }

  .nutrition-title {
    margin: 0 0 1.5rem;
    color: var(--lcdb-heading);
    font-family: var(--font-heading);
    font-size: 2rem;
    line-height: 1.05;
  }

  .nutrition-content {
    display: grid;
    gap: 1rem;
  }

  .nutrition-section {
    padding: 1.25rem;
    border: 1px solid rgba(216, 210, 194, 0.9);
    border-radius: 10px;
    background: #faf8f2;
  }

  .section-title {
    margin: 0 0 0.95rem;
    color: var(--lcdb-heading);
    font-family: var(--font-button);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .nutrition-grid,
  .nutrition-grid-small {
    display: grid;
    gap: 0.85rem;
  }

  .nutrition-grid {
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  }

  .nutrition-grid-small {
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  }

  .nutrition-item,
  .vitamin-item {
    padding: 1rem;
    border-radius: 10px;
    background: #f8f5ee;
    text-align: center;
  }

  .nutrition-label,
  .vitamin-label {
    margin: 0 0 0.4rem;
    color: var(--lcdb-muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .nutrition-value,
  .vitamin-percent {
    margin: 0;
    color: var(--lcdb-heading);
    font-family: var(--font-heading);
    font-size: 1.8rem;
    line-height: 1;
  }

  .nutrition-unit,
  .nutrition-percent {
    margin: 0.3rem 0 0;
    color: var(--lcdb-muted);
    font-size: 0.85rem;
  }

  .nutrition-rows {
    display: grid;
    gap: 0.7rem;
  }

  .nutrition-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid rgba(216, 210, 194, 0.75);
  }

  .nutrition-row:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .nutrition-row-label {
    color: var(--lcdb-copy);
    font-weight: 500;
  }

  .nutrition-row-value {
    display: inline-flex;
    gap: 0.75rem;
    color: var(--lcdb-heading);
    font-weight: 500;
    text-align: right;
  }

  .nutrition-row-value small {
    color: var(--lcdb-muted);
    font-size: 0.8rem;
  }

  .nutrition-disclaimer {
    margin: 1rem 0 0;
    color: var(--lcdb-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .recipe-nutrition {
      margin: 1.75rem 0;
      padding: 1.35rem;
    }

    .nutrition-title {
      font-size: 1.65rem;
    }

    .nutrition-grid,
    .nutrition-grid-small {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nutrition-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

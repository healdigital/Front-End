  }

  #comments-section :global(#disqus_thread .dropdown),
  #comments-section :global(#disqus_thread .dropdown-menu),
  #comments-section :global(#disqus_thread .media),
  #comments-section :global(#disqus_thread .ad) {
    box-shadow: none !important;
  }
</style>

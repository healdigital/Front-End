  }

  #comments-section :global(#disqus_thread .post-actions),
  #comments-section :global(#disqus_thread .actions),
  #comments-section :global(#disqus_thread .footer) {
    display: flex !important;
    align-items: center !important;
    flex-wrap: wrap !important;
    gap: 18px !important;
    margin-top: 16px !important;
  }


    text-decoration: underline !important;
    text-underline-offset: 2px !important;
  }

  #comments-section :global(#disqus_thread .vote),
  #comments-section :global(#disqus_thread .likes),
  #comments-section :global(#disqus_thread .replies),
  #comments-section :global(#disqus_thread .vote-up),
  #comments-section :global(#disqus_thread .vote-down) {

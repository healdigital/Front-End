---
interface Props extends astroHTML.JSX.InputHTMLAttributes {
  class?: string;
}

const { class: className, ...rest } = Astro.props;

const baseStyles = "w-full bg-white/18 border border-transparent rounded-full px-4 py-2 text-text-primary placeholder:text-text-secondary focus:outline-none focus:ring-2 focus:ring-primary-turquoise transition-all duration-300";
---

<input class:list={[baseStyles, className]} {...rest} />

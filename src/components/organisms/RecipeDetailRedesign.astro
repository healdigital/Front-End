---
import {
  buildWordPressImageFallbackCandidates,
  buildWpPortraitVariantUrl,
} from '../../utils/cdnUrlReplacer';

const {
  title,
  slug,
  image,
  imageAlt,
  ratingLabel,
  ratingStars = [],
  articleShareLinks = [],
  heroMetaItems = [],
  introText = "",
  recipeBlock = null,
  ingredientGroups = [],
  stepGroups = [],
  nutritionItems = [],
  showNutritionFallback = false,
  pinterestLink = "",
  collectionHref = "/favoris",
} = Astro.props;

const heroImage = image ? buildWpPortraitVariantUrl(image, '797x1024') || image : '';
const heroImageFallbackCandidates = image
  ? buildWordPressImageFallbackCandidates(image)
  : [];
const recipeImageFallbackCandidates = image
  ? buildWordPressImageFallbackCandidates(image)
  : [];
const visibleShareLinks = articleShareLinks.filter((link: any) => {
  const platform = String(link?.platform || '').toLowerCase();
  const label = String(link?.label || '').toLowerCase();
  return (
    platform === 'facebook' ||
    platform === 'pinterest' ||
    platform === 'email' ||
    label.includes('facebook') ||
    label.includes('pinterest') ||
    label.includes('mail')
  );
});

const toNumber = (value: any) => {
  if (typeof value === "number") {
    return Number.isFinite(value) ? value : null;
  }
  const normalized = String(value ?? "")
    .trim()
    .replace(",", ".")
    .replace(/[^0-9.+-]/g, "");
  if (!normalized) return null;
  const numeric = Number(normalized);
  return Number.isFinite(numeric) ? numeric : null;
};

const formatMinutes = (value: any) => {
  const numeric = toNumber(value);
  if (numeric === null || numeric < 0) return "";
  return `${Math.round(numeric)} min`;
};

const normalizeDifficultyLabel = (value: any) => {
  const raw = String(value || "").trim();
  const normalized = raw
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase();

  if (!normalized) return "";
  if (["easy", "facile"].includes(normalized)) return "Facile";
  if (["medium", "moyen", "intermediate"].includes(normalized)) return "M\u00E9dium";
  if (["hard", "difficult", "difficile"].includes(normalized)) return "Difficile";
  return raw;
};

const normalizeRecipeMetaValue = (value: any, type: "recipeType" | "dishType" | "cuisine" = "recipeType") => {
  const raw = String(value || "").trim();
  const normalized = raw
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase();

  if (!normalized) return "";

  if (type === "cuisine") {
    if (["french", "france", "francaise", "francais"].includes(normalized)) return "Française";
    if (["italian", "italie", "italienne"].includes(normalized)) return "Italienne";
    if (["asian", "asie", "asiatique"].includes(normalized)) return "Asiatique";
    if (["japanese", "japon", "japonaise"].includes(normalized)) return "Japonaise";
    if (["chinese", "chine", "chinoise"].includes(normalized)) return "Chinoise";
    if (["indian", "inde", "indienne"].includes(normalized)) return "Indienne";
    if (["thai", "thailandaise", "thaïlandaise"].includes(normalized)) return "Thaïlandaise";
    if (["american", "americaine", "americain", "usa"].includes(normalized)) return "Américaine";
  }

  if (["other", "autre"].includes(normalized)) return "Autre";
  if (["starter", "entree"].includes(normalized)) return "Entrée";
  if (["main", "main course", "plat", "plat principal"].includes(normalized)) return "Plat principal";
  if (["dessert", "desserts"].includes(normalized)) return "Dessert";
  if (["savory", "savoury", "sale", "sales", "salee", "salees"].includes(normalized)) return "Salé";
  if (["sweet", "sucre", "sucree", "sucrees"].includes(normalized)) return "Sucré";

  return raw;
};

const formatServingsLabel = (value: any) => {
  const raw = String(value || "").trim();
  if (!raw) return "";

  const numeric = Number(raw.replace(",", "."));
  if (Number.isFinite(numeric)) {
    const rounded = Math.round(numeric);
    return `${rounded} personne${rounded > 1 ? "s" : ""}`;
  }

  return raw
    .replace(/\b(servings?|people|persons?)\b/gi, "personnes")
    .replace(/\b(person)\b/gi, "personne")
    .replace(/\b1\s+personnes\b/gi, "1 personne")
    .replace(/\b1\s+people\b/gi, "1 personne")
    .replace(/\b1\s+persons\b/gi, "1 personne")
    .replace(/\s+/g, " ")
    .trim();
};

const quickInfoItems = [
  {
    label: "Temps de préparation",
    value: formatMinutes(recipeBlock?.preparationTimeMinutes),
  },
  {
    label: "Temps de cuisson",
    value: formatMinutes(recipeBlock?.cookingTimeMinutes),
  },
  {
    label: "Nombre de portions",
    value: formatServingsLabel(recipeBlock?.servingsCount),
  },
  { label: "Difficulté", value: normalizeDifficultyLabel(recipeBlock?.difficulty) },
  {
    label: "Type de recette",
    value: normalizeRecipeMetaValue(recipeBlock?.recipeType, "recipeType"),
  },
  { label: "Type de plat", value: normalizeRecipeMetaValue(recipeBlock?.dishType, "dishType") },
  { label: "Cuisine", value: normalizeRecipeMetaValue(recipeBlock?.cuisine, "cuisine") },
  { label: "Portions", value: formatServingsLabel(recipeBlock?.servings) },
].filter((item) => item.value);

const printLink = `/print/${slug}/?auto=1`;
---

<div class="recipe-redesign" data-recipe-redesign data-recipe-redesign-slug={slug}>
  <section class="recipe-redesign__hero-card">
    <div class="recipe-redesign__topline">
      <nav class="recipe-redesign__breadcrumb" aria-label="Breadcrumb">
        <a href="/">Accueil</a>
        <span>/</span>
        <span>Recettes</span>
        <span>/</span>
        <span>{title}</span>
      </nav>

      <div class="recipe-redesign__share" aria-label="Partager la recette">
        {
          visibleShareLinks.map((link: any) => (
            <a
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="recipe-redesign__share-link"
              aria-label={`Partager sur ${link.label}`}
              data-share-platform={link.platform}
            >
              <i class={link.icon} aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </div>

    <div class="recipe-redesign__hero-copy">
      <h1 class="recipe-redesign__title">{title}</h1>

      <div class="recipe-redesign__rating" aria-label={ratingLabel}>
        <span class="recipe-redesign__stars" aria-hidden="true">
          {
            ratingStars.map((filled: boolean) => (
              <i class={filled ? "fas fa-star" : "far fa-star"} />
            ))
          }
        </span>
        <span>{ratingLabel}</span>
      </div>

      {
        heroMetaItems.length > 0 && (
          <div class="recipe-redesign__meta">
            {heroMetaItems.map((item: string) => (
              <span class="recipe-redesign__meta-pill">{item}</span>
            ))}
          </div>
        )
      }

      <div class="recipe-redesign__actions">
        <a
          href={collectionHref}
          class="recipe-redesign__action recipe-redesign__action--collection"
        >
          <i class="far fa-bookmark" aria-hidden="true"></i>
          <span>Ajouter à la collection</span>
        </a>
      </div>
    </div>

    {
      image && (
        <figure class="recipe-redesign__hero-image">
          <img
            src={heroImage}
            alt={imageAlt || title}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            width="797"
            height="1024"
            sizes="(min-width: 1280px) 38vw, (min-width: 960px) 46vw, 100vw"
            data-fallback-candidates={heroImageFallbackCandidates.join('|')}
            onerror="const current=this.currentSrc||this.src; const list=(this.dataset.fallbackCandidates||'').split('|').map((item)=>item.trim()).filter((item)=>item && item!==current); const next=list.shift(); this.dataset.fallbackCandidates=list.join('|'); if(next && next!==current) this.src=next;"
          />
        </figure>
      )
    }
  </section>

  <section class="recipe-redesign__section">
    <div class="recipe-redesign__card">
      <div class="recipe-redesign__section-head recipe-redesign__section-head--inside">
        <h2>Ingrédients</h2>
        <div class="recipe-redesign__servings" aria-label="Portions">
          <button type="button" class="is-active" data-multiplier="1">1x</button>
          <button type="button" data-multiplier="2">2x</button>
          <button type="button" data-multiplier="3">3x</button>
        </div>
      </div>
      {
        ingredientGroups.map((group: any) => (
          <section class="recipe-redesign__group">
            {group.heading && (
              <h3 class="recipe-redesign__group-title">{group.heading}</h3>
            )}
            <ul class="recipe-redesign__ingredients">
              {group.items.map((item: any) => (
                <li class="recipe-redesign__ingredient">
                  {item.quantity && (
                    <span
                      class="recipe-redesign__amount"
                      data-base-quantity={item.quantity}
                    >
                      {item.quantity}
                    </span>
                  )}
                  <span>{item.item}</span>
                  {item.notes && (
                    <span class="recipe-redesign__note">{item.notes}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <section class="recipe-redesign__section">
    <h2>Préparation</h2>
    <div class="recipe-redesign__steps">
      {
        stepGroups.map((group: any) => (
          <section class="recipe-redesign__step-group">
            {group.heading && (
              <h3 class="recipe-redesign__group-title">{group.heading}</h3>
            )}
            {group.items.map((step: any) => (
              <article class="recipe-redesign__step-card">
                <div class="recipe-redesign__step-copy">
                  <p class="recipe-redesign__step-text">{step.instruction}</p>
                </div>
                {step.media?.url && (
                  <figure class="recipe-redesign__step-media">
                    <img
                      src={step.media.url}
                      alt={step.media.alt || step.instruction}
                      loading="lazy"
                      decoding="async"
                      width="512"
                      height="512"
                      sizes="(min-width: 960px) 420px, (min-width: 768px) 60vw, 92vw"
                    />
                  </figure>
                )}
              </article>
            ))}
          </section>
        ))
      }
    </div>
  </section>

  <p class="recipe-redesign__bon-appetit">Bon appétit !</p>

  {
    image && (
      <figure class="recipe-redesign__final-image bon_img">
        <img
          src={image}
          alt={imageAlt || title}
          loading="lazy"
          decoding="async"
          width="1200"
          height="1200"
          sizes="(min-width: 1280px) 980px, (min-width: 768px) 88vw, 100vw"
          data-fallback-candidates={recipeImageFallbackCandidates.join('|')}
          onerror="const current=this.currentSrc||this.src; const list=(this.dataset.fallbackCandidates||'').split('|').map((item)=>item.trim()).filter((item)=>item && item!==current); const next=list.shift(); this.dataset.fallbackCandidates=list.join('|'); if(next && next!==current) this.src=next;"
        />
      </figure>
    )
  }

  <section class="recipe-redesign__recipe-card">
    <div class="recipe-redesign__recipe-card-hero">
      <div class="recipe-redesign__recipe-card-copy">
        <h2>{title}</h2>
        <div class="recipe-redesign__rating" aria-label={ratingLabel}>
          <span class="recipe-redesign__stars" aria-hidden="true">
            {
              ratingStars.map((filled: boolean) => (
                <i class={filled ? "fas fa-star" : "far fa-star"} />
              ))
            }
          </span>
          <span>{ratingLabel}</span>
        </div>
        {introText && <p class="recipe-redesign__excerpt">{introText}</p>}
      </div>

      {
        image && (
          <figure class="recipe-redesign__recipe-card-image">
            <img
              src={image}
              alt={imageAlt || title}
              loading="lazy"
              decoding="async"
              width="720"
              height="720"
              sizes="(min-width: 960px) 240px, 72vw"
              data-fallback-candidates={recipeImageFallbackCandidates.join('|')}
              onerror="const current=this.currentSrc||this.src; const list=(this.dataset.fallbackCandidates||'').split('|').map((item)=>item.trim()).filter((item)=>item && item!==current); const next=list.shift(); this.dataset.fallbackCandidates=list.join('|'); if(next && next!==current) this.src=next;"
            />
          </figure>
        )
      }
    </div>

    {
      quickInfoItems.length > 0 && (
        <div class="recipe-redesign__quick-info">
          {quickInfoItems.map((item) => (
            <div class="recipe-redesign__quick-info-item">
              <p>{item.label}</p>
              <strong>{item.value}</strong>
            </div>
          ))}
        </div>
      )
    }

    <div class="recipe-redesign__card">
      <div
        class="recipe-redesign__section-head recipe-redesign__section-head--compact recipe-redesign__section-head--inside"
      >
        <h3>Ingrédients</h3>
        <div class="recipe-redesign__servings" aria-label="Portions">
          <button type="button" class="is-active" data-multiplier="1">1x</button>
          <button type="button" data-multiplier="2">2x</button>
          <button type="button" data-multiplier="3">3x</button>
        </div>
      </div>
      {
        ingredientGroups.map((group: any) => (
          <section class="recipe-redesign__group">
            {group.heading && (
              <h4 class="recipe-redesign__group-title">{group.heading}</h4>
            )}
            <ul class="recipe-redesign__ingredients">
              {group.items.map((item: any) => (
                <li class="recipe-redesign__ingredient">
                  {item.quantity && (
                    <span
                      class="recipe-redesign__amount"
                      data-base-quantity={item.quantity}
                    >
                      {item.quantity}
                    </span>
                  )}
                  <span>{item.item}</span>
                  {item.notes && (
                    <span class="recipe-redesign__note">{item.notes}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <div class="recipe-redesign__card">
      <h3 class="recipe-redesign__compact-title">Préparation</h3>
      {
        stepGroups.map((group: any) => (
          <section class="recipe-redesign__group">
            {group.heading && (
              <h4 class="recipe-redesign__group-title">{group.heading}</h4>
            )}
            <ol class="recipe-redesign__instructions">
              {group.items.map((step: any) => (
                <li>{step.instruction}</li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>

    {(nutritionItems.length > 0 || showNutritionFallback) && (
      <div class="recipe-redesign__card recipe-redesign__nutrition-card">
        <h3 class="recipe-redesign__nutrition-title">Valeurs nutritionnelles</h3>
        {nutritionItems.length > 0 ? (
          <div class="recipe-redesign__nutrition">
            {nutritionItems.map((item: any) => (
              <div class="recipe-redesign__nutrition-item">
                <span>{item.label}</span>
                <strong>
                  {Math.round(toNumber(item.value) ?? 0)} {item.unit}
                </strong>
              </div>
            ))}
          </div>
        ) : (
          <p class="recipe-redesign__nutrition-empty">
            Valeurs nutritionnelles indisponibles pour cette recette.
          </p>
        )}
      </div>
    )}
  </section>
</div>

<script is:inline>
  (() => {
    const roots = Array.from(
      document.querySelectorAll("[data-recipe-redesign]"),
    );
    if (!roots.length) return;

    const unicodeFractions = {
      "¼": 0.25,
      "½": 0.5,
      "¾": 0.75,
      "⅓": 1 / 3,
      "⅔": 2 / 3,
      "⅛": 0.125,
      "⅜": 0.375,
      "⅝": 0.625,
      "⅞": 0.875,
    };

    const parseFraction = (token) => {
      const clean = String(token || "").trim();
      if (!clean) return null;
      if (unicodeFractions[clean] !== undefined) return unicodeFractions[clean];
      if (/^\d+\s+\d+\/\d+$/.test(clean)) {
        const [whole, fraction] = clean.split(/\s+/);
        const [num, den] = fraction.split("/").map(Number);
        return Number(whole) + num / den;
      }
      if (/^\d+\/\d+$/.test(clean)) {
        const [num, den] = clean.split("/").map(Number);
        return num / den;
      }
      const normalized = clean.replace(",", ".");
      const numeric = Number(normalized);
      return Number.isFinite(numeric) ? numeric : null;
    };

    const formatScaled = (value) => {
      const rounded = Math.round(value * 100) / 100;
      const fractionEntries = [
        [0.125, "1/8"],
        [0.25, "1/4"],
        [1 / 3, "1/3"],
        [0.375, "3/8"],
        [0.5, "1/2"],
        [0.625, "5/8"],
        [2 / 3, "2/3"],
        [0.75, "3/4"],
        [0.875, "7/8"],
      ];
      const whole = Math.floor(rounded);
      const decimal = rounded - whole;
      for (const [candidate, label] of fractionEntries) {
        if (Math.abs(decimal - candidate) < 0.02) {
          return whole > 0 ? `${whole} ${label}` : label;
        }
      }
      if (Math.abs(rounded - Math.round(rounded)) < 0.02)
        return String(Math.round(rounded));
      return String(rounded).replace(/\.0+$/, "").replace(".", ",");
    };

    const scaleQuantityText = (raw, multiplier) => {
      const value = String(raw || "").trim();
      if (!value) return value;
      const mixedMatch = value.match(/^(\d+\s+\d+\/\d+)(.*)$/);
      const fractionMatch = value.match(/^(\d+\/\d+|[¼½¾⅓⅔⅛⅜⅝⅞])(.*)$/);
      const decimalMatch = value.match(/^(\d+(?:[.,]\d+)?)(.*)$/);
      const match = mixedMatch || fractionMatch || decimalMatch;
      if (!match) return value;
      const base = parseFraction(match[1]);
      if (base === null) return value;
      const suffix = match[2] || "";
      return `${formatScaled(base * multiplier)}${suffix}`;
    };

    const applyMultiplier = (root, multiplier) => {
      root.querySelectorAll("[data-base-quantity]").forEach((node) => {
        const raw = node.getAttribute("data-base-quantity") || "";
        node.textContent = scaleQuantityText(raw, multiplier);
      });
      root
        .querySelectorAll(".recipe-redesign__servings button")
        .forEach((button) => {
          button.classList.toggle(
            "is-active",
            Number(button.dataset.multiplier || "1") === multiplier,
          );
        });
    };

    roots.forEach((root) => {
      const shareSlug = String(root.getAttribute("data-recipe-redesign-slug") || "").replace(/^\/+|\/+$/g, "");
      const currentArticleUrl = shareSlug
        ? new URL(`/${shareSlug}/`, window.location.origin).toString()
        : window.location.href;
      const shareTitle =
        root.querySelector(".recipe-redesign__title")?.textContent?.trim() ||
        document.title ||
        "Découvrez cette recette";

      root
        .querySelectorAll(".recipe-redesign__share-link[data-share-platform]")
        .forEach((link) => {
          if (!(link instanceof HTMLAnchorElement)) return;
          const platform = link.dataset.sharePlatform || "";

          if (platform === "facebook") {
            link.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentArticleUrl)}`;
          } else if (platform === "pinterest") {
            link.href = `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(currentArticleUrl)}&description=${encodeURIComponent(shareTitle)}`;
          } else if (platform === "email") {
            link.href = `mailto:?subject=${encodeURIComponent(shareTitle)}&body=${encodeURIComponent(currentArticleUrl)}`;
          }
        });

      root
        .querySelectorAll(".recipe-redesign__servings button")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const multiplier = Number(button.dataset.multiplier || "1");
            applyMultiplier(root, multiplier);
          });
        });
      applyMultiplier(root, 1);
    });
  })();
</script>

<style>
  .bon_img img {
    width: 100% !important;
  }
  .recipe-redesign {
    display: grid;
    gap: 26px;
    width: 100%;
    min-width: 0;
  }

  .recipe-redesign__hero-card,
  .recipe-redesign__card,
  .recipe-redesign__recipe-card,
  .recipe-redesign__step-card,
  .recipe-redesign__final-image {
    background: #faf8f2;
    border: 1px solid #ddd6c8;
    border-radius: 18px;
    box-shadow: 0 8px 28px rgba(50, 42, 28, 0.05);
  }

  .recipe-redesign__hero-card {
    padding: 26px 28px 30px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  .recipe-redesign__topline,
  .recipe-redesign__section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .recipe-redesign__topline {
    grid-column: 1 / -1;
  }

  .recipe-redesign__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    color: var(--lcdb-muted);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .recipe-redesign__breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .recipe-redesign__share {
    display: inline-flex;
    gap: 10px;
    flex-shrink: 0;
  }

  .recipe-redesign__share-link {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #d8d0c2;
    border-radius: 999px;
    color: #2a2a2a;
    text-decoration: none;
  }

  .recipe-redesign__hero-copy {
    display: grid;
    gap: 22px;
    align-content: start;
    max-width: none;
  }

  .recipe-redesign__title,
  .recipe-redesign__section h2,
  .recipe-redesign__recipe-card h2,
  .recipe-redesign__compact-title,
  .recipe-redesign__nutrition-title {
    margin: 0;
    color: #111;
    font-family: var(--font-heading), serif;
    font-weight: 500;
    line-height: 1.02;
  }

  .recipe-redesign__title {
    font-size: clamp(2rem, 3.2vw, 3.2rem);
    padding: 2px 0 6px;
  }

  .recipe-redesign__rating {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--lcdb-copy);
    font-size: 0.95rem;
    flex-wrap: wrap;
  }

  .recipe-redesign__stars {
    display: inline-flex;
    gap: 4px;
    color: #54b6b1;
  }

  .recipe-redesign__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .recipe-redesign__actions {
    display: flex;
    gap: 10px;
    flex-wrap: nowrap;
  }

  .recipe-redesign__action--collection {

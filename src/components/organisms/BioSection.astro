---
interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props as Props;

const features = [
  {
    title: 'Vrai Chef, Vraies Recettes',
    description: 'Form&eacute; dans les plus grandes maisons parisiennes',
    icon: '/images/feature-fish.svg',
  },
  {
    title: 'Contenu 100% Original',
    description: 'Aucune IA, aucun plagiat, que de l&apos;authenticit&eacute;',
    icon: '/images/feature-shrimp.svg',
  },
  {
    title: 'Test&eacute;es et Approuv&eacute;es',
    description: 'Chaque recette valid&eacute;e par des centaines de lecteurs',
    icon: '/images/feature-bowl.svg',
  },
];
---

<section class={`relative ${embedded ? 'py-12 md:py-16' : 'py-16 md:py-24 bg-secondary-cream overflow-hidden'}`}>
  {!embedded && (
    <div
      class="section-noise-overlay absolute inset-0 pointer-events-none opacity-28"
      aria-hidden="true"
    ></div>
  )}
  <div class={embedded ? 'relative z-10' : 'max-w-[1440px] mx-auto px-5 md:px-10 lg:px-[90px] relative z-10'}>
    <div class="bio-section-card">
      <div class="bio-section-grid">
        <div class="bio-section-media">
          <img
            src="/images/bernard-chef-2010.png"
            alt="Bernard Laurance"
            class="bio-section-media-image"
            loading="lazy"
          />
        </div>
        <div class="bio-section-content">
          <div class="bio-section-content-inner">
            <div class="bio-section-intro">
              <p class="bio-section-eyebrow">L&apos;humain derri&egrave;re les recettes</p>
              <h2 class="bio-section-title">
                Bernard, Chef cuisinier depuis 2010
              </h2>
              <p class="bio-section-description">
                Dans un monde satur&eacute; de contenu g&eacute;n&eacute;r&eacute; automatiquement, je m&apos;engage &agrave; vous offrir des recettes authentiques, test&eacute;es dans ma cuisine et celles de mes ateliers. Chaque technique, chaque astuce, chaque photo provient d&apos;une exp&eacute;rience r&eacute;elle.
              </p>
            </div>

            <div class="bio-section-features">
              {features.map((feature) => (
                <div class="bio-section-feature">
                  <img src={feature.icon} alt="" aria-hidden="true" class="bio-section-feature-icon" />
                  <div>
                    <p class="bio-section-feature-title" set:html={feature.title}></p>
                    <p class="bio-section-feature-description" set:html={feature.description}></p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

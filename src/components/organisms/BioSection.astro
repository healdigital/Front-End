---
import Icon from '../atoms/Icon.astro';

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props as Props;

const features = [
  {
    title: 'Vrai Chef, Vraies Recettes',
    description: 'Form&eacute; dans les plus grandes maisons parisiennes',
    icon: 'utensils',
  },
  {
    title: 'Contenu 100% Original',
    description: 'Aucune IA, aucun plagiat, que de l&apos;authenticit&eacute;',
    icon: 'check',
  },
  {
    title: 'Test&eacute;es et Approuv&eacute;es',
    description: 'Chaque recette valid&eacute;e par des centaines de lecteurs',
    icon: 'star',
  },
];
---

<section class={`relative ${embedded ? 'py-12 md:py-16' : 'py-16 md:py-24 bg-secondary-cream overflow-hidden'}`}>
  {!embedded && (
    <div
      class="absolute inset-0 pointer-events-none opacity-28"
      aria-hidden="true"
      style="background-image: url('/images/noise.png'); background-size: 180px 180px;"
    ></div>
  )}
  <div class={embedded ? 'relative z-10' : 'max-w-[1440px] mx-auto px-5 md:px-10 lg:px-[90px] relative z-10'}>
    <div class="flex flex-col lg:flex-row gap-8">
      <div class="flex-1 min-w-0">
        <img
          src="/images/bernard-chef-2010.png"
          alt="Bernard Laurance"
          class="w-full h-[520px] lg:h-[760px] object-cover object-top rounded-[10px]"
          loading="lazy"
        />
      </div>
      <div class="flex-1 bg-[#F7F5EF] rounded-[10px] border border-[#DDD8CA] p-8 lg:p-12">
        <p class="font-mono text-[12px] uppercase tracking-[0.24em] text-[#2F3441] typ-meta">L&apos;humain derri&egrave;re les recettes</p>
        <h2 class="font-heading text-[44px] md:text-[56px] lg:text-[72px] leading-[1.02] text-[#161A22] mt-4">
          Bernard, Chef cuisinier depuis 2010
        </h2>
        <p class="text-[15px] text-[#555C67] leading-[1.7] mt-5 typ-body">
          Dans un monde satur&eacute; de contenu g&eacute;n&eacute;r&eacute; automatiquement, je m&apos;engage &agrave; vous offrir des recettes authentiques, test&eacute;es dans ma cuisine et celles de mes ateliers. Chaque technique, chaque astuce, chaque photo provient d&apos;une exp&eacute;rience r&eacute;elle.
        </p>
        <div class="mt-7 border-t border-[#D8D2C2] pt-7 space-y-5">
          {features.map((feature) => (
            <div class="flex gap-4">
              <div class="w-10 h-10 flex items-center justify-center text-primary-turquoise flex-shrink-0">
                <Icon name={feature.icon as any} size="sm" />
              </div>
              <div>
                <p class="text-[20px] leading-[1.25] font-body font-semibold text-[#22303B] md:text-[22px]" set:html={feature.title}></p>
                <p class="text-[15px] text-[#6B7280] typ-body" set:html={feature.description}></p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

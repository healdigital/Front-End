    </div>
  )}

  {isFull && (
    <div class="sidebar-block px-6 py-8">
      <h4 class="sidebar-title">Rejoignez mon club</h4>
      <ul class="mt-4 space-y-4 text-[16px] text-[#2A3543] recipe-sidebar-club-list">
        <li class="recipe-sidebar-club-item">
          <span class="recipe-sidebar-club-icon"><Icon name="book" size="sm" /></span>
          <span>Échanges passionnés</span>
        </li>
        <li class="recipe-sidebar-club-item">
          <span class="recipe-sidebar-club-icon"><Icon name="refresh" size="sm" /></span>
          <span>Recettes avancées</span>
        </li>
        <li class="recipe-sidebar-club-item">
          <span class="recipe-sidebar-club-icon"><Icon name="video" size="sm" /></span>
          <span>Conseils exclusifs</span>
        </li>
      </ul>
      <a href={SHOP_CLUB_URL} class="inline-flex items-center gap-2 text-primary-turquoise text-[13px] uppercase tracking-[0.08em] mt-6 underline underline-offset-2 typ-button label-data">
        Rejoindre le club
      </a>
    </div>
  )}

  {isFull && (
    <div class="sidebar-block px-6 py-8 recipe-sidebar-books-block">
      <p class="recipe-sidebar-books-eyebrow">{sidebarBooksEyebrow}</p>
      <h4 class="recipe-sidebar-books-title">{sidebarBooksTitle}</h4>
      <p class="recipe-sidebar-books-description">{sidebarBooksDescription}</p>

      <div class="sidebar-books-grid recipe-sidebar-books-grid mt-6">
        {sidebarBooks.map((book) => (
          <a
            href={book.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={['recipe-sidebar-book-card', book.inset && 'recipe-sidebar-book-card--inset']}
            aria-label={`Découvrir le livre ${book.alt}`}
          >
            <img
              src={book.src}
              alt={book.alt}
              class="recipe-sidebar-book-image"
              loading="lazy"
              decoding="async"
              width="420"
              height="620"
            />
          </a>
        ))}
      </div>
      <a href="/mes-livres" class="label-data inline-flex items-center gap-2 text-primary-turquoise text-[13px] uppercase tracking-[0.08em] mt-5 underline underline-offset-2 typ-button">
        Voir tous les livres
      </a>
    </div>
  )}

  <div class:list={['recipe-sidebar-sticky-rail', stickyPopularRail && 'recipe-sidebar-sticky-rail--enabled']}>
    <div class="sidebar-block px-6 py-8">
      <h4 class="sidebar-title">Articles populaires</h4>
      <div class="space-y-4 mt-5">
        {normalizedPopularArticles.map((article) => (
          <a href={article.slug} class="flex gap-3 items-start border-b border-[#D8D2C2] pb-4 last:border-b-0 last:pb-0">
            <img
              src={article.image}
              alt=""
              class="w-[92px] h-[72px] shrink-0 object-cover rounded-[6px]"
              loading="lazy"
              decoding="async"
              width="92"
              height="72"
            />
            <div class="min-w-0 flex-1">
              {article.label && (
                <p class="inline-flex max-w-full items-center rounded-full bg-[#F0EFE8] px-2 py-[3px] text-[10px] uppercase tracking-[0.06em] text-[#2D3643] font-mono article-date">
                  {article.label}
                </p>
              )}
              <p class="text-[17px] leading-[1.18] text-[#111111] mt-2 font-heading article-title break-words">{article.title}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

      <div class="sidebar-block px-4 pt-4 pb-5">
        <div class="rounded-[8px] border border-[#D8D2C2] bg-[#F7F5EF] p-3" data-mediavine>
        <MediavineSlot slot={sidebarAdSlot} hint={false} minHeight={220} className="rounded-[6px] bg-[#E9E4D8]" />
        </div>
      </div>
    </div>
</aside>

<script>
  // @ts-nocheck
  function setupSidebarWorkshopData() {
    const blocks = Array.from(document.querySelectorAll('[data-sidebar-workshop]'));
    if (!blocks.length) return;

    const parser = new DOMParser();
    const dateFormatter = new Intl.DateTimeFormat('fr-FR', {
      day: 'numeric',
      month: 'short',
    });

    const decodeEntities = (value = '') =>
      parser.parseFromString(`<!doctype html><body>${String(value || '')}`, 'text/html').body.textContent || '';

    const toPositiveNumber = (value, fallback = 0) => {
      const numeric = Number(value);
      return Number.isFinite(numeric) && numeric >= 0 ? numeric : fallback;
    };

    const formatDuration = (value) => {
      const minutes = toPositiveNumber(value, 0);
      if (!minutes) return '--';
      const hours = Math.floor(minutes / 60);
      const restMinutes = minutes % 60;
      if (hours && restMinutes) return `${hours}h ${restMinutes}m`;
      if (hours) return `${hours}h`;
      return `${restMinutes}m`;
    };

    const normalizeStatus = (value) => {
      const raw = String(value || '').toUpperCase().trim();
      if (raw === 'SOLD_OUT') return 'SOLD_OUT';
      if (raw === 'LIMITED') return 'LIMITED';
      return 'OPEN';
    };

    const normalizeHref = (value = '', fallbackUrl = '') => {
      const raw = String(value || '').trim();
      if (!raw) return fallbackUrl || 'https://atelier-lacuisinedebernard.com/latelier/';
      if (/^https?:\/\//i.test(raw)) return raw;
      return raw.startsWith('/') ? raw : `/${raw.replace(/^\/+/, '')}`;
    };

    const normalizeImage = (value = '') => {
      const raw = String(value || '').trim();
      if (!raw) return '';
      if (/^https?:\/\//i.test(raw)) return raw;
      if (raw.startsWith('/')) return `https://atelier-lacuisinedebernard.com${raw}`;
      return '';
    };

    const resolveImageValue = (value) => {
      if (!value) return '';
      if (typeof value === 'string') return value;
      if (typeof value === 'object') {
        return String(value.url || value.src || value.sourceUrl || value.file || '').trim();
      }
      return '';
    };

    const mapWorkshopItem = (item, fallbackUrl = 'https://atelier-lacuisinedebernard.com/latelier/') => {
      if (!item || typeof item !== 'object') return null;
      const parsedDate = new Date(item.startAt || item.date || '');
      if (Number.isNaN(parsedDate.getTime())) return null;

      const title = decodeEntities(item.title || '').replace(/\s+/g, ' ').trim();
      if (!title) return null;
      const description = decodeEntities(
        item.shortDescription ||
          item.description ||
          item.excerpt ||
          item.summary ||
          item.content ||
          ''
      )
        .replace(/\s+/g, ' ')
        .trim();

      const maxParticipants = toPositiveNumber(item.capacity || item.maxParticipants, 0);
      const rawSpotsLeft = toPositiveNumber(item.spotsLeft, Number.NaN);
      const spotsLeft = Number.isFinite(rawSpotsLeft)
        ? rawSpotsLeft
        : maxParticipants > 0
        ? Math.max(maxParticipants - toPositiveNumber(item.currentParticipants, 0), 0)
        : 0;
      const currentParticipants = maxParticipants > 0 ? Math.max(maxParticipants - spotsLeft, 0) : 0;

      return {
        title,
        date: parsedDate,
        price: toPositiveNumber(item.price, 0),
        duration: formatDuration(item.durationMin || item.duration || 0),
        maxParticipants,
        currentParticipants,
        spotsLeft,
        description,
        status: normalizeStatus(item.status),
        slug: normalizeHref(item.bookingUrl || item.slug, fallbackUrl),
        image: normalizeImage(
          resolveImageValue(item.image) ||
          resolveImageValue(item.featuredImage) ||
          resolveImageValue(item.coverImage) ||
          resolveImageValue(item.thumbnail),
        ),
      };
    };

    const hydrateBlock = (block) => {
      if (!(block instanceof HTMLElement)) return;
      if (block.dataset.workshopLoaded === 'loading' || block.dataset.workshopLoaded === 'true') return;

      const apiUrl = String(block.dataset.workshopsApi || '').trim();
      const fallbackUrl = String(block.dataset.workshopsFallbackUrl || 'https://atelier-lacuisinedebernard.com/latelier/').trim();
      if (!apiUrl) return;

      block.dataset.workshopLoaded = 'loading';
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 5000);

      const applyFallbackState = (message) => {
        const statusEl = block.querySelector('[data-sidebar-workshop-status]');
        const titleEl = block.querySelector('[data-sidebar-workshop-title]');
        const descriptionEl = block.querySelector('[data-sidebar-workshop-description]');
        const capacityEl = block.querySelector('[data-sidebar-workshop-capacity]');
        const durationEl = block.querySelector('[data-sidebar-workshop-duration]');
        const priceEl = block.querySelector('[data-sidebar-workshop-price]');
        const monthEl = block.querySelector('[data-sidebar-workshop-month]');
        const dayEl = block.querySelector('[data-sidebar-workshop-day]');
        const imageEl = block.querySelector('[data-sidebar-workshop-image]');

        if (statusEl instanceof HTMLElement) {
          statusEl.textContent = message;
          statusEl.style.color = '#5F6671';
        }

        if (titleEl instanceof HTMLElement) titleEl.textContent = 'Atelier à venir';
        if (descriptionEl instanceof HTMLElement) {
          descriptionEl.textContent =
            'Les prochains ateliers ne sont pas disponibles pour le moment. Vous pouvez consulter la page atelier pour voir les mises à jour dès leur publication.';
        }
        if (capacityEl instanceof HTMLElement) capacityEl.textContent = '--';
        if (durationEl instanceof HTMLElement) durationEl.textContent = '--';
        if (priceEl instanceof HTMLElement) priceEl.textContent = '--';
        if (monthEl instanceof HTMLElement) monthEl.textContent = '--';
        if (dayEl instanceof HTMLElement) dayEl.textContent = '--';
        if (imageEl instanceof HTMLImageElement) {
          imageEl.src = '/images/ateliers-physiques.jpg';
          imageEl.alt = 'Atelier à venir';
        }
      };

      fetch(apiUrl, {
        method: 'GET',
        headers: { Accept: 'application/json' },
        cache: 'no-store',
        signal: controller.signal,
      })
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json();
        })
        .then((payload) => {
          const items = Array.isArray(payload?.items) ? payload.items : Array.isArray(payload) ? payload : [];
          const workshops = items
            .map((item) => mapWorkshopItem(item, fallbackUrl))
            .filter(Boolean)
            .sort((a, b) => a.date.getTime() - b.date.getTime());

          const firstWorkshop = workshops[0];
          if (!firstWorkshop) {
            block.dataset.workshopLoaded = 'empty';
            applyFallbackState('Ateliers bientôt disponibles');
            return;
          }

          const monthEl = block.querySelector('[data-sidebar-workshop-month]');
          const dayEl = block.querySelector('[data-sidebar-workshop-day]');
          const titleEl = block.querySelector('[data-sidebar-workshop-title]');
          const statusEl = block.querySelector('[data-sidebar-workshop-status]');
          const capacityEl = block.querySelector('[data-sidebar-workshop-capacity]');
          const durationEl = block.querySelector('[data-sidebar-workshop-duration]');
          const priceEl = block.querySelector('[data-sidebar-workshop-price]');
          const descriptionEl = block.querySelector('[data-sidebar-workshop-description]');
          const ctaEl = block.querySelector('[data-sidebar-workshop-cta]');
          const imageEl = block.querySelector('[data-sidebar-workshop-image]');

          if (titleEl instanceof HTMLElement) {
            titleEl.textContent = firstWorkshop.title;
          }

          const dateParts = dateFormatter.formatToParts(firstWorkshop.date);
          const month = dateParts.find((part) => part.type === 'month')?.value || '--';
          const day = dateParts.find((part) => part.type === 'day')?.value || '--';

          if (monthEl instanceof HTMLElement) monthEl.textContent = month;
          if (dayEl instanceof HTMLElement) dayEl.textContent = day;

          if (statusEl instanceof HTMLElement) {
            const directSpotsLeft = toPositiveNumber(firstWorkshop.spotsLeft, Number.NaN);
            const spotsLeft = Number.isFinite(directSpotsLeft)
              ? directSpotsLeft
              : firstWorkshop.maxParticipants > 0
              ? Math.max(firstWorkshop.maxParticipants - firstWorkshop.currentParticipants, 0)
              : Number.NaN;
            const hasSpotsInfo = Number.isFinite(spotsLeft);
            const isSoldOut =
              firstWorkshop.status === 'SOLD_OUT' ||
              ((firstWorkshop.maxParticipants > 0 || hasSpotsInfo) && (spotsLeft || 0) <= 0);

            if (isSoldOut) {
              statusEl.textContent = 'Complet';
              statusEl.style.color = '#B24639';
            } else if (hasSpotsInfo) {
              const plural = spotsLeft === 1 ? '' : 's';
              statusEl.textContent = `${spotsLeft} place${plural} disponible${plural}`;
              statusEl.style.color = firstWorkshop.status === 'LIMITED' ? '#B24639' : '#2E7D5A';
            } else {
              statusEl.textContent = firstWorkshop.status === 'LIMITED' ? 'Dernières places' : 'Places disponibles';
              statusEl.style.color = firstWorkshop.status === 'LIMITED' ? '#B24639' : '#2E7D5A';
            }
          }

          if (capacityEl instanceof HTMLElement) {
            const directSpotsLeft = toPositiveNumber(firstWorkshop.spotsLeft, Number.NaN);
            const spotsLeft = Number.isFinite(directSpotsLeft)
              ? directSpotsLeft
              : firstWorkshop.maxParticipants > 0
              ? Math.max(firstWorkshop.maxParticipants - firstWorkshop.currentParticipants, 0)
              : Number.NaN;

            if (Number.isFinite(spotsLeft)) {
              const plural = spotsLeft === 1 ? '' : 's';
              capacityEl.textContent = `${spotsLeft} place${plural} disponible${plural}`;
            } else {
              capacityEl.textContent = firstWorkshop.status === 'SOLD_OUT' ? 'Complet' : '--';
            }
          }

          if (durationEl instanceof HTMLElement) {
            durationEl.textContent = firstWorkshop.duration || '--';
          }

          if (priceEl instanceof HTMLElement) {
            priceEl.textContent = firstWorkshop.price > 0 ? `${Math.round(firstWorkshop.price)}€` : '--';
          }

          if (descriptionEl instanceof HTMLElement) {
            descriptionEl.textContent =
              firstWorkshop.description ||
              'Je vous accueille dans des ateliers de cuisine et de pâtisserie dans une ambiance conviviale, avec une approche précise, généreuse et accessible.';
          }

          if (imageEl instanceof HTMLImageElement) {
            imageEl.src = firstWorkshop.image || '/images/ateliers-physiques.jpg';
            imageEl.alt = firstWorkshop.title || 'Atelier de cuisine';
          }

          if (ctaEl instanceof HTMLAnchorElement) {
            ctaEl.href = firstWorkshop.slug || fallbackUrl || 'https://atelier-lacuisinedebernard.com/latelier/';
            ctaEl.target = '_blank';
            ctaEl.rel = 'noopener noreferrer';
          }

          block.dataset.workshopLoaded = 'true';
        })
        .catch((error) => {
          console.warn('[SIDEBAR] Failed to load workshop data:', error);
          block.dataset.workshopLoaded = 'error';
          applyFallbackState('Ateliers bientôt disponibles');
        })
        .finally(() => {
          window.clearTimeout(timeout);
        });
    };

    blocks.forEach((block) => {
      if (!(block instanceof HTMLElement)) return;
      if (block.dataset.workshopObserverBound === 'true') return;
      block.dataset.workshopObserverBound = 'true';

      const start = () => hydrateBlock(block);

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          start();
        }, {
          rootMargin: '240px 0px',
          threshold: 0.01,
        });

        observer.observe(block);
        return;
      }

      if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(() => start(), { timeout: 1800 });
      } else {
        window.setTimeout(() => start(), 400);
      }
    });
  }

  setupSidebarWorkshopData();
  document.addEventListener('astro:page-load', setupSidebarWorkshopData);
</script>


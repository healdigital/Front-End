---
import Icon from '../atoms/Icon.astro';
import Button from '../atoms/Button.astro';

interface Props {
  variant?: 'full' | 'popular';
  className?: string;
}

const { variant = 'full', className = '' } = Astro.props as Props;
const isFull = variant === 'full';

const popularArticles = [
  {
    title: 'Salade de nouilles de tofu aux 5 parfums, l&eacute;gumes frais et sauce...',
    date: 'R&eacute;dig&eacute; le 3 janv 2026',
    image: '/images/workshop-soup.jpg',
    slug: '/salade-nouilles-tofu',
  },
  {
    title: 'Concombres marin&eacute;s',
    date: 'R&eacute;dig&eacute; le 8 janv 2026',
    image: '/images/workshop-dumplings.jpg',
    slug: '/concombres-marines',
  },
  {
    title: 'Caldo de feijao (soupe br&eacute;silienne de haricots)',
    date: 'R&eacute;dig&eacute; le 12 janv 2026',
    image: '/images/masterclass-featured.jpg',
    slug: '/caldo-feijao',
  },
  {
    title: 'Les indispensables de ma cuisine professionnelle',
    date: 'R&eacute;dig&eacute; le 14 f&eacute;v 2026',
    image: '/images/ateliers-physiques.jpg',
    slug: '/indispensables-cuisine-pro',
  },
  {
    title: 'Lohikeitto (soupe de saumon finlandaise)',
    date: 'R&eacute;dig&eacute; le 23 f&eacute;v 2026',
    image: '/images/masterclass-video.jpg',
    slug: '/lohikeitto',
  },
];
---

<aside class={`hidden lg:flex flex-col w-full min-h-full ${className}`}>
  {isFull && (
    <div class="px-5 py-8 border-b border-[#D8D2C2] text-center">
      <img
        src="/images/bernard-avatar-mask.png"
        alt="Bernard Laurance"
        class="w-[130px] h-[130px] rounded-full object-cover object-top mx-auto"
      />
      <h3 class="font-heading text-[26px] leading-[1.02] text-text-primary mt-5">Bernard Laurance</h3>
      <p class="font-mono text-[13px] uppercase tracking-[0.14em] text-text-secondary mt-3 typ-meta">
        Cuisine r&eacute;elle, recettes test&eacute;es depuis 2010
      </p>
      <p class="text-[16px] text-text-secondary leading-[1.7] mt-5 typ-body">
        Voyageur et passionn&eacute; de cuisine, je vous livre tous mes secrets de cuisine, sans d&eacute;tour. J&apos;essaie de rendre hommage aux traditions, du canel&eacute; de Bordeaux aux dim-sums de Hong Kong. Les recettes de Bernard, ce sont des dizaines de recettes de p&acirc;tisseries, d&apos;entr&eacute;es et de plats divers.
      </p>

      <div class="mt-7">
        <div class="flex items-center justify-center gap-6 text-[#171F2C]">
          <span class="w-11 h-11 rounded-full bg-[#F0EFE8] flex items-center justify-center"><i class="fab fa-facebook-f text-[20px]"></i></span>
          <span class="w-11 h-11 rounded-full bg-[#F0EFE8] flex items-center justify-center"><i class="fab fa-instagram text-[20px]"></i></span>
          <span class="w-11 h-11 rounded-full bg-[#F0EFE8] flex items-center justify-center"><i class="fab fa-youtube text-[20px]"></i></span>
          <span class="w-11 h-11 rounded-full bg-[#F0EFE8] flex items-center justify-center"><i class="fab fa-pinterest text-[20px]"></i></span>
        </div>
        <div class="mt-3 flex items-center justify-center gap-9 text-[#23313B] text-[15px]">
          <span>145 .7k</span>
          <span>62k</span>
          <span>1k</span>
          <span>0 .5k</span>
        </div>
      </div>

      <a href="/a-propos" class="inline-block mt-8 text-primary-turquoise font-body text-[13px] uppercase tracking-[0.08em] underline underline-offset-2 typ-button">
        D&eacute;couvrir son univers
      </a>
    </div>
  )}

  {isFull && (
    <div class="px-5 py-8 border-b border-[#D8D2C2]">
      <h4 class="font-body text-[18px] uppercase tracking-[0.03em] text-text-primary mb-5">Apprendre en atelier</h4>
      <div class="bg-[#F7F5EF] rounded-[10px] p-6 border border-[#D8D2C2]">
        <p class="text-[13px] uppercase tracking-[0.14em] text-status-error font-mono mb-3 typ-meta">Derni&egrave;res places</p>

        <div class="flex items-start justify-between gap-4">
          <h5 class="font-heading text-[43px] leading-[1] text-text-primary">Atelier cuisine chinoise</h5>
          <div class="bg-[#F7F5EF] rounded-[14px] p-2 text-center min-w-[76px] border border-[#D8D2C2]">
            <span class="block text-[13px] uppercase text-text-secondary font-mono">Mar</span>
            <span class="block text-[50px] leading-none text-text-primary font-heading">9</span>
          </div>
        </div>

        <div class="flex items-center gap-5 text-[#2E3441] text-[13px] mt-4 uppercase tracking-[0.08em] border-b border-[#D8D2C2] pb-4">
          <span class="flex items-center gap-1"><Icon name="users" size="sm" /> 8 personnes maximum</span>
          <span class="flex items-center gap-1"><Icon name="clock" size="sm" /> 4 heures</span>
        </div>

        <p class="text-[16px] text-text-secondary mt-5 leading-[1.7] typ-body">Apprenez directement &agrave; mes c&ocirc;t&eacute;s dans un atelier intimiste.</p>

        <div class="flex items-center justify-between mt-8 pt-5 border-t border-[#D8D2C2]">
          <div>
            <span class="text-[13px] uppercase tracking-[0.14em] text-text-secondary typ-meta">&Agrave; partir de</span>
            <div class="font-heading text-[60px] leading-none text-text-primary">85&euro;</div>
          </div>
          <Button href="/atelier-cuisine-chinoise" variant="primary" size="sm">R&eacute;server</Button>
        </div>
      </div>

      <a href="/ateliers" class="inline-flex items-center gap-2 text-primary-turquoise text-[13px] uppercase tracking-[0.08em] mt-5 underline underline-offset-2 typ-button">
        Voir le calendrier complet
      </a>
    </div>
  )}

  {isFull && (
    <div class="px-5 py-8 border-b border-[#D8D2C2]">
      <h4 class="font-body text-[18px] uppercase tracking-[0.03em] text-text-primary mb-5">Masterclass vid&eacute;os</h4>
      <div class="bg-[#F7F5EF] rounded-[10px] overflow-hidden border border-[#D8D2C2]">
        <div class="relative">
          <img src="/images/masterclass-video.jpg" alt="Masterclass" class="w-full h-[165px] object-cover" />
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-[70px] h-[70px] rounded-full bg-white/90 flex items-center justify-center">
              <Icon name="video" size="sm" class="text-primary-turquoise" />
            </div>
          </div>
        </div>

        <div class="p-6">
          <div class="flex items-center gap-2 mb-2 flex-wrap">
            <span class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-[13px] uppercase tracking-[0.08em] text-text-primary">
              <Icon name="lock" size="sm" /> Acc&egrave;s illimit&eacute;
            </span>
            <span class="inline-flex items-center gap-2 rounded-full bg-[#BBA86B] px-3 py-1 text-[13px] uppercase tracking-[0.08em] text-white">
              R&eacute;serv&eacute; Premium
            </span>
          </div>

          <h5 class="font-heading text-[43px] leading-[1] text-text-primary mt-3">G&acirc;teau indien aux carottes !</h5>

          <div class="flex items-center gap-4 text-text-secondary text-[13px] mt-4 uppercase tracking-[0.08em] border-b border-[#D8D2C2] pb-4">
            <span class="flex items-center gap-1"><Icon name="clock" size="sm" /> 2h</span>
            <span class="flex items-center gap-1"><Icon name="video" size="sm" /> Vid&eacute;o 4K</span>
          </div>

          <p class="text-[16px] text-text-secondary mt-5 leading-[1.7] typ-body">Technique professionnelle pas &agrave; pas.</p>
          <Button href="/masterclass" variant="primary" size="sm" class="w-full mt-4">Voir la vid&eacute;o</Button>
        </div>
      </div>

      <a href="/masterclass" class="inline-flex items-center gap-2 text-primary-turquoise text-[13px] uppercase tracking-[0.08em] mt-5 underline underline-offset-2 typ-button">
        Voir toutes les vid&eacute;os masterclass
      </a>
    </div>
  )}

  {isFull && (
    <div class="px-5 py-8 border-b border-[#D8D2C2]">
      <h4 class="font-body text-[18px] uppercase tracking-[0.03em] text-text-primary mb-5">Rejoignez mon club</h4>
      <ul class="space-y-4 text-[16px] text-text-secondary">
        <li class="flex items-center gap-2"><Icon name="book" size="sm" /> &Eacute;changes passionn&eacute;s</li>
        <li class="flex items-center gap-2"><Icon name="star" size="sm" /> Recettes avanc&eacute;es</li>
        <li class="flex items-center gap-2"><Icon name="check" size="sm" /> Conseils exclusifs</li>
      </ul>
      <a href="/club" class="inline-flex items-center gap-2 text-primary-turquoise text-[13px] uppercase tracking-[0.08em] mt-5 underline underline-offset-2 typ-button">
        Rejoindre le club
      </a>
    </div>
  )}

  {isFull && (
    <div class="px-5 py-8 border-b border-[#D8D2C2]">
      <h4 class="font-body text-[18px] uppercase tracking-[0.03em] text-text-primary mb-5">Mes livres pour approfondir</h4>
      <div class="grid grid-cols-2 gap-3">
        <img src="/images/book-1.png" alt="Livre 1" class="w-full h-[120px] object-cover rounded-md" />
        <img src="/images/book-2.jpg" alt="Livre 2" class="w-full h-[120px] object-cover rounded-md" />
        <img src="/images/book-3.png" alt="Livre 3" class="w-full h-[120px] object-cover rounded-md" />
        <img src="/images/book-4.jpg" alt="Livre 4" class="w-full h-[120px] object-cover rounded-md" />
      </div>
      <a href="/livres" class="inline-flex items-center gap-2 text-primary-turquoise text-[13px] uppercase tracking-[0.08em] mt-5 underline underline-offset-2 typ-button">
        Voir tous les livres
      </a>
    </div>
  )}

  <div class="px-5 py-8 border-b border-[#D8D2C2]">
    <h4 class="font-body text-[18px] uppercase tracking-[0.03em] text-text-primary mb-5">Articles populaires</h4>
    <div class="space-y-4">
      {popularArticles.map((article) => (
        <a href={article.slug} class="flex gap-3 items-start border-b border-[#D8D2C2] pb-4 last:border-b-0 last:pb-0">
          <img src={article.image} alt="" class="w-[166px] h-[93px] object-cover rounded-md" />
          <div>
            <p class="text-[13px] uppercase tracking-[0.08em] text-text-secondary typ-meta" set:html={article.date}></p>
            <p class="text-[28px] leading-[1] text-text-primary mt-2 font-heading" set:html={article.title}></p>
          </div>
        </a>
      ))}
    </div>
  </div>

  <div class="px-5 py-8">
    <div class="bg-secondary-cream rounded-lg border border-[#D8D2C2] h-[240px] flex items-center justify-center text-text-secondary text-[13px] uppercase tracking-[0.12em] typ-meta">
      Espace publicit&eacute;
    </div>
  </div>
</aside>

---
import Icon from '../atoms/Icon.astro';
import Button from '../atoms/Button.astro';
import MediavineSlot from '../MediavineSlot.astro';
import { getPopularSidebarArticles } from '../../lib/articleDiscovery';
import { loadFeaturedCourses } from '../../lib/videoCourses';
import { repairDeepStrings } from '../../utils/repairMojibake';

interface Props {
  variant?: 'full' | 'popular';
  className?: string;
  stickyPopularRail?: boolean;
  mobileVisible?: boolean;
}

const { variant = 'full', className = '', stickyPopularRail = false, mobileVisible = false } = Astro.props as Props;
const isFull = variant === 'full';
const responsiveClass = mobileVisible ? 'flex lg:hidden' : 'hidden lg:flex';
// Single source for right-sidebar workshop CTA target.
// Keep absolute URL so sidebar CTA always opens the workshop tab correctly.
const SIDEBAR_WORKSHOP_URL = 'https://atelier-lacuisinedebernard.com/latelier/';
const normalizeWorkshopUrl = (value: string | undefined | null): string => {
  const raw = String(value || '').trim();
  if (!raw) return SIDEBAR_WORKSHOP_URL;
  if (/https?:\/\/atelier-lacuisinedebernard\.com\/les-cours\/?/i.test(raw)) {
    return SIDEBAR_WORKSHOP_URL;
  }
  if (/^\/les-cours\/?$/i.test(raw)) {
    return SIDEBAR_WORKSHOP_URL;
  }
  return raw;
};
const workshopsApiUrl =
  import.meta.env.WORKSHOPS_CACHE_URL ||
  process.env.WORKSHOPS_CACHE_URL ||
  'https://lacuisinedebernard.com/api/workshops-cache';
const fallbackPopularArticles = [
  {
    title: 'Salade de nouilles de tofu aux 5 parfums',
    label: 'Salé',
    image: '/images/workshop-soup.jpg',
    slug: '/salade-nouilles-tofu',
  },
  {
    title: 'Concombres marinés',
    label: 'Accompagnement',
    image: '/images/workshop-dumplings.jpg',
    slug: '/concombres-marines',
  },
  {
    title: 'Lohikeitto',
    label: 'Soupes',
    image: '/images/masterclass-video.jpg',
    slug: '/lohikeitto',
  },
];
const computedPopularArticles = await getPopularSidebarArticles(5, 'fr');
const popularArticles = computedPopularArticles.length ? computedPopularArticles : fallbackPopularArticles;
const sidebarProfileBullets = [
  {
    title: 'Recettes 100% humaines, testées dans mon atelier',
    body: 'Chaque recette est réellement préparée, goûtée et ajustée avant d’être publiée.',
  },
  {
    title: 'Contenu 100 % original',
    body: 'Photos, explications, astuces, techniques : tout est pensé pour une vraie transmission.',
  },
  {
    title: 'Photos 100% réelles',
    body: 'Tout ce que vous voyez ici est vrai et dévoré avec voracité !',
  },
  {
    title: 'Pas à pas clairs et détaillés',
    body: 'Des recettes précises, pour comprendre ce que l’on fait et réussir vraiment.',
  },
];

const sidebarBooksEyebrow = 'Bibliothèque';
const sidebarBooksTitle = 'Les livres de Bernard';
const sidebarBooksDescription =
  'Des livres dédiés à la pâtisserie, aux classiques et aux saveurs du monde pour continuer à cuisiner avec méthode.';
const sidebarBooks = [
  {
    src: '/images/book-asie-sucree.jpg',
    alt: 'Asie sucrée',
    href: '/mes-livres/',
  },
  {
    src: '/images/book-vege-terrien.jpeg',
    alt: 'Végéterrien',
    href: 'https://www.amazon.fr/gp/product/2081414988/ref=as_li_tl?ie=UTF8&camp=1642&creative=6746&creativeASIN=2081414988&linkCode=as2&tag=lacuisidebern-21&linkId=719ca79e49e810d99cb31199bb21405d',
  },
  {
    src: '/images/book-bouchee.jpg',
    alt: "Je n'en ferai qu'une bouchée",
    href: 'https://www.amazon.fr/Je-nen-ferai-quune-bouch%C3%A9e/dp/2081386011?ie=UTF8&camp=1642&creativeASIN=2081386011&linkCode=xm2&redirect=true&tag=lacuisidebern-21',
  },
  {
    src: '/images/book-mes-desserts.jpg',
    alt: 'Mes desserts de Bernard',
    href: 'https://www.amazon.fr/dp/2081314290?tag=lacuisidebern-21&camp=2910&creative=19482&linkCode=as4&creativeASIN=2081314290&adid=1HMR2DYG7WSG2NANSAQG&&ref-refURL=http%3A%2F%2Fbernardl11.sg-host.com%2F',
  },
  {
    src: '/images/book-mon-grain-de-sel.jpg',
    alt: 'Mon grain de sel',
    href: 'https://www.amazon.fr/gp/product/2081416352/ref=as_li_tl?ie=UTF8&tag=lacuisidebern-21&camp=1642&creative=6746&linkCode=as2&creativeASIN=2081416352&linkId=f6c32b99905d32e830a53930d6340f88',
  },
  {
    src: '/images/book-je-fais-mon-chocolat-maison.png',
    alt: 'Je fais mon chocolat maison',
    href: 'https://lacuisinedebernard.com/produit/je-fais-mon-chocolat-maison/',
    inset: true,
  },
  {
    src: '/images/book-lacuisinedebernard.jpg',
    alt: 'La Cuisine de Bernard',
    href: 'https://www.amazon.fr/gp/product/2080231510/ref=as_li_qf_asin_il_tl?ie=UTF8&tag=lacuisidebern-21&creative=6746&linkCode=as2&creativeASIN=2080231510&linkId=4306a903ba047e2436550805f2f42efd',
  },
];

const SHOP_CLUB_URL = 'https://atelier-lacuisinedebernard.com/club/';
const SHOP_VIDEO_URL = SIDEBAR_WORKSHOP_URL;
const featuredVideoCourses = await loadFeaturedCourses();
const sidebarVideoCards = repairDeepStrings(
  
  (
    featuredVideoCourses.length
      ? featuredVideoCourses
      : [
          {
            id: 'sidebar-fallback-course',
            title: 'Mes cours vidéo',
            shortDescription:
              'Des techniques essentielles expliquées pas à pas pour progresser chez vous à votre rythme.',
            courseUrl: SHOP_VIDEO_URL,
            image: '/images/masterclass-video.jpg',
            duration: null,
          },
        ]
  )
    .slice(0, 3)
    .map((course) => ({
      id: course.id,
      title: course.title || 'Mes cours vidéo',
      description:
        course.shortDescription ||
        'Des techniques essentielles expliquées pas à pas pour progresser chez vous à votre rythme.',
      image: course.image || '/images/masterclass-video.jpg',
      href: normalizeWorkshopUrl(course.courseUrl || SHOP_VIDEO_URL),
      duration: course.duration || '2h',
    })),
);

const sidebarAdSlot = `sidebar-${variant}-${mobileVisible ? 'mobile' : 'desktop'}`;
const normalizedPopularArticles = repairDeepStrings(popularArticles);
const normalizedSidebarProfileBullets = repairDeepStrings(sidebarProfileBullets);
const sidebarProfileEyebrow = 'Cuisine réelle, recettes testées depuis 2010';

const sidebarProfileParagraphs = [
  'Depuis 2010, je publie sur mon site une cuisine à la fois rigoureuse et accessible, inspirée des pâtisseries et des saveurs du monde entier, mêlant grands classiques et recettes plus confidentielles, enrichie par les voyages, les traditions, les découvertes et le plaisir de partager. Plus de 1300 recettes mises au point, testées et validées dans ma cuisine, avec passion et gourmandise.',
  'Chaque recette est travaillée, testée plusieurs fois si nécessaire, photographiée en pas à pas et rédigée par mes soins, pour que vous puissiez la refaire chez vous et vous régaler avec ceux que vous aimez !',
];
const workshopFallbackTitle = 'Atelier à venir';
const workshopFallbackImage = '/images/ateliers-physiques.jpg';
const workshopFallbackDescription =
  'Je vous accueille dans des ateliers de cuisine et de pâtisserie dans une ambiance conviviale, avec une approche précise, généreuse et accessible.';
const workshopUnavailableDescription =
  'Les prochains ateliers ne sont pas disponibles pour le moment. Vous pouvez consulter la page atelier pour voir les mises à jour dès leur publication.';
const workshopCtaLabel = 'Voir les ateliers';
const sidebarVideoHeading = 'Mes cours vidéo';
const sidebarVideoBadgeUnlimited = 'Accès illimité';
const sidebarVideoBadgePremium = 'Réservé premium';
const sidebarVideoMetaLabel = 'Vidéo 4K';
const sidebarVideoCtaLabel = 'Voir les ateliers';
const sidebarClubItems = ['Échanges passionnés', 'Recettes avancées', 'Conseils exclusifs'];
---

<aside class={`recipe-sidebar ${responsiveClass} flex-col w-full min-h-full recipe-sidebar--${variant} ${className}`}>
  {isFull && (
    <div class="sidebar-block px-5 py-7 text-center">
      <img
        src="/images/image.png"
        alt="Bernard Laurance"
        class="w-[168px] h-[168px] rounded-full object-cover object-top mx-auto"
        loading="lazy"
        decoding="async"
        width="168"
        height="168"
      />
      <h3 class="recipe-sidebar-profile-title mt-6 font-heading text-primary-black">Bernard Laurance</h3>
      <p class="recipe-sidebar-profile-eyebrow mt-3 text-[13px] uppercase tracking-[0.15em] text-text-secondary">
        {sidebarProfileEyebrow}
      </p>
      <div class="recipe-sidebar-profile-copy mt-5 space-y-4 text-text-secondary">
        {sidebarProfileParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <ul class="mt-6 space-y-4 text-left recipe-sidebar-bullets">
        {normalizedSidebarProfileBullets.map((item) => (
          <li class="recipe-sidebar-bullet-item">
            <span class="recipe-sidebar-bullet-dot" aria-hidden="true"></span>
            <div>
              <h3 class="recipe-sidebar-bullet-title text-primary-black">{item.title}</h3>
              <p class="mt-2 recipe-sidebar-bullet-body text-text-secondary">{item.body}</p>
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-8">
        <div class="flex items-center justify-center gap-5 text-[#121C28]">
          <span class="w-[43px] h-[43px] rounded-full bg-[#F0EFE8] flex items-center justify-center"><i class="fab fa-facebook-f text-[20px]"></i></span>
          <span class="w-[43px] h-[43px] rounded-full bg-[#F0EFE8] flex items-center justify-center"><i class="fab fa-instagram text-[20px]"></i></span>
        </div>
        <div class="mt-3 flex items-center justify-center gap-7 text-[#1A2335] text-[13px]">
          <span>145.7k</span>
          <span>66,3 k</span>
        </div>
      </div>

    </div>
  )}

  {isFull && (
    <div class="sidebar-block px-6 py-8">
      <h4 class="sidebar-title">Ateliers de cuisine</h4>
      <div class="rounded-[10px] border border-[#D8D2C2] bg-[#F7F5EF] mt-5 workshop-box" data-sidebar-workshop data-workshops-api={workshopsApiUrl} data-workshops-fallback-url={SIDEBAR_WORKSHOP_URL}>
        <div class="workshop-media overflow-hidden">
          <img
            src={workshopFallbackImage}
            alt={workshopFallbackTitle}
            class="w-full aspect-[16/10] object-cover block"
            loading="lazy"
            decoding="async"
            width="640"
            height="640"
            data-sidebar-workshop-image
            onerror="if(!this.dataset.fallbackApplied){this.dataset.fallbackApplied='true';this.src='/images/ateliers-physiques.jpg';}"
          />
        </div>
        <div class="workshop-content p-6 pt-5">
        <p class="sidebar-subtitle font-mono text-[13px] uppercase tracking-[0.14em] text-[#5F6671]" data-sidebar-workshop-status>Chargement...</p>
        <div class="mt-3 grid grid-cols-[minmax(0,1fr)_74px] items-start gap-4">
          <h5 class="font-heading text-[28px] leading-[1.02] text-[#111111]" data-sidebar-workshop-title>{workshopFallbackTitle}</h5>
          <div class="date-box bg-[#F7F5EF] rounded-[14px] p-2 text-center min-w-[74px] border border-[#D8D2C2]">
            <span class="block text-[13px] uppercase text-[#8B8880] font-mono month-title" data-sidebar-workshop-month>--</span>
            <span class="block text-[34px] leading-none text-[#111111] font-heading date-title" data-sidebar-workshop-day>--</span>
          </div>
        </div>

        <div class="flex items-center justify-between gap-3 text-[#2D3440] text-[13px] mt-4 uppercase tracking-[0.08em] border-b border-[#D8D2C2] pb-4">
          <span class="flex items-center gap-1"><Icon name="users" size="sm" /> <span data-sidebar-workshop-capacity>--</span></span>
          <span class="flex items-center gap-1"><Icon name="clock" size="sm" /> <span data-sidebar-workshop-duration>--</span></span>
        </div>

        <p
          class="text-[16px] text-[#5F6671] mt-5 leading-[1.65] description-data"
          style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;"
          data-sidebar-workshop-description
        >{workshopFallbackDescription}</p>

        <div class="sidebar-workshop-footer flex items-end justify-between gap-4 mt-8 pt-5 border-t border-[#D8D2C2]">
          <div>
            {/* <span class="text-[13px] uppercase tracking-[0.14em] text-[#5F6671]">A partir de</span> */}
            <div class="font-heading text-[44px] leading-none text-[#111111]" data-sidebar-workshop-price>--</div>
          </div>
          <Button href={SIDEBAR_WORKSHOP_URL} class="button-data sidebar-workshop-cta-button" variant="primary" size="sm" data-sidebar-workshop-cta>{workshopCtaLabel}</Button>
        </div>
        </div>
      </div>

      <a href={SIDEBAR_WORKSHOP_URL} class="label-data inline-flex items-center gap-2 text-primary-turquoise text-[13px] uppercase tracking-[0.08em] mt-5 underline underline-offset-2 typ-button">{workshopCtaLabel}</a>
    </div>
  )}

  {isFull && (
    <div class="sidebar-block px-6 py-8">
      <h4 class="sidebar-title">{sidebarVideoHeading}</h4>
      <div class="mt-5 space-y-4">
        {sidebarVideoCards.map((course) => (
          <div class="rounded-[10px] border border-[#D8D2C2] bg-[#F7F5EF] overflow-hidden pannel-data">
            <div class="relative">
              <img
                src={course.image}
                alt={course.title}
                class="w-full aspect-[16/10] object-cover"
                loading="lazy"
                decoding="async"
                width="640"
                height="368"
                onerror="if(!this.dataset.fallbackApplied){this.dataset.fallbackApplied='true';this.src='/images/masterclass-video.jpg';}"
              />
              <div class="absolute top-3 right-3 w-[44px] h-[44px] rounded-full bg-[#FAF8F2]/95 flex items-center justify-center text-[#1A2335]">
                <Icon name="video" size="sm" class="w-[14px] h-[14px]" />
              </div>
            </div>

            <div class="p-4">
              <div class="masterclass-badges mb-3">
                <span class="masterclass-badge masterclass-badge--light inline-flex items-center gap-2 rounded-full bg-[#ECEBE4] px-3 py-1 text-[13px] uppercase tracking-[0.08em] text-[#1E2B3A] acces-data">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1.50646 15.641C1.08549 15.641 0.729167 15.4952 0.4375 15.2035C0.145833 14.9119 0 14.5556 0 14.1346V6.31417C0 5.8932 0.145833 5.53688 0.4375 5.24521C0.729167 4.95354 1.08549 4.80771 1.50646 4.80771H14.3269C14.7478 4.80771 15.1042 4.95354 15.3958 5.24521C15.6875 5.53688 15.8333 5.8932 15.8333 6.31417V14.1346C15.8333 14.5556 15.6875 14.9119 15.3958 15.2035C15.1042 15.4952 14.7478 15.641 14.3269 15.641H1.50646ZM1.50646 14.391H14.3269C14.391 14.391 14.4498 14.3643 14.5031 14.3108C14.5566 14.2575 14.5833 14.1988 14.5833 14.1346V6.31417C14.5833 6.25 14.5566 6.19125 14.5031 6.13792C14.4498 6.08444 14.391 6.05771 14.3269 6.05771H1.50646C1.44229 6.05771 1.38354 6.08444 1.33021 6.13792C1.27674 6.19125 1.25 6.25 1.25 6.31417V14.1346C1.25 14.1988 1.27674 14.2575 1.33021 14.3108C1.38354 14.3643 1.44229 14.391 1.50646 14.391ZM6.45833 13.1731L10.8815 10.2244L6.45833 7.27563V13.1731ZM1.45833 3.65396V2.40396H14.375V3.65396H1.45833ZM3.95833 1.25V0H11.875V1.25H3.95833Z" fill="#091D23"/>
                  </svg>

                  {sidebarVideoBadgeUnlimited}
                </span>
                <span class="masterclass-badge masterclass-badge--gold inline-flex items-center gap-2 rounded-full bg-[#BBA86B] px-3 py-1 text-[13px] uppercase tracking-[0.08em] text-white reserve-data">
                  <svg width="17" height="15" viewBox="0 0 17 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8.085 14.4631L0 4.75958L2.37979 0H13.7902L16.17 4.75958L8.085 14.4631ZM5.76917 4.16667H10.4008L8.94229 1.25H7.22771L5.76917 4.16667ZM7.46 11.7644V5.41667H2.18583L7.46 11.7644ZM8.71 11.7644L13.9842 5.41667H8.71V11.7644ZM11.7902 4.16667H14.4633L13.0048 1.25H10.3317L11.7902 4.16667ZM1.70667 4.16667H4.37979L5.83833 1.25H3.16521L1.70667 4.16667Z" fill="#FAF8F2"/>
                  </svg>
                  {sidebarVideoBadgePremium}
                </span>
              </div>

              <h5 class="font-heading text-[28px] leading-[1.02] text-[#111111] mt-1">{course.title}</h5>

              <div class="flex items-center gap-4 text-[#2F3642] text-[13px] mt-4 uppercase tracking-[0.08em] border-b border-[#D8D2C2] pb-4">
                <span class="flex items-center gap-1"><Icon name="clock" size="sm" /> {course.duration}</span>
                <span class="flex items-center gap-1"><Icon name="video" size="sm" /> {sidebarVideoMetaLabel}</span>
              </div>

              <p class="description-data text-[16px] text-[#5F6671] mt-5 leading-[1.65]" style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">{course.description}</p>
              <Button href={course.href} variant="primary" size="sm" class="button-data-full w-full mt-5">{sidebarVideoCtaLabel}</Button>
            </div>

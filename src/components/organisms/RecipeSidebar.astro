---
import Icon from '../atoms/Icon.astro';
import Button from '../atoms/Button.astro';
import { getPopularSidebarArticles } from '../../lib/articleDiscovery';
import { loadVideoCourses } from '../../lib/videoCourses';

interface Props {
  variant?: 'full' | 'popular';
  className?: string;
  stickyPopularRail?: boolean;
  mobileVisible?: boolean;
}

const { variant = 'full', className = '', stickyPopularRail = false, mobileVisible = false } = Astro.props as Props;
const isFull = variant === 'full';
const responsiveClass = mobileVisible ? 'flex lg:hidden' : 'hidden lg:flex';
const SIDEBAR_WORKSHOP_URL = 'https://atelier-lacuisinedebernard.com/latelier/';
const workshopsApiUrl =
  process.env.WORKSHOPS_CACHE_URL ||
  'https://lacuisinedebernard.com/api/workshops-cache';
const fallbackPopularArticles = [
  {
    title: 'Salade de nouilles de tofu aux 5 parfums',
    label: 'Salé',
    image: '/images/workshop-soup.jpg',
    slug: '/salade-nouilles-tofu',
  },
  {
    title: 'Concombres marinés',
    label: 'Accompagnement',
    image: '/images/workshop-dumplings.jpg',
    slug: '/concombres-marines',
  },
  {
    title: 'Lohikeitto',
    label: 'Soupes',
    image: '/images/masterclass-video.jpg',
    slug: '/lohikeitto',
  },
];
const computedPopularArticles = await getPopularSidebarArticles(5, 'fr');
const popularArticles = computedPopularArticles.length ? computedPopularArticles : fallbackPopularArticles;
const videoCourses = await loadVideoCourses();
const featuredVideoCourse = videoCourses[0] || null;
const sidebarProfileBullets = [
  {
    title: 'Recettes 100% humaines, testées dans mon atelier',
    body: 'Chaque recette est réellement préparée, goûtée et ajustée avant d’être publiée.',
  },
  {
    title: 'Contenu 100 % original',
    body: 'Photos, explications, astuces, techniques : tout est pensé pour une vraie transmission.',
  },
  {
    title: 'Photos 100% réelles',
    body: 'Tout ce que vous voyez ici est vrai et dévoré avec voracité !',
  },
  {
    title: 'Pas à pas clairs et détaillés',
    body: 'Des recettes précises, pour comprendre ce que l’on fait et réussir vraiment.',
  },
];
const sidebarBooks = [
  { src: '/images/book-mes-desserts.jpg', alt: 'Mes desserts de Bernard' },
  { src: '/images/book-mon-grain-de-sel.jpg', alt: 'Mon grain de sel' },
  { src: '/images/book-bouchee.jpg', alt: "Je n'en ferai qu'une bouchee" },
  { src: '/images/book-asie-sucree.jpg', alt: 'Asie Sucree' },
  { src: '/images/book-je-fais-mon-chocolat-maison.png', alt: 'Je fais mon chocolat maison' },
  { src: '/images/book-lacuisinedebernard.jpg', alt: 'La Cuisine de Bernard' },
  { src: '/images/book-scandaleusement-decadent.jpg', alt: 'Scandaleusement Decadent' },
];
const SHOP_CLUB_URL = 'https://atelier-lacuisinedebernard.com/club/';
const SHOP_VIDEO_URL = '/cours-video';
const sidebarVideoTitle = featuredVideoCourse?.title || 'Mes cours vidéo';
const sidebarVideoDescription =
  featuredVideoCourse?.shortDescription ||
  'Des techniques essentielles expliquees pas a pas pour progresser chez vous a votre rythme.';
const sidebarVideoImage = featuredVideoCourse?.image || '/images/masterclass-video.jpg';
const sidebarVideoHref = featuredVideoCourse?.courseUrl || SHOP_VIDEO_URL;
const sidebarVideoDisplayTitle = featuredVideoCourse?.title || 'Mes cours vid\u00E9o';
const sidebarVideoDisplayDescription =
  featuredVideoCourse?.shortDescription ||
  'Des techniques essentielles expliqu\u00E9es pas \u00E0 pas pour progresser chez vous \u00E0 votre rythme.';
---

<aside class={`recipe-sidebar ${responsiveClass} flex-col w-full min-h-full recipe-sidebar--${variant} ${className}`}>
  {isFull && (
    <div class="sidebar-block px-5 py-7 text-center">
      <img
        src="/images/image.png"
        alt="Bernard Laurance"
        class="w-[130px] h-[130px] rounded-full object-cover object-top mx-auto"
        loading="lazy"
        decoding="async"
        width="130"
        height="130"
      />
      <h3 class="mt-6 font-heading text-primary-black">Bernard Laurance</h3>
      <p class="mt-3 font-mono text-[13px] uppercase tracking-[0.15em] text-text-secondary">
        Cuisine réelle, recettes testées depuis 2010
      </p>
      <div class="recipe-sidebar-profile-copy mt-5 space-y-4 text-[15px] leading-[1.72] text-text-secondary typ-body">
        <p>
          Depuis 2010, je publie sur mon site une cuisine à la fois rigoureuse et accessible, inspirée des pâtisseries et des saveurs du monde entier, mêlant grands classiques et recettes plus confidentielles, enrichie par les voyages, les traditions, les découvertes et le plaisir de partager. Plus de 1300 recettes mises au point, testées et validées dans ma cuisine, avec passion et gourmandise.
        </p>
        <p>
          Chaque recette est travaillée, testée plusieurs fois si nécessaire, photographiée en pas à pas et rédigée par mes soins, pour que vous puissiez la refaire chez vous et vous régaler avec ceux que vous aimez !
        </p>
      </div>

      <ul class="mt-6 space-y-4 text-left recipe-sidebar-bullets">
        {sidebarProfileBullets.map((item) => (
          <li class="recipe-sidebar-bullet-item">
            <span class="recipe-sidebar-bullet-dot" aria-hidden="true"></span>
            <div>
              <h3 class="recipe-sidebar-bullet-title font-heading text-primary-black">{item.title}</h3>
              <p class="mt-2 recipe-sidebar-bullet-body text-text-secondary">{item.body}</p>
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-8">
        <div class="flex items-center justify-center gap-5 text-[#121C28]">
          <span class="w-[43px] h-[43px] rounded-full bg-[#F0EFE8] flex items-center justify-center"><i class="fab fa-facebook-f text-[20px]"></i></span>
          <span class="w-[43px] h-[43px] rounded-full bg-[#F0EFE8] flex items-center justify-center"><i class="fab fa-instagram text-[20px]"></i></span>
        </div>
        <div class="mt-3 flex items-center justify-center gap-7 text-[#1A2335] text-[13px]">
          <span>145 .7k</span>
          <span>62k</span>
        </div>
      </div>

    </div>
  )}

  {isFull && (
    <div class="sidebar-block px-6 py-8">
      <h4 class="sidebar-title">Ateliers de cuisine</h4>
      <div class="rounded-[10px] border border-[#D8D2C2] bg-[#F7F5EF] p-6 mt-5 workshop-box " data-sidebar-workshop data-workshops-api={workshopsApiUrl}>
        <p class="sidebar-subtitle font-mono text-[13px] uppercase tracking-[0.14em] text-[#5F6671]" data-sidebar-workshop-status>Chargement...</p>
        <div class="mt-3 grid grid-cols-[minmax(0,1fr)_74px] items-start gap-4">
          <h5 class="font-heading text-[28px] leading-[1.02] text-[#111111]" data-sidebar-workshop-title>Atelier à venir</h5>
          <div class="date-box bg-[#F7F5EF] rounded-[14px] p-2 text-center min-w-[74px] border border-[#D8D2C2]">
            <span class="block text-[13px] uppercase text-[#8B8880] font-mono month-title" data-sidebar-workshop-month>--</span>
            <span class="block text-[34px] leading-none text-[#111111] font-heading date-title" data-sidebar-workshop-day>--</span>
          </div>
        </div>

        <div class="flex items-center justify-between gap-3 text-[#2D3440] text-[13px] mt-4 uppercase tracking-[0.08em] border-b border-[#D8D2C2] pb-4">
          <span class="flex items-center gap-1"><Icon name="users" size="sm" /> <span data-sidebar-workshop-capacity>--</span></span>
          <span class="flex items-center gap-1"><Icon name="clock" size="sm" /> <span data-sidebar-workshop-duration>--</span></span>
        </div>

        <p
          class="text-[16px] text-[#5F6671] mt-5 leading-[1.65] description-data"
          style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;"
          data-sidebar-workshop-description

---
import Icon from '../atoms/Icon.astro';
import Button from '../atoms/Button.astro';
import { getPopularSidebarArticles } from '../../lib/articleDiscovery';

interface Props {
  variant?: 'full' | 'popular';
  className?: string;
  stickyPopularRail?: boolean;
}

const { variant = 'full', className = '', stickyPopularRail = false } = Astro.props as Props;
const isFull = variant === 'full';
const workshopsApiUrl =
  process.env.WORKSHOPS_CACHE_URL ||
  'https://lacuisinedebernard.com/api/workshops-cache';
const fallbackPopularArticles = [
  {
    title: 'Salade de nouilles de tofu aux 5 parfums',
    date: 'Rédigé récemment',
    image: '/images/workshop-soup.jpg',
    slug: '/salade-nouilles-tofu',
  },
  {
    title: 'Concombres marinés',
    date: 'Rédigé récemment',
    image: '/images/workshop-dumplings.jpg',
    slug: '/concombres-marines',
  },
  {
    title: 'Lohikeitto',
    date: 'Rédigé récemment',
    image: '/images/masterclass-video.jpg',
    slug: '/lohikeitto',
  },
];
const computedPopularArticles = await getPopularSidebarArticles(5, 'fr');
const popularArticles = computedPopularArticles.length ? computedPopularArticles : fallbackPopularArticles;
const sidebarBooks = [
  { src: '/images/book-mes-desserts.jpg', alt: 'Mes desserts de Bernard' },
  { src: '/images/book-mon-grain-de-sel.jpg', alt: 'Mon grain de sel' },
  { src: '/images/book-bouchee.jpg', alt: "Je n'en ferai qu'une bouchee" },
  { src: '/images/book-asie-sucree.jpg', alt: 'Asie Sucree' },
  { src: '/images/book-je-fais-mon-chocolat-maison.png', alt: 'Je fais mon chocolat maison' },
  { src: '/images/book-lacuisinedebernard.jpg', alt: 'La Cuisine de Bernard' },
  { src: '/images/book-scandaleusement-decadent.jpg', alt: 'Scandaleusement Decadent' },
];
---

<aside class={`recipe-sidebar hidden lg:flex flex-col w-full min-h-full recipe-sidebar--${variant} ${className}`}>
  {isFull && (
    <div class="sidebar-block px-5 py-7 text-center">
      <img
        src="/images/image.png"
        alt="Bernard Laurance"
        class="w-[130px] h-[130px] rounded-full object-cover object-top mx-auto"
        loading="lazy"
        decoding="async"
      />
      <h3 class="font-body text-[28px] leading-[1.05] text-[#1A2335] mt-6">Bernard Laurance</h3>
      <p class="font-mono text-[13px] uppercase tracking-[0.15em] text-[#3E4652] mt-3">
        Cuisine reelle, recettes testees depuis 2010
      </p>
      <p class="text-[16px] text-[#2F3B4A] leading-[1.65] mt-5">
        Voyageur et passionne de cuisine, je vous livre tous mes secrets de cuisine, sans detour.
        J'essaie de rendre hommage aux traditions, du canele de Bordeaux aux dim-sums de Hong Kong.
        Les recettes de Bernard, ce sont des dizaines de recettes de patisseries, d'entrees et de plats divers.
      </p>

      <div class="mt-8">
        <div class="flex items-center justify-center gap-5 text-[#121C28]">
          <span class="w-[43px] h-[43px] rounded-full bg-[#F0EFE8] flex items-center justify-center"><i class="fab fa-facebook-f text-[20px]"></i></span>
          <span class="w-[43px] h-[43px] rounded-full bg-[#F0EFE8] flex items-center justify-center"><i class="fab fa-instagram text-[20px]"></i></span>
        </div>
        <div class="mt-3 flex items-center justify-center gap-7 text-[#1A2335] text-[13px]">
          <span>145 .7k</span>
          <span>62k</span>
        </div>
      </div>

    </div>
  )}

  {isFull && (
    <div class="sidebar-block px-6 py-8">
      <h4 class="sidebar-title">Apprendre en atelier</h4>
      <div class="rounded-[10px] border border-[#D8D2C2] bg-[#F7F5EF] p-6 mt-5 workshop-box " data-sidebar-workshop data-workshops-api={workshopsApiUrl}>
        <p class="sidebar-subtitle font-mono text-[13px] uppercase tracking-[0.14em] text-[#5F6671]" data-sidebar-workshop-status>Chargement...</p>
        <div class="mt-3 grid grid-cols-[minmax(0,1fr)_74px] items-start gap-4">
          <h5 class="font-heading text-[28px] leading-[1.02] text-[#111111]" data-sidebar-workshop-title>Atelier a venir</h5>
          <div class="date-box bg-[#F7F5EF] rounded-[14px] p-2 text-center min-w-[74px] border border-[#D8D2C2]">
            <span class="block text-[13px] uppercase text-[#8B8880] font-mono month-title" data-sidebar-workshop-month>--</span>
            <span class="block text-[34px] leading-none text-[#111111] font-heading date-title" data-sidebar-workshop-day>--</span>
          </div>
        </div>

        <div class="flex items-center justify-between gap-3 text-[#2D3440] text-[13px] mt-4 uppercase tracking-[0.08em] border-b border-[#D8D2C2] pb-4">
          <span class="flex items-center gap-1"><Icon name="users" size="sm" /> <span data-sidebar-workshop-capacity>--</span></span>
          <span class="flex items-center gap-1"><Icon name="clock" size="sm" /> <span data-sidebar-workshop-duration>--</span></span>
        </div>

        <p class="text-[16px] text-[#5F6671] mt-5 leading-[1.65] description-data">Apprenez directement a mes cotes dans un atelier intimiste.</p>

        <div class="flex items-end justify-between mt-8 pt-5 border-t border-[#D8D2C2]">
          <div>
            {/* <span class="text-[13px] uppercase tracking-[0.14em] text-[#5F6671]">A partir de</span> */}
            <div class="font-heading text-[44px] leading-none text-[#111111]" data-sidebar-workshop-price>--</div>
          </div>
          <Button href="/ateliers" class="button-data" variant="primary" size="sm" data-sidebar-workshop-cta>Reserver</Button>
        </div>
      </div>

      <a href="/ateliers" class="label-data inline-flex items-center gap-2 text-primary-turquoise text-[13px] uppercase tracking-[0.08em] mt-5 underline underline-offset-2 typ-button">
        Voir le calendrier complet
      </a>
    </div>
  )}

  {isFull && (
    <div class="sidebar-block px-6 py-8">
      <h4 class="sidebar-title">Masterclass videos</h4>
      <div class="rounded-[10px] border border-[#D8D2C2] bg-[#F7F5EF] overflow-hidden mt-5 pannel-data">
        <div class="relative">
          <img
            src="/images/masterclass-video.jpg"
            alt="Masterclass"
            class="w-full h-[184px] object-cover"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute top-4 right-4 w-[68px] h-[68px] rounded-full bg-white/95 flex items-center justify-center text-[#1A2335]">
            <Icon name="video" size="sm" />
          </div>
        </div>

        <div class="p-4">
          <div class="masterclass-badges mb-3">
            <span class="masterclass-badge masterclass-badge--light inline-flex items-center gap-2 rounded-full bg-[#ECEBE4] px-3 py-1 text-[13px] uppercase tracking-[0.08em] text-[#1E2B3A] acces-data">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1.50646 15.641C1.08549 15.641 0.729167 15.4952 0.4375 15.2035C0.145833 14.9119 0 14.5556 0 14.1346V6.31417C0 5.8932 0.145833 5.53688 0.4375 5.24521C0.729167 4.95354 1.08549 4.80771 1.50646 4.80771H14.3269C14.7478 4.80771 15.1042 4.95354 15.3958 5.24521C15.6875 5.53688 15.8333 5.8932 15.8333 6.31417V14.1346C15.8333 14.5556 15.6875 14.9119 15.3958 15.2035C15.1042 15.4952 14.7478 15.641 14.3269 15.641H1.50646ZM1.50646 14.391H14.3269C14.391 14.391 14.4498 14.3643 14.5031 14.3108C14.5566 14.2575 14.5833 14.1988 14.5833 14.1346V6.31417C14.5833 6.25 14.5566 6.19125 14.5031 6.13792C14.4498 6.08444 14.391 6.05771 14.3269 6.05771H1.50646C1.44229 6.05771 1.38354 6.08444 1.33021 6.13792C1.27674 6.19125 1.25 6.25 1.25 6.31417V14.1346C1.25 14.1988 1.27674 14.2575 1.33021 14.3108C1.38354 14.3643 1.44229 14.391 1.50646 14.391ZM6.45833 13.1731L10.8815 10.2244L6.45833 7.27563V13.1731ZM1.45833 3.65396V2.40396H14.375V3.65396H1.45833ZM3.95833 1.25V0H11.875V1.25H3.95833Z" fill="#091D23"/>
              </svg>

              Acces illimite
            </span>
            <span class="masterclass-badge masterclass-badge--gold inline-flex items-center gap-2 rounded-full bg-[#BBA86B] px-3 py-1 text-[13px] uppercase tracking-[0.08em] text-white reserve-data">
              <svg width="17" height="15" viewBox="0 0 17 15" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8.085 14.4631L0 4.75958L2.37979 0H13.7902L16.17 4.75958L8.085 14.4631ZM5.76917 4.16667H10.4008L8.94229 1.25H7.22771L5.76917 4.16667ZM7.46 11.7644V5.41667H2.18583L7.46 11.7644ZM8.71 11.7644L13.9842 5.41667H8.71V11.7644ZM11.7902 4.16667H14.4633L13.0048 1.25H10.3317L11.7902 4.16667ZM1.70667 4.16667H4.37979L5.83833 1.25H3.16521L1.70667 4.16667Z" fill="white"/>
              </svg>
              Reserve Premium
            </span>
          </div>

          <h5 class="font-heading text-[28px] leading-[1.02] text-[#111111] mt-1">Gateau indien aux carottes !</h5>

          <div class="flex items-center gap-4 text-[#2F3642] text-[13px] mt-4 uppercase tracking-[0.08em] border-b border-[#D8D2C2] pb-4">
            <span class="flex items-center gap-1"><Icon name="clock" size="sm" /> 2h</span>
            <span class="flex items-center gap-1"><Icon name="video" size="sm" /> Video 4K</span>
          </div>

          <p class="description-data text-[16px] text-[#5F6671] mt-5 leading-[1.65]">Technique professionnelle pas a pas.</p>
          <Button href="/masterclass" variant="primary" size="sm" class="button-data-full w-full mt-5">Voir la video</Button>
        </div>
      </div>

      <a href="/masterclass" class="label-data inline-flex items-center gap-2 text-primary-turquoise text-[13px] uppercase tracking-[0.08em] mt-5 underline underline-offset-2 typ-button">
        Voir toutes les videos masterclass
      </a>
    </div>
  )}

  {isFull && (
    <div class="sidebar-block px-6 py-8">
      <h4 class="sidebar-title">Rejoignez mon club</h4>
      <ul class="mt-4 space-y-4 text-[16px] text-[#2A3543]">
        <li class="flex items-center gap-2"><Icon name="book" size="sm" /> Echanges passionnes</li>
        <li class="flex items-center gap-2"><Icon name="refresh" size="sm" /> Recettes avancees</li>
        <li class="flex items-center gap-2"><Icon name="video" size="sm" /> Conseils exclusifs</li>
      </ul>
      <a href="/club" class="inline-flex items-center gap-2 text-primary-turquoise text-[13px] uppercase tracking-[0.08em] mt-6 underline underline-offset-2 typ-button label-data">
        Rejoindre le club
      </a>
    </div>
  )}

  {isFull && (
    <div class="sidebar-block px-6 py-8">
      <h4 class="sidebar-title">Mes livres pour approfondir</h4>
      <div class="grid grid-cols-3 gap-3 mt-4 sidebar-books-grid">
        {sidebarBooks.map((book, index) => (
          <img
            src={book.src}
            alt={book.alt}
            class:list={[
              'w-full rounded-[2px] object-contain bg-[#F7F5EF] p-1',
              index === sidebarBooks.length - 1 && sidebarBooks.length % 3 === 1
                ? 'col-span-3 h-[176px]'
                : 'h-[154px]',
            ]}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
      <a href="/livres" class="label-data inline-flex items-center gap-2 text-primary-turquoise text-[13px] uppercase tracking-[0.08em] mt-5 underline underline-offset-2 typ-button">
        Voir tous les livres
      </a>
    </div>
  )}

  <div class:list={['recipe-sidebar-sticky-rail', stickyPopularRail && 'recipe-sidebar-sticky-rail--enabled']}>
    <div class="sidebar-block px-6 py-8">
      <h4 class="sidebar-title">Articles populaires</h4>
      <div class="space-y-4 mt-5">
        {popularArticles.map((article) => (
          <a href={article.slug} class="flex gap-3 items-start border-b border-[#D8D2C2] pb-4 last:border-b-0 last:pb-0">
            <img
              src={article.image}
              alt=""
              class="w-[92px] h-[72px] shrink-0 object-cover rounded-[6px]"
              loading="lazy"
              decoding="async"
            />
            <div class="min-w-0 flex-1">
              <p class="text-[11px] uppercase tracking-[0.12em] text-[#2D3643] font-mono article-date">{article.date}</p>
              <p class="text-[17px] leading-[1.18] text-[#111111] mt-2 font-heading article-title break-words">{article.title}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="sidebar-block px-4 pt-4 pb-5">
      <div class="bg-[#DCDCCF] rounded-[8px] border border-[#D8D2C2] h-[220px] flex items-center justify-center text-[#363A40] text-[13px] uppercase tracking-[0.12em]">
        Espace publicite
      </div>
    </div>
  </div>
</aside>

<script>
  // @ts-nocheck
  function setupSidebarWorkshopData() {
    const blocks = Array.from(document.querySelectorAll('[data-sidebar-workshop]'));
    if (!blocks.length) return;

    const parser = new DOMParser();
    const dateFormatter = new Intl.DateTimeFormat('fr-FR', {
      day: 'numeric',
      month: 'short',
    });

    const decodeEntities = (value = '') =>
      parser.parseFromString(`<!doctype html><body>${String(value || '')}`, 'text/html').body.textContent || '';

    const toPositiveNumber = (value, fallback = 0) => {
      const numeric = Number(value);
      return Number.isFinite(numeric) && numeric >= 0 ? numeric : fallback;
    };

    const formatDuration = (value) => {
      const minutes = toPositiveNumber(value, 0);
      if (!minutes) return '--';
      const hours = Math.floor(minutes / 60);
      const restMinutes = minutes % 60;
      if (hours && restMinutes) return `${hours}h ${restMinutes}m`;
      if (hours) return `${hours}h`;
      return `${restMinutes}m`;
    };

    const normalizeStatus = (value) => {
      const raw = String(value || '').toUpperCase().trim();
      if (raw === 'SOLD_OUT') return 'SOLD_OUT';
      if (raw === 'LIMITED') return 'LIMITED';
      return 'OPEN';
    };

    const normalizeHref = (value = '') => {
      const raw = String(value || '').trim();
      if (!raw) return '/ateliers';
      if (/^https?:\/\//i.test(raw)) return raw;
      return raw.startsWith('/') ? raw : `/${raw.replace(/^\/+/, '')}`;
    };

    const mapWorkshopItem = (item) => {
      if (!item || typeof item !== 'object') return null;
      const parsedDate = new Date(item.startAt || item.date || '');
      if (Number.isNaN(parsedDate.getTime())) return null;

      const title = decodeEntities(item.title || '').replace(/\s+/g, ' ').trim();
      if (!title) return null;

      const maxParticipants = toPositiveNumber(item.capacity || item.maxParticipants, 0);
      const rawSpotsLeft = toPositiveNumber(item.spotsLeft, Number.NaN);
      const spotsLeft = Number.isFinite(rawSpotsLeft)
        ? rawSpotsLeft
        : maxParticipants > 0
        ? Math.max(maxParticipants - toPositiveNumber(item.currentParticipants, 0), 0)
        : 0;
      const currentParticipants = maxParticipants > 0 ? Math.max(maxParticipants - spotsLeft, 0) : 0;

      return {
        title,
        date: parsedDate,
        price: toPositiveNumber(item.price, 0),
        duration: formatDuration(item.durationMin || item.duration || 0),
        maxParticipants,
        currentParticipants,
        spotsLeft,
        status: normalizeStatus(item.status),
        slug: normalizeHref(item.bookingUrl || item.slug || '/ateliers'),
      };
    };

    const hydrateBlock = (block) => {
      if (!(block instanceof HTMLElement)) return;
      if (block.dataset.workshopLoaded === 'loading' || block.dataset.workshopLoaded === 'true') return;

      const apiUrl = String(block.dataset.workshopsApi || '').trim();
      if (!apiUrl) return;

      block.dataset.workshopLoaded = 'loading';
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 5000);

      fetch(apiUrl, {
        method: 'GET',
        headers: { Accept: 'application/json' },
        cache: 'no-store',
        signal: controller.signal,
      })
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json();
        })
        .then((payload) => {
          const items = Array.isArray(payload?.items) ? payload.items : Array.isArray(payload) ? payload : [];
          const workshops = items
            .map((item) => mapWorkshopItem(item))
            .filter(Boolean)
            .sort((a, b) => a.date.getTime() - b.date.getTime());

          const firstWorkshop = workshops[0];
          if (!firstWorkshop) {
            block.dataset.workshopLoaded = 'empty';
            return;
          }

          const monthEl = block.querySelector('[data-sidebar-workshop-month]');
          const dayEl = block.querySelector('[data-sidebar-workshop-day]');
          const titleEl = block.querySelector('[data-sidebar-workshop-title]');
          const statusEl = block.querySelector('[data-sidebar-workshop-status]');
          const capacityEl = block.querySelector('[data-sidebar-workshop-capacity]');
          const durationEl = block.querySelector('[data-sidebar-workshop-duration]');
          const priceEl = block.querySelector('[data-sidebar-workshop-price]');
          const ctaEl = block.querySelector('[data-sidebar-workshop-cta]');

          if (titleEl instanceof HTMLElement) {
            titleEl.textContent = firstWorkshop.title;
          }

          const dateParts = dateFormatter.formatToParts(firstWorkshop.date);
          const month = dateParts.find((part) => part.type === 'month')?.value || '--';
          const day = dateParts.find((part) => part.type === 'day')?.value || '--';

          if (monthEl instanceof HTMLElement) monthEl.textContent = month;
          if (dayEl instanceof HTMLElement) dayEl.textContent = day;

          if (statusEl instanceof HTMLElement) {
            const directSpotsLeft = toPositiveNumber(firstWorkshop.spotsLeft, Number.NaN);
            const spotsLeft = Number.isFinite(directSpotsLeft)
              ? directSpotsLeft
              : firstWorkshop.maxParticipants > 0
              ? Math.max(firstWorkshop.maxParticipants - firstWorkshop.currentParticipants, 0)
              : Number.NaN;
            const hasSpotsInfo = Number.isFinite(spotsLeft);
            const isSoldOut =
              firstWorkshop.status === 'SOLD_OUT' ||
              ((firstWorkshop.maxParticipants > 0 || hasSpotsInfo) && (spotsLeft || 0) <= 0);

            if (isSoldOut) {
              statusEl.textContent = 'Complet';
              statusEl.style.color = '#B24639';
            } else if (hasSpotsInfo) {
              const plural = spotsLeft === 1 ? '' : 's';
              statusEl.textContent = `${spotsLeft} place${plural} disponible${plural}`;
              statusEl.style.color = firstWorkshop.status === 'LIMITED' ? '#B24639' : '#2E7D5A';
            } else {
              statusEl.textContent = firstWorkshop.status === 'LIMITED' ? 'Dernieres places' : 'Places disponibles';
              statusEl.style.color = firstWorkshop.status === 'LIMITED' ? '#B24639' : '#2E7D5A';
            }
          }

          if (capacityEl instanceof HTMLElement) {
            const directSpotsLeft = toPositiveNumber(firstWorkshop.spotsLeft, Number.NaN);
            const spotsLeft = Number.isFinite(directSpotsLeft)
              ? directSpotsLeft
              : firstWorkshop.maxParticipants > 0
              ? Math.max(firstWorkshop.maxParticipants - firstWorkshop.currentParticipants, 0)
              : Number.NaN;

            if (Number.isFinite(spotsLeft)) {
              const plural = spotsLeft === 1 ? '' : 's';
              capacityEl.textContent = `${spotsLeft} place${plural} disponible${plural}`;
            } else {
              capacityEl.textContent = firstWorkshop.status === 'SOLD_OUT' ? 'Complet' : '--';
            }
          }

          if (durationEl instanceof HTMLElement) {
            durationEl.textContent = firstWorkshop.duration || '--';
          }

          if (priceEl instanceof HTMLElement) {
            priceEl.textContent = firstWorkshop.price > 0 ? `${Math.round(firstWorkshop.price)}€` : '--';
          }

          if (ctaEl instanceof HTMLAnchorElement) {
            ctaEl.href = firstWorkshop.slug || '/ateliers';
            if (/^https?:\/\//i.test(firstWorkshop.slug || '')) {
              ctaEl.target = '_blank';
              ctaEl.rel = 'noopener noreferrer';
            } else {
              ctaEl.removeAttribute('target');
              ctaEl.removeAttribute('rel');
            }
          }

          block.dataset.workshopLoaded = 'true';
        })
        .catch((error) => {
          console.warn('[SIDEBAR] Failed to load workshop data:', error);
          block.dataset.workshopLoaded = 'error';
        })
        .finally(() => {
          window.clearTimeout(timeout);
        });
    };

    blocks.forEach((block) => {
      if (!(block instanceof HTMLElement)) return;
      if (block.dataset.workshopObserverBound === 'true') return;
      block.dataset.workshopObserverBound = 'true';

      const start = () => hydrateBlock(block);

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          start();
        }, {
          rootMargin: '240px 0px',
          threshold: 0.01,
        });

        observer.observe(block);
        return;
      }

      if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(() => start(), { timeout: 1800 });
      } else {
        window.setTimeout(() => start(), 400);
      }
    });
  }

  setupSidebarWorkshopData();
  document.addEventListener('astro:page-load', setupSidebarWorkshopData);
</script>

<style>
  .recipe-sidebar {
    width: 100%;
  }

  .recipe-sidebar :global(.sidebar-block) {
    width: 100%;
    box-sizing: border-box;
    background: #faf8f2;
    overflow: hidden;
  }

  .recipe-sidebar--full {
    gap: 18px;
  }

  .recipe-sidebar--full > :global(.sidebar-block),
  .recipe-sidebar--full > .recipe-sidebar-sticky-rail > :global(.sidebar-block) {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .recipe-sidebar--full :global(.workshop-box),
  .recipe-sidebar--full :global(.pannel-data) {
    width: 100%;
    box-sizing: border-box;
  }

  .recipe-sidebar--full :global(.pannel-data > .p-4) {
    padding: 16px 16px 18px;
  }

  .recipe-sidebar--full :global(.masterclass-badges) {
    width: 100%;
  }

  .recipe-sidebar--full :global(.masterclass-badge) {
    min-width: 0;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 12px;
  }

  .recipe-sidebar--full :global(.button-data),
  .recipe-sidebar--full :global(.button-data-full) {
    width: 100%;
    justify-content: center;
  }

  .recipe-sidebar--full :global(.date-box) {
    min-width: 70px;
  }

  .recipe-sidebar-sticky-rail {
    display: grid;
    gap: 14px;
  }

  .recipe-sidebar :global(.sidebar-block:last-child) {
    margin-bottom: 0;
  }

  .recipe-sidebar :global(.label-data) {
    text-underline-offset: 4px;
  }



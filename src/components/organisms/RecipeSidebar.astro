        ))}
      </div>

      <a href={SHOP_VIDEO_URL} class="label-data inline-flex items-center gap-2 text-primary-turquoise text-[13px] uppercase tracking-[0.08em] mt-5 underline underline-offset-2 typ-button">
        Voir les ateliers

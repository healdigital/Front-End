---
import SocialShare from '../molecules/SocialShare.astro';

/**
 * Props for the `RecipeCard` organism.
 */
interface Props {
  /** Recipe title displayed in the card header. */
  title: string;
  /** Destination URL for the recipe details page. */
  slug: string;
  /** Hero image URL or asset reference. */
  image: string;
  /** Optional original image fallback if optimized variant fails. */
  imageFallback?: string;
  /** Short summary rendered in the description area. */
  description: string;
  /** Preparation time label (for example, `25 min`). */
  prepTime: string;
  /** Difficulty label shown as a status badge. */
  difficulty: string;
  /** Category badge label. */
  category?: string;
  /** Controls the visual state of the favorite icon. */
  isFavorite?: boolean;
}

const {
  title,
  slug,
  image,
  imageFallback = image,
  description,
  prepTime,
  difficulty,
  category = 'RECETTE',
  isFavorite = false,
} = Astro.props;

const MAX_LENGTH = 200;
const truncatedDescription = description.length > MAX_LENGTH
  ? description.slice(0, MAX_LENGTH).trim() + '...'
  : description;
---

<article class="group w-full rounded-[10px] bg-[#F7F5EF] overflow-hidden border border-[#D8D2C2] transition-all duration-300 hover:shadow-lg">
  <!-- Image Container -->
  <div class="relative w-full overflow-hidden aspect-[3/4]">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-contain object-center bg-[#f7f5ef] transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      fetchpriority="low"
      decoding="async"
      width="500"
      height="667"
      sizes="(min-width: 1280px) 28vw, (min-width: 1024px) 34vw, (min-width: 768px) 44vw, 92vw"
      data-fallback-src={imageFallback}
      onerror="if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc) this.src = this.dataset.fallbackSrc;"
    />

    <!-- Bookmark Button -->
    <button
      class="absolute top-4 right-4 w-[54px] h-[54px] rounded-full bg-white backdrop-blur-sm flex items-center justify-center text-text-primary hover:text-primary-turquoise transition-colors"
      aria-label={isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris'}
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z" />
      </svg>
    </button>
  </div>

  <!-- Content -->
  <div class="px-6 pb-7 pt-5 flex flex-col gap-4">
    <h3 class="font-heading text-[43px] leading-[1] text-text-primary">
      <a href={slug} class="hover:text-primary-turquoise transition-colors">
        {title}
      </a>
    </h3>

    <div class="flex items-center justify-between text-[13px] text-text-secondary uppercase tracking-[0.14em] typ-meta border-b border-[#D8D2C2] pb-4">
      <div class="flex items-center gap-2">
        <span data-recipe-meta-tag>{difficulty}</span>
        <span aria-hidden="true">&bull;</span>
        <span data-recipe-meta-time>{prepTime}</span>
      </div>
      <SocialShare url={`${Astro.url.origin}${slug}`} title={title} class="gap-3 text-[14px]" />
    </div>

    <p class="text-text-secondary font-body text-[16px] leading-[1.7] typ-body">
      {truncatedDescription}
    </p>

    <a
      href={slug}
      class="inline-flex items-center gap-2 text-primary-turquoise font-body text-[13px] uppercase tracking-[0.08em] hover:underline typ-button"
    >
      Lire la suite
    </a>
  </div>
</article>

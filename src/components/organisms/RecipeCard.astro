---
import SocialShare from '../molecules/SocialShare.astro';

/**
 * Props for the `RecipeCard` organism.
 */
interface Props {
  /** Recipe title displayed in the card header. */
  title: string;
  /** Destination URL for the recipe details page. */
  slug: string;
  /** Hero image URL or asset reference. */
  image: string;
  /** Optional original image fallback if optimized variant fails. */
  imageFallback?: string;
  /** Short summary rendered in the description area. */
  description: string;
  /** Preparation time label (for example, `25 min`). */
  prepTime: string;
  /** Difficulty label shown as a status badge. */
  difficulty: string;
  /** Category badge label. */
  category?: string;
  /** Controls the visual state of the favorite icon. */
  isFavorite?: boolean;
}

const {
  title,
  slug,
  image,
  imageFallback = image,
  description,
  prepTime,
  difficulty,
  category = 'RECETTE',
  isFavorite = false,
} = Astro.props;

const MAX_LENGTH = 150;
const truncatedDescription = description.length > MAX_LENGTH
  ? description.slice(0, MAX_LENGTH).trim() + '...'
  : description;
---

<article class="group recipe-card w-full rounded-[10px] bg-[#FAF8F2] overflow-hidden border border-[#D8D2C2] transition-all duration-300 hover:shadow-lg">
  <!-- Image Container -->
  <div class="relative w-full overflow-hidden aspect-[4/5] bg-[#EAE4D8]">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      fetchpriority="low"
      decoding="async"
      width="500"
      height="643"
      sizes="(min-width: 1280px) 28vw, (min-width: 1024px) 34vw, (min-width: 768px) 44vw, 92vw"
      data-fallback-src={imageFallback}
      onerror="if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc) this.src = this.dataset.fallbackSrc;"
    />

    <!-- Bookmark Button -->
    <button
      class="absolute top-4 right-4 w-[46px] h-[46px] rounded-full bg-white flex items-center justify-center text-text-primary shadow-[0_4px_16px_rgba(17,17,17,0.08)] hover:text-primary-turquoise transition-colors"
      aria-label={isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris'}
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z" />
      </svg>
    </button>
  </div>

  <!-- Content -->
  <div class="px-5 pb-6 pt-4 md:px-6 md:pb-7 md:pt-5 flex flex-col gap-4">
    <h3 class="recipe-card__title font-heading text-[30px] md:text-[34px] leading-[0.96] tracking-[-0.01em] text-text-primary">
      <a href={slug} class="hover:text-primary-turquoise transition-colors">
        {title}
      </a>
    </h3>

    <div class="flex items-center justify-between text-[13px] text-text-secondary uppercase tracking-[0.14em] typ-meta border-b border-[#D8D2C2] pb-3">
      <div class="flex items-center gap-2">
        <span data-recipe-meta-time>{prepTime}</span>
      </div>
      <SocialShare url={`${Astro.url.origin}${slug}`} title={title} class="gap-3 text-[14px]" />
    </div>

    <p class="recipe-card__excerpt text-text-secondary font-body text-[15px] leading-[1.65] typ-body">
      {truncatedDescription}
    </p>

    <a
      href={slug}
      class="inline-flex items-center gap-2 text-primary-turquoise font-body text-[13px] uppercase tracking-[0.08em] hover:underline typ-button"
    >
      Lire la suite
    </a>
  </div>
</article>

<style>
  .recipe-card__title a {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
  }

  .recipe-card__excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
    min-height: 6.6em;
  }
</style>

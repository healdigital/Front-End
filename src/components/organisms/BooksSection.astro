---
interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props as Props;
---

<section class={`relative ? '' : ' bg-secondary-cream overflow-hidden'}`}>
  {!embedded && (
    <div
      class="section-noise-overlay absolute inset-0 pointer-events-none opacity-28"
      aria-hidden="true"
    ></div>
  )}
  <div class={embedded ? 'relative z-10' : 'max-w-[1440px] mx-auto px-5 md:px-10 lg:px-[90px] relative z-10'}>
    <div class="flex items-center gap-6 mb-12 mt-12">
      <h2 class="font-heading text-3xl lg:text-5xl text-[#171F2C] whitespace-nowrap typ-section">Mes livres de recettes</h2>
      <div class="flex-1 h-px bg-[#D7D1C2] hidden md:block"></div>
    </div>

    <div class="books-section-card">
      <div class="books-section-grid">
        <div class="books-section-media">
          <img
            src="/images/bernard-books.png"
            alt="Bernard Laurance"
            class="books-section-media-image"
            loading="lazy"
          />
        </div>

        <div class="books-section-content">
          <div class="books-section-inner">
            <p class="books-section-eyebrow">L&apos;humain derri&egrave;re les recettes</p>
            <h3 class="books-section-title">Mes livres pour approfondir</h3>
            <p class="books-section-description">
              Bienvenue dans mon univers culinaire. Voyageur curieux, j&apos;ai ramen&eacute; de mes p&eacute;riples bien plus que des souvenirs : des saveurs oubli&eacute;es et des tours de main ancestraux. Aujourd&apos;hui, je vous livre tous mes secrets de cuisine, sans filtre et avec transparence.
            </p>
            <a
              href="/livres"
              class="books-section-button"
            >
              D&eacute;couvrir mes livres
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

---
interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props as Props;
---

<section class={`relative ${embedded ? '' : 'py-16 md:py-24 bg-secondary-cream overflow-hidden'}`}>
  {!embedded && (
    <div class="section-noise-overlay absolute inset-0 pointer-events-none section_2 opacity-28" aria-hidden="true"></div>
  )}
  <div class={embedded ? 'relative z-10' : 'max-w-[1440px] mx-auto px-5 md:px-10 lg:px-[90px] relative z-10'}>
    <div class={`flex items-center gap-6 mb-12 ${embedded ? '' : 'mt-12'}`}>
      <h2 class="font-heading text-3xl lg:text-5xl text-[#171F2C] whitespace-nowrap typ-section">Mes livres de recettes</h2>
      <div class="flex-1 h-px bg-[#D7D1C2] hidden md:block"></div>
    </div>

    <div class="books-section-card">
      <div class="books-section-grid">
        <div class="books-section-media books-section-media--grid">
          <img
            src="/images/bernard-books.png"
            alt="Mes livres de recettes"
            class="books-section-media-image"
            loading="lazy"
            decoding="async"
          />
          <img
            src="/images/book-asie-sucree.jpg"
            alt="Asie sucrée"
            class="books-section-media-image"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="books-section-content">
          <div class="books-section-inner">
            <p class="books-section-eyebrow">Mes livres de cuisine</p>
            <h3 class="books-section-title">Mes livres de cuisine</h3>
            <p class="books-section-description">
              D&eacute;couvrez mes livres publi&eacute;s chez Flammarion, Solar et &Eacute;ditions de la Martini&egrave;re. Vous y trouverez des recettes exclusives : p&acirc;tisserie, cuisine du monde, grands classiques et cr&eacute;ations gourmandes. Toutes les recettes sont &eacute;crites, pr&eacute;par&eacute;es et photographi&eacute;es par moi dans mon atelier.
            </p>
            <a href="/livres" class="books-section-button">Voir mes livres</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

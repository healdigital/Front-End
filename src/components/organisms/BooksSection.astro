---
interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props as Props;
---

<section class={`relative ${embedded ? 'py-12 md:py-16' : 'py-16 md:py-24 bg-secondary-cream overflow-hidden'}`}>
  {!embedded && (
    <div
      class="absolute inset-0 pointer-events-none opacity-28"
      aria-hidden="true"
      style="background-image: url('/images/noise.png'); background-size: 180px 180px;"
    ></div>
  )}
  <div class={embedded ? 'relative z-10' : 'max-w-[1440px] mx-auto px-5 md:px-10 lg:px-[90px] relative z-10'}>
    <div class="flex items-center gap-6 mb-12">
      <h2 class="font-heading text-3xl lg:text-5xl text-primary-black whitespace-nowrap typ-section">Mes livres de recettes</h2>
      <div class="flex-1 h-px bg-border-primary hidden md:block"></div>
    </div>

    <div class="flex flex-col lg:flex-row gap-8 rounded-lg overflow-hidden">
      <div class="w-full lg:w-[520px] h-[360px] lg:h-[520px] flex-shrink-0">
        <img
          src="/images/bernard-blog.png"
          alt="Bernard Laurance"
          class="w-full h-full object-cover rounded-lg"
          loading="lazy"
        />
      </div>

      <div class="flex-1 bg-white rounded-lg border border-border-light p-8 lg:p-12 flex flex-col gap-6">
        <p class="font-mono text-[12px] uppercase tracking-widest text-text-secondary typ-meta">L&apos;humain derri&egrave;re les recettes</p>
        <h3 class="font-heading text-4xl lg:text-5xl text-text-primary typ-feature-title">Mes livres pour approfondir</h3>
        <p class="text-[15px] text-text-secondary leading-relaxed typ-body">
          Bienvenue dans mon univers culinaire. Voyageur curieux, j&apos;ai ramen&eacute; de mes p&eacute;riples bien plus que des souvenirs : des saveurs oubli&eacute;es et des tours de main ancestraux. Aujourd&apos;hui, je vous livre tous mes secrets de cuisine, sans filtre et avec transparence.
        </p>
        <a
          href="/livres"
          class="inline-flex items-center justify-center px-8 py-4 bg-primary-turquoise text-primary-white font-button font-medium text-[13px] uppercase tracking-wider rounded-sm hover:opacity-90 w-fit typ-button"
        >
          D&eacute;couvrir mes livres
        </a>
      </div>
    </div>
  </div>
</section>

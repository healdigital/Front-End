---
interface HeroCard {
  title: string;
  image: string;
  imageFallback?: string;
  filterKey?: string;
  category: string;
  slug: string;
}

interface Props {
  cards: HeroCard[];
}

const { cards } = Astro.props;

const normalizeToken = (value: string): string =>
  String(value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim();

const toHeroCategoryTag = (card: HeroCard): string => {
  const filter = normalizeToken(card.filterKey || '');
  if (filter === 'sucrees') return 'SWEET';
  if (filter === 'salees') return 'SAVORY';

  const source = normalizeToken(`${card.category} ${card.title}`);

  const sweetKeywords = [
    'sucre',
    'sweet',
    'dessert',
    'gateau',
    'cake',
    'cookie',
    'brioche',
    'chocolat',
    'chocolate',
    'sable',
    'entremet',
    'galette',
    'tarte',
  ];

  if (sweetKeywords.some((keyword) => source.includes(keyword))) {
    return 'SWEET';
  }

  const savoryKeywords = [
    'sale',
    'savory',
    'savoury',
    'omelette',
    'quiche',
    'gratin',
    'soupe',
    'salade',
    'foie gras',
    'poulet',
    'poisson',
  ];

  if (savoryKeywords.some((keyword) => source.includes(keyword))) {
    return 'SAVORY';
  }

  const fallbackCategory = String(card.category || '').trim().toUpperCase();
  return fallbackCategory || 'RECIPE';
};
---

<section class="relative bg-[#fff] pt-10 pb-8 md:pt-14 md:pb-10 lg:pt-12 lg:pb-9 overflow-hidden p-4">
  <div class="section-noise-overlay absolute inset-0 pointer-events-none opacity-45" aria-hidden="true"></div>
  <div class="home-shell-width relative z-10">
    <div class="relative" data-hero-carousel>
      <div class="mb-8 md:mb-10 lg:mb-9 flex items-end justify-between gap-6">
        <div>
          <h1 class="font-heading text-primary-black mb-3 typ-title">&Agrave; la une</h1>
          <p class="font-mono text-[13px] uppercase tracking-[0.3em] text-text-secondary typ-subtitle">
            Cette semaine dans la cuisine de Bernard
          </p>
        </div>

        <div class="hidden md:flex items-center gap-3 self-start pt-2">
          <button
            class="hero-arrow-btn w-[62px] h-[62px] rounded-full border border-[#1A2335] flex items-center justify-center hover:bg-[#1A2335] hover:text-white transition-colors"
            aria-label="Pr&eacute;c&eacute;dent"
            data-carousel-prev
          >
            <svg class="w-5 h-5 rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <button
            class="hero-arrow-btn w-[62px] h-[62px] rounded-full border border-[#1A2335] flex items-center justify-center hover:bg-[#1A2335] hover:text-white transition-colors"
            aria-label="Suivant"
            data-carousel-next
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <div class="hero-scroll-shell">
        <div class="flex gap-5 overflow-x-auto scroll-smooth pb-4 hero-scroll-container" data-carousel-track>
          {cards.map((card, index) => (
            <a href={card.slug} class="hero-slide flex-shrink-0 rounded-[10px] overflow-hidden relative group block">
              <img
                src={card.image}
                alt={card.title}
                class="w-full h-full object-fill transition-transform duration-500 group-hover:scale-105"
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'low'}
                decoding="async"
                data-fallback-src={card.imageFallback || card.image}
                onerror="if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc) this.src = this.dataset.fallbackSrc;"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/72 via-black/30 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6">
                <div class="mb-3">
                  <span class="inline-flex rounded-full bg-white/95 px-4 py-1.5 text-[12px] font-mono uppercase tracking-[0.1em] text-[#26323E]">
                    {toHeroCategoryTag(card)}
                  </span>
                </div>
                <h3 class="font-body text-[34px] md:text-[35px] text-white leading-[1.08] line-clamp-2">
                  {card.title}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="mt-4 md:hidden flex items-center justify-start gap-3">
        <button
          class="hero-arrow-btn w-[56px] h-[56px] rounded-full border border-[#1A2335] flex items-center justify-center"
          aria-label="Pr&eacute;c&eacute;dent"
          data-carousel-prev
        >
          <svg class="w-5 h-5 rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
        <button
          class="hero-arrow-btn w-[56px] h-[56px] rounded-full border border-[#1A2335] flex items-center justify-center"
          aria-label="Suivant"
          data-carousel-next
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>

      <div class="mt-1 md:mt-4 flex items-center gap-3 douted_pagination">
        {[0, 1, 2, 3].map((dot, index) => (
          <span
            class={`hero-dot ${index === 0 ? 'is-active' : ''}`}
            data-carousel-dot={dot}
            aria-hidden="true"
          ></span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-scroll-shell {
    width: 100%;
    overflow: hidden;
  }

  .hero-scroll-container {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .hero-scroll-container::-webkit-scrollbar {
    display: none;
  }

  .hero-slide {
    width: 262px;
    height: 370px;
    scroll-snap-align: start;
  }

  .hero-arrow-btn {
    color: #1a2335;
    background: transparent;
  }

  .hero-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: rgba(49, 56, 68, 0.22);
    transition: background-color 0.2s ease;
  }

  .hero-dot.is-active {
    background: #1a2335;
  }

  @media (min-width: 768px) {
    .hero-slide {
      width: 300px;
      height: 495px;
    }
  }
</style>

<script>
  const carousels = Array.from(document.querySelectorAll('[data-hero-carousel]'));
  carousels.forEach((carousel) => {
    const track = carousel.querySelector('[data-carousel-track]');
    if (!track) return;

    const dots = Array.from(carousel.querySelectorAll('[data-carousel-dot]'));
    const prevButtons = Array.from(carousel.querySelectorAll('[data-carousel-prev]'));
    const nextButtons = Array.from(carousel.querySelectorAll('[data-carousel-next]'));

    const getStep = () => {
      const firstCard = track.firstElementChild;
      if (!(firstCard instanceof HTMLElement)) return 320;
      const styles = window.getComputedStyle(track);
      const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
      return firstCard.getBoundingClientRect().width + gap;
    };

    const updateDots = () => {
      if (dots.length === 0) return;
      const maxScroll = Math.max(track.scrollWidth - track.clientWidth, 1);
      const ratio = Math.min(Math.max(track.scrollLeft / maxScroll, 0), 1);
      const activeIndex = Math.round(ratio * (dots.length - 1));
      dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === activeIndex);
      });
    };

    prevButtons.forEach((button) => {
      button.addEventListener('click', () => {
        track.scrollBy({ left: -getStep(), behavior: 'smooth' });
      });
    });

    nextButtons.forEach((button) => {
      button.addEventListener('click', () => {
        track.scrollBy({ left: getStep(), behavior: 'smooth' });
      });
    });

    track.addEventListener('scroll', updateDots, { passive: true });
    window.addEventListener('resize', updateDots);
    updateDots();
  });
</script>

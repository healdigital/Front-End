---
interface HeroCard {
  title: string;
  image: string;
  category: string;
  slug: string;
}

interface Props {
  cards: HeroCard[];
}

const { cards } = Astro.props;
---

<section class="relative bg-[#ECEBE4] py-12 md:py-16 lg:py-20 overflow-hidden">
  <div
    class="absolute inset-0 pointer-events-none opacity-45"
    aria-hidden="true"
    style="background-image: url('/images/noise.png'); background-size: 180px 180px;"
  ></div>
  <div class="max-w-[1440px] mx-auto px-5 md:px-10 lg:px-[90px] relative z-10">
    <!-- Carousel -->
    <div class="relative" data-hero-carousel>
      <!-- Section Header -->
      <div class="mb-8 md:mb-12 flex items-end justify-between gap-6">
        <div>
          <h1 class="font-heading text-primary-black mb-5 typ-title">
            &Agrave; la une
          </h1>
          <p class="font-mono text-[13px] uppercase tracking-widest text-text-secondary typ-subtitle">
            Cette semaine dans la cuisine de Bernard
          </p>
        </div>

        <!-- Navigation Arrows -->
        <div class="hidden md:flex items-center gap-3 self-center">
          <button
            class="w-[63px] h-[63px] rounded-full border border-primary-black flex items-center justify-center hover:bg-primary-black hover:text-white transition-colors"
            aria-label="Pr&eacute;c&eacute;dent"
            data-carousel-prev
          >
            <svg class="w-5 h-5 rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <button
            class="w-[63px] h-[63px] rounded-full border border-primary-black flex items-center justify-center hover:bg-primary-black hover:text-white transition-colors"
            aria-label="Suivant"
            data-carousel-next
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <!-- Cards Container -->
      <div
        class="flex gap-5 overflow-x-auto scroll-smooth pb-4 -mx-5 px-5 md:-mx-0 md:px-0 hero-scroll-container"
        data-carousel-track
      >
        {cards.map((card) => (
          <a
            href={card.slug}
            class="flex-shrink-0 w-[260px] md:w-[311px] h-[420px] md:h-[500px] rounded-lg overflow-hidden relative group block"
          >
            <img
              src={card.image}
              alt={card.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="eager"
            />
            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
            <!-- Title -->
            <div class="absolute bottom-0 left-0 right-0 p-5">
              <div class="mb-3">
                <span class="inline-block rounded-full bg-white/90 backdrop-blur-md px-4 py-1.5 text-[12px] font-mono uppercase tracking-wider text-text-primary">
                  {card.category}
                </span>
              </div>
              <h3 class="font-body text-[17px] text-white font-medium leading-snug line-clamp-3">
                {card.title}
              </h3>
            </div>
          </a>
        ))}
      </div>

      <!-- Mobile controls -->
      <div class="mt-6 flex items-center justify-between md:hidden">
        <div class="flex items-center gap-3">
          <button
            class="w-[54px] h-[54px] rounded-full border border-primary-black flex items-center justify-center"
            aria-label="Pr&eacute;c&eacute;dent"
            data-carousel-prev
          >
            <svg class="w-5 h-5 rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <button
            class="w-[54px] h-[54px] rounded-full border border-primary-black flex items-center justify-center"
            aria-label="Suivant"
            data-carousel-next
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>

        <div class="flex items-center gap-3">
          {cards.map((_, index) => (
            <span
              class={`w-2 h-2 rounded-full ${index === 0 ? 'bg-text-primary' : 'bg-text-tertiary/60'}`}
              aria-hidden="true"
            ></span>
          ))}
        </div>
      </div>
    </div>

    <!-- Dots (desktop) -->
    <div class="mt-6 hidden md:flex items-center gap-3">
      {cards.map((_, index) => (
        <span
          class={`w-2 h-2 rounded-full ${index === 0 ? 'bg-text-primary' : 'bg-text-tertiary/60'}`}
          aria-hidden="true"
        ></span>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-scroll-container {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .hero-scroll-container::-webkit-scrollbar {
    display: none;
  }
  .hero-scroll-container > a {
    scroll-snap-align: start;
  }
</style>

<script>
  const carousel = document.querySelector('[data-hero-carousel]');
  if (carousel) {
    const track = carousel.querySelector('[data-carousel-track]');
    const prevButtons = Array.from(carousel.querySelectorAll('[data-carousel-prev]'));
    const nextButtons = Array.from(carousel.querySelectorAll('[data-carousel-next]'));

    const scrollAmount = 330;

    prevButtons.forEach((button) => {
      button.addEventListener('click', () => {
        track?.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
    });

    nextButtons.forEach((button) => {
      button.addEventListener('click', () => {
        track?.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    });
  }
</script>

---
import { loadGoogleReviews } from '../../lib/googleReviews';

interface Props {
  title?: string;
  subtitle?: string;
  limit?: number;
  compact?: boolean;
}

const {
  title = 'Avis Google',
  subtitle = 'Les derniers avis publies sur Google.',
  limit = 5,
  compact = false,
} = Astro.props;

const { data, endpoint, reviewsPageUrl } = await loadGoogleReviews();
const reviews = data?.reviews.slice(0, Math.max(1, limit)) || [];
const hasReviews = reviews.length > 0;

const formatRating = (value: number): string => {
  if (!Number.isFinite(value) || value <= 0) return '--';
  return value.toFixed(1).replace(/\.0$/, '');
};
---

<section
  class:list={[
    'google-reviews',
    compact && 'google-reviews--compact',
    !hasReviews && 'google-reviews--hidden',
  ]}
  data-google-reviews-root
  data-endpoint={endpoint || ''}
  data-page-url={reviewsPageUrl || ''}
  data-title={title}
  data-subtitle={subtitle}
  data-limit={String(limit)}
>
  {hasReviews && (
    <>
      <div class="google-reviews__header">
        <div>
          <p class="google-reviews__eyebrow">Google</p>
          <h2 class="google-reviews__title">{title}</h2>
          <p class="google-reviews__subtitle">{subtitle}</p>
        </div>
        <div class="google-reviews__summary">
          <div class="google-reviews__score">{formatRating(data!.rating)}</div>
          <div>
            <div class="google-reviews__stars" aria-label={`${formatRating(data!.rating)} sur 5`}>
              {Array.from({ length: 5 }).map((_, index) => (
                <span class:list={['google-reviews__star', index < Math.round(data!.rating) && 'is-filled']}>★</span>
              ))}
            </div>
            <p class="google-reviews__count">{data!.totalReviews} avis Google</p>
          </div>
        </div>
      </div>

      <div class="google-reviews__grid">
        {reviews.map((review) => (
          <article class="google-reviews__card">
            <div class="google-reviews__card-head">
              {review.authorPhoto ? (
                <img
                  src={review.authorPhoto}
                  alt=""
                  aria-hidden="true"
                  class="google-reviews__avatar"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                />
              ) : (
                <div class="google-reviews__avatar google-reviews__avatar--fallback" aria-hidden="true">
                  {review.author.charAt(0)}
                </div>
              )}

              <div class="google-reviews__meta">
                <p class="google-reviews__author">{review.author}</p>
                <p class="google-reviews__time">{review.relativeTime || 'Avis recent'}</p>
              </div>
            </div>

            <div class="google-reviews__stars google-reviews__stars--card" aria-label={`${review.rating} sur 5`}>
              {Array.from({ length: 5 }).map((_, index) => (
                <span class:list={['google-reviews__star', index < Math.round(review.rating) && 'is-filled']}>★</span>
              ))}
            </div>

            <p class="google-reviews__text">{review.text}</p>
          </article>
        ))}
      </div>

      {reviewsPageUrl && (
        <div class="google-reviews__footer">
          <a
            href={reviewsPageUrl}
            target="_blank"
            rel="noreferrer noopener"
            class="google-reviews__cta"
          >
            Voir tous les avis
          </a>
        </div>
      )}
    </>
  )}
</section>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-google-reviews-root]');

    const formatRating = (value) => {
      const numeric = Number(value || 0);
      if (!Number.isFinite(numeric) || numeric <= 0) return '--';
      return numeric.toFixed(1).replace(/\.0$/, '');
    };

    const escapeHtml = (value) =>
      String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    const renderStars = (rating) => {
      const rounded = Math.round(Number(rating || 0));
      return Array.from({ length: 5 })
        .map((_, index) => `<span class="google-reviews__star${index < rounded ? ' is-filled' : ''}">★</span>`)
        .join('');
    };

    roots.forEach(async (root) => {
      if (root.querySelector('.google-reviews__grid')) {
        root.classList.remove('google-reviews--hidden');
        return;
      }

      const endpoint = root.getAttribute('data-endpoint');
      const pageUrl = root.getAttribute('data-page-url') || '';
      const title = root.getAttribute('data-title') || 'Avis Google';
      const subtitle = root.getAttribute('data-subtitle') || 'Les derniers avis publies sur Google.';
      const limit = Math.max(1, Number(root.getAttribute('data-limit') || '5'));

      if (!endpoint) return;

      try {
        const response = await fetch(endpoint, {
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) return;

        const payload = await response.json();
        const reviews = Array.isArray(payload?.reviews) ? payload.reviews.slice(0, limit) : [];
        const rating = Number(payload?.rating || 0);
        const totalReviews = Number(payload?.total_reviews || reviews.length || 0);

        if (!payload?.name || !reviews.length || !Number.isFinite(rating) || rating <= 0) return;

        const cardsHtml = reviews
          .map((review) => {
            const author = escapeHtml(review?.author || '');
            const text = escapeHtml(review?.text || '');
            const relativeTime = escapeHtml(review?.relative_time || 'Avis recent');
            const authorPhoto = String(review?.author_photo || '').trim();
            const reviewRating = Number(review?.rating || 0);

            if (!author || !text || !Number.isFinite(reviewRating) || reviewRating <= 0) return '';

            const avatarHtml = authorPhoto
              ? `<img src="${escapeHtml(authorPhoto)}" alt="" aria-hidden="true" class="google-reviews__avatar" loading="lazy" decoding="async" referrerpolicy="no-referrer" />`
              : `<div class="google-reviews__avatar google-reviews__avatar--fallback" aria-hidden="true">${author.charAt(0)}</div>`;

            return `
              <article class="google-reviews__card">
                <div class="google-reviews__card-head">
                  ${avatarHtml}
                  <div class="google-reviews__meta">
                    <p class="google-reviews__author">${author}</p>
                    <p class="google-reviews__time">${relativeTime}</p>
                  </div>
                </div>
                <div class="google-reviews__stars google-reviews__stars--card" aria-label="${reviewRating} sur 5">
                  ${renderStars(reviewRating)}
                </div>
                <p class="google-reviews__text">${text}</p>
              </article>
            `;
          })
          .filter(Boolean)
          .join('');

        if (!cardsHtml) return;

        root.innerHTML = `
          <div class="google-reviews__header">
            <div>
              <p class="google-reviews__eyebrow">Google</p>
              <h2 class="google-reviews__title">${escapeHtml(title)}</h2>
              <p class="google-reviews__subtitle">${escapeHtml(subtitle)}</p>
            </div>
            <div class="google-reviews__summary">
              <div class="google-reviews__score">${escapeHtml(formatRating(rating))}</div>
              <div>
                <div class="google-reviews__stars" aria-label="${escapeHtml(formatRating(rating))} sur 5">
                  ${renderStars(rating)}
                </div>
                <p class="google-reviews__count">${escapeHtml(totalReviews)} avis Google</p>
              </div>
            </div>
          </div>
          <div class="google-reviews__grid">${cardsHtml}</div>
          ${
            pageUrl
              ? `<div class="google-reviews__footer"><a href="${escapeHtml(pageUrl)}" target="_blank" rel="noreferrer noopener" class="google-reviews__cta">Voir tous les avis</a></div>`
              : ''
          }
        `;

        root.classList.remove('google-reviews--hidden');
      } catch {
        // Keep silent on failure to avoid page noise.
      }
    });
  })();
</script>

<style>
  .google-reviews {
    border: 1px solid #d8d2c2;
    border-radius: 14px;
    background: #faf8f2;
    padding: 28px;
  }

  .google-reviews--hidden {
    display: none;
  }

  .google-reviews--compact {
    padding: 22px;
  }

  .google-reviews__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .google-reviews__eyebrow {
    margin: 0 0 8px;
    font-family: var(--font-mono, "Roboto Mono", monospace);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5f6671;
  }

  .google-reviews__title {
    margin: 0;
    font-family: var(--font-heading, "Instrument Serif", serif);
    font-size: clamp(32px, 3.4vw, 42px);
    line-height: 1.02;
    color: #111111;
  }

  .google-reviews__subtitle {
    margin: 10px 0 0;
    max-width: 560px;
    font-family: var(--font-body, "PT Serif", serif);
    font-size: 16px;
    line-height: 1.6;
    color: #5b5b5b;
  }

  .google-reviews__summary {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border: 1px solid #d8d2c2;
    border-radius: 12px;
    background: #f7f5ef;
  }

  .google-reviews__score {
    font-family: var(--font-heading, "Instrument Serif", serif);
    font-size: 40px;
    line-height: 1;
    color: #111111;
  }

  .google-reviews__stars {
    display: flex;
    gap: 4px;
    color: #c9c1b3;
    font-size: 16px;
    line-height: 1;
  }

  .google-reviews__stars--card {
    margin-top: 14px;
  }

  .google-reviews__star.is-filled {
    color: #5a822b;
  }

  .google-reviews__count {
    margin: 6px 0 0;
    font-family: var(--font-mono, "Roboto Mono", monospace);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #5f6671;
  }

  .google-reviews__grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 18px;
  }

  .google-reviews__card {
    border: 1px solid #d8d2c2;
    border-radius: 12px;
    background: #f7f5ef;
    padding: 20px;
  }

  .google-reviews__card-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .google-reviews__avatar {
    width: 46px;
    height: 46px;
    border-radius: 999px;
    object-fit: cover;
    flex-shrink: 0;
    background: #ece8dc;
  }

  .google-reviews__avatar--fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono, "Roboto Mono", monospace);
    font-size: 15px;
    text-transform: uppercase;
    color: #111111;
  }

  .google-reviews__meta {
    min-width: 0;
  }

  .google-reviews__author {
    margin: 0;
    font-family: var(--font-body, "PT Serif", serif);
    font-size: 18px;
    line-height: 1.2;
    color: #111111;
  }

  .google-reviews__time {
    margin: 4px 0 0;
    font-family: var(--font-mono, "Roboto Mono", monospace);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #5f6671;
  }

  .google-reviews__text {
    margin: 14px 0 0;
    font-family: var(--font-body, "PT Serif", serif);
    font-size: 16px;
    line-height: 1.65;
    color: #5b5b5b;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .google-reviews__footer {
    margin-top: 22px;
  }

  .google-reviews__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 16px 28px;
    border-radius: 2px;
    background: #54b6b1;
    color: #faf8f2;
    font-family: var(--font-button, "Roboto Mono", monospace);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .google-reviews__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .google-reviews__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .google-reviews {
      padding: 22px 18px;
    }

    .google-reviews__header {
      flex-direction: column;
      margin-bottom: 20px;
    }

    .google-reviews__summary {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>

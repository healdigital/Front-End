---
import Button from '../atoms/Button.astro';
import Icon from '../atoms/Icon.astro';

interface Props {
  title: string;
  image: string;
  date: Date;
  price: number;
  duration: string;
  maxParticipants: number;
  currentParticipants?: number;
  slug: string;
}

const {
  title,
  image,
  date,
  price,
  duration,
  maxParticipants,
  currentParticipants = 0,
  slug,
} = Astro.props;

const isFull = currentParticipants >= maxParticipants;
const spotsLeft = maxParticipants - currentParticipants;

let statusLabel = 'Places disponibles';
let statusClass = 'text-status-success';

if (isFull) {
  statusLabel = 'Complet';
  statusClass = 'text-status-error';
} else if (spotsLeft <= 2) {
  statusLabel = 'Derni&egrave;res places';
  statusClass = 'text-status-error';
}

const formatter = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'short',
});
const parts = formatter.formatToParts(date);
const day = parts.find((p) => p.type === 'day')?.value || '';
const month = parts.find((p) => p.type === 'month')?.value || '';
---

<article class="w-full max-w-[388px] rounded-[10px] bg-[#F7F5EF] overflow-hidden border border-[#D8D2C2] shadow-[0_16px_44px_rgba(6,18,40,0.26)]">
  <div class="relative aspect-[0.98] max-h-[386px]">
    <img src={image} alt={title} class="w-full h-full object-cover" loading="lazy" />
    <div class="absolute bottom-4 left-4 bg-white rounded-[14px] p-2 text-center min-w-[63px] shadow-sm">
      <span class="block text-[14px] uppercase text-[#8D8C86] font-mono leading-none">{month}</span>
      <span class="block text-[50px] leading-none font-heading text-[#111111]">{day}</span>
    </div>
  </div>

  <div class="p-6">
    <p class={`text-[13px] uppercase tracking-[0.14em] font-mono ${statusClass} typ-meta`} set:html={statusLabel}></p>
    <h3 class="font-heading text-[43px] leading-[1] text-text-primary mt-2">{title}</h3>

    <div class="flex items-center gap-6 text-[#2F3642] text-[13px] uppercase tracking-[0.08em] mt-4 border-b border-[#D8D2C2] pb-4">
      <span class="flex items-center gap-2"><Icon name="users" size="sm" /> {maxParticipants} personnes maximum</span>
      <span class="flex items-center gap-2"><Icon name="clock" size="sm" /> {duration}</span>
    </div>

    <p class="text-[16px] text-text-secondary mt-5 leading-[1.7] typ-body">Apprenez directement &agrave; mes c&ocirc;t&eacute;s dans un atelier intimiste.</p>

    <div class="flex items-center justify-between mt-8">
      <div>
        <span class="text-[13px] uppercase tracking-[0.14em] text-text-secondary typ-meta">&Agrave; partir de</span>
        <div class="font-heading text-[60px] leading-none text-text-primary">{price}&euro;</div>
      </div>
      <Button href={isFull ? undefined : slug} variant={isFull ? 'disabled' : 'primary'} size="sm">
        {isFull ? 'Complet' : 'R&eacute;server'}
      </Button>
    </div>
  </div>
</article>

---
import Icon from '../atoms/Icon.astro';

const features = [
  { icon: 'video' as const, label: '12 modules vidéo' },
  { icon: 'download' as const, label: 'Fiches téléchargeables' },
  { icon: 'refresh' as const, label: 'Accès à vie + mises à jour gratuites' },
];
---

<section class="py-16 md:py-24 bg-primary-white">
  <div class="max-w-[1440px] mx-auto px-5 md:px-10 lg:px-[90px]">
    <!-- Section header -->
    <div class="flex items-center gap-6 mb-12">
      <h2 class="font-heading text-3xl lg:text-5xl text-primary-black whitespace-nowrap">Produit phare Masterclass</h2>
      <div class="flex-1 h-px bg-border-primary hidden md:block"></div>
    </div>

    <!-- Two-panel card -->
    <div class="flex flex-col lg:flex-row rounded-lg overflow-hidden shadow-light">
      <!-- Left: Image with play button -->
      <div class="relative w-full lg:w-[492px] h-[350px] lg:h-[639px] flex-shrink-0 bg-secondary-beige-warm">
        <img
          src="/images/masterclass-patisserie.jpg"
          alt="Masterclass pâtisserie avec Bernard"
          class="w-full h-full object-cover"
          loading="lazy"
        />
        <!-- Play button overlay -->
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-20 h-20 rounded-full bg-white/90 backdrop-blur-md flex items-center justify-center shadow-medium cursor-pointer hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-primary-turquoise ml-1" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5,3 19,12 5,21" />
            </svg>
          </div>
        </div>
        <!-- Badge "Produit phare" -->
        <div class="absolute top-5 left-5 flex items-center gap-2 bg-white/80 backdrop-blur-md rounded-full px-5 py-3">
          <Icon name="star" size="md" class="text-primary-black" />
          <span class="font-mono text-[14px] uppercase text-primary-black">Produit phare</span>
        </div>
      </div>

      <!-- Right: Content -->
      <div class="flex-1 bg-secondary-cream p-8 lg:p-12 flex flex-col justify-between">
        <div class="flex flex-col gap-6">
          <!-- Title -->
          <h3 class="font-heading text-4xl lg:text-5xl text-primary-black leading-snug">
            Les Bases de la Pâtisserie
          </h3>

          <!-- Description -->
          <p class="font-body text-md leading-relaxed text-text-secondary">
            Maîtrisez les fondamentaux : pâte feuilletée, pâte à choux, crème pâtissière, meringues... Tout ce dont vous avez besoin pour réussir 90% des recettes classiques.
          </p>

          <!-- Divider -->
          <hr class="border-border-light" />

          <!-- Features -->
          <div class="flex flex-col gap-5">
            {features.map((feature) => (
              <div class="flex items-center gap-4">
                <div class="w-6 h-6 flex items-center justify-center text-text-secondary">
                  <Icon name={feature.icon} size="md" />
                </div>
                <span class="font-mono font-medium text-[13px] uppercase text-text-secondary tracking-wide">{feature.label}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Price + CTA -->
        <div class="mt-8 flex items-end justify-between">
          <div>
            <span class="text-sm text-text-secondary block">À partir de</span>
            <span class="font-heading text-[44px] text-text-primary leading-none">149€</span>
          </div>
          <a
            href="/masterclass-patisserie-francaise"
            class="inline-flex items-center justify-center px-8 py-4 bg-primary-turquoise text-primary-white font-button font-medium text-md uppercase tracking-wide rounded-sm hover:opacity-90 transition-opacity"
          >
            Réserver
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

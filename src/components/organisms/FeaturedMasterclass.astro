---
import Icon from '../atoms/Icon.astro';

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props as Props;

const features = [
  { icon: 'video' as const, label: 'Cours vid&eacute;o pas &agrave; pas' },
  { icon: 'download' as const, label: 'Fiches t&eacute;l&eacute;chargeables' },
  { icon: 'refresh' as const, label: 'Acc&egrave;s &agrave; vie et mises &agrave; jour gratuites' },
];
---

<section class={`relative ${embedded ? '' : 'py-16 md:py-24 bg-secondary-cream overflow-hidden'}`}>
  {!embedded && (
    <div
      class="section-noise-overlay absolute inset-0 pointer-events-none opacity-25"
      aria-hidden="true"
    ></div>
  )}
  <div class={embedded ? 'relative z-10' : 'max-w-[1440px] mx-auto px-5 md:px-10 lg:px-[90px] relative z-10'}>
    <div class="flex items-center gap-6 mb-12">
      <h2 class="font-heading text-3xl lg:text-5xl text-primary-black whitespace-nowrap typ-section" style="padding-top:0px !important;">Mes cours vid&eacute;o</h2>
      <div class="flex-1 h-px bg-border-primary hidden md:block"></div>
    </div>

    <div class="featured-masterclass-card">
      <div class="featured-masterclass-media">
        <img
          src="/images/masterclass-featured.jpg"
          alt="Masterclass p&acirc;tisserie"
          class="featured-masterclass-media-image"
          loading="lazy"
          decoding="async"
          sizes="(min-width: 1024px) 42vw, 92vw"
        />
        <div class="absolute top-4 left-4 bg-white/90 rounded-full px-4 py-2 flex items-center gap-2">
          <Icon name="star" size="sm" class="text-text-primary" />
          <span class="font-mono text-[11px] uppercase tracking-wider text-text-primary">Produit phare</span>
        </div>
      </div>

      <div class="featured-masterclass-panel">
        <div class="featured-masterclass-copy">
              <p class="featured-masterclass-eyebrow">Cours vid&eacute;o</p>
          <h3 class="featured-masterclass-title">
            Les Bases de la P&acirc;tisserie
          </h3>
          <p class="featured-masterclass-description">
            D&eacute;couvrez mes premiers cours vid&eacute;o pour apprendre les bases de la p&acirc;tisserie &agrave; votre rythme depuis chez vous. Cr&egrave;me p&acirc;tissi&egrave;re, chantilly, cr&egrave;me diplomate, millefeuille, p&acirc;te feuillet&eacute;e invers&eacute;e : des techniques essentielles expliqu&eacute;es pas &agrave; pas avec les bons gestes, les bonnes textures et le niveau de d&eacute;tail n&eacute;cessaire pour r&eacute;ussir.
          </p>
          <div class="featured-masterclass-features">
            {features.map((feature) => (
              <div class="featured-masterclass-feature">
                <Icon name={feature.icon} size="sm" />
                <span set:html={feature.label}></span>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-8 flex items-end justify-between gap-4 flex-wrap">
          <a
            href="/masterclass"
            class="inline-flex items-center justify-center px-8 py-4 bg-primary-turquoise text-primary-white font-button font-medium text-[13px] uppercase tracking-wider rounded-sm hover:opacity-90 typ-button"
          >
            Voir les cours vid&eacute;o
          </a>
          <a
            href="/masterclass#bundle"
            class="inline-flex items-center justify-center px-6 py-4 border border-[#D7D1C2] text-text-primary font-button font-medium text-[13px] uppercase tracking-wider rounded-sm hover:bg-[#F7F5EF] typ-button"
          >
            D&eacute;couvrir le bundle
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

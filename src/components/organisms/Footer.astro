---
import Icon from '../atoms/Icon.astro';

const currentYear = new Date().getFullYear();
const SHOP_VIDEO_URL = '/cours-video';
const SHOP_WORKSHOP_URL = 'https://atelier-lacuisinedebernard.com/latelier/';

const socialLinks = [
  { name: 'facebook', url: 'https://facebook.com', label: 'Suivez-nous sur Facebook' },
  { name: 'instagram', url: 'https://instagram.com', label: 'Suivez-nous sur Instagram' },
  { name: 'pinterest', url: 'https://pinterest.com', label: 'Suivez-nous sur Pinterest' },
  { name: 'youtube', url: 'https://youtube.com', label: 'Suivez-nous sur YouTube' },
] as const;

const categories = [
  { label: 'Recettes sucrées', url: '/recettes-sucrees' },
  { label: 'Recettes salées', url: '/recettes-salees' },
  { label: 'Livres', url: '/mes-livres' },
  { label: 'Ateliers', url: SHOP_WORKSHOP_URL },
  { label: 'Cours vidéo', url: SHOP_VIDEO_URL },
  { label: 'Voyages', url: '/voyages' },
  { label: 'Reportages', url: '/reportages' },
  { label: 'Sélections', url: '/selections' },
];

const informationLinks = [
  { label: 'Contact', url: '/contact' },
  { label: 'Mentions légales', url: '/mentions-legales' },
  { label: 'Politique de confidentialité', url: '/politique-confidentialite' },
  { label: 'CGU', url: '/cgu' },
  { label: 'Gestion des cookies', url: '/cookies' },
];
---

<footer class="bg-[#1C2639] text-text-on-dark pt-16 pb-8 border-t border-border-footer" role="contentinfo">
  <div class="max-w-[1440px] mx-auto px-5 md:px-10 lg:px-[90px]">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 mb-16">
      <div class="space-y-6">
        <a
          href="/"
          class="inline-block text-2xl font-heading text-primary-white mb-2"
          aria-label="La Cuisine de Bernard - Accueil"
        >
          La Cuisine de Bernard
        </a>
        <p class="text-text-secondary font-body text-md leading-relaxed max-w-xs">
          Pour tous les amoureux de cuisine, de pâtisserie et de gourmandise.
        </p>
        <div class="flex gap-4">
          {socialLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary-white hover:text-primary-turquoise transition-colors duration-200"
              aria-label={link.label}
            >
              <Icon name={link.name} size="md" />
            </a>
          ))}
        </div>
      </div>

      <div>
        <h3 class="text-primary-white font-heading text-2xl mb-6">Explorer</h3>
        <ul class="space-y-3">
          {categories.map((cat) => (
            <li>
              <a
                href={cat.url}
                class="text-text-secondary hover:text-primary-turquoise transition-colors duration-200 font-body text-md"
              >
                {cat.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-primary-white font-heading text-2xl mb-6">Informations</h3>
        <ul class="space-y-3">
          {informationLinks.map((link) => (
            <li>
              <a
                href={link.url}
                class="text-text-secondary hover:text-primary-turquoise transition-colors duration-200 font-body text-md"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-primary-white font-heading text-2xl mb-6">Newsletter</h3>
        <p class="text-text-secondary font-body text-md mb-4">
          Recevez les nouvelles recettes, les dates d'ateliers et les dernières nouveautés directement par email.
        </p>
        <button
          id="open-newsletter-footer"
          class="inline-flex items-center justify-center rounded-full bg-primary-turquoise px-6 py-3 text-[13px] font-medium uppercase tracking-[0.08em] text-primary-black transition-colors duration-200 hover:bg-[#3aa8a2]"
        >
          S'inscrire
        </button>
      </div>
    </div>

    <div class="border-t border-white/10 my-8"></div>

    <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-text-tertiary">
      <p>&copy; {currentYear} La Cuisine de Bernard. Tous droits réservés.</p>
      <p class="text-center md:text-right">Cuisine, pâtisserie et gourmandise au quotidien.</p>
    </div>
  </div>
</footer>

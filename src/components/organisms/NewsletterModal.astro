---
import Icon from '../atoms/Icon.astro';

/**
 * Props for the `NewsletterModal` organism.
 */
interface Props {
  /** Id of the button that opens the modal dialog. */
  triggerId?: string; // ID of the button that opens this modal
  /** Unique dialog id used for ARIA attributes and script hooks. */
  id?: string;
}

const { 
  triggerId = 'open-newsletter-modal',
  id = 'newsletter-modal'
} = Astro.props;
---

<dialog
  id={id}
  data-trigger-id={triggerId}
  data-motion="full"
  class="newsletter-modal-dialog fixed inset-0 z-50 hidden items-center justify-center bg-transparent overflow-hidden"
  aria-modal="true"
  aria-labelledby={`${id}-title`}
  aria-describedby={`${id}-desc`}
>
  <div
    class="newsletter-modal-panel"
    data-modal-panel
  >
    <button
      id={`${id}-close`}
      class="newsletter-modal-close-btn"
      aria-label="Fermer la modale"
    >
      <Icon name="close" size="lg" />
    </button>

    <div class="newsletter-modal-media" aria-hidden="true">
      <div class="newsletter-modal-media-image"></div>
    </div>

    <div class="newsletter-modal-content">
      <div class="newsletter-modal-copy">
        <h2 id={`${id}-title`} class="newsletter-modal-title">
          Recevez les nouvelles recettes
        </h2>
        <p id={`${id}-desc`} class="newsletter-modal-description">
          Abonnez-vous à la newsletter mensuelle pour recevoir les nouvelles recettes, les dates d'ateliers, les nouveautés du site, les sorties de livres et bien plus encore.
        </p>
      </div>

      <form class="newsletter-modal-form" novalidate id={`${id}-form`}>
        <div class="newsletter-modal-field-row">
          <div class="newsletter-modal-field">
            <label class="sr-only" for={`${id}-email`}>Votre adresse email</label>
            <input
              type="email"
              id={`${id}-email`}
              name="email"
              class="newsletter-modal-input"
              placeholder="Votre adresse email"
              required
            />
          </div>
          <button class="newsletter-modal-submit typ-button" type="submit">
            S'inscrire
          </button>
        </div>

        <label class="newsletter-modal-consent">
          <input
            id={`${id}-consent`}
            type="checkbox"
            class="newsletter-modal-checkbox-input"
            name="consent"
            required
          />
          <span class="newsletter-modal-checkbox-box" aria-hidden="true">
            <svg viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 5L4.5 8.5L13 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="newsletter-modal-consent-text">
            J'accepte les <a href="/mentions-legales/" target="_blank" rel="noopener noreferrer">Conditions Générales d'Utilisation</a> du site
            lacuisinedebernard.com ne partage ni ne vend les données personnelles.
          </span>
        </label>

        <p
          id={`${id}-feedback`}
          class="newsletter-modal-feedback hidden"
          aria-live="polite"
        ></p>
      </form>
    </div>
  </div>
</dialog>

<script>
  import { newsletterSchema } from '../../lib/validation/schemas';
  import { validateForm } from '../../lib/validation/client';
  import { isReducedMotionPreferred, subscribeToReducedMotionPreference } from '../../utils/motion';

  const dialogs = document.querySelectorAll<HTMLDialogElement>('dialog[id^="newsletter-modal"]');

  dialogs.forEach((dialog) => {
    const id = dialog.id;
    const triggerId = dialog.dataset.triggerId;
    const trigger = triggerId ? document.getElementById(triggerId) : null;
    const panel = dialog.querySelector<HTMLElement>('[data-modal-panel]');
    const closeBtn = document.getElementById(`${id}-close`);
    const form = document.getElementById(`${id}-form`) as HTMLFormElement | null;
    const emailInput = document.getElementById(`${id}-email`) as HTMLInputElement | null;
    const consentCheckbox = document.getElementById(`${id}-consent`) as HTMLInputElement | null;
    const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]') ?? null;
    const feedback = document.getElementById(`${id}-feedback`) as HTMLParagraphElement | null;

    if (!form || !emailInput || !consentCheckbox) return;

    const defaultSubmitText = submitBtn?.innerText || "S'inscrire";

    const textInputErrorClasses = ['newsletter-modal-input--error'];
    const textInputSuccessClasses = ['newsletter-modal-input--success'];
    const textInputDefaultClasses = ['newsletter-modal-input--default'];
    const checkboxErrorClasses = ['newsletter-modal-checkbox-box--error'];
    const checkboxSuccessClasses = ['newsletter-modal-checkbox-box--success'];
    const checkboxDefaultClasses = ['newsletter-modal-checkbox-box--default'];

    const focusableSelector = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
    let prefersReducedMotion = isReducedMotionPreferred();

    const applyMotionPreference = () => {
      dialog.dataset.motion = prefersReducedMotion ? 'reduced' : 'full';
    };

    applyMotionPreference();

    const unsubscribeReducedMotion = subscribeToReducedMotionPreference((matches) => {
      prefersReducedMotion = matches;
      applyMotionPreference();
    });

    function setFeedback(message: string, state: 'error' | 'success' | 'neutral') {
      if (!feedback) return;

      feedback.textContent = message;
      feedback.classList.remove(
        'hidden',
        'newsletter-modal-feedback--error',
        'newsletter-modal-feedback--success',
        'newsletter-modal-feedback--neutral'
      );
      if (!message) {
        feedback.classList.add('hidden');
        return;
      }

      if (state === 'error') {
        feedback.classList.add('newsletter-modal-feedback--error');
      } else if (state === 'success') {
        feedback.classList.add('newsletter-modal-feedback--success');
      } else {
        feedback.classList.add('newsletter-modal-feedback--neutral');
      }
    }

    function getErrorElement(input: HTMLInputElement): HTMLElement {
      let errorElement = document.getElementById(`${input.id}-error`);
      if (errorElement) return errorElement;

      errorElement = document.createElement(input.type === 'checkbox' ? 'p' : 'span');
      errorElement.id = `${input.id}-error`;
      errorElement.setAttribute('role', 'alert');

      if (input.type === 'checkbox') {
        errorElement.className = 'newsletter-modal-error newsletter-modal-error--checkbox';
        const checkboxLabel = input.closest('label');
        checkboxLabel?.appendChild(errorElement);
      } else {
        errorElement.className = 'newsletter-modal-error';
        input.parentElement?.appendChild(errorElement);
      }

      return errorElement;
    }

    function setFieldState(input: HTMLInputElement, state: 'default' | 'error' | 'success') {
      input.dataset.validationState = state;

      if (input.type === 'checkbox') {
        const visualBox = input.nextElementSibling as HTMLElement | null;
        if (!visualBox) return;

        visualBox.classList.remove(...checkboxDefaultClasses, ...checkboxErrorClasses, ...checkboxSuccessClasses);

        if (state === 'error') {
          visualBox.classList.add(...checkboxErrorClasses);
          input.setAttribute('aria-invalid', 'true');
        } else if (state === 'success') {
          visualBox.classList.add(...checkboxSuccessClasses);
          input.removeAttribute('aria-invalid');
        } else {
          visualBox.classList.add(...checkboxDefaultClasses);
          input.removeAttribute('aria-invalid');
        }
        return;
      }

      input.classList.remove(...textInputDefaultClasses, ...textInputErrorClasses, ...textInputSuccessClasses);

      if (state === 'error') {
        input.classList.add(...textInputErrorClasses);
        input.setAttribute('aria-invalid', 'true');
      } else if (state === 'success') {
        input.classList.add(...textInputSuccessClasses);
        input.removeAttribute('aria-invalid');
      } else {
        input.classList.add(...textInputDefaultClasses);
        input.removeAttribute('aria-invalid');
      }
    }

    function showError(input: HTMLInputElement, message: string) {
      if (!input) return;

      const errorElement = getErrorElement(input);
      errorElement.textContent = message;
      errorElement.classList.remove('hidden');
      input.setAttribute('aria-describedby', errorElement.id);
      setFieldState(input, 'error');
    }

    function hideError(input: HTMLInputElement) {
      const errorElement = document.getElementById(`${input.id}-error`);
      if (!errorElement) return;
      errorElement.textContent = '';
      errorElement.classList.add('hidden');
    }

    function clearError(input: HTMLInputElement) {
      if (!input) return;
      hideError(input);
      input.removeAttribute('aria-describedby');
      setFieldState(input, 'default');
    }

    function setSuccess(input: HTMLInputElement) {
      hideError(input);
      input.removeAttribute('aria-describedby');
      setFieldState(input, 'success');
    }

    const trapFocus = (event: KeyboardEvent) => {
      if (event.key !== 'Tab') return;

      const focusableElements = Array.from(
        dialog.querySelectorAll<HTMLElement>(focusableSelector)
      ).filter((element) => !element.hasAttribute('disabled'));

      if (focusableElements.length === 0) return;

      const firstElement = focusableElements[0];
      const lastElement = focusableElements[focusableElements.length - 1];

      if (event.shiftKey && document.activeElement === firstElement) {
        event.preventDefault();
        lastElement.focus();
      }

      if (!event.shiftKey && document.activeElement === lastElement) {
        event.preventDefault();
        firstElement.focus();
      }
    };

    function resetFormState() {
      form.reset();
      clearError(emailInput);
      clearError(consentCheckbox);
      setFeedback('', 'neutral');
      form.removeAttribute('aria-busy');

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.removeAttribute('aria-disabled');
        submitBtn.innerText = defaultSubmitText;
        submitBtn.classList.remove('newsletter-modal-submit--success');
      }
    }

    function openDialog() {
      if (!dialog.open) dialog.showModal();
      dialog.classList.remove('hidden');
      dialog.classList.add('flex');
      document.body.style.overflow = 'hidden';
      dialog.addEventListener('keydown', trapFocus);

      const firstFocusable = dialog.querySelector<HTMLElement>(focusableSelector);
      setTimeout(() => firstFocusable?.focus(), 0);
    }

    function closeDialog({ reset = true }: { reset?: boolean } = {}) {
      if (dialog.open) dialog.close();
      dialog.classList.add('hidden');
      dialog.classList.remove('flex');
      document.body.style.overflow = '';
      dialog.removeEventListener('keydown', trapFocus);
      if (reset) resetFormState();
      trigger?.focus();
    }

    if (trigger) {
      trigger.addEventListener('click', openDialog);
    }

    closeBtn?.addEventListener('click', () => {
      closeDialog({ reset: true });
    });

    dialog.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (!panel || panel.contains(target)) return;
      closeDialog({ reset: true });
    });

    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeDialog({ reset: true });
    });

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      dialog.removeEventListener('keydown', trapFocus);
      dialog.classList.add('hidden');
      dialog.classList.remove('flex');
    });

    // Form Submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      clearError(emailInput);
      clearError(consentCheckbox);
      setFeedback('', 'neutral');

      const formData = {
        email: emailInput.value,
        consent: consentCheckbox.checked ? true : undefined,
      };

      const result = validateForm(newsletterSchema, formData);

      if (!result.success && result.errors) {
        setFeedback('Veuillez corriger les champs indiqués en rouge.', 'error');
        if (result.errors.email) {
          showError(emailInput, result.errors.email);
        }
        if (result.errors.consent) {
          showError(consentCheckbox, result.errors.consent);
        }
        return;
      }

      setSuccess(emailInput);
      setSuccess(consentCheckbox);

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.setAttribute('aria-disabled', 'true');
        submitBtn.innerText = 'Inscription...';
        form.setAttribute('aria-busy', 'true');

        await new Promise((resolve) => setTimeout(resolve, 1000));

        submitBtn.innerText = 'Inscrit !';
        submitBtn.classList.add('newsletter-modal-submit--success');
        setFeedback('Inscription réussie. Merci pour votre confiance.', 'success');
        form.removeAttribute('aria-busy');

        setTimeout(() => {
          closeDialog({ reset: true });
        }, 1500);
      }
    });

    emailInput.addEventListener('input', () => {
      const emailResult = newsletterSchema.shape.email.safeParse(emailInput.value);
      if (!emailResult.success) {
        if (emailInput.dataset.validationState === 'error') {
          showError(emailInput, emailResult.error.issues[0]?.message ?? 'Veuillez entrer une adresse email valide.');
        } else {
          setFieldState(emailInput, 'default');
        }
        return;
      }

      if (emailInput.value.trim().length > 0) {
        setSuccess(emailInput);
      } else {
        clearError(emailInput);
      }
    });

    consentCheckbox.addEventListener('change', () => {
      if (consentCheckbox.checked) {
        setSuccess(consentCheckbox);
      } else if (consentCheckbox.dataset.validationState === 'error') {
        showError(consentCheckbox, 'Vous devez accepter la politique de confidentialité.');
      } else {
        clearError(consentCheckbox);
      }
    });

    window.addEventListener('pagehide', unsubscribeReducedMotion, { once: true });
  });
</script>

<style is:global>
  dialog[id^="newsletter-modal"] {
    border: 0;
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    padding: 0;
    background: transparent;
    margin: 0;
    box-sizing: border-box;
  }

  dialog[id^="newsletter-modal"]::backdrop {
    background: rgba(28, 30, 36, 0.84);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  dialog[id^="newsletter-modal"][open]::backdrop {
    opacity: 1;
  }

  dialog[id^="newsletter-modal"]:not([open]) {
    pointer-events: none;
    opacity: 0;
  }

  dialog[id^="newsletter-modal"] [data-modal-panel] {
    opacity: 0;
    transform: translateY(16px) scale(0.98);
  }

  dialog[id^="newsletter-modal"][open] [data-modal-panel] {
    animation: newsletter-modal-fade-in 0.3s ease forwards;
  }

  .newsletter-modal-panel {
    position: relative;
    width: min(100%, 756px);
    min-height: 402px;
    max-height: calc(100vh - 96px);
    display: grid;
    grid-template-columns: 317px minmax(0, 439px);
    background: #f3f0ea;
    border: 0;
    border-radius: 0;
    box-shadow: 0 24px 56px rgba(10, 18, 28, 0.28);
    overflow: hidden;
  }

  .newsletter-modal-media {
    position: relative;
    min-height: 402px;
    background: #ece6da;
  }

  .newsletter-modal-media-image {
    width: 100%;
    height: 100%;
    background: #ece6da url('/images/ateliers-physiques.jpg') 36% center / cover no-repeat;
  }

  .newsletter-modal-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 56px 44px 42px 32px;
    background: #f3f0ea;
    overflow-y: auto;
  }

  .newsletter-modal-copy {
    max-width: 322px;
  }

  .newsletter-modal-title {
    margin: 0;
    color: #162a32;
    font-family: var(--font-heading);
    font-size: clamp(3.35rem, 3.7vw, 4.3rem);
    line-height: 0.94;
    letter-spacing: -0.01em;
  }

  .newsletter-modal-description {
    margin: 20px 0 0;
    max-width: 320px;
    color: #293840;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.42;
  }

  .newsletter-modal-form {
    width: 100%;
    max-width: 366px;
    margin-top: 24px;
  }

  .newsletter-modal-field-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 133px;
    gap: 7px;
    align-items: stretch;
  }

  .newsletter-modal-field {
    min-width: 0;
  }

  .newsletter-modal-input {
    width: 100%;
    min-height: 44px;
    padding: 0 15px;
    border: 1px solid #e7e1d5;
    border-radius: 3px;
    background: #ffffff;
    color: #111111;
    font-family: var(--font-body);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .newsletter-modal-input::placeholder {
    color: #a59f95;
    opacity: 1;
  }

  .newsletter-modal-input--default:focus,
  .newsletter-modal-input:focus {
    border-color: #54b6b1;
    box-shadow: inset 0 0 0 1px #54b6b1;
  }

  .newsletter-modal-input--error {
    border-color: #c64545 !important;
    box-shadow: inset 0 0 0 1px #c64545;
  }

  .newsletter-modal-input--success {
    border-color: #2f8f57 !important;
    box-shadow: inset 0 0 0 1px #2f8f57;
  }

  .newsletter-modal-submit {
    min-height: 44px;
    border: 0;
    border-radius: 2px;
    background: #54b6b1;
    color: #ffffff !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0 18px;
    font-family: var(--font-button);
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 1;
    box-shadow: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .newsletter-modal-submit:hover {
    background: #48aba6;
  }

  .newsletter-modal-submit:active {
    transform: scale(0.98);
  }

  .newsletter-modal-submit--success {
    background: #2f8f57 !important;
  }

  .newsletter-modal-consent {
    position: relative;
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    align-items: start;
    gap: 9px;
    margin-top: 14px;
    cursor: pointer;
  }

  .newsletter-modal-checkbox-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .newsletter-modal-checkbox-box {
    width: 16px;
    height: 16px;
    margin-top: 2px;
    border: 1.5px solid #54b6b1;
    border-radius: 2px;
    background: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .newsletter-modal-checkbox-box svg {
    width: 10px;
    height: 10px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .newsletter-modal-checkbox-input:checked + .newsletter-modal-checkbox-box {
    background: #54b6b1;
    border-color: #54b6b1;
  }

  .newsletter-modal-checkbox-input:checked + .newsletter-modal-checkbox-box svg {
    opacity: 1;
  }

  .newsletter-modal-checkbox-input:focus-visible + .newsletter-modal-checkbox-box,
  .newsletter-modal-checkbox-box--default {
    box-shadow: none;
  }

  .newsletter-modal-checkbox-box--error {
    border-color: #c64545 !important;
    box-shadow: inset 0 0 0 1px #c64545;
  }

  .newsletter-modal-checkbox-box--success {
    border-color: #2f8f57 !important;
    box-shadow: inset 0 0 0 1px #2f8f57;
  }

  .newsletter-modal-consent-text {
    max-width: 322px;
    color: #3d4a51;
    font-family: var(--font-body);
    font-size: 0.73rem;
    line-height: 1.22;
  }

  .newsletter-modal-consent-text a {
    color: #54b6b1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .newsletter-modal-feedback {
    margin-top: 14px;
    font-family: var(--font-body);
    font-size: 0.86rem;
    line-height: 1.4;
  }

  .newsletter-modal-feedback--error {
    color: #c64545;
  }

  .newsletter-modal-feedback--success {
    color: #2f8f57;
  }

  .newsletter-modal-feedback--neutral {
    color: #52606a;
  }

  .newsletter-modal-error {
    display: block;
    margin-top: 8px;
    color: #c64545;
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .newsletter-modal-error--checkbox {
    grid-column: 2;
    margin-top: -4px;
  }

  .newsletter-modal-close-btn {
    position: absolute;
    top: 21px;
    right: 22px;
    z-index: 2;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: #1b2b33;
    transition: color 0.3s ease, transform 0.3s ease, opacity 0.2s ease;
  }

  .newsletter-modal-close-btn:active {
    transform: scale(0.96);
    transition-duration: 0.2s;
  }

  .newsletter-modal-close-btn:hover {
    opacity: 0.68;
  }

  dialog[id^="newsletter-modal"].flex {
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
  }

  @keyframes newsletter-modal-fade-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  dialog[id^="newsletter-modal"][data-motion='reduced']::backdrop {
    transition-duration: 0.01ms;
  }

  dialog[id^="newsletter-modal"][data-motion='reduced'] [data-modal-panel] {
    animation-duration: 0.01ms;
    transform: none;
  }

  @media (max-width: 767px) {
    .newsletter-modal-panel {
      width: min(100%, 520px);
      min-height: 0;
      max-height: calc(100vh - 32px);
      grid-template-columns: minmax(0, 1fr);
    }

    .newsletter-modal-media {
      min-height: 220px;
    }

    .newsletter-modal-content {
      padding: 34px 20px 22px;
    }

    .newsletter-modal-title {
      font-size: clamp(2.4rem, 10vw, 3.2rem);
    }

    .newsletter-modal-field-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }

    .newsletter-modal-consent {
      grid-template-columns: 18px minmax(0, 1fr);
      gap: 10px;
    }

    .newsletter-modal-close-btn {
      top: 12px;
      right: 12px;
      width: 24px;
      height: 24px;
    }

    dialog[id^="newsletter-modal"].flex {
      padding: 16px;
    }
  }
</style>

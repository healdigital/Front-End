---
import { Image } from 'astro:assets';
import Badge from '../atoms/Badge.astro';
import Button from '../atoms/Button.astro';
import Icon from '../atoms/Icon.astro';

/**
 * Props for the `MasterclassCard` organism.
 */
interface Props {
  /** Card headline shown in the content area. */
  title: string;
  /** Hero image URL or asset reference. */
  image: string;
  /** Entry price displayed in euros. */
  price: number;
  /** Bullet list of included benefits. */
  features: string[];
  /** Destination URL for the details page. */
  slug: string;
  /** Optional location badge rendered over the image. */
  location?: string;
}

const {
  title,
  image,
  price,
  features,
  slug,
  location
} = Astro.props;
---

<article class="w-full max-w-[603px] rounded-[10px] bg-white overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 flex flex-col h-full border border-gray-100 group">
  <!-- Image Header -->
  <div class="relative h-[340px] w-full">
    <Image 
      src={image} 
      alt={title} 
      width={603} 
      height={340} 
      widths={[603, 1206]}
      sizes="(max-width: 768px) 100vw, 603px"
      className="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    
    <!-- Badges -->
    <div class="absolute top-4 left-4 flex flex-col gap-2 items-start">
      <Badge variant="premium" icon="star">RÉSERVÉ PREMIUM</Badge>
      {location && (
        <Badge variant="category" icon="map-pin" class="bg-white/90 text-text-primary backdrop-blur-md border-transparent">
          {location}
        </Badge>
      )}
    </div>
  </div>

  <!-- Content -->
  <div class="p-8 flex flex-col flex-grow">
    <h3 class="text-4xl font-heading text-text-primary mb-6">
        <a href={slug} class="hover:text-status-premium transition-colors">
            {title}
        </a>
    </h3>

    <ul class="space-y-3 mb-8 flex-grow">
      {features.map(feature => (
        <li class="flex items-center gap-3 text-text-secondary">
          <div class="w-5 h-5 flex items-center justify-center rounded-full bg-status-premium/10 text-status-premium">
             <Icon name="check" size="sm" />
          </div>
          <span class="font-body font-medium text-md">{feature}</span>
        </li>
      ))}
    </ul>

    <div class="flex items-center justify-between pt-6 border-t border-gray-100 mt-auto">
      <div class="flex flex-col">
        <span class="font-mono text-sm text-text-secondary">À partir de</span>
        <span class="text-5xl font-heading text-text-primary">{price}€</span>
      </div>
      <Button 
        href={slug} 
        class="bg-[#BBA86B] hover:bg-[#A89558] !text-black border-none px-8"
      >
        DEVENIR PREMIUM
      </Button>
    </div>
  </div>
</article>

---
interface Props {
  initialCount?: number;
  batchSize?: number;
  gridClass?: string;
  ariaLabel: string;
  totalCount?: number;
  endpoint?: string;
  nextPage?: number | null;
}

const {
  initialCount = 30,
  batchSize = 24,
  gridClass = '',
  ariaLabel,
  totalCount = 0,
  endpoint = '',
  nextPage = null,
} = Astro.props;
---

<div
  class="infinite-grid-root"
  data-infinite-grid-root
  data-initial-count={initialCount}
  data-batch-size={batchSize}
  data-total-count={totalCount}
  data-endpoint={endpoint}
  data-next-page={nextPage ?? ''}
>
  <p class="infinite-grid-counter" data-infinite-grid-counter aria-live="polite">
    {Math.min(initialCount, totalCount)} / {totalCount} recettes affichées
  </p>

  <div class:list={['infinite-grid', gridClass]} data-infinite-grid aria-label={ariaLabel}>
    <slot />
  </div>

  <div class="infinite-grid-sentinel" data-infinite-grid-sentinel aria-hidden="true"></div>

  <div class="infinite-grid-loading hidden" data-infinite-grid-loading aria-live="polite">
    <span class="infinite-grid-spinner" aria-hidden="true"></span>
    <span>Chargement des recettes...</span>
  </div>

  <button
    type="button"
    class="infinite-grid-top hidden"
    data-infinite-grid-top
    aria-label="Haut de page"
    title="Haut de page"
  >
    <span aria-hidden="true">↑</span>
  </button>
</div>

<script>
  const setupInfiniteGrids = () => {
    const roots = Array.from(document.querySelectorAll('[data-infinite-grid-root]'));

    roots.forEach((root) => {
      if (!(root instanceof HTMLElement)) return;
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const grid = root.querySelector('[data-infinite-grid]');
      const sentinel = root.querySelector('[data-infinite-grid-sentinel]');
      const loading = root.querySelector('[data-infinite-grid-loading]');
      const counter = root.querySelector('[data-infinite-grid-counter]');
      const topButton = root.querySelector('[data-infinite-grid-top]');

      if (!(grid instanceof HTMLElement) || !(sentinel instanceof HTMLElement)) return;

      const cards = Array.from(
        grid.querySelectorAll('.lcdb-archive-recipe-card'),
      ).filter((item): item is HTMLElement => item instanceof HTMLElement);
      const initialCount = Number(root.dataset.initialCount || '30');
      const batchSize = Number(root.dataset.batchSize || '24');
      const totalCount = Number(root.dataset.totalCount || String(cards.length)) || cards.length;
      const endpoint = String(root.dataset.endpoint || '').trim();
      const hasRemoteSource = endpoint.length > 0;
      let nextPage = Number(root.dataset.nextPage || '');
      if (!Number.isFinite(nextPage) || nextPage <= 0) nextPage = null;
      let remoteHasMore = hasRemoteSource && nextPage !== null;
      let visibleCount = Math.min(initialCount, cards.length);
      let observer = null;
      let remoteLoading = false;
      const normalizeLanguageCode = (value) => {
        const raw = String(value || '').trim().toLowerCase();
        if (raw === 'pt' || raw === 'pt_br' || raw === 'ptbr' || raw === 'pt-pt') return 'pt-br';
        return ['fr', 'en', 'es', 'pt-br', 'ar'].includes(raw) ? raw : 'fr';
      };
      const getPreferredLanguage = () => {
        let stored = '';
        try {
          stored = String(localStorage.getItem('preferred-language') || '');
        } catch {
          stored = '';
        }
        const rootLang = document.documentElement.getAttribute('data-lang') || document.documentElement.lang || '';
        return normalizeLanguageCode(stored || rootLang || 'fr');
      };

      const escapeHtml = (value) =>
        String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');

      const buildCardHtml = (card) => {
        const href = escapeHtml(card?.href || '#');
        const title = escapeHtml(card?.title || 'Recette');
        const image = String(card?.image || '').trim();
        const imageFallback = escapeHtml(card?.imageFallback || image);
        const candidates = Array.isArray(card?.imageFallbackCandidates)
          ? card.imageFallbackCandidates.map((item) => String(item || '').trim()).filter(Boolean)
          : [];
        const candidateAttr = escapeHtml(candidates.join('|'));
        const prepTime = escapeHtml(card?.prepTime || '--');
        const excerpt = escapeHtml(card?.excerpt || '');

        const media = image
          ? `<img src="${escapeHtml(image)}" alt="${title}" class="lcdb-archive-recipe-card__image lcdb-archive-recipe-card__image--square w-full h-full object-center bg-[#FAF8F2] transition-transform duration-500 group-hover:scale-105 object-cover" loading="lazy" fetchpriority="low" decoding="async" width="500" height="643" data-fallback-src="${imageFallback}" data-fallback-candidates="${candidateAttr}" onerror="const current=this.currentSrc||this.src; const list=(this.dataset.fallbackCandidates||'').split('|').map((item)=>item.trim()).filter((item)=>item && item!==current); const next=list.shift() || this.dataset.fallbackSrc; this.dataset.fallbackCandidates=list.join('|'); if (next && next!==current) this.src=next;">`
          : `<div class="lcdb-archive-recipe-card__image lcdb-archive-recipe-card__image--square w-full h-full bg-[#ece5d8] flex items-center justify-center text-[#7a7569] text-sm">Image indisponible</div>`;

        return `<article class="group lcdb-archive-recipe-card flex h-full w-full flex-col rounded-[10px] bg-[#FAF8F2] overflow-hidden border border-[#D8D2C2] transition-all duration-300 hover:shadow-lg infinite-grid-card--revealed"><div class="lcdb-archive-recipe-card__media lcdb-archive-recipe-card__media--square relative w-full overflow-hidden aspect-square">${media}</div><div class="flex flex-1 flex-col gap-3 px-5 pb-5 pt-4 archive-card-content"><h3 class="font-heading text-[22px] leading-[1.08] text-[#111111] line-clamp-3"><a href="${href}" class="no-underline hover:text-primary-turquoise transition-colors">${title}</a></h3><div class="flex items-center justify-between text-[13px] text-text-secondary uppercase tracking-[0.14em] typ-meta border-t border-[#D8D2C2] border-b-0 pt-3 pb-0 mb-0"><div class="flex items-center gap-2"><span data-recipe-meta-time>${prepTime}</span></div></div>${excerpt ? `<p class="flex-1 text-text-secondary font-body text-[16px] leading-[1.7] typ-body line-clamp-4">${excerpt}</p>` : ''}</div></article>`;
      };

      const fetchRemoteBatch = async () => {
        if (!hasRemoteSource || !remoteHasMore || remoteLoading || !nextPage) return false;
        remoteLoading = true;
        if (loading instanceof HTMLElement) loading.classList.remove('hidden');
        let appendedNodes = [];
        try {
          const url = new URL(endpoint, window.location.origin);
          url.searchParams.set('page', String(nextPage));
          url.searchParams.set('size', String(batchSize));
          url.searchParams.set('lang', getPreferredLanguage());
          const response = await fetch(url.toString(), { method: 'GET', credentials: 'same-origin' });
          if (!response.ok) return false;
          const payload = await response.json();
          const incoming = Array.isArray(payload?.cards) ? payload.cards : [];
          incoming.forEach((card) => {
            const wrapper = document.createElement('div');
            wrapper.innerHTML = buildCardHtml(card);
            const node = wrapper.firstElementChild;
            if (node instanceof HTMLElement) {
              grid.appendChild(node);
              cards.push(node);
              appendedNodes.push(node);
            }
          });
          if (appendedNodes.length) {
            window.dispatchEvent(
              new CustomEvent('lcdb:content-added', {
                detail: { roots: appendedNodes },
              }),
            );
          }
          nextPage = Number(payload?.nextPage || '');
          if (!Number.isFinite(nextPage) || nextPage <= 0) nextPage = null;
          remoteHasMore = Boolean(payload?.hasMore) && nextPage !== null;
          return incoming.length > 0;
        } catch {
          return false;
        } finally {
          remoteLoading = false;
        }
      };

      const updateCounter = () => {
        if (!(counter instanceof HTMLElement)) return;
        counter.textContent =
          visibleCount >= totalCount
            ? `${totalCount} recettes affichées`
            : `${visibleCount} / ${totalCount} recettes affichées`;
      };

      const positionSentinel = () => {
        const lastVisible = cards[Math.max(0, visibleCount - 1)];
        if (!lastVisible) return;
        lastVisible.insertAdjacentElement('afterend', sentinel);
      };

      const updateTopButton = () => {
        if (!(topButton instanceof HTMLButtonElement)) return;
        const shouldShow = window.scrollY > window.innerHeight * 2;
        topButton.classList.toggle('hidden', !shouldShow);
      };

      const revealNextBatch = async () => {
        if (visibleCount >= cards.length && remoteHasMore) {
          const added = await fetchRemoteBatch();
          if (added) positionSentinel();
        }

        if (visibleCount >= cards.length) {
          if (!remoteHasMore && observer) observer.disconnect();
          if (loading instanceof HTMLElement && !remoteHasMore) loading.classList.add('hidden');
          updateCounter();
          return;
        }

        if (loading instanceof HTMLElement) loading.classList.remove('hidden');

        const nextVisible = Math.min(visibleCount + batchSize, cards.length);
        const nextCards = cards.slice(visibleCount, nextVisible);

        nextCards.forEach((card, index) => {
          card.removeAttribute('data-hidden');
          card.classList.add('infinite-grid-card--revealed');
          card.style.animationDelay = `${index * 40}ms`;
        });

        visibleCount = nextVisible;
        positionSentinel();
        updateCounter();

        if (loading instanceof HTMLElement) {
          loading.classList.toggle('hidden', visibleCount >= cards.length);
        }

        if (visibleCount >= cards.length && !remoteHasMore && observer) {
          observer.disconnect();
        }
      };

      cards.forEach((card, index) => {
        if (!(card instanceof HTMLElement)) return;
        card.dataset.infiniteCard = 'true';
        if (index >= visibleCount) {
          card.setAttribute('data-hidden', 'true');
        }
      });

      updateCounter();
      positionSentinel();
      updateTopButton();

      observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) void revealNextBatch();
          });
        },
        {
          rootMargin: '0px 0px 300px 0px',
          threshold: 0,
        },
      );

      observer.observe(sentinel);

      const shouldRevealFromViewport = () => {
        const rect = sentinel.getBoundingClientRect();
        return rect.top <= window.innerHeight + 320;
      };

      const onWindowScroll = () => {
        updateTopButton();
        if (shouldRevealFromViewport()) void revealNextBatch();
      };

      topButton?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      window.addEventListener('scroll', onWindowScroll, { passive: true });
      window.addEventListener('resize', onWindowScroll, { passive: true });
      onWindowScroll();
    });
  };

  setupInfiniteGrids();
  document.addEventListener('astro:page-load', setupInfiniteGrids);
</script>

<style is:global>
  [data-infinite-card][data-hidden='true'] {
    display: none !important;
  }

  .infinite-grid-sentinel {
    width: 100%;
    height: 1px;
    grid-column: 1 / -1;
    pointer-events: none;
  }

  .infinite-grid-counter {
    margin: 0 0 1rem;
    color: #787161;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .infinite-grid-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    margin: 1.25rem 0 0;
    padding: 0.95rem 1.1rem;
    border: 1px solid rgba(84, 182, 177, 0.25);
    border-radius: 12px;
    background: #f7f5ef;
    color: #4f4a40;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .infinite-grid-spinner {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    border: 3px solid rgba(84, 182, 177, 0.25);
    border-top-color: #54b6b1;
    animation: lcdb-spin 0.8s linear infinite;
  }

  .infinite-grid-top {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 30;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #54b6b1;
    color: #faf8f2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.55rem;
    line-height: 1;
    box-shadow: 0 14px 32px rgba(17, 25, 39, 0.18);
  }

  .infinite-grid-card--revealed {
    animation: lcdb-fade-in 0.3s ease both;
  }

  @keyframes lcdb-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes lcdb-fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

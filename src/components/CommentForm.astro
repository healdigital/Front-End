---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="comment-section">
  <h2>Laisser un commentaire et une note</h2>

  <form id="comment-form" class="comment-form" method="post" novalidate>
    <div class="form-group">
      <label for="author">Votre nom *</label>
      <input
        type="text"
        id="author"
        name="author"
        required
        minlength="2"
        maxlength="50"
        placeholder="Votre nom"
        autocomplete="name"
      />
    </div>

    <div class="form-group">
      <label for="email">Votre email *</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder="vous@email.com"
        autocomplete="email"
      />
    </div>

    <div class="form-group">
      <label id="rating-group-label">Note *</label>
      <div class="rating-input">
        <input type="hidden" id="rating" name="rating" value="5" required />
        <div class="stars" role="group" aria-labelledby="rating-group-label">
          {[1, 2, 3, 4, 5].map((star) => (
            <button
              type="button"
              class={`star star-${star}`}
              data-rating={star}
              title={`${star} sur 5`}
              aria-label={`${star} étoile${star > 1 ? 's' : ''} sur 5`}
              aria-pressed={star === 5 ? 'true' : 'false'}
            >
              <span aria-hidden="true">&#9733;</span>
            </button>
          ))}
        </div>
        <span id="rating-text" role="status" aria-live="polite">Excellent (5/5)</span>
      </div>
    </div>

    <div class="form-group">
      <label for="text">Votre commentaire *</label>
      <textarea
        id="text"
        name="text"
        required
        minlength="3"
        maxlength="1000"
        rows="5"
        placeholder="Partagez votre avis sur cette recette..."
        aria-describedby="char-count"
      ></textarea>
      <small id="char-count" role="status" aria-live="polite">0 / 1000 caractères</small>
    </div>

    <div id="form-message" class="form-message" role="status" aria-live="polite"></div>

    <button type="submit" class="submit-btn" aria-busy="false">
      Publier le commentaire et la note
    </button>
  </form>
</div>

<style>
  .comment-section {
    background: linear-gradient(135deg, #f8f9fa 0%, #f0f4f8 100%);
    padding: 2rem;
    border-radius: 0.75rem;
    margin: 2rem 0;
    border: 2px solid #e5e7eb;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .comment-section h2 {
    margin-top: 0;
    color: #1a2335;
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
    font-weight: 700;
  }

  .comment-form {
    max-width: 600px;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 700;
    color: #2d3748;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
  }

  .form-group input[type='text'],
  .form-group input[type='email'],
  .form-group textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 2px solid #e5e7eb;
    border-radius: 0.5rem;
    font-family: inherit;
    font-size: 0.95rem;
    background-color: #ffffff;
    color: #1f2937;
    transition: all 0.3s ease;
  }

  .form-group input[type='text']:focus,
  .form-group input[type='email']:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #54b6b1;
    background-color: #f8fffe;
    box-shadow: 0 0 0 4px rgba(84, 182, 177, 0.15);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
    box-sizing: border-box;
  }

  #char-count {
    display: block;
    margin-top: 0.5rem;
    color: #5b5b5b;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .rating-input {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background-color: #fef8ff;
    border-radius: 0.5rem;
    border: 2px solid #f3e8ff;
  }

  .stars {
    display: flex;
    gap: 0.25rem;
  }

  .star {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 2rem;
    color: #d1d5db;
    transition: all 0.2s ease;
    padding: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
  }

  .star:hover,
  .star:focus-visible {
    color: #fbbf24;
    transform: scale(1.08);
    outline: none;
    box-shadow: 0 0 0 3px rgba(84, 182, 177, 0.25);
  }

  .star.active {
    color: #fbbf24;
    text-shadow: 0 0 8px rgba(251, 191, 36, 0.5);
  }

  #rating-text {
    font-weight: 700;
    color: #5b5b5b;
    min-width: 140px;
    font-size: 0.95rem;
  }

  .submit-btn {
    background: #54b6b1;
    color: white;
    padding: 0.95rem 2.5rem;
    border: none;
    border-radius: 0.5rem;
    font-weight: 700;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .submit-btn:hover {
    background: #3aa8a2;
  }

  .submit-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .submit-btn.is-loading {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .submit-btn-spinner {
    width: 1rem;
    height: 1rem;
    border: 2px solid rgba(255, 255, 255, 0.45);
    border-top-color: #ffffff;
    border-radius: 999px;
    animation: comment-submit-spin 0.8s linear infinite;
  }

  .form-message {
    margin-bottom: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    display: none;
    font-weight: 600;
    border-left: 4px solid transparent;
  }

  .form-message.error {
    background: linear-gradient(135deg, #fef2f2 0%, #fde8e8 100%);
    color: #991b1b;
    border: 2px solid #fecaca;
    border-left-color: #dc2626;
    display: block;
  }

  .form-message.success {
    background: linear-gradient(135deg, #f0fdf4 0%, #e8f8f0 100%);
    color: #166534;
    border: 2px solid #bbf7d0;
    border-left-color: #16a34a;
    display: block;
  }

  @keyframes comment-submit-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script define:vars={{ slug }}>
  const form = document.getElementById('comment-form');
  const messageDiv = document.getElementById('form-message');
  const ratingInput = document.getElementById('rating');
  const ratingText = document.getElementById('rating-text');
  const charCount = document.getElementById('char-count');
  const textArea = document.getElementById('text');
  const submitBtn = form?.querySelector('.submit-btn');

  setTimeout(() => {
    if (!form || !textArea || !ratingInput || !ratingText || !submitBtn || !messageDiv || !charCount) {
      return;
    }

    const stars = Array.from(document.querySelectorAll('.star'));
    const ratingLabels = {
      1: 'Faible (1/5)',
      2: 'Moyen (2/5)',
      3: 'Bien (3/5)',
      4: 'Très bien (4/5)',
      5: 'Excellent (5/5)',
    };

    const syncStars = (rating) => {
      stars.forEach((star) => {
        const starValue = Number(star.dataset.rating || 0);
        const isActive = starValue <= rating;
        star.classList.toggle('active', isActive);
        star.setAttribute('aria-pressed', String(starValue === rating));
      });
      ratingText.textContent = ratingLabels[rating] || ratingLabels[5];
      ratingInput.value = String(rating);
    };

    stars.forEach((star) => {
      star.addEventListener('click', () => {
        syncStars(Number(star.dataset.rating || 5));
      });

      star.addEventListener('keydown', (event) => {
        const current = Number(ratingInput.value || 5);
        if (event.key === 'ArrowRight' || event.key === 'ArrowUp') {
          event.preventDefault();
          syncStars(Math.min(5, current + 1));
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowDown') {
          event.preventDefault();
          syncStars(Math.max(1, current - 1));
        } else if (event.key === 'Home') {
          event.preventDefault();
          syncStars(1);
        } else if (event.key === 'End') {
          event.preventDefault();
          syncStars(5);
        } else if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          syncStars(Number(star.dataset.rating || 5));
        }
      });
    });

    textArea.addEventListener(
      'input',
      (event) => {
        const target = event.target;
        const count = target instanceof HTMLTextAreaElement ? target.value.length : 0;
        charCount.textContent = `${count} / 1000 caractères`;
      },
      true,
    );

    syncStars(5);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const authorInput = document.getElementById('author');
      const emailInput = document.getElementById('email');
      const author = authorInput instanceof HTMLInputElement ? authorInput.value : '';
      const email = emailInput instanceof HTMLInputElement ? emailInput.value : '';
      const text = textArea instanceof HTMLTextAreaElement ? textArea.value : '';
      const rating = ratingInput instanceof HTMLInputElement ? ratingInput.value : '5';

      messageDiv.textContent = '';
      messageDiv.className = 'form-message';

      submitBtn.disabled = true;
      submitBtn.setAttribute('aria-busy', 'true');
      submitBtn.classList.add('is-loading');
      submitBtn.innerHTML =
        '<span class="submit-btn-spinner" aria-hidden="true"></span><span>Publication...</span>';

      try {
        const response = await fetch('/api/comments', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            slug,
            author,
            email,
            text,
            rating: parseInt(rating, 10),
          }),
        });

        const data = await response.json();

        if (response.ok) {
          messageDiv.className = 'form-message success';
          messageDiv.textContent =
            'Merci. Votre commentaire a bien été envoyé et apparaîtra après modération.';

          form.reset();
          charCount.textContent = '0 / 1000 caractères';
          syncStars(5);
        } else {
          messageDiv.className = 'form-message error';
          messageDiv.textContent = `Erreur : ${data.error || 'Impossible de publier le commentaire.'}`;
        }
      } catch (error) {
        console.error('Error submitting comment:', error);
        messageDiv.className = 'form-message error';
        messageDiv.textContent = 'Erreur : impossible d’envoyer le commentaire pour le moment.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.setAttribute('aria-busy', 'false');
        submitBtn.classList.remove('is-loading');
        submitBtn.textContent = 'Publier le commentaire et la note';
      }
    });
  }, 100);
</script>

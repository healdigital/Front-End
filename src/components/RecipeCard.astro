---
interface Props {
  title: string;
  slug: string;
  image: string;
  excerpt: string;
  prepTime?: number;
  cookTime?: number;
  servings?: number;
  rating?: number;
  ratingCount?: number;
  featured?: boolean;
}

const {
  title,
  slug,
  image,
  excerpt,
  prepTime = 0,
  cookTime = 0,
  servings = 4,
  rating = 0,
  ratingCount = 0,
  featured = false,
} = Astro.props;

const recipeUrl = `/${slug}/`;

const renderStars = (rate: number) => {
  const stars = [];
  for (let i = 1; i <= 5; i++) {
    stars.push(i <= Math.floor(rate) ? '★' : '☆');
  }
  return stars.join('');
};
---

<a href={recipeUrl} class={`recipe-card ${featured ? 'featured' : ''}`} aria-label={`Lire la recette : ${title}`}>
  <div class="recipe-card-image">
    <img
      src={image}
      alt={title}
      loading="lazy"
      decoding="async"
      width="400"
      height="500"
      sizes="(min-width: 1280px) 22vw, (min-width: 768px) 30vw, 92vw"
    />
    {featured && <div class="featured-badge">À la une</div>}
  </div>

  <div class="recipe-card-content">
    <h3 class="recipe-card-title">{title}</h3>

    <p class="recipe-card-excerpt">{excerpt}</p>

    <div class="recipe-card-meta">
      {prepTime > 0 && (
        <div class="meta-item">
          <span class="icon" aria-hidden="true">⏱</span>
          <span>{prepTime} min préparation</span>
        </div>
      )}

      {cookTime > 0 && (
        <div class="meta-item">
          <span class="icon" aria-hidden="true">🔥</span>
          <span>{cookTime} min cuisson</span>
        </div>
      )}

      <div class="meta-item">
        <span class="icon" aria-hidden="true">🍽</span>
        <span>{servings} portions</span>
      </div>
    </div>

    {rating > 0 && (
      <div class="recipe-card-rating" aria-label={`Note moyenne : ${rating.toFixed(1)} sur 5`}>
        <span class="stars" aria-hidden="true">{renderStars(rating)}</span>
        <span class="rating-count">({ratingCount})</span>
      </div>
    )}
  </div>
</a>

<style>
  .recipe-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--lcdb-surface);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    box-shadow: 0 16px 40px rgba(6, 18, 40, 0.08);
    border: 1px solid var(--lcdb-border);
  }

  .recipe-card:hover,
  .recipe-card:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 20px 48px rgba(6, 18, 40, 0.12);
    border-color: rgba(84, 182, 177, 0.45);
    outline: none;
  }

  .recipe-card.featured {
    border-color: rgba(84, 182, 177, 0.55);
  }

  .recipe-card-image {
    position: relative;
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: var(--lcdb-surface);
  }

  .recipe-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .recipe-card:hover .recipe-card-image img {
    transform: scale(1.05);
  }

  .featured-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--lcdb-accent);
    color: #faf8f2;
    padding: 0.45rem 0.9rem;
    border-radius: 6px;
    font-size: 0.72rem;
    font-family: var(--font-button);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .recipe-card-content {
    flex: 1;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .recipe-card-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.9rem;
    font-weight: 400;
    line-height: 1.05;
    color: var(--lcdb-heading);
  }

  .recipe-card-excerpt {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--lcdb-copy);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .recipe-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(216, 210, 194, 0.72);
    font-size: 0.78rem;
    color: var(--lcdb-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .meta-item .icon {
    font-size: 1rem;
  }

  .recipe-card-rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .stars {
    color: #d6aa35;
    letter-spacing: 2px;
  }

  .rating-count {
    color: var(--lcdb-muted);
  }

  @media (max-width: 768px) {
    .recipe-card-image {
      height: 160px;
    }

    .recipe-card-content {
      padding: 1rem;
      gap: 0.75rem;
    }

    .recipe-card-title {
      font-size: 1.45rem;
    }

    .recipe-card-excerpt {
      font-size: 0.95rem;
    }

    .recipe-card-meta {
      gap: 0.75rem;
    }
  }
</style>

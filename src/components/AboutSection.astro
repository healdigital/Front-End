---
const welcomeText =
  "Voyageur et passionné de cuisine, Bernard partage ici une cuisine généreuse, précise et profondément ancrée dans les traditions. Des recettes familiales aux découvertes glanées partout dans le monde, chaque publication vise à transmettre des gestes clairs et fiables.";

const books = [
  { image: "/images/book-vege-terrien.jpeg", url: "https://www.amazon.fr/gp/product/2081414988/ref=as_li_tl?ie=UTF8&camp=1642&creative=6746&creativeASIN=2081414988&linkCode=as2&tag=lacuisidebern-21&linkId=719ca79e49e810d99cb31199bb21405d" },
  { image: "/images/book-2.jpg", url: "https://www.amazon.fr/gp/product/2081414988/ref=as_li_tl?ie=UTF8&camp=1642&creative=6746&creativeASIN=2081414988&linkCode=as2&tag=lacuisidebern-21&linkId=719ca79e49e810d99cb31199bb21405d" },
  { image: "/images/book-3.png", url: "https://www.amazon.fr/Je-nen-ferai-quune-bouch%C3%A9e/dp/2081386011?ie=UTF8&camp=1642&creativeASIN=2081386011&linkCode=xm2&redirect=true&tag=lacuisidebern-21" },
  { image: "/images/book-4.jpg", url: "https://www.amazon.fr/dp/2081314290?tag=lacuisidebern-21&camp=2910&creative=19482&linkCode=as4&creativeASIN=2081314290&adid=1HMR2DYG7WSG2NANSAQG&&ref-refURL=http%3A%2F%2Fbernardl11.sg-host.com%2F" },
  { image: "/images/book-5.jpg", url: "https://www.amazon.fr/gp/product/2081416352/ref=as_li_tl?ie=UTF8&tag=lacuisidebern-21&camp=1642&creative=6746&linkCode=as2&creativeASIN=2081416352&linkId=f6c32b99905d32e830a53930d6340f88" },
  { image: "/images/book-1.png", url: "https://lacuisinedebernard.com/produit/je-fais-mon-chocolat-maison/" },
  { image: "/images/book-6.jpg", url: "https://www.amazon.fr/gp/product/2080231510/ref=as_li_qf_asin_il_tl?ie=UTF8&tag=lacuisidebern-21&creative=6746&linkCode=as2&creativeASIN=2080231510&linkId=4306a903ba047e2436550805f2f42efd" },
];
---

<section class="border-t border-border-primary bg-secondary-cream/35 py-16">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 sm:px-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.05fr)_minmax(280px,0.85fr)] lg:px-8">
    <article class="rounded-[14px] border border-border-primary bg-primary-white p-6 shadow-[0_12px_30px_rgba(17,17,17,0.05)]">
      <div class="overflow-hidden rounded-[12px] bg-secondary-beige-light">
        <img
          src="/images/bernard-blog.png"
          alt="Bernard Laurance"
          class="h-[320px] w-full object-cover"
          loading="lazy"
          decoding="async"
          width="640"
          height="760"
          sizes="(min-width: 1024px) 26vw, 92vw"
        />
      </div>
      <p class="mt-5 text-[13px] uppercase tracking-[0.14em] text-text-tertiary">À propos</p>
      <h3 class="mt-2 font-heading text-[34px] leading-none text-text-primary">Bernard Laurance</h3>
      <p class="mt-4 text-[16px] leading-[1.7] text-text-secondary">{welcomeText}</p>
      <a
        href="/a-propos/"
        class="mt-6 inline-flex items-center text-[13px] font-medium uppercase tracking-[0.08em] text-primary-turquoise underline underline-offset-4 transition-colors duration-200 hover:text-[#137f74]"
      >
        En savoir plus
      </a>
    </article>

    <article class="rounded-[14px] border border-border-primary bg-primary-white p-6 shadow-[0_12px_30px_rgba(17,17,17,0.05)]">
      <p class="text-[13px] uppercase tracking-[0.14em] text-text-tertiary">Les livres</p>
      <h3 class="mt-2 font-heading text-[34px] leading-none text-text-primary">Découvrir les ouvrages</h3>
      <p class="mt-4 text-[16px] leading-[1.7] text-text-secondary">
        Une sélection de livres publiés chez Flammarion, Solar et d'autres maisons pour prolonger l'expérience à la maison.
      </p>

      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
        {books.map((book, index) => (
          <a
            href={book.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group overflow-hidden rounded-[10px] border border-border-primary bg-secondary-beige-light transition-transform duration-200 hover:-translate-y-[2px]"
            aria-label={`Voir le livre ${index + 1}`}
          >
            <img
              src={book.image}
              alt={`Livre ${index + 1}`}
              class="h-[172px] w-full object-cover transition-opacity duration-200 group-hover:opacity-90"
              loading="lazy"
              decoding="async"
              width="420"
              height="540"
              sizes="(min-width: 1024px) 14vw, (min-width: 640px) 22vw, 42vw"
            />
          </a>
        ))}
      </div>
    </article>

    <aside class="rounded-[14px] border border-border-primary bg-primary-white p-6 shadow-[0_12px_30px_rgba(17,17,17,0.05)]">
      <p class="text-[13px] uppercase tracking-[0.14em] text-text-tertiary">Communauté</p>
      <h3 class="mt-2 font-heading text-[34px] leading-none text-text-primary">Suivre Bernard</h3>
      <p class="mt-4 text-[16px] leading-[1.7] text-text-secondary">
        Retrouvez les actualités, les publications et les nouveautés directement sur la page Facebook.
      </p>
      <div class="mt-6 overflow-hidden rounded-[12px] border border-border-primary bg-secondary-beige-light">
        <iframe
          src="https://www.facebook.com/v9.0/plugins/page.php?adapt_container_width=true&app_id=&channel=https%3A%2F%2Fstaticxx.facebook.com%2Fx%2Fconnect%2Fxd_arbiter%2F%3Fversion%3D46%23cb%3Dfe77393b8306eb300%26domain%3Dlacuisinedebernard.com%26is_canvas%3Dfalse%26origin%3Dhttps%253A%252F%252Flacuisinedebernard.com%252Ff78c1a27da79a4709%26relation%3Dparent.parent&container_width=291&hide_cover=false&href=https%3A%2F%2Fwww.facebook.com%2Flacuisinedebernard%2F&locale=fr_FR&sdk=joey&show_facepile=true&show_posts=false&small_header=false"
          title="Page Facebook La Cuisine de Bernard"
          width="100%"
          height="420"
          style="border:none;overflow:hidden"
          scrolling="no"
          frameborder="0"
          allowfullscreen="true"
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
          loading="lazy"
        ></iframe>
      </div>
    </aside>
  </div>
</section>

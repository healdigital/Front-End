---
interface Props {
  title: string;
  subtitle?: string;
  className?: string;
  navLinks?: Array<{
    label: string;
    href?: string;
    description?: string;
    active?: boolean;
  }>;
}

const { title, subtitle, className = '', navLinks = [] } = Astro.props;
---

<section class:list={['static-page', className]}>
  <div class="lcdb-page-hero">
    <div class="lcdb-page-shell lcdb-page-hero-inner">
      <p class="lcdb-page-eyebrow typ-caption">Page</p>
      <h1 class="lcdb-page-title typ-h2">{title}</h1>
      {subtitle && <p class="lcdb-page-description typ-body">{subtitle}</p>}
    </div>
  </div>

  <div class="lcdb-page-section">
    <div class="lcdb-page-shell lcdb-page-section-inner">
      {navLinks.length > 0 && (
        <nav class="static-page-nav" aria-label="Page navigation">
          {navLinks.map((link) =>
            link.active ? (
              <div class="static-page-nav-card is-active" aria-current="page">
                <p class="static-page-nav-label">{link.label}</p>
                {link.description && <p class="static-page-nav-description">{link.description}</p>}
              </div>
            ) : (
              <a href={link.href} class="static-page-nav-card">
                <p class="static-page-nav-label">{link.label}</p>
                {link.description && <p class="static-page-nav-description">{link.description}</p>}
              </a>
            )
          )}
        </nav>
      )}

      <article class="lcdb-surface-card static-page-body">
        <div class="static-page-content">
          <slot />
        </div>
      </article>
    </div>
  </div>
</section>

<style is:global>
  .static-page .static-page-body {
    padding: 26px;
  }

  .static-page .lcdb-page-section-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .static-page .static-page-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem;
  }

  .static-page .static-page-nav-card {
    display: block;
    min-width: 0;
    border: 1px solid #d8d2c2;
    border-radius: 16px;
    background-color: #ffffff;
    box-shadow: 0 16px 36px rgba(17, 25, 39, 0.07);
    padding: 1rem 1.05rem;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      border-color 160ms ease;
  }

  .static-page .static-page-nav-card:hover {
    transform: translateY(-2px);
    border-color: #2ec4b6;
    box-shadow: 0 18px 40px rgba(17, 25, 39, 0.11);
  }

  .static-page .static-page-nav-card.is-active {
    border-color: #2ec4b6;
    background-color: #ffffff;
    box-shadow: 0 18px 40px rgba(46, 196, 182, 0.1);
  }

  .static-page .static-page-nav-label {
    margin: 0;
    color: #1a2335;
    font-family: var(--font-heading);
    font-size: 1.08rem;
    line-height: 1.18;
  }

  .static-page .static-page-nav-description {
    margin: 0.42rem 0 0;
    color: #6b7280;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .static-page .static-page-content {
    color: #5b5b5b;
    font-family: var(--font-maison);
    font-size: 16px;
    line-height: 1.72;
  }

  .static-page .static-page-content h2,
  .static-page .static-page-content h3,
  .static-page .static-page-content h4 {
    margin-top: 2rem;
    margin-bottom: 0.8rem;
    color: #111111;
    font-family: var(--font-heading);
    line-height: 1.15;
  }

  .static-page .static-page-content h2 {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
  }

  .static-page .static-page-content h3 {
    font-size: clamp(1.45rem, 2.3vw, 1.95rem);
  }

  .static-page .static-page-content p {
    margin: 1rem 0;
  }

  .static-page .static-page-content .wpb-content-wrapper {
    max-width: 100%;
  }

  .static-page.menu-page .static-page-body {
    padding: clamp(18px, 3vw, 34px);
  }

  .static-page.menu-page .static-page-content,
  .static-page.menu-page .static-page-content > *,
  .static-page.menu-page .static-page-content .wp-content,
  .static-page.menu-page .static-page-content .wpb-content-wrapper,
  .static-page.menu-page .static-page-content .home-featured-cat-wrapper,
  .static-page.menu-page .static-page-content .home-featured-cat-content {
    min-width: 0;
    max-width: 100%;
  }

  .static-page.menu-page .static-page-content .wpb-content-wrapper,
  .static-page.menu-page .static-page-content .wp-content {
    overflow-x: clip;
  }

  .static-page.menu-page .static-page-content p:empty,
  .static-page.menu-page .static-page-content div:empty,
  .static-page.menu-page .static-page-content ul:empty {
    display: none;
  }

  .static-page.menu-page .static-page-content .penci-homepage-title {
    display: none;
  }

  .static-page .static-page-content .penci-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .static-page .static-page-content .penci-grid .grid-style,
  .static-page .static-page-content .mag-post-box {
    background: #ffffff;
    border: 1px solid #d8d2c2;
    border-radius: 12px;
    box-shadow: 0 12px 30px rgba(14, 24, 39, 0.06);
    padding: 1rem;
  }

  .static-page .static-page-content .mag-post-box {
    margin-bottom: 1.2rem;
  }

  .static-page .static-page-content .penci-image-holder {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-size: cover;
    background-position: center;
    border-radius: 10px;
    margin-bottom: 0.85rem;
  }

  .static-page .static-page-content .grid-title,
  .static-page .static-page-content .magcat-title-small,
  .static-page .static-page-content .magcat-titlte {
    font-family: var(--font-maison);
    font-size: 1rem;
    line-height: 1.45;
    color: #111111;
  }

  .static-page .static-page-content .grid-header-box,
  .static-page .static-page-content .magcat-detail {
    margin-top: 0.5rem;
  }

  .static-page.menu-page .static-page-content .penci-hide-tagupdated,
  .static-page.menu-page .static-page-content .grid-post-box-meta {
    color: #8a8578;
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .static-page.menu-page .static-page-content .penci-hide-tagupdated a,
  .static-page.menu-page .static-page-content .grid-post-box-meta a {
    color: #6b7280;
    text-decoration: none;
  }

  .static-page .static-page-content img,
  .static-page .static-page-content iframe {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid #d8d2c2;
    box-shadow: 0 16px 38px rgba(14, 24, 39, 0.08);
    margin: 1.5rem auto;
  }

  .static-page .static-page-content iframe {
    width: 100%;
    min-height: 360px;
  }

  .static-page .static-page-content figure,
  .static-page .static-page-content .separator {
    margin: 1.75rem 0;
  }

  .static-page .static-page-content a {
    color: #54b6b1;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .static-page .static-page-content ul,
  .static-page .static-page-content ol {
    margin: 1.5rem 0 1.5rem 1.5rem;
  }

  .static-page .static-page-content blockquote {
    border-left: 4px solid #54b6b1;
    padding-left: 1rem;
    color: #5b5b5b;
    margin: 1.5rem 0;
    font-style: italic;
  }

  .static-page.menu-page--recipe-grid .static-page-content .penci-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .static-page.menu-page--recipe-grid .static-page-content .grid-style {
    padding: 0;
    overflow: hidden;
  }

  .static-page.menu-page--recipe-grid .static-page-content .thumbnail {
    padding: 0.85rem 0.85rem 0;
  }

  .static-page.menu-page--recipe-grid .static-page-content .penci-image-holder {
    margin-bottom: 0;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
  }

  .static-page.menu-page--recipe-grid .static-page-content .grid-header-box {
    margin-top: 0;
    padding: 0.95rem 1rem 1rem;
  }

  .static-page.menu-page--recipe-grid .static-page-content .grid-title {
    font-size: 1.08rem;
  }

  .static-page.menu-page--recipe-list .static-page-content .home-featured-cat-content.style-14 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .static-page.menu-page--recipe-list .static-page-content .mag-post-box {
    margin-bottom: 0;
    padding: 0;
    overflow: hidden;
  }

  .static-page.menu-page--recipe-list .static-page-content .mag-post-box.first-post {
    grid-column: 1 / -1;
  }

  .static-page.menu-page--recipe-list .static-page-content .mag-post-box.first-post .magcat-thumb {
    display: grid;
    grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    min-width: 0;
  }

  .static-page.menu-page--recipe-list .static-page-content .mag-post-box.first-post .penci-image-holder {
    height: 100%;
    min-height: 100%;
    aspect-ratio: auto;
    border-radius: 0;
    margin: 0;
  }

  .static-page.menu-page--recipe-list .static-page-content .mag-post-box .magcat-detail {
    margin-top: 0;
    padding: 1rem 1.1rem;
  }

  .static-page.menu-page--recipe-list .static-page-content .mag-post-box .magcat-padding {
    padding: 0;
  }

  .static-page.menu-page--recipe-list .static-page-content .magcat-title-small,
  .static-page.menu-page--recipe-list .static-page-content .magcat-titlte {
    font-size: 1.02rem;
    line-height: 1.4;
  }

  .static-page.menu-page--travel-grid .static-page-content .penci-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .static-page.menu-page--travel-grid .static-page-content .grid-style {
    padding: 0;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(247, 243, 235, 0.96));
  }

  .static-page.menu-page--travel-grid .static-page-content .thumbnail {
    padding: 0.85rem 0.85rem 0;
  }

  .static-page.menu-page--travel-grid .static-page-content .penci-image-holder {
    margin-bottom: 0;
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    position: relative;
  }

  .static-page.menu-page--travel-grid .static-page-content .grid-header-box {
    margin-top: 0;
    padding: 0.95rem 1rem 1rem;
  }

  .static-page.menu-page--travel-grid .static-page-content .grid-title {
    font-size: 1.15rem;
    line-height: 1.28;
  }

  .static-page.menu-page--travel-grid .static-page-content .penci-hide-tagupdated {
    margin-top: 0.45rem;
  }

  .static-page .travel-page-intro {
    margin: 0 0 1.25rem;
    max-width: 62ch;
    color: #5f6470;
    font-size: 1rem;
    line-height: 1.7;
  }

  .static-page.menu-page--books .static-page-content p,
  .static-page.menu-page--book-detail .static-page-content p {
    max-width: 72ch;
  }

  .static-page.menu-page--books .static-page-content .separator,
  .static-page.menu-page--book-detail .static-page-content .separator {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
    align-items: start;
  }

  .static-page.menu-page--books .static-page-content .separator a,
  .static-page.menu-page--book-detail .static-page-content .separator a {
    display: block;
  }

  .static-page.menu-page--books .static-page-content figure,
  .static-page.menu-page--book-detail .static-page-content figure {
    max-width: 100%;
  }

  .static-page.menu-page--book-detail .static-page-content iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 0;
  }

  @media (max-width: 767px) {
    .static-page .static-page-body {
      padding: 18px;
    }

    .static-page.menu-page--recipe-grid .static-page-content .penci-grid,
    .static-page.menu-page--recipe-list .static-page-content .home-featured-cat-content.style-14,
    .static-page.menu-page--travel-grid .static-page-content .penci-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .static-page.menu-page--recipe-list .static-page-content .mag-post-box.first-post .magcat-thumb {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
import SocialShare from './molecules/SocialShare.astro';
import { processArticleImageUrl } from '../utils/cdnUrlReplacer';

interface Props {
  article: {
    id: number;
    slug: string;
    title: {
      rendered: string;
    };
    excerpt: {
      rendered: string;
    };
    featured_media?: number;
    date?: string;
    featured_image_url?: string;
    author?: number;
  };
}

const { article } = Astro.props;

const articleTitle = article.title.rendered.replace(/<[^>]*>/g, '');
const rawExcerpt = article.excerpt.rendered.replace(/<[^>]*>/g, '').trim();
const plainExcerpt = rawExcerpt.length > 150 ? `${rawExcerpt.substring(0, 150)}...` : rawExcerpt;
const articleUrl = `/${article.slug}/`;
const imageSrc =
  processArticleImageUrl(article) ||
  `https://via.placeholder.com/400x300?text=${encodeURIComponent(articleTitle)}`;

const authorName = 'La Cuisine de Bernard';
const formattedDate = article.date
  ? new Date(article.date).toLocaleDateString('fr-FR', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : '';
---

<article class="overflow-hidden rounded-[10px] border border-border-primary bg-primary-white shadow-[0_6px_18px_rgba(17,17,17,0.04)] transition duration-300 hover:-translate-y-[2px] hover:shadow-[0_10px_24px_rgba(17,17,17,0.08)] focus-within:-translate-y-[2px] focus-within:shadow-[0_10px_24px_rgba(17,17,17,0.08)] focus-within:ring-2 focus-within:ring-primary-turquoise/40">
  <div class="relative h-48 overflow-hidden bg-primary-cream">
    <img
      src={imageSrc}
      alt={articleTitle}
      class="h-full w-full object-cover transition duration-300 hover:scale-[1.04]"
      loading="lazy"
      decoding="async"
      width="640"
      height="384"
      sizes="(min-width: 1280px) 28vw, (min-width: 768px) 44vw, 92vw"
    />
  </div>

  <div class="flex h-full flex-col p-6">
    <h3 class="mb-3 text-lg font-semibold text-text-primary line-clamp-2">
      <a
        href={articleUrl}
        class="rounded-sm transition duration-200 hover:text-primary-turquoise focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-turquoise/60"
      >
        {articleTitle}
      </a>
    </h3>

    <div class="mb-4 border-b border-border-primary/80 pb-4">
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-2 text-xs text-text-secondary">
          {formattedDate && (
            <>
              <span>{formattedDate}</span>
              <span class="author-meta text-text-tertiary">|</span>
            </>
          )}
          <span class="author-meta">{authorName}</span>
        </div>

        <SocialShare url={articleUrl} title={articleTitle} class="text-[18px]" />
      </div>
    </div>

    <p class="mb-4 flex-grow text-sm text-text-secondary line-clamp-3">
      {plainExcerpt}
    </p>

    <a
      href={articleUrl}
      class="inline-flex items-center text-[13px] font-medium text-primary-turquoise underline underline-offset-4 transition-colors duration-200 hover:text-[#137f74]"
      aria-label={`Lire l’article : ${articleTitle}`}
    >
      Lire la suite
    </a>
  </div>
</article>

---
import Icon from './atoms/Icon.astro';
import booksMenuIcon from '../../menu/la_cuisine_de_bernard_24_books 1.svg?raw';
import savoryMenuIcon from '../../menu/sale 1.svg?raw';
import sweetMenuIcon from '../../menu/la_cuisine_de_bernard_24_sweet-37 1.svg?raw';
import workshopsMenuIcon from '../../menu/la_cuisine_de_bernard_24_savory 2.svg?raw';
import videosMenuIcon from '../../menu/la_cuisine_de_bernard_24_video_course 1.svg?raw';
import voyagesMenuIcon from '../../menu/voyage 1.svg?raw';
import reportagesMenuIcon from '../../menu/reportages 1.svg?raw';
import selectionsMenuIcon from '../../menu/Frame-1 1.svg?raw';

interface Props {
  lang?: string;
}

const { lang = 'fr' } = Astro.props;

const languageLabels: Record<string, string> = {
  fr: 'Fran&ccedil;ais',
  en: 'English',
  es: 'Espa&ntilde;ol',
  'pt-br': 'Portugu&ecirc;s',
  ar: '&#1575;&#1604;&#1593;&#1585;&#1576;&#1610;&#1577;',
};

const supportedLanguages = ['fr', 'en', 'es', 'pt-br', 'ar'];
const currentLang = supportedLanguages.includes(lang) ? lang : 'fr';
const languageLabel = languageLabels[currentLang];
const languageOptions = supportedLanguages.map((code) => ({
  code,
  label: languageLabels[code],
}));

const navItems = [
  {
    label: 'MES LIVRES',
    href: '/mes-livres/',
    iconSvg: booksMenuIcon,
    children: [
      {
        label: 'Chocolat maison',
        href: '/chocolat-maison/',
      },
    ],
  },
  {
    label: 'SAL&Eacute;',
    href: '/recettes-salees/',
    iconSvg: savoryMenuIcon,
    children: [
      {
        label: 'Index des recettes sal&eacute;es avec photo',
        href: '/recettes-salees/',
      },
      {
        label: 'Index des recettes sal&eacute;es sans photo',
        href: '/le-sale/',
      },
    ],
  },
  {
    label: 'SUCR&Eacute;',
    href: '/recettes-sucrees/',
    iconSvg: sweetMenuIcon,
    children: [
      {
        label: 'Index des recettes sucr&eacute;es avec photo',
        href: '/recettes-sucrees/',
      },
      {
        label: 'Index des recettes sucr&eacute;es sans photo',
        href: '/le-sucre/',
      },
    ],
  },
  { label: 'LES ATELIERS', href: 'https://atelier-lacuisinedebernard.com/', iconSvg: workshopsMenuIcon, external: true },
  { label: 'VID&Eacute;OS', href: '/videos', iconSvg: videosMenuIcon },
  { label: 'VOYAGES', href: '/voyages-culinaires', iconSvg: voyagesMenuIcon },
  { label: 'REPORTAGES', href: '/reportages', iconSvg: reportagesMenuIcon },
  { label: 'S&Eacute;LECTIONS', href: '/selection', iconSvg: selectionsMenuIcon },
];

const accountItems = [
  { label: 'VOTRE PANIER', href: '/panier', icon: 'shopping-bag' },
  { label: 'VOTRE COMPTE', href: '/compte', icon: 'user' },
];

---

<header class="relative z-50" data-header>
  <!-- Promo bar -->
  <div class="bg-[#F8F8F8] h-[36px] lg:h-[40px] hidden lg:flex items-center justify-center relative data-promo-bar" data-promo-bar>
    <div class="home-shell w-full flex items-center justify-center">
      <p class="font-mono text-[12px] lg:text-[13px] tracking-wide text-text-primary flex items-center gap-2">
        <span aria-hidden="true">&#10024;</span>
        Acc&eacute;dez en illimit&eacute; au meilleur pour seulement 9,99 &euro; / mois.
        <a href="/devenir-membre" class="underline underline-offset-4 font-medium">Devenir membre</a>
      </p>
      <button
        class="absolute right-4 w-7 h-7 flex items-center justify-center text-text-secondary hover:text-text-primary transition-colors"
        aria-label="Fermer la barre promotionnelle"
        data-promo-close
      >
        <Icon name="close" size="sm" />
      </button>
    </div>
  </div>

  <!-- Main header -->
  <div class="bg-[#1A2335] header-main">
    <div class="home-shell h-[64px] lg:h-[72px] flex items-center gap-5">
      <!-- Mobile menu trigger -->
      <button
        class="lg:hidden text-white/80 hover:text-white transition-colors"
        aria-label="Ouvrir le menu"
        data-menu-trigger
      >
        <Icon name="menu" size="lg" />
      </button>

      <!-- Logo -->
      <a href="/" class="flex-shrink-0" aria-label="La Cuisine de Bernard">
        <img
          src="/images/logo-v3.png"
          alt="La Cuisine de Bernard"
          class="h-8 lg:h-9 w-auto"
          loading="eager"
          decoding="async"
        />
      </a>

      <!-- Search (desktop) -->
      <div class="hidden lg:flex flex-1 max-w-[640px]">
        <div class="relative w-full">
          <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-white/42">
            <Icon name="search" size="sm" class="w-[18px] h-[18px]" />
          </div>
          <input
            type="search"
            placeholder="Rechercher une recette, un atelier, une vid&eacute;o..."
            class="w-full h-[44px] pl-11 pr-4 rounded-full bg-white/15 text-white placeholder:text-white/44 border border-white/10 focus:outline-none focus:ring-2 focus:ring-primary-turquoise/60 header-search-text"
            data-header-search
            data-header-desktop-search
          />
        </div>
      </div>

      <div class="hidden lg:block w-px h-8 bg-white/25"></div>

      <!-- Desktop actions -->
      <div class="hidden lg:flex items-center gap-[18px] ml-auto">
        <a href="/contact" class="flex items-center gap-[7px] text-white/85 hover:text-white text-[14px] header-utility-text" data-header-utility-link>
          <Icon name="mail" size="sm" class="w-[18px] h-[18px]" />
          <span data-header-utility-label>Contact</span>
        </a>
        <div class="relative" data-lang-menu data-no-translate="true">
          <button
            type="button"
            class="flex items-center gap-[7px] text-white/85 hover:text-white text-[14px] header-utility-text"
            data-lang-trigger
            data-header-utility-link
            aria-haspopup="true"
            aria-expanded="false"
            aria-busy="false"
            aria-controls="header-language-dropdown"
          >
            <Icon name="globe" size="sm" class="w-[17px] h-[17px]" />
            <span data-lang-current-label data-header-utility-label set:html={languageLabel} />
            <span
              class="hidden items-center gap-1 text-[11px] text-white/75"
              data-lang-loading
              aria-live="polite"
            >
              <span class="inline-block w-3 h-3 rounded-full border border-white/35 border-t-white animate-spin"></span>
              <span>Translating...</span>
            </span>
            <Icon name="chevron-down" size="sm" class="w-[12px] h-[12px]" data-lang-chevron />
          </button>
          <div
            id="header-language-dropdown"
            class="absolute right-0 top-full mt-3 w-[172px] rounded-2xl border border-white/15 bg-[#111927] p-2 shadow-2xl hidden"
            data-lang-dropdown
            role="menu"
            aria-label="Language selection"
          >
            {languageOptions.map((option) => (
              <button
                type="button"
                class={`lang-btn w-full text-left px-3 py-2 rounded-xl text-[13px] header-utility-text text-white transition-colors hover:bg-white/10 hover:text-white ${option.code === currentLang ? 'hidden' : ''}`}
                data-lang={option.code}
                data-lang-option
                role="menuitemradio"
                aria-checked={option.code === currentLang}
              >
                <span set:html={option.label} />
              </button>
            ))}
          </div>
        </div>
        <a href="/compte" class="w-9 h-9 rounded-full overflow-hidden border border-white/20" aria-label="Mon compte">
          <img src="/images/bernard-avatar-mask.png" alt="" class="w-full h-full object-cover" loading="lazy" decoding="async" />
        </a>
        <a href="/favoris" class="inline-flex items-center gap-[6px] text-white/85 hover:text-white" aria-label="Favoris">
          <span class="header-favorites-icon" aria-hidden="true">
            <img src="/images/client-favorites.svg" alt="" loading="lazy" decoding="async" />
          </span>
          <span class="header-utility-text text-[17px] leading-none normal-case" data-header-utility-label>3</span>
        </a>
      </div>

      <!-- Mobile actions -->
      <div class="flex lg:hidden items-center gap-4 ml-auto text-white/80">
        <div class="relative" data-mobile-header-lang-menu data-no-translate="true">
          <button
            type="button"
            class="text-white/80 hover:text-white transition-colors"
            aria-label="Langues"
            aria-controls="mobile-header-language-dropdown"
            aria-expanded="false"
            data-mobile-lang-trigger
          >
            <Icon name="globe" size="md" />
          </button>
          <div
            id="mobile-header-language-dropdown"
            class="absolute right-0 top-full mt-3 w-[172px] rounded-2xl border border-white/15 bg-[#111927] p-2 shadow-2xl hidden z-30"
            data-mobile-lang-dropdown
            role="menu"
            aria-label="Mobile language selection"
          >
            {languageOptions.map((option) => (
              <button
                type="button"
                class={`lang-btn w-full text-left px-3 py-2 rounded-xl text-[13px] header-mobile-nav-text text-white transition-colors hover:bg-white/10 hover:text-white ${option.code === currentLang ? 'hidden' : ''}`}
                data-lang={option.code}
                data-mobile-lang-option
                role="menuitemradio"
                aria-checked={option.code === currentLang}
              >
                <span set:html={option.label} />
              </button>
            ))}
          </div>
        </div>
        <button
          type="button"
          class="text-white/80"
          aria-label="Rechercher"
          aria-expanded="false"
          aria-controls="header-mobile-search"
          data-mobile-search
        >
          <Icon name="search" size="md" />
        </button>
      </div>
    </div>
  </div>

  <div
    id="header-mobile-search"
    class="hidden lg:hidden bg-[#1A2335] border-t border-white/10"
    data-mobile-search-panel
  >
    <div class="home-shell py-3">
      <form class="flex items-center gap-2" data-mobile-search-form>
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-white/50">
            <Icon name="search" size="sm" />
          </div>
          <input
            type="search"
            placeholder="Rechercher une recette, un atelier, une vid&eacute;o..."
            class="w-full h-[42px] pl-11 pr-4 rounded-full bg-white/15 text-white placeholder:text-white/52 border border-white/10 focus:outline-none focus:ring-2 focus:ring-primary-turquoise/60 font-maison text-[15px] tracking-[0.01em]"
            data-mobile-header-search
          />
        </div>
        <button
          type="submit"
          class="h-[42px] px-4 rounded-full bg-white text-[#1A2335] text-[12px] font-semibold tracking-wide uppercase"
          aria-label="Lancer la recherche"
        >
          Go
        </button>
        <button
          type="button"
          class="h-[42px] w-[42px] rounded-full border border-white/25 text-white/80 hover:text-white flex items-center justify-center"
          aria-label="Fermer la recherche"
          data-mobile-search-close
        >
          <Icon name="close" size="sm" />
        </button>
      </form>
    </div>
  </div>

  <!-- Secondary navigation -->
  <div class="hidden lg:flex bg-secondary-cream/95 border-b border-[#D0D0C5] header-bottom">
    <div class="home-shell w-full h-[70px] flex items-center">
      <nav class="flex items-center gap-8" aria-label="Navigation principale">
        {navItems.map((item) => (
          item.children?.length ? (
            <div class="relative group">
              <a
                href={item.href}
                class="flex items-center gap-[10px] text-text-primary hover:text-primary-turquoise transition-colors header-main-nav-text"
                data-header-nav-link
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                aria-haspopup="true"
              >
                <span class="menu-nav-icon" aria-hidden="true" set:html={item.iconSvg} />
                <span data-header-nav-label set:html={item.label} />
                <Icon name="chevron-down" size="sm" class="w-[15px] h-[15px] text-[#6F7680] transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" />
              </a>

              <div class="absolute left-0 top-full pt-3 opacity-0 invisible pointer-events-none transition-all duration-200 group-hover:opacity-100 group-hover:visible group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:visible group-focus-within:pointer-events-auto">
                <div class="min-w-[340px] rounded-2xl border border-[#D8D2C2] bg-white p-2 shadow-[0_22px_50px_rgba(17,25,39,0.14)]">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="flex items-start rounded-xl px-4 py-3 text-[13px] leading-5 text-[#2F3441] transition-colors hover:bg-[#F4F0E6] hover:text-[#1A2335]"
                    >
                      <span set:html={child.label} />
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="flex items-center gap-[10px] text-text-primary hover:text-primary-turquoise transition-colors header-main-nav-text"
              data-header-nav-link
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              <span class="menu-nav-icon" aria-hidden="true" set:html={item.iconSvg} />
              <span data-header-nav-label set:html={item.label} />
            </a>
          )
        ))}
      </nav>
    </div>
  </div>

  <!-- Mobile menu overlay -->
  <div
    class="fixed inset-0 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
    data-menu-overlay
    aria-hidden="true"
  ></div>

  <!-- Mobile menu drawer -->
  <aside
    class="fixed inset-y-0 left-0 w-[320px] bg-[#1A2335] text-white transform -translate-x-full transition-transform duration-300 ease-in-out lg:hidden z-50"
    data-menu-drawer
    aria-hidden="true"
    inert
  >
    <div class="p-6 flex items-center justify-between border-b border-white/10">
      <h2 class="font-heading text-[20px]">Navigation</h2>
      <button class="text-white/70 hover:text-white" aria-label="Fermer le menu" data-menu-close>
        <Icon name="close" size="md" />
      </button>
    </div>

    <nav class="px-6 py-4">
      <ul class="space-y-3">
        {navItems.map((item, index) => (
          <li class="border-b border-white/10 last:border-b-0">
            {item.children?.length ? (
              <div class="py-3">
                <div class="flex items-center gap-3">
                  <a
                    href={item.href}
                    class="flex min-w-0 flex-1 items-center gap-3 text-white/80 hover:text-white header-mobile-nav-text"
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                  >
                    <span class="menu-nav-icon" aria-hidden="true" set:html={item.iconSvg} />
                    <span set:html={item.label} />
                  </a>
                  <button
                    type="button"
                    class="inline-flex h-8 w-8 items-center justify-center text-white/70 transition-colors hover:text-white"
                    aria-label={`Afficher le sous-menu ${item.label.replace(/&[^;]+;/g, '').toLowerCase()}`}
                    aria-expanded="false"
                    aria-controls={`mobile-submenu-${index}`}
                    data-mobile-submenu-trigger
                  >
                    <Icon
                      name="chevron-down"
                      size="sm"
                      class="w-4 h-4 transition-transform duration-200"
                      data-mobile-submenu-chevron
                    />
                  </button>
                </div>

                <div
                  id={`mobile-submenu-${index}`}
                  class="ml-9 mt-3 hidden space-y-2 border-l border-white/10 pl-4"
                  data-mobile-submenu
                >
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="block rounded-lg py-2 text-[13px] leading-5 text-white/70 transition-colors hover:text-white"
                    >
                      <span set:html={child.label} />
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class="flex items-center justify-between py-3 text-white/80 hover:text-white header-mobile-nav-text"
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                <span class="flex items-center gap-3">
                  <span class="menu-nav-icon" aria-hidden="true" set:html={item.iconSvg} />
                  <span set:html={item.label} />
                </span>
                <span aria-hidden="true">&#8250;</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="px-6 pb-6">
      <h3 class="font-heading text-[18px] mt-6 mb-3">Votre espace</h3>
      <ul class="space-y-3">
        {accountItems.map((item) => (
          <li class="border-b border-white/10 last:border-b-0">
            <a href={item.href} class="flex items-center justify-between py-3 text-[14px] uppercase tracking-wide text-white/80 hover:text-white">
              <span class="flex items-center gap-3">
                <span class="text-primary-turquoise">
                  <Icon name={item.icon as any} size="sm" />
                </span>
                {item.label}
              </span>
              <span aria-hidden="true">&#8250;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </aside>
</header>

<style>
  @media (min-width: 1024px) {
    :global(.header-main [data-header-desktop-search]) {
      font-family: var(--font-maison) !important;
      font-size: 15px !important;
      font-weight: 300 !important;
      line-height: 1 !important;
      letter-spacing: 0 !important;
      color: rgba(255, 255, 255, 0.78) !important;
    }

    :global(.header-main [data-header-desktop-search]::placeholder) {
      font-family: var(--font-maison) !important;
      font-size: 15px !important;
      font-weight: 300 !important;
      line-height: 1 !important;
      letter-spacing: 0 !important;
      color: rgba(255, 255, 255, 0.46) !important;
      opacity: 1 !important;
    }

    :global(.header-main [data-header-utility-link]),
    :global(.header-main [data-header-utility-label]) {
      font-family: var(--font-maison) !important;
      font-size: 13px !important;
      font-weight: 300 !important;
      line-height: 1 !important;
      letter-spacing: 0 !important;
      text-transform: uppercase !important;
    }

    :global(.header-main [data-lang-trigger]),
    :global(.header-main [data-header-utility-link]) {
      min-height: 21px;
    }

    :global(.header-bottom [data-header-nav-link]),
    :global(.header-bottom [data-header-nav-label]) {
      font-family: var(--font-maison) !important;
      font-size: 14px !important;
      font-weight: 400 !important;
      line-height: 1 !important;
      letter-spacing: 0 !important;
      text-transform: uppercase !important;
    }
  }

  :global(.header-main .header-mobile-nav-text),
  :global(.header-main .header-mobile-nav-text span) {
    font-family: var(--font-maison) !important;
    font-size: 14px !important;
    font-weight: 400 !important;
    line-height: 1.1 !important;
    letter-spacing: 0 !important;
    text-transform: uppercase !important;
  }

  .menu-nav-icon {
    display: inline-flex;
    width: 30px;
    height: 24px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    color: var(--lcdb-accent, #54b6b1);
  }

  .menu-nav-icon :global(svg) {
    display: block;
    width: auto;
    height: 100%;
    overflow: visible;
  }

  .header-favorites-icon {
    display: inline-flex;
    width: 20px;
    height: 18px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
  }

  .header-favorites-icon :global(svg),
  .header-favorites-icon img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .header-favorites-icon img {
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }

  .header-favorites-icon :global(path) {
    stroke: currentColor;
  }
</style>

<script>
  // @ts-nocheck
  const LANGUAGE_STORAGE_KEY = 'preferred-language';
  const promoBar = document.querySelector('[data-promo-bar]');
  const promoClose = document.querySelector('[data-promo-close]');

  if (promoBar && promoClose) {
    if (localStorage.getItem('promo-bar-hidden') === 'true') {
      promoBar.classList.add('hidden');
      promoBar.classList.remove('lg:flex');
    }

    promoClose.addEventListener('click', () => {
      promoBar.classList.add('hidden');
      promoBar.classList.remove('lg:flex');
      localStorage.setItem('promo-bar-hidden', 'true');
    });
  }

  const menuTrigger = document.querySelector('[data-menu-trigger]');
  const menuClose = document.querySelector('[data-menu-close]');
  const menuOverlay = document.querySelector('[data-menu-overlay]');
  const menuDrawer = document.querySelector('[data-menu-drawer]');
  const headerSearchInputs = Array.from(document.querySelectorAll('[data-header-search]'));
  const mobileSearchButton = document.querySelector('[data-mobile-search]');
  const mobileSearchPanel = document.querySelector('[data-mobile-search-panel]');
  const mobileSearchForm = document.querySelector('[data-mobile-search-form]');
  const mobileSearchInput = document.querySelector('[data-mobile-header-search]');
  const mobileSearchClose = document.querySelector('[data-mobile-search-close]');
  const languageMenu = document.querySelector('[data-lang-menu]');
  const languageTrigger = languageMenu?.querySelector('[data-lang-trigger]');
  const languageDropdown = languageMenu?.querySelector('[data-lang-dropdown]');
  const currentLangLabel = languageMenu?.querySelector('[data-lang-current-label]');
  const languageOptions = Array.from(languageMenu?.querySelectorAll('[data-lang-option]') || []);
  const languageLoading = languageMenu?.querySelector('[data-lang-loading]');
  const languageChevron = languageMenu?.querySelector('[data-lang-chevron]');
  const mobileLangMenu = document.querySelector('[data-mobile-header-lang-menu]');
  const mobileLangTrigger = mobileLangMenu?.querySelector('[data-mobile-lang-trigger]');
  const mobileLangDropdown = mobileLangMenu?.querySelector('[data-mobile-lang-dropdown]');
  const mobileCurrentLangLabel = mobileLangMenu?.querySelector('[data-mobile-lang-current-label]');
  const mobileLanguageOptions = Array.from(mobileLangMenu?.querySelectorAll('[data-mobile-lang-option]') || []);
  const mobileLangChevron = mobileLangMenu?.querySelector('[data-mobile-lang-chevron]');
  const mobileSubmenuTriggers = Array.from(document.querySelectorAll('[data-mobile-submenu-trigger]'));
  const body = document.body;
  let languageLoadingTimeout = null;

  function submitHeaderSearch(rawValue) {
    const query = String(rawValue || '').trim();
    if (!query) {
      window.location.href = '/search/';
      return;
    }
    window.location.href = `/search/?q=${encodeURIComponent(query)}`;
  }

  function toggleMenu(show) {
    if (!menuDrawer || !menuOverlay) return;

    menuDrawer.setAttribute('aria-hidden', String(!show));
    menuOverlay.setAttribute('aria-hidden', String(!show));

    if (show) {
      toggleMobileSearch(false);
      toggleMobileLanguageMenu(false);
      menuDrawer.removeAttribute('inert');
      menuDrawer.classList.remove('-translate-x-full');
      menuOverlay.classList.remove('opacity-0', 'pointer-events-none');
      body.classList.add('overflow-hidden');
    } else {
      toggleMobileLanguageMenu(false);
      mobileSubmenuTriggers.forEach((trigger) => {
        const controls = trigger.getAttribute('aria-controls');
        const panel = controls ? document.getElementById(controls) : null;
        trigger.setAttribute('aria-expanded', 'false');
        trigger
          .querySelector('[data-mobile-submenu-chevron]')
          ?.classList.remove('rotate-180');
        panel?.classList.add('hidden');
      });
      menuDrawer.setAttribute('inert', '');
      menuDrawer.classList.add('-translate-x-full');
      menuOverlay.classList.add('opacity-0', 'pointer-events-none');
      body.classList.remove('overflow-hidden');
    }
  }

  function toggleMobileSearch(show) {
    if (!mobileSearchPanel) return;
    mobileSearchPanel.classList.toggle('hidden', !show);

    if (mobileSearchButton) {
      mobileSearchButton.setAttribute('aria-expanded', String(show));
    }

    if (show && mobileSearchInput instanceof HTMLInputElement) {
      requestAnimationFrame(() => mobileSearchInput.focus());
    }
  }

  function toggleLanguageMenu(show) {
    if (!languageDropdown || !languageTrigger) return;
    languageDropdown.classList.toggle('hidden', !show);
    languageTrigger.setAttribute('aria-expanded', String(show));
  }

  function toggleMobileLanguageMenu(show) {
    if (!mobileLangDropdown || !mobileLangTrigger) return;
    mobileLangDropdown.classList.toggle('hidden', !show);
    mobileLangTrigger.setAttribute('aria-expanded', String(show));
    mobileLangChevron?.classList.toggle('rotate-180', Boolean(show));
  }

  function syncLanguageMenu(selectedLang) {
    if (!languageOptions.length) return;

    languageOptions.forEach((button) => {
      const buttonLang = button.getAttribute('data-lang');
      const isSelected = buttonLang === selectedLang;
      button.classList.toggle('hidden', isSelected);
      button.setAttribute('aria-checked', String(isSelected));

      if (isSelected && currentLangLabel) {
        currentLangLabel.innerHTML = button.innerHTML;
      }
    });
  }

  function syncMobileLanguageMenu(selectedLang) {
    if (!mobileLanguageOptions.length) return;

    mobileLanguageOptions.forEach((button) => {
      const buttonLang = button.getAttribute('data-lang');
      const isSelected = buttonLang === selectedLang;
      button.classList.toggle('hidden', isSelected);
      button.setAttribute('aria-checked', String(isSelected));

      if (isSelected && mobileCurrentLangLabel) {
        mobileCurrentLangLabel.innerHTML = button.innerHTML;
      }
    });
  }

  function setLanguageLoading(isLoading) {
    if (!languageTrigger || !languageLoading) return;
    languageTrigger.setAttribute('aria-busy', String(Boolean(isLoading)));
    languageLoading.classList.toggle('hidden', !isLoading);
    languageLoading.classList.toggle('inline-flex', Boolean(isLoading));
    languageChevron?.classList.toggle('hidden', Boolean(isLoading));

    languageOptions.forEach((button) => {
      button.disabled = Boolean(isLoading);
      button.classList.toggle('opacity-60', Boolean(isLoading));
      button.classList.toggle('cursor-not-allowed', Boolean(isLoading));
    });
  }

  function startLanguageLoading() {
    if (languageLoadingTimeout) {
      clearTimeout(languageLoadingTimeout);
    }
    setLanguageLoading(true);
    languageLoadingTimeout = setTimeout(() => {
      setLanguageLoading(false);
      languageLoadingTimeout = null;
    }, 15000);
  }

  function stopLanguageLoading() {
    if (languageLoadingTimeout) {
      clearTimeout(languageLoadingTimeout);
      languageLoadingTimeout = null;
    }
    setLanguageLoading(false);
  }

  function applyLanguageSelection(selectedLang) {
    if (!selectedLang) return;
    syncLanguageMenu(selectedLang);
    syncMobileLanguageMenu(selectedLang);
    startLanguageLoading();

    // Keep language intent even if translation runtime is still booting.
    window.__lcdbPendingLanguage = selectedLang;
    try {
      localStorage.setItem(LANGUAGE_STORAGE_KEY, selectedLang);
    } catch {}

    const changeLanguage = window.__lcdbChangeLanguage;
    if (typeof changeLanguage === 'function') {
      changeLanguage(selectedLang).catch((error) => {
        stopLanguageLoading();
        console.error('[header] Failed to change language:', error);
      });
    } else {
      window.dispatchEvent(new CustomEvent('lcdb:language-select', { detail: { lang: selectedLang } }));
    }
  }

  menuTrigger?.addEventListener('click', () => toggleMenu(true));
  menuClose?.addEventListener('click', () => toggleMenu(false));
  menuOverlay?.addEventListener('click', () => toggleMenu(false));
  languageTrigger?.addEventListener('click', (event) => {
    event.preventDefault();
    event.stopPropagation();
    const isOpen = languageTrigger.getAttribute('aria-expanded') === 'true';
    toggleLanguageMenu(!isOpen);
  });
  mobileLangTrigger?.addEventListener('click', (event) => {
    event.preventDefault();
    event.stopPropagation();
    const isOpen = mobileLangTrigger.getAttribute('aria-expanded') === 'true';
    toggleMobileLanguageMenu(!isOpen);
  });
  languageOptions.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedLang = button.getAttribute('data-lang');
      toggleLanguageMenu(false);
      applyLanguageSelection(selectedLang);
    });
  });
  mobileLanguageOptions.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedLang = button.getAttribute('data-lang');
      toggleMobileLanguageMenu(false);
      applyLanguageSelection(selectedLang);
    });
  });
  window.addEventListener('page-translated', (event) => {
    const selectedLang = event?.detail?.lang;
    if (!selectedLang) return;
    syncLanguageMenu(selectedLang);
    syncMobileLanguageMenu(selectedLang);
    stopLanguageLoading();
  });
  document.addEventListener('click', (event) => {
    if (!languageMenu || !event.target || languageMenu.contains(event.target)) return;
    toggleLanguageMenu(false);
  });
  document.addEventListener('click', (event) => {
    if (!mobileLangMenu || !event.target || mobileLangMenu.contains(event.target)) return;
    toggleMobileLanguageMenu(false);
  });
  headerSearchInputs.forEach((input) => {
    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      submitHeaderSearch(input.value);
    });
  });
  mobileSearchButton?.addEventListener('click', (event) => {
    event.preventDefault();
    const isOpen = mobileSearchButton.getAttribute('aria-expanded') === 'true';
    toggleMobileSearch(!isOpen);
  });
  mobileSearchForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = mobileSearchInput instanceof HTMLInputElement ? mobileSearchInput.value : '';
      submitHeaderSearch(query);
  });
  mobileSearchClose?.addEventListener('click', () => toggleMobileSearch(false));
  mobileSubmenuTriggers.forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      const controls = trigger.getAttribute('aria-controls');
      const panel = controls ? document.getElementById(controls) : null;
      if (!panel) return;

      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!isOpen));
      trigger
        .querySelector('[data-mobile-submenu-chevron]')
        ?.classList.toggle('rotate-180', !isOpen);
      panel.classList.toggle('hidden', isOpen);
    });
  });

  const initialMenuLang =
    document.documentElement.getAttribute('data-lang') ||
    document.documentElement.lang ||
    'fr';
  syncLanguageMenu(initialMenuLang);
  syncMobileLanguageMenu(initialMenuLang);
  stopLanguageLoading();

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      toggleMenu(false);
      toggleLanguageMenu(false);
      toggleMobileLanguageMenu(false);
      toggleMobileSearch(false);
    }
  });
</script>

---
import Icon from './atoms/Icon.astro';

interface Props {
  lang?: string;
}

const { lang = 'fr' } = Astro.props;

const languageLabels: Record<string, string> = {
  fr: 'Fran&ccedil;ais',
  en: 'English',
  es: 'Espa&ntilde;ol',
  'pt-br': 'Portugu&ecirc;s',
  ar: '&#1575;&#1604;&#1593;&#1585;&#1576;&#1610;&#1577;',
};

const supportedLanguages = ['fr', 'en', 'es', 'pt-br', 'ar'];
const currentLang = supportedLanguages.includes(lang) ? lang : 'fr';
const languageLabel = languageLabels[currentLang];
const languageOptions = supportedLanguages.map((code) => ({
  code,
  label: languageLabels[code],
}));

const navItems = [
  { label: 'MES LIVRES', href: '/books', icon: 'book' },
  { label: 'SAL&Eacute;', href: '/recettes-salees', icon: 'utensils' },
  { label: 'SUCR&Eacute;', href: '/recettes-sucrees', icon: 'heart' },
  { label: 'LES ATELIERS', href: 'https://atelier-lacuisinedebernard.com/', icon: 'star', external: true },
  { label: 'VID&Eacute;OS', href: '/videos', icon: 'video' },
  { label: 'VOYAGES', href: '/voyages-culinaires', icon: 'map-pin' },
  { label: 'REPORTAGES', href: '/reportages', icon: 'book' },
  { label: 'S&Eacute;LECTIONS', href: '/selection', icon: 'star' },
];

const accountItems = [
  { label: 'VOTRE PANIER', href: '/panier', icon: 'shopping-bag' },
  { label: 'VOTRE COMPTE', href: '/compte', icon: 'user' },
  { label: 'LANGUES', href: '#langues', icon: 'globe' },
];

---

<header class="relative z-50" data-header>
  <!-- Promo bar -->
  <div class="bg-[#F8F8F8] h-[36px] lg:h-[40px] hidden lg:flex items-center justify-center relative data-promo-bar" data-promo-bar>
    <div class="home-shell w-full flex items-center justify-center">
      <p class="font-mono text-[12px] lg:text-[13px] tracking-wide text-text-primary flex items-center gap-2">
        <span aria-hidden="true">&#10024;</span>
        Acc&eacute;dez en illimit&eacute; au meilleur pour seulement 9,99 &euro; / mois.
        <a href="/devenir-membre" class="underline underline-offset-4 font-medium">Devenir membre</a>
      </p>
      <button
        class="absolute right-4 w-7 h-7 flex items-center justify-center text-text-secondary hover:text-text-primary transition-colors"
        aria-label="Fermer la barre promotionnelle"
        data-promo-close
      >
        <Icon name="close" size="sm" />
      </button>
    </div>
  </div>

  <!-- Main header -->
  <div class="bg-[#1A2335] header-main">
    <div class="home-shell h-[64px] lg:h-[72px] flex items-center gap-5">
      <!-- Mobile menu trigger -->
      <button
        class="lg:hidden text-white/80 hover:text-white transition-colors"
        aria-label="Ouvrir le menu"
        data-menu-trigger
      >
        <Icon name="menu" size="lg" />
      </button>

      <!-- Logo -->
      <a href="/" class="flex-shrink-0" aria-label="La Cuisine de Bernard">
        <img
          src="/images/logo-v3.png"
          alt="La Cuisine de Bernard"
          class="h-8 lg:h-9 w-auto"
          loading="eager"
          decoding="async"
        />
      </a>

      <!-- Search (desktop) -->
      <div class="hidden lg:flex flex-1 max-w-[640px]">
        <div class="relative w-full">
          <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-white/50">
            <Icon name="search" size="sm" />
          </div>
          <input
            type="search"
            placeholder="Rechercher une recette, un atelier, une vid&eacute;o..."
            class="w-full h-[44px] pl-11 pr-4 rounded-full bg-white/15 text-white placeholder:text-white/50 border border-white/10 focus:outline-none focus:ring-2 focus:ring-primary-turquoise/60 font-body text-[14px]"
            data-header-search
          />
        </div>
      </div>

      <div class="hidden lg:block w-px h-8 bg-white/25"></div>

      <!-- Desktop actions -->
      <div class="hidden lg:flex items-center gap-7 ml-auto">
        <a href="/contact" class="flex items-center gap-2 text-white/85 hover:text-white text-[14px] typ-nav">
          <Icon name="mail" size="sm" />
          <span>Contact</span>
        </a>
        <div class="relative" data-lang-menu data-no-translate="true">
          <button
            type="button"
            class="flex items-center gap-2 text-white/85 hover:text-white text-[14px] typ-nav"
            data-lang-trigger
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="header-language-dropdown"
          >
            <Icon name="globe" size="sm" />
            <span data-lang-current-label set:html={languageLabel} />
            <Icon name="chevron-down" size="sm" class="w-4 h-4" />
          </button>
          <div
            id="header-language-dropdown"
            class="absolute right-0 top-full mt-3 w-[172px] rounded-2xl border border-white/15 bg-[#111927] p-2 shadow-2xl hidden"
            data-lang-dropdown
            role="menu"
            aria-label="Language selection"
          >
            {languageOptions.map((option) => (
              <button
                type="button"
                class={`lang-btn w-full text-left px-3 py-2 rounded-xl text-[13px] typ-nav text-white transition-colors hover:bg-white/10 hover:text-white ${option.code === currentLang ? 'hidden' : ''}`}
                data-lang={option.code}
                data-lang-option
                role="menuitemradio"
                aria-checked={option.code === currentLang}
              >
                <span set:html={option.label} />
              </button>
            ))}
          </div>
        </div>
        <a href="/compte" class="w-9 h-9 rounded-full overflow-hidden border border-white/20" aria-label="Mon compte">
          <img src="/images/bernard-avatar-mask.png" alt="" class="w-full h-full object-cover" loading="lazy" decoding="async" />
        </a>
        <a href="/favoris" class="inline-flex items-center gap-2 text-white/85 hover:text-white" aria-label="Favoris">
          <Icon name="heart" size="md" />
          <span class="text-[18px] leading-none font-body">3</span>
        </a>
        <a href="/panier" class="inline-flex items-center gap-2 text-white/85 hover:text-white" aria-label="Panier">
          <Icon name="shopping-bag" size="md" />
          <span class="text-[18px] leading-none font-body">1</span>
        </a>
      </div>

      <!-- Mobile actions -->
      <div class="flex lg:hidden items-center gap-4 ml-auto text-white/80">
        <a href="/panier" class="relative" aria-label="Panier">
          <Icon name="shopping-bag" size="md" />
          <span class="absolute -top-1.5 -right-2 w-4 h-4 rounded-full bg-primary-turquoise text-[10px] font-bold text-primary-black flex items-center justify-center">1</span>
        </a>
        <button
          type="button"
          class="text-white/80"
          aria-label="Rechercher"
          aria-expanded="false"
          aria-controls="header-mobile-search"
          data-mobile-search
        >
          <Icon name="search" size="md" />
        </button>
      </div>
    </div>
  </div>

  <div
    id="header-mobile-search"
    class="hidden lg:hidden bg-[#1A2335] border-t border-white/10"
    data-mobile-search-panel
  >
    <div class="home-shell py-3">
      <form class="flex items-center gap-2" data-mobile-search-form>
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-white/50">
            <Icon name="search" size="sm" />
          </div>
          <input
            type="search"
            placeholder="Rechercher une recette, un atelier, une vid&eacute;o..."
            class="w-full h-[42px] pl-11 pr-4 rounded-full bg-white/15 text-white placeholder:text-white/50 border border-white/10 focus:outline-none focus:ring-2 focus:ring-primary-turquoise/60 font-body text-[14px]"
            data-mobile-header-search
          />
        </div>
        <button
          type="submit"
          class="h-[42px] px-4 rounded-full bg-white text-[#1A2335] text-[12px] font-semibold tracking-wide uppercase"
          aria-label="Lancer la recherche"
        >
          Go
        </button>
        <button
          type="button"
          class="h-[42px] w-[42px] rounded-full border border-white/25 text-white/80 hover:text-white flex items-center justify-center"
          aria-label="Fermer la recherche"
          data-mobile-search-close
        >
          <Icon name="close" size="sm" />
        </button>
      </form>
    </div>
  </div>

  <!-- Secondary navigation -->
  <div class="hidden lg:flex bg-secondary-cream/95 border-b border-[#D0D0C5] header-bottom">
    <div class="home-shell w-full h-[70px] flex items-center">
      <nav class="flex items-center gap-8" aria-label="Navigation principale">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="flex items-center gap-2 text-[13px] uppercase tracking-wide text-text-primary hover:text-primary-turquoise transition-colors typ-nav"
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            <span class="text-primary-turquoise">
              <Icon name={item.icon as any} size="sm" />
            </span>
            <span set:html={item.label} />
          </a>
        ))}
      </nav>
    </div>
  </div>

  <!-- Mobile menu overlay -->
  <div
    class="fixed inset-0 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
    data-menu-overlay
    aria-hidden="true"
  ></div>

  <!-- Mobile menu drawer -->
  <aside
    class="fixed inset-y-0 left-0 w-[320px] bg-[#1A2335] text-white transform -translate-x-full transition-transform duration-300 ease-in-out lg:hidden z-50"
    data-menu-drawer
    aria-hidden="true"
    inert
  >
    <div class="p-6 flex items-center justify-between border-b border-white/10">
      <h2 class="font-heading text-[20px]">Navigation</h2>
      <button class="text-white/70 hover:text-white" aria-label="Fermer le menu" data-menu-close>
        <Icon name="close" size="md" />
      </button>
    </div>

    <nav class="px-6 py-4">
      <ul class="space-y-3">
        {navItems.map((item) => (
          <li class="border-b border-white/10 last:border-b-0">
            <a
              href={item.href}
              class="flex items-center justify-between py-3 text-[14px] uppercase tracking-wide text-white/80 hover:text-white"
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              <span class="flex items-center gap-3">
                <span class="text-primary-turquoise">
                  <Icon name={item.icon as any} size="sm" />
                </span>
                <span set:html={item.label} />
              </span>
              <span aria-hidden="true">&#8250;</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="px-6 pb-6">
      <h3 class="font-heading text-[18px] mt-6 mb-3">Votre espace</h3>
      <ul class="space-y-3">
        {accountItems.map((item) => (
          <li class="border-b border-white/10 last:border-b-0">
            <a href={item.href} class="flex items-center justify-between py-3 text-[14px] uppercase tracking-wide text-white/80 hover:text-white">
              <span class="flex items-center gap-3">
                <span class="text-primary-turquoise">
                  <Icon name={item.icon as any} size="sm" />
                </span>
                {item.label}
              </span>
              <span aria-hidden="true">&#8250;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </aside>
</header>

<script>
  // @ts-nocheck
  const promoBar = document.querySelector('[data-promo-bar]');
  const promoClose = document.querySelector('[data-promo-close]');

  if (promoBar && promoClose) {
    if (localStorage.getItem('promo-bar-hidden') === 'true') {
      promoBar.classList.add('hidden');
      promoBar.classList.remove('lg:flex');
    }

    promoClose.addEventListener('click', () => {
      promoBar.classList.add('hidden');
      promoBar.classList.remove('lg:flex');
      localStorage.setItem('promo-bar-hidden', 'true');
    });
  }

  const menuTrigger = document.querySelector('[data-menu-trigger]');
  const menuClose = document.querySelector('[data-menu-close]');
  const menuOverlay = document.querySelector('[data-menu-overlay]');
  const menuDrawer = document.querySelector('[data-menu-drawer]');
  const headerSearchInputs = Array.from(document.querySelectorAll('[data-header-search]'));
  const mobileSearchButton = document.querySelector('[data-mobile-search]');
  const mobileSearchPanel = document.querySelector('[data-mobile-search-panel]');
  const mobileSearchForm = document.querySelector('[data-mobile-search-form]');
  const mobileSearchInput = document.querySelector('[data-mobile-header-search]');
  const mobileSearchClose = document.querySelector('[data-mobile-search-close]');
  const languageMenu = document.querySelector('[data-lang-menu]');
  const languageTrigger = languageMenu?.querySelector('[data-lang-trigger]');
  const languageDropdown = languageMenu?.querySelector('[data-lang-dropdown]');
  const currentLangLabel = languageMenu?.querySelector('[data-lang-current-label]');
  const languageOptions = Array.from(languageMenu?.querySelectorAll('[data-lang-option]') || []);
  const body = document.body;

  function submitHeaderSearch(rawValue) {
    const query = String(rawValue || '').trim();
    if (!query) {
      window.location.href = '/search/';
      return;
    }
    window.location.href = `/search/?q=${encodeURIComponent(query)}`;
  }

  function toggleMenu(show) {
    if (!menuDrawer || !menuOverlay) return;

    menuDrawer.setAttribute('aria-hidden', String(!show));
    menuOverlay.setAttribute('aria-hidden', String(!show));

    if (show) {
      toggleMobileSearch(false);
      menuDrawer.removeAttribute('inert');
      menuDrawer.classList.remove('-translate-x-full');
      menuOverlay.classList.remove('opacity-0', 'pointer-events-none');
      body.classList.add('overflow-hidden');
    } else {
      menuDrawer.setAttribute('inert', '');
      menuDrawer.classList.add('-translate-x-full');
      menuOverlay.classList.add('opacity-0', 'pointer-events-none');
      body.classList.remove('overflow-hidden');
    }
  }

  function toggleMobileSearch(show) {
    if (!mobileSearchPanel) return;
    mobileSearchPanel.classList.toggle('hidden', !show);

    if (mobileSearchButton) {
      mobileSearchButton.setAttribute('aria-expanded', String(show));
    }

    if (show && mobileSearchInput instanceof HTMLInputElement) {
      requestAnimationFrame(() => mobileSearchInput.focus());
    }
  }

  function toggleLanguageMenu(show) {
    if (!languageDropdown || !languageTrigger) return;
    languageDropdown.classList.toggle('hidden', !show);
    languageTrigger.setAttribute('aria-expanded', String(show));
  }

  function syncLanguageMenu(selectedLang) {
    if (!languageOptions.length) return;

    languageOptions.forEach((button) => {
      const buttonLang = button.getAttribute('data-lang');
      const isSelected = buttonLang === selectedLang;
      button.classList.toggle('hidden', isSelected);
      button.setAttribute('aria-checked', String(isSelected));

      if (isSelected && currentLangLabel) {
        currentLangLabel.innerHTML = button.innerHTML;
      }
    });
  }

  menuTrigger?.addEventListener('click', () => toggleMenu(true));
  menuClose?.addEventListener('click', () => toggleMenu(false));
  menuOverlay?.addEventListener('click', () => toggleMenu(false));
  languageTrigger?.addEventListener('click', (event) => {
    event.preventDefault();
    event.stopPropagation();
    const isOpen = languageTrigger.getAttribute('aria-expanded') === 'true';
    toggleLanguageMenu(!isOpen);
  });
  languageOptions.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedLang = button.getAttribute('data-lang');
      toggleLanguageMenu(false);
      if (!selectedLang) return;

      const changeLanguage = window.__lcdbChangeLanguage;
      if (typeof changeLanguage === 'function') {
        changeLanguage(selectedLang).catch((error) => {
          console.error('[header] Failed to change language:', error);
        });
      } else {
        window.dispatchEvent(new CustomEvent('lcdb:language-select', { detail: { lang: selectedLang } }));
      }
    });
  });
  window.addEventListener('page-translated', (event) => {
    const selectedLang = event?.detail?.lang;
    if (!selectedLang) return;
    syncLanguageMenu(selectedLang);
  });
  document.addEventListener('click', (event) => {
    if (!languageMenu || !event.target || languageMenu.contains(event.target)) return;
    toggleLanguageMenu(false);
  });
  headerSearchInputs.forEach((input) => {
    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      submitHeaderSearch(input.value);
    });
  });
  mobileSearchButton?.addEventListener('click', (event) => {
    event.preventDefault();
    const isOpen = mobileSearchButton.getAttribute('aria-expanded') === 'true';
    toggleMobileSearch(!isOpen);
  });
  mobileSearchForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = mobileSearchInput instanceof HTMLInputElement ? mobileSearchInput.value : '';
    submitHeaderSearch(query);
  });
  mobileSearchClose?.addEventListener('click', () => toggleMobileSearch(false));

  syncLanguageMenu(document.documentElement.getAttribute('data-lang') || document.documentElement.lang || 'fr');

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      toggleMenu(false);
      toggleLanguageMenu(false);
      toggleMobileSearch(false);
    }
  });
</script>

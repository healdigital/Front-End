---
const navigationLinks = [
  { label: 'Toutes les recettes', url: '/recettes' },
  { label: 'Techniques', url: '/techniques' },
  { label: 'Ateliers', url: '/ateliers' },
];

const legalLinks = [
  { label: 'Mentions l&eacute;gales', url: '/mentions-legales' },
  { label: 'Politique de confidentialit&eacute;', url: '/rgpd' },
  { label: 'CGV', url: '/cgv' },
];

const socialLinks = [
  { icon: 'fab fa-facebook-f', label: 'Facebook', url: 'https://www.facebook.com/lacuisinedebernard' },
  { icon: 'fab fa-youtube', label: 'YouTube', url: 'https://www.youtube.com/@lacuisinedebernard' },
  { icon: 'fab fa-pinterest', label: 'Pinterest', url: 'https://www.pinterest.com/lacuisinedebernard' },
  { icon: 'far fa-envelope', label: 'Email', url: 'mailto:contact@lacuisinedebernard.com' },
];
---

<footer class="bg-[#1A2335] text-white border-t border-white/10" role="contentinfo">
  <div class="max-w-[1440px] mx-auto px-5 md:px-10 lg:px-[90px] pt-14 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <div>
        <h3 class="font-heading text-[22px] typ-card-title">La Cuisine de Bernard</h3>
        <p class="text-white/70 text-[14px] leading-relaxed mt-4 typ-body">
          Des recettes authentiques et des techniques professionnelles pour tous les passionn&eacute;s de p&acirc;tisserie depuis 2010.
        </p>
      </div>

      <div>
        <h4 class="font-heading text-[18px] typ-card-title">Navigation</h4>
        <ul class="mt-4 space-y-3 text-[14px] text-white/70">
          {navigationLinks.map((link) => (
            <li>
              <a href={link.url} class="hover:text-primary-turquoise transition-colors" set:html={link.label}></a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-heading text-[18px] typ-card-title">L&eacute;gal</h4>
        <ul class="mt-4 space-y-3 text-[14px] text-white/70">
          {legalLinks.map((link) => (
            <li>
              <a href={link.url} class="hover:text-primary-turquoise transition-colors" set:html={link.label}></a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-heading text-[18px] typ-card-title">Suivez-moi</h4>
        <div class="flex items-center gap-4 mt-4 text-white/80">
          {socialLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              class="hover:text-primary-turquoise transition-colors"
            >
              <i class={link.icon}></i>
            </a>
          ))}
        </div>
        <a
          href="/contact"
          class="inline-flex items-center justify-center mt-6 px-6 py-3 bg-primary-turquoise text-primary-black font-button font-medium text-[12px] uppercase tracking-wider rounded-sm typ-button"
        >
          Contactez-moi
        </a>
      </div>
    </div>
  </div>
</footer>

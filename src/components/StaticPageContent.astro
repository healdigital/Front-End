---
import fs from "node:fs";
import path from "node:path";
import { normalizeWordPressUploadUrl, replaceCdnUrl } from "../utils/cdnUrlReplacer";

interface Props {
  slug: string;
  sourceUrl?: string;
}

const { slug, sourceUrl } = Astro.props;
const filePath = path.resolve(
  process.cwd(),
  "src",
  "content",
  "static-pages",
  `${slug}.html`,
);
let html = "";

if (fs.existsSync(filePath)) {
  html = fs.readFileSync(filePath, "utf8").trim();
}

if (html) {
  html = html.replace(
    /https?:\/\/[^"'()\s]+\/wp-content\/uploads\/[^"'()\s]+/gi,
    (match) => normalizeWordPressUploadUrl(match),
  );

  html = html.replace(
    /https?:\/\/cdn\.lacuisinedebernard\.com\/[^"'()\s]+/gi,
    (match) => replaceCdnUrl(match),
  );
}

const hasHtml = html.length > 0;
---

{hasHtml ? (
  <div class="wp-content" set:html={html} />
) : (
  <div class="space-y-4">
    <p>Content import pending for this page.</p>
    {sourceUrl && (
      <p>
        Source:
        <a href={sourceUrl} target="_blank" rel="noopener noreferrer">
          {sourceUrl}
        </a>
      </p>
    )}
    <slot />
  </div>
)}

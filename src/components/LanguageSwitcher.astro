---
import { getSupportedLanguages } from '../i18n';

interface Props {
  currentLang?: string;
  showLabel?: boolean;
  className?: string;
}

const { currentLang = 'fr', showLabel = true, className = '' } = Astro.props;

const supportedLanguages = getSupportedLanguages();

const languageNames: Record<string, string> = {
  en: 'English',
  fr: 'Français',
  es: 'Español',
  'pt-br': 'Português',
  ar: 'العربية',
};
---

<div class={`language-switcher ${className}`} data-no-translate="true">
  {showLabel && <span class="lang-label">Langue</span>}
  <div class="lang-buttons" role="group" aria-label="Changer de langue">
    {supportedLanguages.map((lang) => (
      <button
        type="button"
        class={`lang-btn ${lang === currentLang ? 'active' : 'inactive'}`}
        data-lang={lang}
        aria-pressed={lang === currentLang}
        aria-label={`Passer en ${languageNames[lang] || lang.toUpperCase()}`}
      >
        {languageNames[lang] || lang.toUpperCase()}
      </button>
    ))}
  </div>
</div>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .lang-label {
    color: var(--lcdb-heading);
    font-family: var(--font-button);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .lang-buttons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .lang-btn {
    min-height: 38px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--lcdb-border);
    background: #f8f5ee;
    color: var(--lcdb-copy);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 500;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  .lang-btn.active {
    background: var(--lcdb-accent);
    border-color: var(--lcdb-accent);
    color: #faf8f2;
    box-shadow: 0 8px 20px rgba(84, 182, 177, 0.18);
  }

  .lang-btn.inactive:hover,
  .lang-btn.inactive:focus-visible {
    background: #f1ece2;
    border-color: #cfc7b7;
    color: var(--lcdb-heading);
    outline: none;
    box-shadow: 0 0 0 2px rgba(84, 182, 177, 0.18);
  }
</style>

<script>
  const syncLanguageButtons = (newLang) => {
    document.querySelectorAll('.lang-btn').forEach((btn) => {
      const btnLang = btn.getAttribute('data-lang');
      const isActive = btnLang === newLang;
      btn.classList.toggle('active', isActive);
      btn.classList.toggle('inactive', !isActive);
      btn.setAttribute('aria-pressed', String(isActive));
    });
  };

  document.addEventListener('DOMContentLoaded', () => {
    const htmlLang = document.documentElement.getAttribute('data-lang') || document.documentElement.lang || 'fr';
    const savedLang = htmlLang || localStorage.getItem('preferred-language') || 'fr';
    syncLanguageButtons(savedLang);
  });

  window.addEventListener('page-translated', (event) => {
    const newLang = event?.detail?.lang;
    if (newLang) syncLanguageButtons(newLang);
  });
</script>

---
import { getSupportedLanguages } from '../i18n';

interface Props {
  currentLang?: string;
  showLabel?: boolean;
  className?: string;
}

const { currentLang = 'fr', showLabel = true, className = '' } = Astro.props;

const supportedLanguages = getSupportedLanguages();

const languageNames: Record<string, string> = {
  en: 'English',
  fr: 'Français',
  es: 'Español',
  'pt-br': 'Português',
  ar: 'العربية',
};
---

<div class={`language-switcher ${className}`} data-no-translate="true">
  {showLabel && <span class="lang-label">Langue :</span>}
  <div class="lang-buttons" role="group" aria-label="Changer de langue">
    {supportedLanguages.map((lang) => (
      <button
        type="button"
        class={`lang-btn ${lang === currentLang ? 'active' : 'inactive'}`}
        data-lang={lang}
        aria-pressed={lang === currentLang}
        aria-label={`Passer en ${languageNames[lang] || lang}`}
      >
        {languageNames[lang] || lang.toUpperCase()}
      </button>
    ))}
  </div>
</div>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .lang-label {
    font-weight: 600;
    color: var(--lcdb-heading);
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .lang-buttons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .lang-btn {
    padding: 8px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
    border: 1px solid var(--lcdb-border);
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
    background: #f5f1e8;
    color: var(--lcdb-copy);
  }

  .lang-btn.active {
    background: var(--lcdb-accent);
    border-color: var(--lcdb-accent);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(84, 182, 177, 0.25);
  }

  .lang-btn.inactive:hover,
  .lang-btn.inactive:focus-visible {
    background: #ebe6d8;
    color: var(--lcdb-heading);
    outline: none;
    box-shadow: 0 0 0 2px rgba(84, 182, 177, 0.2);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const htmlLang = document.documentElement.getAttribute('data-lang') || document.documentElement.lang || 'fr';
    const savedLang = htmlLang || localStorage.getItem('preferred-language');
    if (savedLang) {
      document.querySelectorAll('.lang-btn').forEach((btn) => {
        const btnLang = btn.getAttribute('data-lang');
        if (btnLang === savedLang) {
          btn.classList.add('active');
          btn.classList.remove('inactive');
          btn.setAttribute('aria-pressed', 'true');
        } else {
          btn.classList.remove('active');
          btn.classList.add('inactive');
          btn.setAttribute('aria-pressed', 'false');
        }
      });
    }
  });

  window.addEventListener('page-translated', (e: any) => {
    const newLang = e.detail?.lang;
    if (newLang) {
      document.querySelectorAll('.lang-btn').forEach((btn) => {
        const btnLang = btn.getAttribute('data-lang');
        if (btnLang === newLang) {
          btn.classList.add('active');
          btn.classList.remove('inactive');
          btn.setAttribute('aria-pressed', 'true');
        } else {
          btn.classList.remove('active');
          btn.classList.add('inactive');
          btn.setAttribute('aria-pressed', 'false');
        }
      });
    }
  });
</script>

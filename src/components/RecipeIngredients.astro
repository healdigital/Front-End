---
interface Ingredient {
  group?: string;
  amount: string;
  unit: string;
  name: string;
  notes?: string;
}

interface Props {
  ingredients: Ingredient[];
  servings?: number;
  title?: string;
}

const { ingredients, servings = 4, title = 'Ingrédients' } = Astro.props;

const groupedIngredients = ingredients.reduce((acc: Record<string, Ingredient[]>, ing: Ingredient) => {
  const group = ing.group || 'Principal';
  if (!acc[group]) acc[group] = [];
  acc[group].push(ing);
  return acc;
}, {});
---

<div class="recipe-ingredients" data-recipe-ingredients>
  <div class="recipe-ingredients-header">
    <h2 class="ingredients-title">{title}</h2>

    <div class="servings-adjuster" data-servings-adjuster>
      <label for="recipe-servings">Portions</label>
      <div class="servings-input-group">
        <button class="servings-btn" aria-label="Diminuer les portions" data-action="decrease" type="button">−</button>
        <input
          type="number"
          id="recipe-servings"
          name="servings"
          value={servings}
          min="1"
          max="20"
          step="1"
          class="servings-input"
          aria-label="Nombre de portions"
        />
        <button class="servings-btn" aria-label="Augmenter les portions" data-action="increase" type="button">+</button>
      </div>
      <span class="servings-status" role="status" aria-live="polite"></span>
    </div>
  </div>

  {Object.entries(groupedIngredients).map(([group, items]) => {
    const groupId = `ingredient-group-${String(group).replace(/\s+/g, '-').toLowerCase()}`;
    return (
      <section class="ingredient-group" aria-labelledby={groupId}>
        {group !== 'Principal' && (
          <h3 class="group-title" id={groupId}>{group}</h3>
        )}

        <ul class="ingredients-list">
          {items.map((ingredient) => (
            <li class="ingredient-item">
              <div class="ingredient-amount">
                <span class="amount" data-amount={ingredient.amount}>
                  {ingredient.amount}
                </span>
                {ingredient.unit && <span class="unit">{ingredient.unit}</span>}
              </div>
              <div class="ingredient-details">
                <span class="name">{ingredient.name}</span>
                {ingredient.notes && <span class="notes">{ingredient.notes}</span>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</div>

<style>
  .recipe-ingredients {
    margin: 2.5rem 0;
    border: 1px solid var(--lcdb-border);
    border-radius: 12px;
    background: #f8f5ee;
    padding: 2rem;
    transition: opacity 0.2s ease;
  }

  .recipe-ingredients.is-updating {
    opacity: 0.8;
  }

  .recipe-ingredients-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }

  .ingredients-title {
    margin: 0;
    color: var(--lcdb-heading);
    font-family: var(--font-heading);
    font-size: 2rem;
    line-height: 1.05;
  }

  .servings-adjuster {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .servings-adjuster label {
    color: var(--lcdb-heading);
    font-family: var(--font-button);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .servings-input-group {
    display: inline-flex;
    align-items: center;
    gap: 0;
    overflow: hidden;
    border: 1px solid var(--lcdb-border);
    border-radius: 999px;
    background: #ffffff;
  }

  .servings-btn,
  .servings-input {
    min-height: 40px;
  }

  .servings-btn {
    width: 40px;
    border: 0;
    background: transparent;
    color: var(--lcdb-accent);
    cursor: pointer;
    font-size: 1.1rem;
    font-weight: 600;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .servings-btn:hover,
  .servings-btn:focus-visible {
    background: #f0ece1;
    color: var(--lcdb-heading);
    outline: none;
  }

  .servings-input {
    width: 54px;
    border: 0;
    background: transparent;
    color: var(--lcdb-heading);
    text-align: center;
    font-size: 1rem;
    font-weight: 600;
    outline: none;
  }

  .servings-status {
    min-width: 120px;
    color: var(--lcdb-muted);
    font-size: 0.88rem;
  }

  .ingredient-group + .ingredient-group {
    margin-top: 1.75rem;
  }

  .group-title {
    margin: 0 0 0.9rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--lcdb-border);
    color: var(--lcdb-heading);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .ingredients-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ingredient-item {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgba(216, 210, 194, 0.7);
  }

  .ingredient-item:last-child {
    border-bottom: 0;
  }

  .ingredient-amount {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .amount {
    color: var(--lcdb-heading);
    font-family: var(--font-button);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .unit {
    color: var(--lcdb-muted);
    font-size: 0.84rem;
  }

  .ingredient-details {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .name {
    color: var(--lcdb-copy);
    font-size: 1rem;
    line-height: 1.6;
  }

  .notes {
    color: var(--lcdb-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .recipe-ingredients {
      padding: 1.35rem;
      margin: 1.75rem 0;
    }

    .ingredients-title {
      font-size: 1.65rem;
    }

    .ingredient-item {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>

<script>
  const parseFractionalAmount = (rawValue) => {
    const value = String(rawValue || '').trim().replace(',', '.');
    if (!value) return null;

    if (/^\d+(\.\d+)?$/.test(value)) {
      return Number(value);
    }

    const mixedMatch = value.match(/^(\d+)\s+(\d+)\/(\d+)$/);
    if (mixedMatch) {
      const whole = Number(mixedMatch[1]);
      const numerator = Number(mixedMatch[2]);
      const denominator = Number(mixedMatch[3]);
      if (denominator) return whole + numerator / denominator;
    }

    const fractionMatch = value.match(/^(\d+)\/(\d+)$/);
    if (fractionMatch) {
      const numerator = Number(fractionMatch[1]);
      const denominator = Number(fractionMatch[2]);
      if (denominator) return numerator / denominator;
    }

    return null;
  };

  const formatScaledAmount = (value) => {
    if (!Number.isFinite(value)) return '';
    if (value >= 10) return Math.round(value).toString();
    if (value >= 1) return value.toFixed(1).replace(/\.0$/, '');
    return value.toFixed(2).replace(/0$/, '').replace(/\.0$/, '');
  };

  document.querySelectorAll('[data-servings-adjuster]').forEach((adjuster) => {
    const wrapper = adjuster.closest('[data-recipe-ingredients]');
    const input = adjuster.querySelector('.servings-input');
    const decreaseBtn = adjuster.querySelector('[data-action="decrease"]');
    const increaseBtn = adjuster.querySelector('[data-action="increase"]');
    const status = adjuster.querySelector('.servings-status');

    if (!(input instanceof HTMLInputElement) || !(wrapper instanceof HTMLElement)) return;

    const baseServings = parseInt(input.value, 10) || 4;
    const amountNodes = wrapper.querySelectorAll('.ingredient-amount .amount');

    const updateAmounts = (nextServings) => {
      wrapper.classList.add('is-updating');
      const multiplier = nextServings / baseServings;

      amountNodes.forEach((amountNode) => {
        const rawAmount = amountNode.getAttribute('data-amount');
        const parsedAmount = parseFractionalAmount(rawAmount);
        if (parsedAmount === null) return;
        amountNode.textContent = formatScaledAmount(parsedAmount * multiplier);
      });

      if (status) {
        status.textContent = `${nextServings} portion${nextServings > 1 ? 's' : ''}`;
      }

      window.setTimeout(() => {
        wrapper.classList.remove('is-updating');
      }, 120);
    };

    const clampServings = (value) => Math.min(20, Math.max(1, value || baseServings));

    decreaseBtn?.addEventListener('click', () => {
      const current = clampServings(parseInt(input.value, 10));
      const next = clampServings(current - 1);
      input.value = String(next);
      updateAmounts(next);
    });

    increaseBtn?.addEventListener('click', () => {
      const current = clampServings(parseInt(input.value, 10));
      const next = clampServings(current + 1);
      input.value = String(next);
      updateAmounts(next);
    });

    input.addEventListener('change', () => {
      const next = clampServings(parseInt(input.value, 10));
      input.value = String(next);
      updateAmounts(next);
    });

    updateAmounts(baseServings);
  });
</script>

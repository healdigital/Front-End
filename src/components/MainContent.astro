---
import Pagination from './Pagination.astro';
import GlobalSidebar from './GlobalSidebar.astro';
import { processArticleImageUrl } from '../utils/cdnUrlReplacer';

interface Props {
  latestArticles: any[];
  currentLang?: string;
  currentPage?: number;
  totalPages?: number;
}

const { latestArticles = [], currentLang = 'fr', currentPage = 1, totalPages = 1 } = Astro.props;

const getArticleSlug = (article: any) => {
  if (!article) return '';
  if (typeof article.slug === 'string') return article.slug;
  if (article.slug?.current) return article.slug.current;
  return '';
};

const getArticleTitle = (article: any) => {
  if (typeof article?.title === 'string') return article.title;
  if (typeof article?.title?.rendered === 'string') return article.title.rendered.replace(/<[^>]*>/g, '');
  if (typeof article?.title?.value === 'string') return article.title.value;
  return 'Article';
};

const decodeHtmlEntities = (text: string) =>
  text
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'");

const getExcerpt = (article: any) => {
  const excerptSource =
    typeof article?.excerpt === 'string'
      ? article.excerpt
      : typeof article?.excerpt?.rendered === 'string'
        ? article.excerpt.rendered
        : typeof article?.content === 'string'
          ? article.content
          : '';

  const text = decodeHtmlEntities(excerptSource.replace(/<[^>]*>/g, '').trim());
  if (!text) return 'Découvrez cette recette et ses détails pas à pas.';
  return text.length > 200 ? `${text.substring(0, 200)}...` : text;
};

const formatDate = (article: any) => {
  if (!article?.date) return '';
  return new Date(article.date).toLocaleDateString(currentLang === 'fr' ? 'fr-FR' : 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};

const shareLinks = {
  facebook: (url: string) => `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
  pinterest: (url: string) => `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}`,
  email: (url: string, title: string) =>
    `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`Découvrez cette recette : ${title} - ${url}`)}`,
};
---

<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <div class="mb-8">
        <h2 class="mb-8 text-3xl font-bold text-text-primary">
          Les dernières recettes
        </h2>

        <div class="space-y-6">
          {latestArticles.map((article) => {
            const title = getArticleTitle(article);
            const slug = getArticleSlug(article);
            const url = `/${String(slug || '').replace(/^\/+|\/+$/g, '')}/`;
            const imageSrc = processArticleImageUrl(article);

            return (
              <article class="overflow-hidden rounded-[10px] border border-border-primary bg-primary-white shadow-[0_6px_18px_rgba(17,17,17,0.04)] transition duration-300 hover:-translate-y-[2px] hover:shadow-[0_10px_24px_rgba(17,17,17,0.08)] focus-within:-translate-y-[2px] focus-within:shadow-[0_10px_24px_rgba(17,17,17,0.08)] focus-within:ring-2 focus-within:ring-primary-turquoise/40">
                <div class="flex flex-col gap-4 p-4 sm:flex-row">
                  <div class="sm:h-40 sm:w-40 shrink-0 overflow-hidden rounded-lg bg-[#efe9dc]">
                    {imageSrc ? (
                      <img
                        src={imageSrc}
                        alt={title}
                        class="h-40 w-full object-cover transition-transform duration-300 hover:scale-[1.04] sm:h-full"
                        loading="lazy"
                        decoding="async"
                        width="320"
                        height="320"
                        sizes="160px"
                      />
                    ) : (
                      <div class="flex h-40 w-full items-center justify-center text-text-tertiary sm:h-full">
                        <span aria-hidden="true" class="text-3xl">+</span>
                      </div>
                    )}
                  </div>

                  <div class="flex flex-1 flex-col">
                    <h3 class="mb-2 text-lg font-semibold text-text-primary">
                      <a
                        href={url}
                        class="rounded-sm transition-colors duration-200 hover:text-primary-turquoise focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-turquoise/60"
                      >
                        {title}
                      </a>
                    </h3>

                    <div class="mb-3 text-xs text-text-secondary">
                      {formatDate(article)}
                    </div>

                    <p class="mb-4 flex-grow text-sm leading-7 text-text-secondary line-clamp-3">
                      {getExcerpt(article)}
                    </p>

                    <a
                      href={url}
                      class="mb-4 inline-flex items-center text-[13px] font-medium text-primary-turquoise underline underline-offset-4 transition-colors duration-200 hover:text-[#3f9f9a]"
                      aria-label={`Lire l’article : ${title}`}
                    >
                      Lire la suite
                    </a>

                    <div class="flex gap-3 border-t border-border-primary pt-3">
                      <a
                        href={shareLinks.facebook(url)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[#1877F2] transition-colors duration-200 hover:opacity-80"
                        title="Partager sur Facebook"
                        aria-label={`Partager l’article sur Facebook : ${title}`}
                      >
                        <i class="fab fa-facebook-f w-5 h-5"></i>
                      </a>
                      <a
                        href={shareLinks.pinterest(url)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[#E60023] transition-colors duration-200 hover:opacity-80"
                        title="Partager sur Pinterest"
                        aria-label={`Partager l’article sur Pinterest : ${title}`}
                      >
                        <i class="fab fa-pinterest w-5 h-5"></i>
                      </a>
                      <a
                        href={shareLinks.email(url, title)}
                        class="text-text-secondary transition-colors duration-200 hover:text-text-primary"
                        title="Partager par email"
                        aria-label={`Partager l’article par email : ${title}`}
                      >
                        <i class="fas fa-envelope w-5 h-5"></i>
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="" />
      </div>
    </div>

    <GlobalSidebar />
  </div>
</div>

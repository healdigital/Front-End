---
import { processArticleImageUrl } from '../utils/cdnUrlReplacer';

interface Props {
  allArticles: any[];
}

const { allArticles = [] } = Astro.props;

const toText = (value: any) => String(value || '').trim().toLowerCase();

const articleCategories = (article: any): string[] => {
  if (!article || !Array.isArray(article.categories)) return [];

  return article.categories
    .map((cat: any) => {
      if (typeof cat === 'string') return toText(cat);
      return toText(cat?.title || cat?.name || cat?.slug?.current || cat?.slug);
    })
    .filter(Boolean);
};

const includesAny = (values: string[], targets: string[]) =>
  values.some((value) => targets.some((target) => value.includes(target)));

const sweetKeywords = ['sweet', 'dessert', 'cake', 'cookie', 'chocolate', 'tarte', 'pastry'];
const savoryKeywords = ['savory', 'salty', 'meat', 'fish', 'chicken', 'pasta', 'salad'];

const sweetArticles = allArticles.filter((article: any) => includesAny(articleCategories(article), sweetKeywords));
const savoryArticles = allArticles.filter((article: any) => includesAny(articleCategories(article), savoryKeywords));

const displaySweet = sweetArticles.length > 0 ? sweetArticles.slice(0, 6) : allArticles.slice(0, 6);
const displaySavory = savoryArticles.length > 0 ? savoryArticles.slice(0, 6) : allArticles.slice(6, 12);

const getArticleTitle = (article: any) =>
  typeof article?.title === 'string'
    ? article.title
    : article?.title?.rendered || article?.title?.value || 'Recette';

const getArticleSlug = (article: any) => article.slug?.current || article.slug || article._id;
const getExcerpt = (article: any, fallback: string) =>
  article?.excerpt?.[0]?.children?.[0]?.text ||
  article?.excerpt?.rendered?.replace(/<[^>]*>/g, '').trim() ||
  fallback;
---

<section class="mx-auto max-w-7xl border-t border-border-primary px-4 py-16 sm:px-6 lg:px-8">
  <h2 class="mb-12 text-center font-heading text-[42px] leading-none text-text-primary md:text-[50px]">
    Recettes sucrées
  </h2>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {displaySweet.map((article) => (
      <a href={`/${getArticleSlug(article)}`} class="group">
        <article class="overflow-hidden rounded-[10px] border border-border-primary bg-primary-white shadow-[0_6px_18px_rgba(17,17,17,0.04)] transition duration-300 group-hover:-translate-y-[2px] group-hover:shadow-[0_10px_24px_rgba(17,17,17,0.08)]">
          <div class="relative h-48 overflow-hidden bg-[#efe9dc]">
            {processArticleImageUrl(article) ? (
              <img
                src={processArticleImageUrl(article)}
                alt={getArticleTitle(article)}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.04]"
                loading="lazy"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center text-primary-turquoise">
                <i class="fas fa-utensils text-4xl" aria-hidden="true"></i>
              </div>
            )}
          </div>

          <div class="p-4">
            <h3 class="mb-2 text-lg font-semibold text-text-primary transition-colors duration-200 group-hover:text-primary-turquoise line-clamp-2">
              {getArticleTitle(article)}
            </h3>
            <p class="text-sm text-text-secondary line-clamp-2">
              {getExcerpt(article, 'Délicieuse recette sucrée.')}
            </p>
          </div>
        </article>
      </a>
    ))}
  </div>
</section>

<section class="mx-auto max-w-7xl border-t border-border-primary px-4 py-16 sm:px-6 lg:px-8">
  <h2 class="mb-12 text-center font-heading text-[42px] leading-none text-text-primary md:text-[50px]">
    Recettes salées
  </h2>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {displaySavory.map((article) => (
      <a href={`/${getArticleSlug(article)}`} class="group">
        <article class="overflow-hidden rounded-[10px] border border-border-primary bg-primary-white shadow-[0_6px_18px_rgba(17,17,17,0.04)] transition duration-300 group-hover:-translate-y-[2px] group-hover:shadow-[0_10px_24px_rgba(17,17,17,0.08)]">
          <div class="relative h-48 overflow-hidden bg-[#efe9dc]">
            {processArticleImageUrl(article) ? (
              <img
                src={processArticleImageUrl(article)}
                alt={getArticleTitle(article)}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.04]"
                loading="lazy"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center text-primary-turquoise">
                <i class="fas fa-utensils text-4xl" aria-hidden="true"></i>
              </div>
            )}
          </div>

          <div class="p-4">
            <h3 class="mb-2 text-lg font-semibold text-text-primary transition-colors duration-200 group-hover:text-primary-turquoise line-clamp-2">
              {getArticleTitle(article)}
            </h3>
            <p class="text-sm text-text-secondary line-clamp-2">
              {getExcerpt(article, 'Délicieuse recette salée.')}
            </p>
          </div>
        </article>
      </a>
    ))}
  </div>
</section>

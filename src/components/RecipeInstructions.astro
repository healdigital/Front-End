---
interface RecipeStep {
  group?: string;
  number: number;
  instruction: string;
  time?: number;
  tips?: string[];
}

interface Props {
  steps: RecipeStep[];
  title?: string;
}

const { steps, title = 'Préparation' } = Astro.props;

const groupedSteps = steps.reduce((acc: Record<string, RecipeStep[]>, step: RecipeStep) => {
  const group = step.group || 'Préparation';
  if (!acc[group]) acc[group] = [];
  acc[group].push(step);
  return acc;
}, {});
---

<div class="recipe-instructions" data-recipe-instructions>
  <div class="instructions-header">
    <h2 class="instructions-title">{title}</h2>
    <button type="button" class="instructions-reset" data-reset-steps hidden>Réinitialiser les étapes</button>
  </div>

  {Object.entries(groupedSteps).map(([group, groupSteps]) => {
    const groupId = `instruction-group-${String(group).replace(/\s+/g, '-').toLowerCase()}`;
    return (
      <section class="instruction-group" aria-labelledby={groupId}>
        {group !== 'Préparation' && (
          <h3 class="group-title" id={groupId}>{group}</h3>
        )}

        <ol class="steps-list">
          {groupSteps.map((step, index) => {
            const stepNumber = step.number || index + 1;
            return (
              <li class="step-item" data-step-item>
                <div class="step-header">
                  <button
                    type="button"
                    class="step-toggle"
                    data-step-toggle
                    aria-pressed="false"
                    aria-label={`Marquer l'étape ${stepNumber} comme terminée`}
                  >
                    <span class="step-number" aria-hidden="true">{stepNumber}</span>
                    <span class="step-check" aria-hidden="true">✓</span>
                  </button>

                  <div class="step-content">
                    <p class="step-instruction">{step.instruction}</p>
                    {step.time && (
                      <p class="step-time" aria-label={`Temps estimé : ${step.time} minutes`}>
                        Temps estimé : {step.time} min
                      </p>
                    )}
                  </div>
                </div>

                {step.tips && step.tips.length > 0 && (
                  <aside class="step-tips" aria-label={`Astuces pour l'étape ${stepNumber}`}>
                    <p class="step-tips-title">Astuce</p>
                    <ul class="step-tips-list">
                      {step.tips.map((tip) => (
                        <li>{tip}</li>
                      ))}
                    </ul>
                  </aside>
                )}
              </li>
            );
          })}
        </ol>
      </section>
    );
  })}
</div>

<style>
  .recipe-instructions {
    margin: 2.5rem 0;
  }

  .instructions-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .instructions-title {
    margin: 0;
    color: var(--lcdb-heading);
    font-family: var(--font-heading);
    font-size: 2rem;
    line-height: 1.05;
  }

  .instructions-reset {
    border: 0;
    background: transparent;
    color: var(--lcdb-accent);
    font-family: var(--font-button);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-transform: uppercase;
  }

  .instruction-group + .instruction-group {
    margin-top: 2rem;
  }

  .group-title {
    margin: 0 0 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--lcdb-border);
    color: var(--lcdb-heading);
    font-size: 1.12rem;
    font-weight: 600;
  }

  .steps-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .step-item {
    padding: 1.25rem;
    border: 1px solid var(--lcdb-border);
    border-radius: 12px;
    background: #f8f5ee;
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .step-item.is-complete {
    background: #eef7f6;
    border-color: rgba(84, 182, 177, 0.42);
    box-shadow: 0 10px 24px rgba(84, 182, 177, 0.08);
  }

  .step-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .step-toggle {
    position: relative;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border: 0;
    border-radius: 999px;
    background: var(--lcdb-accent);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }

  .step-toggle:hover,
  .step-toggle:focus-visible {
    transform: translateY(-1px);
    outline: none;
    box-shadow: 0 0 0 3px rgba(84, 182, 177, 0.2);
  }

  .step-number,
  .step-check {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
    transition: opacity 0.2s ease;
  }

  .step-check {
    opacity: 0;
  }

  .step-item.is-complete .step-number {
    opacity: 0;
  }

  .step-item.is-complete .step-check {
    opacity: 1;
  }

  .step-content {
    flex: 1;
  }

  .step-instruction {
    margin: 0;
    color: var(--lcdb-copy);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .step-time {
    margin: 0.6rem 0 0;
    color: var(--lcdb-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .step-tips {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(216, 210, 194, 0.72);
  }

  .step-tips-title {
    margin: 0 0 0.45rem;
    color: var(--lcdb-heading);
    font-family: var(--font-button);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .step-tips-list {
    margin: 0;
    padding-left: 1rem;
    color: var(--lcdb-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    .recipe-instructions {
      margin: 1.75rem 0;
    }

    .instructions-title {
      font-size: 1.65rem;
    }

    .step-item {
      padding: 1rem;
    }

    .step-header {
      gap: 0.85rem;
    }

    .step-toggle {
      width: 38px;
      height: 38px;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-recipe-instructions]').forEach((wrapper) => {
    const stepItems = wrapper.querySelectorAll('[data-step-item]');
    const toggles = wrapper.querySelectorAll('[data-step-toggle]');
    const resetButton = wrapper.querySelector('[data-reset-steps]');

    if (toggles.length === 0 || !(resetButton instanceof HTMLButtonElement)) return;

    const syncResetVisibility = () => {
      const completedCount = wrapper.querySelectorAll('[data-step-item].is-complete').length;
      resetButton.hidden = completedCount === 0;
    };

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const item = toggle.closest('[data-step-item]');
        if (!(item instanceof HTMLElement)) return;

        const willComplete = !item.classList.contains('is-complete');
        item.classList.toggle('is-complete', willComplete);
        toggle.setAttribute('aria-pressed', String(willComplete));
        syncResetVisibility();
      });
    });

    resetButton.addEventListener('click', () => {
      stepItems.forEach((item) => item.classList.remove('is-complete'));
      toggles.forEach((toggle) => toggle.setAttribute('aria-pressed', 'false'));
      syncResetVisibility();
    });

    syncResetVisibility();
  });
</script>

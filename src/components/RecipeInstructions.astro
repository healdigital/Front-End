---
interface RecipeStep {
  group?: string;
  number: number;
  instruction: string;
  time?: number;
  tips?: string[];
}

interface Props {
  steps: RecipeStep[];
  title?: string;
}

const { steps, title = 'Préparation' } = Astro.props;

const groupedSteps = steps.reduce((acc: any, step: RecipeStep) => {
  const group = step.group || 'Préparation';
  if (!acc[group]) acc[group] = [];
  acc[group].push(step);
  return acc;
}, {});
---

<div class="recipe-instructions">
  <h2 class="instructions-title">{title}</h2>

  {Object.entries(groupedSteps).map(([group, groupSteps]: any) => (
    <section class="instruction-group" aria-labelledby={`instruction-group-${String(group).replace(/\s+/g, '-').toLowerCase()}`}>
      {group !== 'Préparation' && (
        <h3 class="group-title" id={`instruction-group-${String(group).replace(/\s+/g, '-').toLowerCase()}`}>
          {group}
        </h3>
      )}

      <ol class="steps-list">
        {groupSteps.map((step: RecipeStep, index: number) => (
          <li class="step-item">
            <div class="step-header">
              <span class="step-number" aria-label={`Étape ${step.number || index + 1}`}>{step.number || index + 1}</span>
              <div class="step-content">
                <p class="step-instruction">{step.instruction}</p>
                {step.time && (
                  <div class="step-time" aria-label={`Temps estimé : ${step.time} minutes`}>
                    <span class="time-label">Temps :</span>
                    <span>{step.time} min</span>
                  </div>
                )}
              </div>
            </div>

            {step.tips && step.tips.length > 0 && (
              <aside class="step-tips" aria-label="Astuces">
                {step.tips.map((tip: string) => (
                  <div class="tip">
                    <span class="tip-label">Astuce :</span>
                    <span>{tip}</span>
                  </div>
                ))}
              </aside>
            )}
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>

<style>
  .recipe-instructions {
    margin: 2.5rem 0;
  }

  .instructions-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--lcdb-heading);
    margin: 0 0 2rem 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .instruction-group {
    margin-bottom: 2rem;
  }

  .instruction-group:last-child {
    margin-bottom: 0;
  }

  .group-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--lcdb-heading);
    margin: 0 0 1.5rem 0;
    padding: 0 0 0.75rem 0;
    text-transform: capitalize;
    border-bottom: 2px solid var(--lcdb-accent);
  }

  .steps-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .step-item {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: #f9f9f9;
    border-radius: 8px;
    border-left: 4px solid var(--lcdb-accent);
    transition: all 0.3s ease;
  }

  .step-item:hover {
    background: #f0f7f6;
    box-shadow: 0 4px 8px rgba(84, 182, 177, 0.1);
  }

  .step-item:last-child {
    margin-bottom: 0;
  }

  .step-header {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .step-number {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background: var(--lcdb-accent);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 700;
    margin-top: 0.2rem;
  }

  .step-content {
    flex: 1;
  }

  .step-instruction {
    font-size: 1.05rem;
    color: var(--lcdb-heading);
    line-height: 1.7;
    margin: 0 0 0.75rem 0;
  }

  .step-time {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--lcdb-copy);
    font-weight: 500;
  }

  .time-label {
    font-weight: 600;
  }

  .step-tips {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #e9ecef;
  }

  .tip {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 0.95rem;
    color: var(--lcdb-copy);
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }

  .tip:last-child {
    margin-bottom: 0;
  }

  .tip-label {
    flex-shrink: 0;
    font-weight: 600;
    color: var(--lcdb-accent);
  }

  @media (max-width: 768px) {
    .instructions-title {
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .step-item {
      padding: 1rem;
      margin-bottom: 1.5rem;
    }

    .step-header {
      gap: 1rem;
    }

    .step-number {
      width: 36px;
      height: 36px;
      font-size: 1rem;
    }

    .step-instruction {
      font-size: 1rem;
      margin-bottom: 0.5rem;
    }

    .group-title {
      font-size: 1.1rem;
      margin-bottom: 1rem;
    }
  }

  @media print {
    .step-item {
      page-break-inside: avoid;
      border-left: 2px solid #333;
      background: #ffffff;
      box-shadow: none;
    }

    .step-number {
      background: #333;
    }

    .step-item:hover {
      background: #ffffff;
    }
  }
</style>

---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary' | 'disabled';
  size?: 'sm' | 'md' | 'lg';
  isDisabled?: boolean;
  href?: string;
}

const {
  variant = 'primary',
  size = 'md',
  isDisabled = false,
  href,
  class: className,
  type = 'button',
  ...rest
} = Astro.props;

const baseStyles = "inline-flex items-center justify-center font-button rounded border border-transparent btn-hover-transition btn-state-transition focus:outline-none focus:ring-2 focus:ring-offset-2";

const variants: Record<string, string> = {
  primary: "bg-primary-turquoise text-primary-black hover:bg-opacity-90 active:scale-95 focus:ring-primary-turquoise",
  secondary: "bg-primary-white border-primary-black text-primary-black hover:bg-gray-50 active:scale-95 focus:ring-primary-black",
  disabled: "bg-status-disabled text-primary-white cursor-not-allowed opacity-70"
};

const sizes: Record<string, string> = {
  sm: "px-3 py-1.5 text-sm",
  md: "px-4 py-2 text-base",
  lg: "px-6 py-3 text-lg"
};

const classes = [
  baseStyles,
  variants[variant],
  sizes[size],
  className
].join(" ");
---

{href && variant !== 'disabled' ? (
  <a href={href} class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button
    type={type}
    class={classes}
    disabled={isDisabled || variant === 'disabled'}
    aria-disabled={isDisabled || variant === 'disabled'}
    {...rest}
  >
    <slot />
  </button>
)}

<style>
  .btn-hover-transition {
    transition-property: transform, background-color, color, border-color, box-shadow, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease;
  }

  .btn-state-transition:active,
  .btn-state-transition:focus-visible,
  .btn-state-transition[aria-disabled='true'] {
    transition-duration: 0.2s;
    transition-timing-function: ease;
  }
</style>

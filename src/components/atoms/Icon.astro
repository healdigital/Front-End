/**
 * Props for the `Icon` atom.
 */
interface Props extends HTMLAttributes<'svg'> {
  /** Icon glyph identifier. */
  name: 'check' | 'close' | 'menu' | 'search' | 'user' | 'arrow-right' | 'star' | 'chevron-down' | 'lock' | 'facebook' | 'instagram' | 'pinterest' | 'youtube' | 'mail' | 'video' | 'download' | 'refresh' | 'loading' | 'book' | 'users' | 'map-pin' | 'clock' | 'heart' | 'utensils' | 'euro-sign' | 'shopping-bag' | 'globe' | 'nav-books' | 'nav-savory' | 'nav-sweet' | 'nav-workshops' | 'nav-video-course' | 'nav-travel' | 'nav-reportage' | 'nav-featured'; // extensible list

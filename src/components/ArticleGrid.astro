---
import { payloadFetch } from '../lib/payload.client';
import { processArticleImageUrl } from '../utils/cdnUrlReplacer';

interface Props {
  limit?: number;
  language?: string;
}

const { limit = 12, language = 'fr' } = Astro.props;

// Fetch articles from PayloadCMS
let articles = [];
try {
  const response = await payloadFetch({
    collection: 'articles',
    endpoint: `/collections/articles?limit=${limit}&depth=2`
  });
  
  articles = response?.docs || [];
  
  // Filter by language if specified
  if (language) {
    articles = articles.filter((a: any) => a.language === language);
  }
} catch (error) {
  console.error('Error fetching articles:', error);
}
---

<div class="articles-grid">
  {articles.length === 0 ? (
    <p class="no-articles">Aucun article trouvé</p>
  ) : (
    articles.map((article: any) => {
      const imageSrc = processArticleImageUrl(article);
      const articleTitle =
        typeof article?.title === 'string'
          ? article.title
          : article?.title?.rendered || article?.title?.value || 'Article';

      return (
      <article class="article-card">
        {imageSrc && (
          <div class="article-image">
            <img 
              src={imageSrc} 
              alt={article.featured_image_alt || articleTitle}
              loading="lazy"
              decoding="async"
              width="640"
              height="400"
              sizes="(min-width: 1280px) 28vw, (min-width: 768px) 44vw, 92vw"
            />
          </div>
        )}
        
        <div class="article-content">
          <h3 class="article-title">
            <a href={`/articles/${article.slug}`}>
              {articleTitle}
            </a>
          </h3>
          
          <p class="article-excerpt">
            {article.excerpt || article.content?.substring(0, 150)}
          </p>
          
          <div class="article-meta">
            <span class="article-author">Par {article.author}</span>
            <span class="article-date">
              {new Date(article.date).toLocaleDateString()}
            </span>
            <span class="article-lang" data-lang={article.language}>
              {article.language.toUpperCase()}
            </span>
          </div>
          
          <a href={`/articles/${article.slug}`} class="read-more" aria-label={`Lire l’article : ${articleTitle}`}>
            Lire la suite →
          </a>
        </div>
      </article>
    )})
  )}
</div>

<style>
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    padding: 2rem 0;
  }
  
  .article-card {
    background: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  
  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }
  
  .article-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: var(--lcdb-surface);
  }
  
  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .article-content {
    padding: 1.5rem;
  }
  
  .article-title {
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
    line-height: 1.4;
  }
  
  .article-title a {
    color: var(--lcdb-heading);
    text-decoration: none;
  }
  
  .article-title a:hover {
    color: var(--lcdb-accent);
  }
  
  .article-excerpt {
    color: var(--lcdb-copy);
    margin: 1rem 0;
    line-height: 1.6;
  }
  
  .article-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--lcdb-muted);
    margin: 1rem 0;
    flex-wrap: wrap;
  }
  
  .article-lang {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    background: var(--lcdb-surface);
    border-radius: 4px;
    font-weight: 600;
  }
  
  .read-more {
    display: inline-block;
    color: var(--lcdb-accent);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s;
  }
  
  .read-more:hover {
    color: #137f74;
  }
  
  .no-articles {
    grid-column: 1 / -1;
    text-align: center;
    padding: 2rem;
    color: var(--lcdb-muted);
  }
</style>

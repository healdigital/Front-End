---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div id="comments-list-container" class="mt-12 border-t border-border-primary pt-8">
  <h2 class="mb-6 font-heading text-[32px] leading-none text-text-primary">
    Commentaires (<span id="comment-count">0</span>)
  </h2>
  <div id="comments-display" class="space-y-6" role="status" aria-live="polite">
    <p class="text-text-secondary">Chargement des commentaires...</p>
  </div>
</div>

<script define:vars={{ slug }}>
  async function loadComments() {
    const container = document.getElementById('comments-display');
    const countEl = document.getElementById('comment-count');

    if (!(container instanceof HTMLElement) || !(countEl instanceof HTMLElement)) {
      return;
    }

    try {
      const url = `/api/comments?slug=${encodeURIComponent(slug)}`;
      const response = await fetch(url, { cache: 'no-store' });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      const comments = await response.json();
      const commentList = Array.isArray(comments) ? comments : [];
      countEl.textContent = String(commentList.length);

      if (commentList.length === 0) {
        container.innerHTML =
          '<p class="text-text-secondary">Aucun commentaire pour le moment. Soyez le premier à partager votre avis.</p>';
        return;
      }

      container.innerHTML = commentList
        .map((comment) => {
          const date = new Date(comment.date).toLocaleDateString('fr-FR', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });

          return `
            <article class="rounded-[10px] border border-border-primary bg-secondary-beige-light p-5">
              <div class="mb-2 flex items-center justify-between gap-4">
                <h3 class="font-body text-[16px] font-semibold text-text-primary">${comment.author || 'Anonyme'}</h3>
                <time class="text-[12px] uppercase tracking-[0.12em] text-text-secondary">${date}</time>
              </div>
              ${comment.email ? `<p class="mb-3 text-[12px] text-text-secondary">${comment.email}</p>` : ''}
              <p class="leading-[1.75] text-text-secondary">${comment.content || ''}</p>
              ${
                comment.approved === false
                  ? '<p class="mt-3 text-[12px] uppercase tracking-[0.12em] text-status-premium">En attente de modération</p>'
                  : ''
              }
            </article>
          `;
        })
        .join('');
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Erreur inconnue';
      container.innerHTML = `<p class="text-status-error">Impossible de charger les commentaires pour le moment (${message}).</p>`;
    }
  }

  loadComments();

  window.setInterval(() => {
    loadComments();
  }, 15000);
</script>

---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div id="comments-list-container" class="mt-12 border-t border-border-primary pt-8">
  <h2 class="mb-6 font-heading text-[32px] leading-none text-text-primary">
    Commentaires (<span id="comment-count">0</span>)
  </h2>
  <div id="comments-display" class="space-y-6" role="status" aria-live="polite">
    <p class="text-text-secondary">Chargement des commentaires...</p>
  </div>
</div>

<script define:vars={{ slug }}>
  const EMPTY_MESSAGE = 'Aucun commentaire pour le moment. Soyez le premier à partager votre avis.';
  const ERROR_PREFIX = 'Impossible de charger les commentaires pour le moment';

  function clearElement(element) {
    while (element.firstChild) {
      element.removeChild(element.firstChild);
    }
  }

  function appendParagraph(container, className, text) {
    const paragraph = document.createElement('p');
    paragraph.className = className;
    paragraph.textContent = text;
    container.appendChild(paragraph);
  }

  function renderComments(container, comments) {
    clearElement(container);

    if (comments.length === 0) {
      appendParagraph(container, 'text-text-secondary', EMPTY_MESSAGE);
      return;
    }

    comments.forEach((comment) => {
      const article = document.createElement('article');
      article.className = 'rounded-[10px] border border-border-primary bg-secondary-beige-light p-5';

      const header = document.createElement('div');
      header.className = 'mb-2 flex items-center justify-between gap-4';

      const title = document.createElement('h3');
      title.className = 'font-body text-[16px] font-semibold text-text-primary';
      title.textContent = comment.author || 'Anonyme';

      const time = document.createElement('time');
      time.className = 'text-[12px] uppercase tracking-[0.12em] text-text-secondary';
      time.textContent = new Date(comment.date).toLocaleDateString('fr-FR', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });

      header.append(title, time);
      article.appendChild(header);

      if (comment.email) {
        appendParagraph(article, 'mb-3 text-[12px] text-text-secondary', comment.email);
      }

      appendParagraph(article, 'leading-[1.75] whitespace-pre-line text-text-secondary', comment.content || '');

      if (comment.approved === false) {
        appendParagraph(
          article,
          'mt-3 text-[12px] uppercase tracking-[0.12em] text-status-premium',
          'En attente de modération',
        );
      }

      container.appendChild(article);
    });
  }

  async function loadComments() {
    const container = document.getElementById('comments-display');
    const countEl = document.getElementById('comment-count');

    if (!(container instanceof HTMLElement) || !(countEl instanceof HTMLElement)) {
      return;
    }

    try {
      const url = `/api/comments?slug=${encodeURIComponent(slug)}`;
      const response = await fetch(url, { cache: 'no-store' });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      const comments = await response.json();
      const commentList = Array.isArray(comments) ? comments : [];
      countEl.textContent = String(commentList.length);
      renderComments(container, commentList);
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Erreur inconnue';
      clearElement(container);
      appendParagraph(container, 'text-status-error', `${ERROR_PREFIX} (${message}).`);
    }
  }

  loadComments();

  window.setInterval(() => {
    loadComments();
  }, 15000);
</script>

---
/**
 * Full-page loader while client translation (DeepL + i18n) catches up to preferred language.
 */
---
<div
  id="lcdb-translation-loader"
  class="lcdb-translation-loader"
  role="status"
  aria-live="polite"
  aria-atomic="true"
>
  <span class="lcdb-translation-loader__spinner" aria-hidden="true"></span>
  <span class="lcdb-translation-loader__text">Traduction en cours…</span>
</div>

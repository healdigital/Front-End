---
interface Props {
  slot?: string;
  minHeight?: number;
  className?: string;
  hint?: 'all' | 'mobile' | 'desktop' | false;
}

const { slot = '', minHeight = 250, className = '', hint = 'all' } = Astro.props;
const style = `min-height: ${minHeight}px; width: 100%;`;
const baseClass =
  hint === false
    ? 'mv-ad-slot'
    : hint === 'mobile'
      ? 'content_mobile_hint'
      : hint === 'desktop'
        ? 'content_desktop_hint'
        : 'content_hint';
---

<div
  class={`${baseClass} ${className}`.trim()}
  data-lcdb-mediavine-slot={slot || undefined}
  data-lcdb-ad-slot="true"
  data-lcdb-ad-state="pending"
  data-no-translate="true"
  style={style}
  aria-hidden="true"
></div>

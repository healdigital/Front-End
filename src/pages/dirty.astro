---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticPage from "../components/StaticPage.astro";
---

<BaseLayout title="Savory">
  <StaticPage title="Savory" subtitle="Savory recipes and articles">
    <p>
      Savory (formerly labeled "DIRTY") is the home of comforting dishes,
      seasonal mains, and elegant starters. Expect classic French techniques
      mixed with modern twists and everyday-friendly ingredients.
    </p>

    <h2>What you'll find here</h2>
    <ul>
      <li>Appetizers and small plates</li>
      <li>Vegetable-forward mains</li>
      <li>Pasta, grains, and hearty bowls</li>
      <li>Seafood and poultry favorites</li>
      <li>Cooking tips and savory techniques</li>
    </ul>

    <p>
      Browse the latest savory ideas in the <a href="/articles">Articles</a>
      section.
    </p>

    <p>
      Savory indexes:
      <a href="/recettes-salees">with photos</a>
      and
      <a href="/le-sale">without photos</a>.
    </p>
  </StaticPage>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticPage from "../components/StaticPage.astro";
import StaticPageContent from "../components/StaticPageContent.astro";

const navLinks = [
  {
    label: "Mes livres",
    description: "Tous les ouvrages, extraits et aperçus.",
    active: true,
  },
  {
    label: "Chocolat maison",
    description: "Le livre consacré au chocolat et ses vidéos.",
    href: "/chocolat-maison/",
  },
];
---

<BaseLayout title="Mes livres">
  <StaticPage
    title="Mes livres"
    subtitle="Sommaires, aperçus et extraits de mes ouvrages."
    className="menu-page menu-page--books"
    navLinks={navLinks}
  >
    <StaticPageContent
      slug="mes-livres"
      sourceUrl="https://lacuisinedebernard.com/mes-livres/"
    />
  </StaticPage>
</BaseLayout>

<style is:global>
  .static-page.menu-page--books .static-page-content .separator:has(> a > img) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
    justify-items: stretch;
  }

  .static-page.menu-page--books .static-page-content .separator:has(> a > img) > a {
    display: block;
    margin: 0 !important;
  }

  .static-page.menu-page--books .static-page-content .separator:has(> a > img) > a > img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 900px) {
    .static-page.menu-page--books .static-page-content .separator:has(> a > img) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .static-page.menu-page--books .static-page-content .separator:has(> a > img) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticPage from "../components/StaticPage.astro";
import InfiniteGrid from "../components/InfiniteGrid.astro";
import RecipeCard from "../components/organisms/RecipeCard.astro";
import { getRecipeFeedBatch } from "../lib/recipeFeed.server";

const normalizeLanguageCode = (value: unknown): "fr" | "en" | "es" | "pt-br" | "ar" => {
  const raw = String(value || "").trim().toLowerCase();
  if (raw === "pt" || raw === "pt_br" || raw === "ptbr" || raw === "pt-pt") return "pt-br";
  if (raw === "en" || raw === "es" || raw === "pt-br" || raw === "ar") return raw;
  return "fr";
};

const navLinks = [
  {
    label: "Index des recettes sucrees avec photo",
    description: "Version illustree, ideale pour parcourir les desserts.",
    active: true,
  },
  {
    label: "Index des recettes sucrees sans photo",
    description: "Version compacte, centree sur les titres des recettes.",
    href: "/le-sucre/",
  },
];

const preferredLanguage = normalizeLanguageCode(Astro.cookies.get("lcdb_lang")?.value || "fr");
const initial = await getRecipeFeedBatch("sucrees", 1, 12, preferredLanguage);
const cards = initial.cards;
---

<BaseLayout title="Recettes sucrees">
  <StaticPage
    title="Recettes sucrees"
    subtitle="Index des recettes sucrees avec photo."
    className="menu-page menu-page--sweet-grid"
    navLinks={navLinks}
  >
    <InfiniteGrid
      gridClass="sweet-grid"
      ariaLabel="Recettes sucrees"
      totalCount={cards.length}
      initialCount={12}
      batchSize={12}
      endpoint="/api/recipe-feed.json?type=sucrees"
      nextPage={initial.nextPage}
    >
      {cards.map((card) => (
        <RecipeCard
          title={card.title}
          slug={card.href}
          image={card.image}
          imageFallback={card.imageFallback}
          imageAspect="square"
          description={card.excerpt}
          prepTime={card.time}
          difficulty={card.difficulty}
          category="SUCRE"
          showDescription={false}
          showReadMore={false}
          contentClass="archive-card-content"
        />
      ))}
    </InfiniteGrid>
  </StaticPage>
</BaseLayout>

<style is:global>
  .menu-page--sweet-grid .static-page-body {
    padding: clamp(14px, 2.2vw, 24px);
  }

  .menu-page--sweet-grid .sweet-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    max-width: 1220px;
    margin-inline: auto;
  }

  .menu-page--sweet-grid .sweet-card {
    display: flex;
    flex-direction: column;
    border: 1px solid #d8d2c2;
    border-radius: 14px;
    background: #f8f5ee;
    overflow: hidden;
    box-shadow: 0 14px 32px rgba(14, 24, 39, 0.06);
  }

  .menu-page--sweet-grid .sweet-card-media-link {
    display: block;
    color: inherit;
    text-decoration: none;
    line-height: 0;
  }

  .menu-page--sweet-grid .sweet-card-media {
    position: relative;
    aspect-ratio: 4 / 4.7;
    overflow: hidden;
    background: #ece5d8;
    line-height: 0;
  }

  .menu-page--sweet-grid .sweet-card-image {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center top;
    display: block;
    margin: 0 !important;
    border: 0 !important;
    box-shadow: none !important;
    border-radius: 0 !important;
  }

  .menu-page--sweet-grid .sweet-card-image--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7a7569;
    font-size: 0.92rem;
  }

  .menu-page--sweet-grid .sweet-card-badge {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: #67d5cf;
    color: #1a2335;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 24px rgba(24, 37, 57, 0.18);
  }

  .menu-page--sweet-grid .sweet-card-badge svg {
    width: 18px;
    height: 18px;
  }

  .menu-page--sweet-grid .sweet-card-content {
    padding: 0.9rem 0.9rem 1rem;
  }

  .menu-page--sweet-grid .sweet-card-meta {
    margin: 0;
    color: #787161;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .menu-page--sweet-grid .sweet-card-title {
    margin: 0.62rem 0 0;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid rgba(120, 113, 97, 0.18);
    font-family: var(--font-maison);
    font-size: 1.75rem;
    line-height: 1.18;
    color: #26231c;
  }

  .menu-page--sweet-grid .sweet-card-title a {
    color: inherit;
    text-decoration: none;
  }

  .menu-page--sweet-grid .sweet-card-excerpt {
    margin: 0.9rem 0 0;
    color: #655f54;
    font-size: 0.98rem;
    line-height: 1.72;
  }

  .menu-page--sweet-grid .sweet-card-cta {
    display: inline-flex;
    margin-top: 1rem;
    color: #54b6b1;
    font-family: var(--font-button);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
  }

  @media (max-width: 1100px) {
    .menu-page--sweet-grid .sweet-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 760px;
    }
  }

  @media (max-width: 720px) {
    .menu-page--sweet-grid .sweet-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 380px;
    }

    .menu-page--sweet-grid .sweet-card-title {
      font-size: 1.45rem;
    }
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticPage from "../components/StaticPage.astro";
import InfiniteGrid from "../components/InfiniteGrid.astro";
import RecipeCard from "../components/organisms/RecipeCard.astro";
import { getRecipeFeedBatch } from "../lib/recipeFeed.server";

const normalizeLanguageCode = (value: unknown): "fr" | "en" | "es" | "pt-br" | "ar" => {
  const raw = String(value || "").trim().toLowerCase();
  if (raw === "pt" || raw === "pt_br" || raw === "ptbr" || raw === "pt-pt") return "pt-br";
  if (raw === "en" || raw === "es" || raw === "pt-br" || raw === "ar") return raw;
  return "fr";
};

const navLinks = [
  {
    label: "Index des recettes salées avec photo",
    description: "Version illustrée, plus visuelle pour parcourir les recettes.",
    active: true,
  },
  {
    label: "Index des recettes salées sans photo",
    description: "Version compacte, plus rapide à scanner par titre.",
    href: "/le-sale/",
  },
];

const preferredLanguage = normalizeLanguageCode(Astro.cookies.get("lcdb_lang")?.value || "fr");
const initial = await getRecipeFeedBatch("salees", 1, 12, preferredLanguage);
const cards = initial.cards;
---

<BaseLayout title="Recettes salées">
  <StaticPage
    title="Recettes salées"
    subtitle="Index des recettes salées avec photo."
    className="menu-page menu-page--savory-grid"
    navLinks={navLinks}
  >
    <InfiniteGrid
      gridClass="savory-grid"
      ariaLabel="Recettes salées"
      totalCount={cards.length}
      initialCount={12}
      batchSize={12}
      endpoint="/api/recipe-feed.json?type=salees"
      nextPage={initial.nextPage}
    >
      {cards.map((card) => (
        <RecipeCard
          title={card.title}
          slug={card.href}
          image={card.image}
          imageFallback={card.imageFallback}
          imageAspect="square"
          description={card.excerpt}
          prepTime={card.prepTime}
          difficulty={card.difficulty}
          category="SALÉ"
          showDescription={false}
          showReadMore={false}
          contentClass="archive-card-content"
        />
      ))}
    </InfiniteGrid>
  </StaticPage>
</BaseLayout>

<style is:global>
  .menu-page--savory-grid .static-page-body {
    padding: clamp(14px, 2.2vw, 24px);
  }

  .menu-page--savory-grid .savory-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    max-width: 1220px;
    margin-inline: auto;
  }

  @media (max-width: 1100px) {
    .menu-page--savory-grid .savory-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 760px;
    }
  }

  @media (max-width: 720px) {
    .menu-page--savory-grid .savory-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 380px;
    }

    .menu-page--savory-grid .savory-card-title {
      font-size: 1.28rem;
    }

    .menu-page--savory-grid .savory-card-excerpt {
      font-size: 0.92rem;
    }
  }
</style>

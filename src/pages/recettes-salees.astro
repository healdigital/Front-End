---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticPage from "../components/StaticPage.astro";
import InfiniteGrid from "../components/InfiniteGrid.astro";
import {
  getPreparedArchiveArticles,
  getStaticArchiveEntries,
  type PreparedArchiveArticle,
} from "../lib/staticArchiveData";
import {
  buildWordPressImageFallbackCandidates,
  processArticleImageUrl,
} from "../utils/cdnUrlReplacer";
import { decodeHtmlEntities } from "../utils/decodeHtmlEntities";

const navLinks = [
  {
    label: "Index des recettes salÃ©es avec photo",
    description: "Version illustrÃ©e, plus visuelle pour parcourir les recettes.",
    active: true,
  },
  {
    label: "Index des recettes salÃ©es sans photo",
    description: "Version compacte, plus rapide Ã  scanner par titre.",
    href: "/le-sale/",
  },
];

const stripHtml = (value: string) =>
  String(value || "")
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const toText = (value: unknown): string => {
  if (!value) return "";
  if (typeof value === "string") return decodeHtmlEntities(stripHtml(value));
  if (Array.isArray(value)) return value.map((item) => toText(item)).filter(Boolean).join(" ");
  if (typeof value === "object") {
    const record = value as Record<string, unknown>;
    const directCandidates = [record.rendered, record.value, record.text, record.title, record.name, record.label];
    for (const candidate of directCandidates) {
      const text = toText(candidate);
      if (text) return text;
    }
    if (Array.isArray(record.children)) {
      return record.children.map((child) => toText(child)).filter(Boolean).join(" ");
    }
  }
  return "";
};

const getExcerpt = (article: PreparedArchiveArticle | undefined, fallbackTitle: string): string => {
  const raw = toText(article?.excerpt) || toText(article?.content) || toText(article?.contentV2);
  if (!raw) return `DÃ©couvrez ${fallbackTitle.toLowerCase()} sur La Cuisine de Bernard.`;
  return raw.length > 120 ? `${raw.slice(0, 120).trim()}...` : raw;
};

const sourceEntries = getStaticArchiveEntries("recettes-salees");
const articleMap = new Map(
  getPreparedArchiveArticles()
    .filter((article) => typeof article?.slug === "string" && article.slug?.trim())
    .map((article) => [String(article.slug).trim(), article]),
);

const cards = sourceEntries.map((entry) => {
  const article = articleMap.get(entry.slug) as PreparedArchiveArticle | undefined;
  const fallbackImage = entry.fallbackImage || "";
  const resolvedImage = processArticleImageUrl(article) || fallbackImage;
  const imageFallbackCandidates = Array.from(
    new Set(
      [
        ...buildWordPressImageFallbackCandidates(resolvedImage),
        fallbackImage,
      ].filter(Boolean),
    ),
  );

  return {
    href: entry.href,
    title: decodeHtmlEntities(
      String(article?.title || entry.fallbackTitle || entry.slug),
    ),
    excerpt: getExcerpt(article, entry.fallbackTitle || entry.slug),
    image: resolvedImage,
    imageFallback: fallbackImage || resolvedImage,
    imageFallbackCandidates,
  };
});
---

<BaseLayout title="Recettes salÃ©es">
  <StaticPage
    title="Recettes salÃ©es"
    subtitle="Index des recettes salÃ©es avec photo."
    className="menu-page menu-page--savory-grid"
    navLinks={navLinks}
  >
    <InfiniteGrid gridClass="savory-grid" ariaLabel="Recettes salées" totalCount={cards.length}>
      {cards.map((card) => (
        <article class="savory-card">
          <a href={card.href} class="savory-card-media-link" aria-label={card.title}>
            <div class="savory-card-media">
              {card.image ? (
                <img
                  src={card.image}
                  alt={card.title}
                  loading="lazy"
                  decoding="async"
                  class="savory-card-image"
                  data-fallback-src={card.imageFallback}
                  data-fallback-candidates={card.imageFallbackCandidates.join('|')}
                  onerror="const current=this.currentSrc||this.src; const list=(this.dataset.fallbackCandidates||'').split('|').map((item)=>item.trim()).filter((item)=>item && item!==current); const next=list.shift() || this.dataset.fallbackSrc; this.dataset.fallbackCandidates=list.join('|'); if (next && next!==current) this.src=next;"
                />
              ) : (
                <div class="savory-card-image savory-card-image--empty">Aucune image</div>
              )}
              <span class="savory-card-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 5h5v5" />
                  <path d="M10 14 19 5" />
                  <path d="M19 14v4a1 1 0 0 1-1 1h-4" />
                  <path d="M10 19H6a1 1 0 0 1-1-1v-4" />
                </svg>
              </span>
            </div>
          </a>

          <div class="savory-card-content">
            <h2 class="savory-card-title">
              <a href={card.href}>{card.title}</a>
            </h2>
            <p class="savory-card-excerpt">{card.excerpt}</p>
            <a href={card.href} class="savory-card-cta">Lire la recette</a>
          </div>
        </article>
      ))}
    </InfiniteGrid>
  </StaticPage>
</BaseLayout>

<style is:global>
  .menu-page--savory-grid .static-page-body {
    padding: clamp(14px, 2.2vw, 24px);
  }

  .menu-page--savory-grid .savory-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    max-width: 1220px;
    margin-inline: auto;
  }

  .menu-page--savory-grid .savory-card {
    display: flex;
    flex-direction: column;
    border: 1px solid #d8d2c2;
    border-radius: 14px;
    background: #f8f5ee;
    overflow: hidden;
    box-shadow: 0 14px 32px rgba(14, 24, 39, 0.06);
  }

  .menu-page--savory-grid .savory-card-media-link {
    display: block;
    color: inherit;
    text-decoration: none;
    line-height: 0;
  }

  .menu-page--savory-grid .savory-card-media {
    position: relative;
    aspect-ratio: 4 / 4.7;
    overflow: hidden;
    background: #ece5d8;
    line-height: 0;
  }

  .menu-page--savory-grid .savory-card-image {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center top;
    display: block;
    margin: 0 !important;
    border: 0 !important;
    box-shadow: none !important;
    border-radius: 0 !important;
  }

  .menu-page--savory-grid .savory-card-image--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7a7569;
    font-size: 0.92rem;
  }

  .menu-page--savory-grid .savory-card-badge {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: #67d5cf;
    color: #1a2335;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 24px rgba(24, 37, 57, 0.18);
  }

  .menu-page--savory-grid .savory-card-badge svg {
    width: 18px;
    height: 18px;
  }

  .menu-page--savory-grid .savory-card-content {
    padding: 0.9rem 0.9rem 1rem;
  }

  .menu-page--savory-grid .savory-card-title {
    margin: 0;
    font-family: var(--font-maison);
    font-size: 1.48rem;
    line-height: 1.14;
    color: #26231c;
  }

  .menu-page--savory-grid .savory-card-title a {
    color: inherit;
    text-decoration: none;
  }

  .menu-page--savory-grid .savory-card-excerpt {
    margin: 0.72rem 0 0;
    color: #655f54;
    font-size: 0.96rem;
    line-height: 1.66;
  }

  .menu-page--savory-grid .savory-card-cta {
    display: inline-flex;
    margin-top: 0.9rem;
    color: #54b6b1;
    font-family: var(--font-button);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
  }

  @media (max-width: 1100px) {
    .menu-page--savory-grid .savory-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 760px;
    }
  }

  @media (max-width: 720px) {
    .menu-page--savory-grid .savory-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 380px;
    }

    .menu-page--savory-grid .savory-card-title {
      font-size: 1.28rem;
    }

    .menu-page--savory-grid .savory-card-excerpt {
      font-size: 0.92rem;
    }
  }
</style>


---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page introuvable">
  <main class="mx-auto flex min-h-[60vh] w-full max-w-[900px] flex-col items-start justify-center px-5 py-16 md:px-10 lg:px-[90px]">
    <p class="typ-caption text-primary-turquoise mb-4">Erreur 404</p>
    <h1 class="typ-title mb-6">Page introuvable</h1>
    <p class="typ-body max-w-[620px] text-text-secondary mb-8">
      La page que vous cherchez n'existe pas ou n'est plus disponible. Vous
      pouvez revenir à l'accueil ou continuer votre visite depuis les sections
      principales du site.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/" class="inline-flex items-center justify-center rounded bg-primary-turquoise px-6 py-3 font-button text-[13px] uppercase tracking-[0.08em] text-primary-black transition-colors duration-200 hover:bg-[#43a6a1]">
        Retour à l'accueil
      </a>
      <a href="/articles" class="inline-flex items-center justify-center rounded border border-border-primary px-6 py-3 font-button text-[13px] uppercase tracking-[0.08em] text-text-primary transition-colors duration-200 hover:border-primary-turquoise hover:text-primary-turquoise">
        Voir les articles
      </a>
    </div>
  </main>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticPage from "../components/StaticPage.astro";
import StaticPageContent from "../components/StaticPageContent.astro";
---

<BaseLayout title="Voyages culinaires">
  <StaticPage
    title="Voyages culinaires"
    subtitle="Carnets de route, marchés, adresses et inspirations gourmandes."
    className="menu-page menu-page--travel-grid"
  >
    <p class="travel-page-intro">
      Une collection de destinations gourmandes pour voyager à travers les marchés,
      les spécialités locales et les découvertes qui inspirent ensuite les recettes
      de la cuisine de Bernard.
    </p>

    <StaticPageContent
      slug="voyages-culinaires"
      sourceUrl="https://lacuisinedebernard.com/voyages-culinaires/"
    />
  </StaticPage>
</BaseLayout>

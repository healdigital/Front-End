---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticPage from "../components/StaticPage.astro";
import StaticPageContent from "../components/StaticPageContent.astro";
---

<BaseLayout title="Reportages">
  <StaticPage title="Reportages" subtitle="Reportages">
    <StaticPageContent
      slug="reportages"
      sourceUrl="https://lacuisinedebernard.com/reportages/"
    >
      <p>Les reportages sont en cours de migration depuis le site d’origine.</p>
      <p>
        En attendant, parcourez les derniers articles ou utilisez la recherche
        pour trouver un sujet précis.
      </p>
      <ul>
        <li><a href="/articles">Parcourir les derniers articles</a></li>
        <li><a href="/search">Rechercher sur le site</a></li>
      </ul>
    </StaticPageContent>
  </StaticPage>
</BaseLayout>

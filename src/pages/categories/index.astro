---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { payloadFetch } from '../../lib/payload.client';
import { BUILD_ONLY_ARTICLE_PAGES } from '../../utils/buildFlags';

let categoriesWithCounts: any[] = [];

if (!BUILD_ONLY_ARTICLE_PAGES) {
  categoriesWithCounts = await payloadFetch({
    collection: 'categories',
    query: { limit: 1000 },
  });
}

const normalizeSlug = (value: any) => String(value || '').replace(/^\/+|\/+$/g, '');

const categories = (Array.isArray(categoriesWithCounts) ? categoriesWithCounts : [])
  .map((category: any) => {
    const slug = normalizeSlug(typeof category?.slug === 'string' ? category.slug : category?.slug?.current);
    if (!slug) return null;

    return {
      slug,
      title: category?.title || category?.name || slug,
      description: category?.description || '',
      articleCount: Number(category?.articleCount || 0),
    };
  })
  .filter(Boolean)
  .sort((a: any, b: any) => b.articleCount - a.articleCount);
---

<BaseLayout title="Categories" description="Browse articles by category">
  <section class="lcdb-page-hero">
    <div class="lcdb-page-shell lcdb-page-hero-inner">
      <p class="lcdb-page-eyebrow typ-caption">Explore</p>
      <h1 class="lcdb-page-title typ-h2">Categories</h1>
      <p class="lcdb-page-description typ-body">{categories.length} cat&eacute;gories disponibles.</p>
    </div>
  </section>

  <section class="lcdb-page-section">
    <div class="lcdb-page-shell lcdb-page-section-inner">
      {BUILD_ONLY_ARTICLE_PAGES && (
        <div class="mb-8 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-amber-800">
          Category pages are excluded in article-only build mode (`BUILD_ONLY_ARTICLE_PAGES=1`).
        </div>
      )}

      {categories.length > 0 ? (
        <div class="lcdb-grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
          {categories.map((category: any) => (
            <a href={`/categories/${category.slug}`} class="lcdb-surface-card p-6 transition-shadow hover:shadow-lg">
              <p class="text-[#8B7A4E] mb-3 typ-caption">{category.articleCount} article{category.articleCount !== 1 ? 's' : ''}</p>
              <h2 class="lcdb-article-card-title mb-3">{category.title}</h2>
              {category.description && <p class="text-[#4B5563] typ-body">{category.description}</p>}
            </a>
          ))}
        </div>
      ) : (
        <div class="lcdb-empty-state"><p class="typ-body">Aucune cat&eacute;gorie disponible.</p></div>
      )}
    </div>
  </section>
</BaseLayout>


---
import BaseLayout from "../layouts/BaseLayout.astro";
import DisqusComments from "../components/DisqusComments.astro";
import SocialShare from "../components/molecules/SocialShare.astro";
import NewsletterModal from "../components/organisms/NewsletterModal.astro";
import RecipeSidebar from "../components/organisms/RecipeSidebar.astro";
import RecipeDetailRedesign from "../components/organisms/RecipeDetailRedesign.astro";

import { payloadFetch } from "../lib/payload.client";
import {
  getAllArticlesFromMongo,
  getArticleBySlugFromMongo,
  getCommentsByArticleIdFromMongo,
  getRelatedArticlesFromMongo,
} from "../lib/mongo.server";
import {
  buildArticleJsonLd,
  buildBreadcrumbJsonLd,
} from "../utils/buildArticleJsonLd";
import { buildRecipeJsonLd } from "../utils/buildRecipeJsonLd";
import { processArticleImageUrl, replaceCdnUrl } from "../utils/cdnUrlReplacer";
import { renderArticleContent } from "../utils/renderArticleContent";

export const prerender = true;

const getBuildLimit = () => {
  const envLimit = Number(process.env.MAX_SSG_ARTICLES);
  return Number.isFinite(envLimit) && envLimit > 0 ? envLimit : 6000;
};

const stripHtml = (value: string) =>
  String(value || "")
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const toText = (value: any): string => {
  if (!value) return "";
  if (typeof value === "string") return stripHtml(value);
  if (Array.isArray(value))
    return value
      .map((item) => toText(item))
      .filter(Boolean)
      .join(" ");
  if (typeof value === "object") {
    const directCandidates = [
      value.rendered,
      value.value,
      value.text,
      value.title,
      value.name,
      value.label,
    ];
    for (const candidate of directCandidates) {
      const text = toText(candidate);
      if (text) return text;
    }
    if (Array.isArray(value.children)) {
      return value.children
        .map((child: any) => toText(child))
        .filter(Boolean)
        .join(" ");
    }
    if (value.content) return toText(value.content);
  }
  return "";
};

const normalizeSlug = (value: any) =>
  String(value || "").replace(/^\/+|\/+$/g, "");
const toTitleCase = (value: string) =>
  value.toLowerCase().replace(/(?:^|\s|[-/])\S/g, (char) => char.toUpperCase());

const dedupeTextList = (items: string[]) => {
  const seen = new Set<string>();
  return items.filter((item) => {
    const key = item.trim().toLowerCase();
    if (!key || seen.has(key)) return false;
    seen.add(key);
    return true;
  });
};

const deriveFlavorCategory = (article: any, categoryTitles: string[]) => {
  const sourceText = [
    ...categoryTitles,
    toText(article?.category),
    toText(article?.tags),
    toText(article?.category_names),
  ]
    .join(" ")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase();

  if (/\b(sucre|sucree|sucrees|sweet)\b/.test(sourceText)) return "Sucré";
  if (/\b(sale|sales|salees|savory|savoury)\b/.test(sourceText)) return "Salé";
  return "";
};

const extractId = (value: any): string => {
  if (!value) return "";
  if (typeof value === "string" || typeof value === "number")
    return String(value);
  if (typeof value === "object") {
    return String(value.id || value._id || value.value || "");
  }
  return "";
};

const formatRecipeTimeLabel = (value: any): string => {
  if (value === null || value === undefined) return "";
  const raw = String(value).replace(/\s+/g, " ").trim();
  if (!raw) return "";

  const numeric = Number(raw);
  if (Number.isFinite(numeric) && numeric > 0) {
    if (numeric < 60) return `${numeric}MIN`;
    const hours = Math.floor(numeric / 60);
    const minutes = numeric % 60;
    return minutes
      ? `${hours}H${String(minutes).padStart(2, "0")}`
      : `${hours}H`;
  }

  return raw.toUpperCase();
};

const toPositiveNumber = (value: any): number | null => {
  const numeric = Number(value);
  if (!Number.isFinite(numeric) || numeric < 0) return null;
  return numeric;
};

const formatMinutes = (value: any): string => {
  const numeric = toPositiveNumber(value);
  if (numeric === null) return "";
  return `${Math.round(numeric)} min`;
};

const resolveRecipeMedia = (...candidates: any[]) => {
  for (const candidate of candidates) {
    if (!candidate) continue;

    if (typeof candidate === "string" && candidate.trim()) {
      return {
        url: replaceCdnUrl(candidate.trim()),
        alt: "",
      };
    }

    if (typeof candidate === "object") {
      const url =
        candidate?.sizes?.articleStep?.url ||
        candidate?.sizes?.gallery?.url ||
        candidate?.sizes?.articleHero?.url ||
        candidate?.url;

      if (typeof url === "string" && url.trim()) {
        return {
          url: replaceCdnUrl(url.trim()),
          alt: toText(candidate?.alt),
        };
      }
    }
  }

  return null;
};

const extractLegacyStepImages = (html: string, featuredUrl: string) => {
  if (!html) return [];

  const images: Array<{ alt: string; url: string }> = [];
  const seen = new Set<string>();
  const regex = /<img\b[^>]*(?:src|data-src)=["']([^"']+)["'][^>]*>/gi;
  let match: RegExpExecArray | null = null;

  while ((match = regex.exec(html))) {
    const rawUrl = String(match[1] || "").trim();
    if (!rawUrl) continue;
    const url = replaceCdnUrl(rawUrl);
    if (!url || seen.has(url) || url === featuredUrl) continue;
    seen.add(url);
    images.push({ alt: "", url });
  }

  return images;
};

const buildIngredientGroups = (ingredients: any[]) => {
  return (Array.isArray(ingredients) ? ingredients : []).reduce(
    (groups: any[], row: any) => {
      if (!row) return groups;

      if (row.isGroupHeading) {
        const heading = toText(row.groupHeading);
        if (heading) groups.push({ heading, items: [] });
        return groups;
      }

      const quantity = String(row.quantity || "").trim();
      const item = toText(row.item);
      const notes = toText(row.notes);
      if (!quantity && !item && !notes) return groups;

      const target =
        groups.length === 0
          ? (groups.push({ heading: "", items: [] }), groups[0])
          : groups[groups.length - 1];
      target.items.push({ item, notes, quantity });
      return groups;
    },
    [],
  );
};

const buildStepGroups = (
  steps: any[],
  legacyImages: Array<{ alt: string; url: string }>,
) => {
  let fallbackIndex = 0;

  return (Array.isArray(steps) ? steps : []).reduce(
    (groups: any[], row: any) => {
      if (!row) return groups;

      if (row.isGroupHeading) {
        const heading = toText(row.groupHeading);
        if (heading) groups.push({ heading, items: [] });
        return groups;
      }

      const instruction = toText(row.instruction);
      if (!instruction) return groups;

      const explicitMedia = resolveRecipeMedia(
        row.image,
        row.imageUrl,
        row.image_url,
        row.media,
        row.photo,
      );
      const fallbackMedia = explicitMedia
        ? null
        : legacyImages[fallbackIndex] || null;
      if (!explicitMedia && fallbackMedia) fallbackIndex += 1;

      const target =
        groups.length === 0
          ? (groups.push({ heading: "", items: [] }), groups[0])
          : groups[groups.length - 1];
      target.items.push({
        instruction,
        media: explicitMedia || fallbackMedia,
      });
      return groups;
    },
    [],
  );
};

export async function getStaticPaths() {
  let articles: any[] = [];

  const decodeSafe = (value: string) => {
    try {
      return decodeURIComponent(value);
    } catch {
      return value;
    }
  };

  try {
    articles = await getAllArticlesFromMongo();
  } catch (error) {
    console.error(
      "getAllArticlesFromMongo failed, falling back to Payload:",
      error,
    );
  }

  if (!articles || articles.length === 0) {
    try {
      const payloadResponse: any = await payloadFetch({
        collection: "articles",
        query: { depth: 2, limit: getBuildLimit() },
      });
      articles = payloadResponse?.docs || payloadResponse || [];
    } catch (error) {
      console.error("payloadFetch fallback failed:", error);
    }
  }

  if (!Array.isArray(articles)) return [];

  return articles
    .filter((item: any) => item?.slug)
    .map((item: any) => {
      const rawSlug =
        typeof item.slug === "string" ? item.slug : item.slug?.current || "";
      const slugValue = decodeSafe(rawSlug);
      return {
        params: { slug: slugValue },
        props: { article: { ...item, slug: slugValue } },
      };
    });
}

interface Props {
  article: any;
}

let { article } = Astro.props as Props;

if (!article) {
  throw new Error("Article data missing at build time");
}

const slug = normalizeSlug(
  typeof article.slug === "string" ? article.slug : article.slug?.current || "",
);

if (slug && !processArticleImageUrl(article)) {
  const hydratedArticle = await getArticleBySlugFromMongo(slug);
  if (hydratedArticle) {
    article = {
      ...article,
      ...hydratedArticle,
    };
  }
}

const getExcerpt = () => {
  if (typeof article.excerpt === "string")
    return article.excerpt.substring(0, 160);
  if (Array.isArray(article.excerpt)) {
    return article.excerpt
      .map(
        (block: any) =>
          block.children?.map((child: any) => child.text).join(" ") || "",
      )
      .join(" ")
      .substring(0, 160);
  }
  return "";
};

const title = article.title || "Untitled";
const excerpt = getExcerpt();
const image = processArticleImageUrl(article);
const imageAlt =
  toText(
    article.featuredMedia?.alt ||
      article.featuredImage?.alt ||
      article.featured_image?.alt,
  ) || "Article featured image";

const articleJsonLd = buildArticleJsonLd(
  article,
  "https://lacuisinedebernard.com",
);
const breadcrumbJsonLd = buildBreadcrumbJsonLd(
  title,
  slug,
  "https://lacuisinedebernard.com",
);
const recipeJsonLd = buildRecipeJsonLd(article);

const articleUrl = `https://lacuisinedebernard.com/${slug}/`;
const articleShareLinks = [
  {
    label: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(articleUrl)}`,
    icon: "fab fa-facebook-f",
  },
  {
    label: "Pinterest",
    href: `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(articleUrl)}&description=${encodeURIComponent(title)}`,
    icon: "fab fa-pinterest-p",
  },
  {
    label: "Email",
    href: `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(articleUrl)}`,
    icon: "far fa-envelope",
  },
];
const numericPostId = Number(article?.post_id);
const disqusIdentifier =
  Number.isFinite(numericPostId) && numericPostId > 0
    ? `${numericPostId} https://lacuisinedebernard.com/?p=${numericPostId}`
    : slug;

const normalizePageLanguage = (value: any) => {
  const raw = String(value || "")
    .trim()
    .toLowerCase();
  if (raw === "pt" || raw === "pt_br" || raw === "ptbr") return "pt-br";
  if (["en", "fr", "es", "pt-br", "ar"].includes(raw)) return raw;
  return "fr";
};

const pageLang = normalizePageLanguage(
  article?.lang || article?.language || article?.locale,
);
const excerptText = toText(article?.excerpt);
const displayAuthorName = "Bernard Laurance";

const categoryItems = (
  Array.isArray(article?.categories) ? article.categories : []
)
  .map((item: any) => {
    const itemTitle = toText(item?.title || item?.name || item?.label || item);
    const itemSlug = normalizeSlug(
      typeof item?.slug === "string" ? item.slug : item?.slug?.current,
    );
    return itemTitle ? { title: itemTitle, slug: itemSlug } : null;
  })
  .filter(Boolean);

const categoryTitles = dedupeTextList(
  categoryItems.map((item: any) => toTitleCase(item.title)),
);
const flavorCategoryLabel = deriveFlavorCategory(article, categoryTitles);
const displayCategoryTitles = dedupeTextList([
  ...(categoryTitles.length > 0 ? categoryTitles : ["Recette"]),
  flavorCategoryLabel,
]);
const secondaryCategoryTitle =
  displayCategoryTitles.find((item) => item !== displayCategoryTitles[0]) || "";

const categoryIds = (
  Array.isArray(article?.categories) ? article.categories : []
)
  .map((item: any) => extractId(item))
  .filter(Boolean);

const currentArticleId = extractId(article?.id || article?._id);
const articleComments = currentArticleId
  ? await getCommentsByArticleIdFromMongo(currentArticleId)
  : [];
const validRatings = articleComments
  .map((comment: any) => Number(comment?.rating))
  .filter((rating: number) => Number.isFinite(rating) && rating > 0);
const ratingCount = validRatings.length;
const ratingAverage =
  ratingCount > 0
    ? validRatings.reduce(
        (total: number, rating: number) => total + rating,
        0,
      ) / ratingCount
    : 0;
const ratingLabel =
  ratingCount > 0
    ? `${ratingAverage.toFixed(1).replace(/\.0$/, "")}/5 • ${ratingCount} avis`
    : "Pas encore de notes";
const ratingStars = Array.from(
  { length: 5 },
  (_, index) => index < Math.round(ratingAverage),
);

const primaryRecipeBlock =
  (Array.isArray(article?.recipeBlocks) ? article.recipeBlocks : []).find(
    (block: any) =>
      block?.blockType === "recipeCard" ||
      Array.isArray(block?.ingredients) ||
      Array.isArray(block?.steps),
  ) || null;
const recipeDifficulty = toText(primaryRecipeBlock?.difficulty);
const recipePortions = toText(
  primaryRecipeBlock?.servings || primaryRecipeBlock?.servingsCount,
);
const heroMetaItems = [
  displayCategoryTitles[0] || "Recette",
  recipeDifficulty,
  recipePortions ? `${recipePortions}` : "",
].filter(Boolean);
const recipeLegacyImages = extractLegacyStepImages(
  typeof article?.content === "string" ? article.content : "",
  image,
);
const ingredientGroups = buildIngredientGroups(
  primaryRecipeBlock?.ingredients || [],
);
const stepGroups = buildStepGroups(
  primaryRecipeBlock?.steps || [],
  recipeLegacyImages,
);
let absoluteStepNumber = 1;
const stepGroupsDetailed = stepGroups.map((group: any) => ({
  ...group,
  items: group.items.map((item: any) => ({
    ...item,
    stepNumber: absoluteStepNumber++,
  })),
}));
const uiText = {
  home: "Accueil",
  recipes: "Recettes",
  ingredients: "Ingrédients",
  preparation: "Préparation",
  bonAppetit: "Bon appétit !",
  print: "Imprimer la recette",
  pin: "Épingler la recette",
  collect: "Ajouter à la collection",
  quickInfo: "Quick Info",
  nutrition: "Nutrition",
  finalRecipe: "Fiche recette",
};
const topInfoItems = [
  {
    label: "Temps de préparation",
    value: formatMinutes(primaryRecipeBlock?.preparationTimeMinutes),
  },
  {
    label: "Temps de cuisson",
    value: formatMinutes(primaryRecipeBlock?.cookingTimeMinutes),
  },
  { label: "Cuisine", value: toText(primaryRecipeBlock?.cuisine) },
  {
    label: "Portions",
    value: toText(
      primaryRecipeBlock?.servings || primaryRecipeBlock?.servingsCount,
    ),
  },
  {
    label: "Calories",
    value:
      toPositiveNumber(primaryRecipeBlock?.nutrition?.caloriesKcal) !== null
        ? `${Math.round(toPositiveNumber(primaryRecipeBlock?.nutrition?.caloriesKcal) || 0)} kcal`
        : "",
  },
].filter((item) => item.value);
const quickInfoItems = [
  {
    label: "Preparation Time Minutes",
    value: formatMinutes(primaryRecipeBlock?.preparationTimeMinutes),
  },
  {
    label: "Cooking Time Minutes",
    value: formatMinutes(primaryRecipeBlock?.cookingTimeMinutes),
  },
  { label: "Servings Count", value: toText(primaryRecipeBlock?.servingsCount) },
  { label: "Difficulty", value: toText(primaryRecipeBlock?.difficulty) },
  { label: "Recipe Type", value: toText(primaryRecipeBlock?.recipeType) },
  { label: "Dish Type", value: toText(primaryRecipeBlock?.dishType) },
  { label: "Cuisine", value: toText(primaryRecipeBlock?.cuisine) },
  { label: "Servings", value: toText(primaryRecipeBlock?.servings) },
].filter((item) => item.value);
const nutritionItems = [
  {
    label: "Calories",
    value: primaryRecipeBlock?.nutrition?.caloriesKcal,
    unit: "kcal",
  },
  {
    label: "Protein",
    value: primaryRecipeBlock?.nutrition?.proteinGrams,
    unit: "g",
  },
  {
    label: "Carbs",
    value: primaryRecipeBlock?.nutrition?.carbohydratesGrams,
    unit: "g",
  },
  { label: "Fat", value: primaryRecipeBlock?.nutrition?.fatGrams, unit: "g" },
  {
    label: "Fiber",
    value: primaryRecipeBlock?.nutrition?.fiberGrams,
    unit: "g",
  },
  {
    label: "Sugar",
    value: primaryRecipeBlock?.nutrition?.sugarGrams,
    unit: "g",
  },
  {
    label: "Sodium",
    value: primaryRecipeBlock?.nutrition?.sodiumMg,
    unit: "mg",
  },
].filter((item) => toPositiveNumber(item.value) !== null);

const recipeOnlyArticle = primaryRecipeBlock
  ? {
      ...article,
      recipeBlocks: [primaryRecipeBlock],
      contentV2: null,
      contentBlocks: [],
      imageBlocks: [],
    }
  : article;

const recipeContent = primaryRecipeBlock
  ? renderArticleContent(recipeOnlyArticle, {
      includeRecipeBlocks: true,
      includeContentV2: false,
      includeContentBlocks: false,
      includeImageBlocks: false,
      suppressRecipeSummaryTitle: true,
    })
  : "";
const recipeContentSanitized = recipeContent
  .replace(
    /(<section class="content-v2-block content-v2-recipe-steps-visual">\s*<h2>)([^<]+)(<\/h2>)/,
    "$1Pr&eacute;paration$3",
  )
  .replace(
    /(<div class="content-v2-recipe-section">\s*<h3>)([^<]+)(<\/h3>\s*<ol>)/,
    "$1Pr&eacute;paration$3",
  )
  .replace(
    /(<div class="content-v2-recipe-section">\s*<h3>)Nutrition[^<]*(<\/h3>)/,
    "$1Nutrition$2",
  );

const storyContent = renderArticleContent(article, {
  includeRecipeBlocks: false,
  includeLegacyFallback: false,
});

const firstStoryParagraphHtml =
  storyContent.match(/<p\b[^>]*>([\s\S]*?)<\/p>/i)?.[0] || "";
const introText =
  excerptText || toText(firstStoryParagraphHtml) || excerpt || "";
const hasStoryContent = false;
const content = renderArticleContent(article);
const firstContentParagraphHtml =
  content.match(/<p\b[^>]*>[\s\S]*?<\/p>/i)?.[0] || "";
const firstContentParagraphHasImage = /<(?:img|picture|figure)\b/i.test(
  firstContentParagraphHtml,
);
const pinterestLink = `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(articleUrl)}&media=${encodeURIComponent(image || articleUrl)}&description=${encodeURIComponent(title)}`;
const collectionHref = "/favoris";

const relatedArticlesRaw =
  categoryIds.length > 0 && currentArticleId
    ? await getRelatedArticlesFromMongo(categoryIds, currentArticleId, 6)
    : [];

const relatedArticles = (
  Array.isArray(relatedArticlesRaw) ? relatedArticlesRaw : []
)
  .map((item: any) => {
    const relatedSlug = normalizeSlug(
      typeof item?.slug === "string" ? item.slug : item?.slug?.current || "",
    );
    const relatedTitle = toText(item?.title);
    if (!relatedSlug || !relatedTitle) return null;

    const relatedCategories = Array.isArray(item?.categories)
      ? item.categories
      : [];
    const relatedCategory = relatedCategories
      .map((category: any) =>
        toText(category?.name || category?.title || category),
      )
      .find(Boolean);

    return {
      slug: relatedSlug,
      title: relatedTitle,
      image: processArticleImageUrl(item),
      category: relatedCategory || "Recette",
      metaPrimary: (
        toText(
          item?.difficulty ||
            item?.recipeDifficulty ||
            item?.recipe?.difficulty,
        ) ||
        relatedCategory ||
        "Recette"
      ).toUpperCase(),
      metaSecondary: formatRecipeTimeLabel(
        item?.prep_time ??
          item?.prepTime ??
          item?.total_time ??
          item?.totalTime ??
          item?.cook_time ??
          item?.cookTime,
      ),
    };
  })
  .filter(Boolean)
  .slice(0, 6);

const tagItems = (Array.isArray(article?.tags) ? article.tags : [])
  .map((item: any) => {
    const itemTitle = toText(item?.title || item?.name || item?.label || item);
    const itemSlug = normalizeSlug(
      typeof item?.slug === "string" ? item.slug : item?.slug?.current,
    );
    return itemTitle ? { title: itemTitle, slug: itemSlug } : null;
  })
  .filter(Boolean);
---

<BaseLayout
  title={title}
  description={excerpt}
  canonical={articleUrl}
  image={image}
  jsonLd={[articleJsonLd, breadcrumbJsonLd, recipeJsonLd].filter(Boolean)}
  slug={slug}
  lang={pageLang}
  loadAds={true}
  showGlobalAbout={false}
>
  <section class="lcdb-page-hero" style="display:none">
    <div class="lcdb-page-shell lcdb-page-hero-inner">
      <nav class="article-breadcrumb typ-caption" aria-label="Breadcrumb">
        <a href="/" class="article-breadcrumb-link">Accueil</a>
        <span>/</span>
        <span class="article-breadcrumb-current">{title}</span>
      </nav>
      <div class="article-hero-topline">
        <div class="article-hero-copy">
          <p class="lcdb-page-eyebrow typ-caption">
            {displayCategoryTitles[0] || "Recette"}
          </p>
          <h1 class="lcdb-page-title typ-h2">{title}</h1>
          <div class="article-hero-meta typ-body">
            <span>{displayAuthorName}</span>
            {secondaryCategoryTitle && <span>{secondaryCategoryTitle}</span>}
          </div>
        </div>

        <div class="article-hero-actions">
          <SocialShare
            url={articleUrl}
            title={title}
            class="article-share-inline"
          />
          <a
            href={`/print/${slug}/?auto=1`}
            target="_blank"
            rel="noopener noreferrer"
            class="article-print-btn typ-button"
          >
            Imprimer la recette
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="lcdb-page-section">
    <div class="lcdb-page-shell lcdb-page-section-inner">
      <div class="article-layout">
        <div class="article-main-column">
          {
            primaryRecipeBlock && (
              <RecipeDetailRedesign
                title={title}
                slug={slug}
                image={image}
                imageAlt={imageAlt}
                ratingLabel={ratingLabel}
                ratingStars={ratingStars}
                articleShareLinks={articleShareLinks}
                heroMetaItems={heroMetaItems}
                introText={introText}
                recipeBlock={primaryRecipeBlock}
                ingredientGroups={ingredientGroups}
                stepGroups={stepGroupsDetailed}
                nutritionItems={nutritionItems}
                pinterestLink={pinterestLink}
                collectionHref={collectionHref}
                storyHtml=""
              />
            )
          }

          <div hidden aria-hidden="true" style="display:none">
            <section class="lcdb-surface-card recipe-detail-shell">
              <div class="recipe-detail-topbar">
                <nav
                  class="article-breadcrumb typ-caption"
                  aria-label="Breadcrumb"
                >
                  <a href="/" class="article-breadcrumb-link">Accueil</a>
                  <span>/</span>
                  <span>Recettes</span>
                  <span>/</span>
                  <span class="article-breadcrumb-current">{title}</span>
                </nav>

                <div
                  class="recipe-detail-topbar-actions"
                  aria-label="Partager la recette"
                >
                  {
                    articleShareLinks.map((link) => (
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="recipe-detail-topbar-link"
                        aria-label={`Partager sur ${link.label}`}
                      >
                        <i class={link.icon} aria-hidden="true" />
                      </a>
                    ))
                  }
                </div>
              </div>

              {
                (categoryItems.length > 0 || tagItems.length > 0) && (

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const normalizeSectionLabel = (text) =>
      String(text || "")
        .replace(/\s+/g, " ")
        .trim()
        .replace(/^pour\s+(les|le|la|l'|des|du)\s+/i, "")
        .replace(/\s+\d+\s*pi(?:è|e)ces?$/i, "")
        .replace(/\s*:\s*$/, "")
        .trim();

    const toSentenceCase = (value) => {
      const cleaned = String(value || "").trim();
      if (!cleaned) return "";
      return cleaned.charAt(0).toUpperCase() + cleaned.slice(1);
    };

    const createServingsNote = (title, servings, unit) => {
      const count = String(servings || "").trim();
      const servingsUnit = String(unit || "")
        .replace(/\s+/g, " ")
        .trim();
      const titleText = String(title || "").toLowerCase();
      if (!count) return "";
      if (titleText.includes("gunkan"))
        return `Pour environ ${count} gunkan makis`;
      return `Pour environ ${count}${servingsUnit ? ` ${servingsUnit}` : ""}`;
    };

    const createStepTitle = (text, fallbackLabel, index) => {
      const cleaned = String(text || "")
        .replace(/\s+/g, " ")
        .trim();
      const normalizedLabel = String(fallbackLabel || "")
        .replace(/\s+/g, " ")
        .trim()
        .replace(/\s*:\s*$/, "");
      const firstSentence = cleaned.split(/[.!?]/)[0]?.trim() || "";
      const actionMatch = firstSentence.match(
        /\b(?:faire\s+)?(?:mariner|mélanger|couper|laissez?|mettre|placez|égouttez|versez|hachez|prenez|coupez|remplissez|ajoutez|pesez|façonnez|dégustez)\b[^.!?]*/i,
      );
      if (actionMatch?.[0]) {
        let actionTitle = actionMatch[0].replace(/^faire\s+/i, "").trim();
        actionTitle =
          actionTitle
            .split(/\b(?:dans le cas|avant de|afin de|pendant|avec)\b/i)[0]
            ?.trim() || actionTitle;
        actionTitle = toSentenceCase(actionTitle);
        if (actionTitle) {
          return actionTitle.length > 54
            ? `${actionTitle.slice(0, 51).trim()}...`
            : actionTitle;
        }
      }
      const firstClause = firstSentence.split(/[,:;]/)[0]?.trim() || "";

      if (firstClause) {
        return firstClause.length > 54
          ? `${firstClause.slice(0, 51).trim()}...`
          : firstClause;
      }

      if (firstSentence) {
        return firstSentence.length > 60
          ? `${firstSentence.slice(0, 57).trim()}...`
          : firstSentence;
      }

      if (normalizedLabel) return normalizedLabel;
      return `Étape ${index}`;
    };

    const enhanceRecipeArticle = () => {
      const content = document.querySelector<HTMLElement>(".article-content");
      if (!content || content.dataset.enhanced === "true") return;

      const recipeContainer = content.querySelector<HTMLElement>(
        ".wprm-recipe-container",
      );
      if (!recipeContainer) return;

      content.dataset.enhanced = "true";

      content
        .querySelectorAll(
          ".xs_social_share_widget, .xs_share_url, .wslu-share-box",
        )
        .forEach((node) => node.remove());

      content.querySelectorAll(":scope > p").forEach((node) => {
        const text =
          node.textContent
            ?.replace(/\u00a0/g, " ")
            .replace(/\s+/g, " ")
            .trim() || "";
        if (!text && !node.querySelector("img, picture, video, iframe")) {
          node.remove();
        }
      });

      const children = Array.from(content.children) as HTMLElement[];
      const recipeIndex = children.indexOf(recipeContainer);
      const articleTitleNormalized = String(content.dataset.articleTitle || "")
        .replace(/\u00a0/g, " ")
        .replace(/\s+/g, " ")
        .trim()
        .toLowerCase();
      const getNodeText = (node: Element | null) =>
        node?.textContent
          ?.replace(/\u00a0/g, " ")
          .replace(/\s+/g, " ")
          .trim() || "";
      const recipeStartIndex = children.findIndex((node, index) => {
        if (index >= recipeIndex) return false;

        const text = getNodeText(node);
        if (!text) return false;

        if (
          (node.tagName === "H2" || node.tagName === "H3") &&
          /^(pour environ|ingrédients?|préparation|instructions?)/i.test(text)
        ) {
          return true;
        }

        if (
          (node.tagName === "H3" || node.tagName === "H4") &&
          /^(pour les?|pour la|pour le|vinaigre|riz|salade)/i.test(text)
        ) {
          return true;
        }

        if ((node.tagName === "UL" || node.tagName === "OL") && index > 0) {
          const previousTag = children[index - 1]?.tagName;
          return (
            previousTag === "H2" || previousTag === "H3" || previousTag === "H4"
          );
        }

        return false;
      });
      const duplicateRecipeStartIndex =
        recipeStartIndex > 0 &&
        children[recipeStartIndex - 1]?.tagName === "P" &&
        getNodeText(children[recipeStartIndex - 1])
          .replace(/\s*:\s*$/, "")
          .toLowerCase() === articleTitleNormalized
          ? recipeStartIndex - 1
          : recipeStartIndex;
      const stepStartIndex = children.findIndex(
        (node, index) =>
          index >= Math.max(duplicateRecipeStartIndex, 0) &&
          node.tagName === "H4",
      );
      const heroFigure = children.find((node) => node.tagName === "FIGURE");
      const duplicateRecipeNodes =
        duplicateRecipeStartIndex > -1
          ? children
              .slice(
                duplicateRecipeStartIndex,
                stepStartIndex > -1 ? stepStartIndex : recipeIndex,
              )
              .filter((node) => node.isConnected)
          : [];

      if (heroFigure) {
        heroFigure.remove();
      }

      recipeContainer
        .querySelectorAll(
          ".wprm-nutrition-label-text-nutrition-container-empty, .wprm-spacer, .wprm-icon-shortcode, .wprm-icon-shortcode-separate",
        )
        .forEach((node) => node.remove());

      const hasRecipeSideMedia = Boolean(
        recipeContainer.querySelector(
          ".wprm-container-float-right img, .wprm-container-float-right picture, .wprm-container-float-right video",
        ),
      );
      if (!hasRecipeSideMedia) {
        recipeContainer.classList.add("article-recipe--no-side-media");
      }

      const ingredientsContainer = recipeContainer.querySelector<HTMLElement>(
        ".wprm-recipe-ingredients-container",
      );
      const servingsCount =
        recipeContainer
          .querySelector<HTMLElement>(".wprm-recipe-servings")
          ?.textContent?.trim() || "";
      const servingsUnit =
        recipeContainer
          .querySelector<HTMLElement>(".wprm-recipe-servings-unit")
          ?.textContent?.trim() || "";
      if (
        ingredientsContainer &&
        !ingredientsContainer.querySelector(".article-ingredients-note")
      ) {
        const noteText = createServingsNote(
          content.dataset.articleTitle,
          servingsCount,
          servingsUnit,
        );
        if (noteText) {
          const note = document.createElement("div");
          note.className = "article-ingredients-note";
          note.textContent = noteText;
          const firstGroup = ingredientsContainer.querySelector(
            ".wprm-recipe-ingredient-group",
          );
          if (firstGroup) {
            ingredientsContainer.insertBefore(note, firstGroup);
          } else {
            ingredientsContainer.appendChild(note);
          }
        }
      }

      const nutritionContainer = recipeContainer.querySelector<HTMLElement>(
        ".wprm-nutrition-label-container",
      );
      if (nutritionContainer) {
        const nutritionOrder = [
          "calories",
          "fat",
          "monounsaturated_fat",
          "sodium",
          "sugar",
          "calcium",
          "carbohydrates",
          "saturated_fat",
          "trans_fat",
          "potassium",
          "vitamin_a",
          "iron",
          "protein",
          "polyunsaturated_fat",
          "cholesterol",
          "fiber",
          "vitamin_c",
        ];

        nutritionContainer
          .querySelectorAll<HTMLElement>(
            ".wprm-nutrition-label-text-nutrition-label",
          )
          .forEach((label) => {
            label.textContent =
              label.textContent?.replace(/\s*:\s*$/, "") || "";
          });

        nutritionContainer
          .querySelectorAll<HTMLElement>(
            ".wprm-nutrition-label-text-nutrition-container",
          )
          .forEach((item) => {
            const value = item.querySelector<HTMLElement>(
              ".wprm-nutrition-label-text-nutrition-value",
            );
            const unit = item.querySelector<HTMLElement>(
              ".wprm-nutrition-label-text-nutrition-unit",
            );
            if (
              !value ||
              !unit ||
              item.querySelector(".article-nutrition-metric")
            )
              return;

            const metric = document.createElement("div");
            metric.className = "article-nutrition-metric";
            metric.appendChild(value);
            metric.appendChild(unit);
            item.appendChild(metric);
          });

        nutritionOrder.forEach((token) => {
          const item = nutritionContainer.querySelector<HTMLElement>(
            `.wprm-nutrition-label-text-nutrition-container-${token}`,
          );
          if (item) nutritionContainer.appendChild(item);
        });
      }

      duplicateRecipeNodes.forEach((node) => node.remove());

      if (stepStartIndex > -1 && recipeIndex > stepStartIndex) {
        const manualNodes = children
          .slice(stepStartIndex, recipeIndex)
          .filter((node) => node.isConnected);
        const journey = document.createElement("section");
        journey.className = "article-visual-journey";

        const journeyHeader = document.createElement("div");
        journeyHeader.className = "article-visual-journey-header";
        journeyHeader.innerHTML = `
          <h2 class="article-visual-title">Préparation</h2>
        `;
        journey.append(journeyHeader);

        const journeyList = document.createElement("div");
        journeyList.className = "article-visual-list";

        let sectionLabel = "";
        let renderedSectionLabel = "";
        let stepIndex = 1;

        for (let i = 0; i < manualNodes.length; i += 1) {
          const node = manualNodes[i];
          if (!node) continue;

          if (node.tagName === "H4") {
            sectionLabel = node.textContent?.trim() || "";
            continue;
          }

          if (node.tagName !== "P") continue;

          const body = node.textContent?.replace(/\s+/g, " ").trim() || "";
          if (!body || body === content.dataset.articleTitle) continue;

          const normalizedSectionLabel = toSentenceCase(
            normalizeSectionLabel(sectionLabel),
          );
          if (
            normalizedSectionLabel &&
            normalizedSectionLabel !== renderedSectionLabel
          ) {
            const sectionHeader = document.createElement("div");
            sectionHeader.className = "article-step-group";
            sectionHeader.innerHTML = `
              <h3 class="article-step-group-title">${normalizedSectionLabel}</h3>
              <span class="article-step-group-line" aria-hidden="true"></span>
            `;
            journeyList.appendChild(sectionHeader);
            renderedSectionLabel = normalizedSectionLabel;
          }

          let figureNode: HTMLElement | null = null;
          const nextNode = manualNodes[i + 1];
          if (nextNode?.tagName === "FIGURE") {
            figureNode = nextNode;
            i += 1;
          }

          const card = document.createElement("article");
          card.className = "article-step-card";

          const textWrap = document.createElement("div");
          textWrap.className = "article-step-copy";

          const badge = document.createElement("span");
          badge.className = "article-step-badge";
          badge.textContent = String(stepIndex).padStart(2, "0");
          textWrap.appendChild(badge);

          const contentWrap = document.createElement("div");
          contentWrap.className = "article-step-text";

          const title = document.createElement("h3");
          title.className = "article-step-title";
          title.textContent = createStepTitle(body, sectionLabel, stepIndex);
          contentWrap.appendChild(title);

          const paragraph = document.createElement("p");
          paragraph.className = "article-step-body";
          paragraph.textContent = body;
          contentWrap.appendChild(paragraph);
          textWrap.appendChild(contentWrap);
          card.appendChild(textWrap);

          if (figureNode) {
            const media = document.createElement("div");
            media.className = "article-step-media";
            media.appendChild(figureNode.cloneNode(true));
            card.appendChild(media);
          }

          journeyList.appendChild(card);
          stepIndex += 1;
        }

        if (journeyList.children.length > 0) {
          journey.appendChild(journeyList);
          content.insertBefore(journey, recipeContainer);
        }

        manualNodes.forEach((node) => node.remove());
      }

      const recipeName = recipeContainer.querySelector(".wprm-recipe-name");
      if (
        recipeName &&
        recipeName.textContent?.trim() === content.dataset.articleTitle?.trim()
      ) {
        recipeName.classList.add("article-recipe-name--matched");
      }
    };

    const setupNewsletterShortcut = () => {
      const trigger = document.getElementById(
        "open-newsletter-article",
      ) as HTMLButtonElement | null;
      const quickInput = document.getElementById(
        "newsletter-article-email",
      ) as HTMLInputElement | null;
      const modalInput = document.getElementById(
        "newsletter-modal-article-email",
      ) as HTMLInputElement | null;

      if (!trigger || !quickInput || !modalInput) return;

      trigger.addEventListener("click", () => {
        const value = quickInput.value.trim();
        if (!value) return;
        modalInput.value = value;
        modalInput.dispatchEvent(new Event("input", { bubbles: true }));
      });
    };

    const setupRelatedSlider = () => {
      const viewport = document.querySelector<HTMLElement>(
        "[data-related-viewport]",
      );
      const track = document.querySelector<HTMLElement>("[data-related-track]");
      const prevButton = document.querySelector<HTMLButtonElement>(
        "[data-related-prev]",
      );
      const nextButton = document.querySelector<HTMLButtonElement>(
        "[data-related-next]",
      );
      const dotsHost = document.querySelector<HTMLElement>(
        "[data-related-dots]",
      );

      if (!viewport || !track) return;

      const cards = Array.from(
        track.querySelectorAll<HTMLElement>(".article-related-card"),
      );
      if (!cards.length) return;

      let currentIndex = 0;
      let visibleCards = 3;
      let maxIndex = 0;
      let gap = 20;

      const getVisibleCards = () => {
        if (window.innerWidth < 768) return 1;
        if (window.innerWidth < 1180) return 2;
        return 3;
      };

      const buildDots = () => {
        if (!dotsHost) return;

        dotsHost.innerHTML = "";
        const totalDots = Math.max(maxIndex + 1, 1);
        for (let index = 0; index < totalDots; index += 1) {
          const dot = document.createElement("button");
          dot.type = "button";
          dot.className = "article-related-dot";
          dot.setAttribute("aria-label", `Voir le groupe ${index + 1}`);
          if (index === currentIndex) dot.classList.add("is-active");
          dot.addEventListener("click", () => {
            currentIndex = index;
            updateSlider();
          });
          dotsHost.appendChild(dot);
        }
      };

      const updateSlider = () => {
        visibleCards = Math.min(getVisibleCards(), cards.length);
        maxIndex = Math.max(cards.length - visibleCards, 0);
        currentIndex = Math.min(currentIndex, maxIndex);

        const styles = window.getComputedStyle(track);
        gap = Number.parseFloat(styles.columnGap || styles.gap || "20") || 20;

        const viewportWidth = viewport.clientWidth;
        const cardWidth =
          visibleCards > 0
            ? (viewportWidth - gap * (visibleCards - 1)) / visibleCards
            : viewportWidth;
        const translateX = currentIndex * (cardWidth + gap);

        cards.forEach((card) => {
          card.style.flexBasis = `${cardWidth}px`;
        });

        track.style.transform = `translate3d(${-translateX}px, 0, 0)`;

        if (prevButton) {
          prevButton.disabled = currentIndex === 0;
          prevButton.setAttribute("aria-disabled", String(currentIndex === 0));
        }

        if (nextButton) {
          nextButton.disabled = currentIndex >= maxIndex;
          nextButton.setAttribute(
            "aria-disabled",
            String(currentIndex >= maxIndex),
          );
        }

        if (dotsHost) {
          const dots = Array.from(
            dotsHost.querySelectorAll<HTMLElement>(".article-related-dot"),
          );
          if (dots.length !== Math.max(maxIndex + 1, 1)) {
            buildDots();
            return;
          }
          dots.forEach((dot, index) => {
            dot.classList.toggle("is-active", index === currentIndex);
          });
        }
      };

      prevButton?.addEventListener("click", () => {
        if (currentIndex <= 0) return;
        currentIndex -= 1;
        updateSlider();
      });

      nextButton?.addEventListener("click", () => {
        if (currentIndex >= maxIndex) return;
        currentIndex += 1;
        updateSlider();
      });

      buildDots();
      updateSlider();
      window.addEventListener("resize", updateSlider, { passive: true });
    };

    const servingButtons = document.querySelectorAll<HTMLElement>(
      ".wprm-recipe-adjustable-servings",
    );
    const ingredientAmounts = document.querySelectorAll<HTMLElement>(
      ".wprm-recipe-ingredient-amount",
    );

    if (servingButtons.length && ingredientAmounts.length) {
      const originalAmounts = new Map();
      ingredientAmounts.forEach((el, index) => {
        const value = Number.parseFloat(el.textContent || "");
        if (Number.isFinite(value)) {
          originalAmounts.set(index, value);
        }
      });

      servingButtons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.classList.contains("wprm-toggle-active")),
        );
      });

      servingButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const multiplier = Number.parseInt(
            button.dataset.multiplier || "1",
            10,
          );
          if (!Number.isFinite(multiplier) || multiplier <= 0) return;

          servingButtons.forEach((otherButton) => {
            const isActive = otherButton === button;
            otherButton.classList.toggle("wprm-toggle-active", isActive);
            otherButton.setAttribute("aria-pressed", String(isActive));
          });

          ingredientAmounts.forEach((el, index) => {
            const original = originalAmounts.get(index);
            if (!Number.isFinite(original)) return;

            const updated = original * multiplier;
            el.textContent =
              updated % 1 === 0 ? updated.toString() : updated.toFixed(2);
          });
        });
      });
    }

    enhanceRecipeArticle();
    setupNewsletterShortcut();
    setupRelatedSlider();
  });
</script>


  .article-related-badge-plus::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    background: #111111;
    transform: translate(-50%, -50%);
    border-radius: 999px;
  }

  .article-related-badge-plus::before {
    width: 8px;
    height: 1px;

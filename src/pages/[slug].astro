---
import BaseLayout from "../layouts/BaseLayout.astro";
import DisqusComments from "../components/DisqusComments.astro";
import SocialShare from "../components/molecules/SocialShare.astro";
import NewsletterModal from "../components/organisms/NewsletterModal.astro";
import RecipeSidebar from "../components/organisms/RecipeSidebar.astro";

import { payloadFetch } from "../lib/payload.client";
import { getAllArticlesFromMongo, getArticleBySlugFromMongo, getRelatedArticlesFromMongo } from "../lib/mongo.server";
import { buildArticleJsonLd, buildBreadcrumbJsonLd } from "../utils/buildArticleJsonLd";
import { buildRecipeJsonLd } from "../utils/buildRecipeJsonLd";
import { processArticleImageUrl } from "../utils/cdnUrlReplacer";
import { renderArticleContent } from "../utils/renderArticleContent";

export const prerender = true;

const getBuildLimit = () => {
  const envLimit = Number(process.env.MAX_SSG_ARTICLES);
  return Number.isFinite(envLimit) && envLimit > 0 ? envLimit : 6000;
};

const stripHtml = (value: string) =>
  String(value || "")
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const toText = (value: any): string => {
  if (!value) return "";
  if (typeof value === "string") return stripHtml(value);
  if (Array.isArray(value)) return value.map((item) => toText(item)).filter(Boolean).join(" ");
  if (typeof value === "object") {
    const directCandidates = [value.rendered, value.value, value.text, value.title, value.name, value.label];
    for (const candidate of directCandidates) {
      const text = toText(candidate);
      if (text) return text;
    }
    if (Array.isArray(value.children)) {
      return value.children.map((child: any) => toText(child)).filter(Boolean).join(" ");
    }
    if (value.content) return toText(value.content);
  }
  return "";
};

const normalizeSlug = (value: any) => String(value || "").replace(/^\/+|\/+$/g, "");
const extractId = (value: any): string => {
  if (!value) return "";
  if (typeof value === "string" || typeof value === "number") return String(value);
  if (typeof value === "object") {
    return String(value.id || value._id || value.value || "");
  }
  return "";
};

const formatRecipeTimeLabel = (value: any): string => {
  if (value === null || value === undefined) return "";
  const raw = String(value).replace(/\s+/g, " ").trim();
  if (!raw) return "";

  const numeric = Number(raw);
  if (Number.isFinite(numeric) && numeric > 0) {
    if (numeric < 60) return `${numeric}MIN`;
    const hours = Math.floor(numeric / 60);
    const minutes = numeric % 60;
    return minutes ? `${hours}H${String(minutes).padStart(2, "0")}` : `${hours}H`;
  }

  return raw.toUpperCase();
};

export async function getStaticPaths() {
  let articles: any[] = [];

  const decodeSafe = (value: string) => {
    try {
      return decodeURIComponent(value);
    } catch {
      return value;
    }
  };

  try {
    articles = await getAllArticlesFromMongo();
  } catch (error) {
    console.error("getAllArticlesFromMongo failed, falling back to Payload:", error);
  }

  if (!articles || articles.length === 0) {
    try {
      const payloadResponse: any = await payloadFetch({
        collection: "articles",
        query: { depth: 2, limit: getBuildLimit() },
      });
      articles = payloadResponse?.docs || payloadResponse || [];
    } catch (error) {
      console.error("payloadFetch fallback failed:", error);
    }
  }

  if (!Array.isArray(articles)) return [];

  return articles
    .filter((item: any) => item?.slug)
    .map((item: any) => {
      const rawSlug = typeof item.slug === "string" ? item.slug : item.slug?.current || "";
      const slugValue = decodeSafe(rawSlug);
      return {
        params: { slug: slugValue },
        props: { article: { ...item, slug: slugValue } },
      };
    });
}

interface Props {
  article: any;
}

let { article } = Astro.props as Props;

if (!article) {
  throw new Error("Article data missing at build time");
}

const slug = normalizeSlug(typeof article.slug === "string" ? article.slug : article.slug?.current || "");

if (slug && !processArticleImageUrl(article)) {
  const hydratedArticle = await getArticleBySlugFromMongo(slug);
  if (hydratedArticle) {
    article = {
      ...article,
      ...hydratedArticle,
    };
  }
}

const getExcerpt = () => {
  if (typeof article.excerpt === "string") return article.excerpt.substring(0, 160);
  if (Array.isArray(article.excerpt)) {
    return article.excerpt
      .map((block: any) => block.children?.map((child: any) => child.text).join(" ") || "")
      .join(" ")
      .substring(0, 160);
  }
  return "";
};

const title = article.title || "Untitled";
const content = renderArticleContent(article);
const firstContentParagraphHtml = content.match(/<p\b[^>]*>[\s\S]*?<\/p>/i)?.[0] || "";
const firstContentParagraphHasImage = /<(?:img|picture|figure)\b/i.test(firstContentParagraphHtml);
const excerpt = getExcerpt();
const image = processArticleImageUrl(article);
const imageAlt = toText(article.featuredMedia?.alt || article.featuredImage?.alt || article.featured_image?.alt) || "Article featured image";

const articleJsonLd = buildArticleJsonLd(article, "https://lacuisinedebernard.com");
const breadcrumbJsonLd = buildBreadcrumbJsonLd(title, slug, "https://lacuisinedebernard.com");
const recipeJsonLd = buildRecipeJsonLd(article);

const articleUrl = `https://lacuisinedebernard.com/${slug}/`;
const articleShareLinks = [
  {
    label: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(articleUrl)}`,
    icon: "fab fa-facebook-f",
  },
  {
    label: "Pinterest",
    href: `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(articleUrl)}&description=${encodeURIComponent(title)}`,
    icon: "fab fa-pinterest-p",
  },
  {
    label: "Email",
    href: `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(articleUrl)}`,
    icon: "far fa-envelope",
  },
];
const numericPostId = Number(article?.post_id);
const disqusIdentifier = Number.isFinite(numericPostId) && numericPostId > 0
  ? `${numericPostId} https://lacuisinedebernard.com/?p=${numericPostId}`
  : slug;
const ratingLabel = "Pas encore de notes";

const normalizePageLanguage = (value: any) => {
  const raw = String(value || "").trim().toLowerCase();
  if (raw === "pt" || raw === "pt_br" || raw === "ptbr") return "pt-br";
  if (["en", "fr", "es", "pt-br", "ar"].includes(raw)) return raw;
  return "fr";
};

const pageLang = normalizePageLanguage(article?.lang || article?.language || article?.locale);
const excerptText = toText(article?.excerpt);
const authorName = toText(article?.author?.name || article?.author?.title || article?.author) || "Bernard Laurance";
const displayAuthorName = authorName.toLowerCase() === "bernard" ? "Bernard Laurance" : authorName;

const categoryItems = (Array.isArray(article?.categories) ? article.categories : [])
  .map((item: any) => {
    const itemTitle = toText(item?.title || item?.name || item?.label || item);
    const itemSlug = normalizeSlug(typeof item?.slug === "string" ? item.slug : item?.slug?.current);
    return itemTitle ? { title: itemTitle, slug: itemSlug } : null;
  })
  .filter(Boolean);

const categoryIds = (Array.isArray(article?.categories) ? article.categories : [])
  .map((item: any) => extractId(item))
  .filter(Boolean);

const currentArticleId = extractId(article?.id || article?._id);

const relatedArticlesRaw =
  categoryIds.length > 0 && currentArticleId
    ? await getRelatedArticlesFromMongo(categoryIds, currentArticleId, 6)
    : [];

const relatedArticles = (Array.isArray(relatedArticlesRaw) ? relatedArticlesRaw : [])
  .map((item: any) => {
    const relatedSlug = normalizeSlug(typeof item?.slug === "string" ? item.slug : item?.slug?.current || "");
    const relatedTitle = toText(item?.title);
    if (!relatedSlug || !relatedTitle) return null;

    const relatedCategories = Array.isArray(item?.categories) ? item.categories : [];
    const relatedCategory = relatedCategories
      .map((category: any) => toText(category?.name || category?.title || category))
      .find(Boolean);

    return {
      slug: relatedSlug,
      title: relatedTitle,
      image: processArticleImageUrl(item),
      category: relatedCategory || "Recette",
      metaPrimary: (toText(item?.difficulty || item?.recipeDifficulty || item?.recipe?.difficulty) || relatedCategory || "Recette").toUpperCase(),
      metaSecondary: formatRecipeTimeLabel(
        item?.prep_time ??
          item?.prepTime ??
          item?.total_time ??
          item?.totalTime ??
          item?.cook_time ??
          item?.cookTime,
      ),
    };
  })
  .filter(Boolean)
  .slice(0, 6);

const tagItems = (Array.isArray(article?.tags) ? article.tags : [])
  .map((item: any) => {
    const itemTitle = toText(item?.title || item?.name || item?.label || item);
    const itemSlug = normalizeSlug(typeof item?.slug === "string" ? item.slug : item?.slug?.current);
    return itemTitle ? { title: itemTitle, slug: itemSlug } : null;
  })
  .filter(Boolean);
---

<BaseLayout
  title={title}
  description={excerpt}
  canonical={articleUrl}
  image={image}
  jsonLd={[articleJsonLd, breadcrumbJsonLd, recipeJsonLd].filter(Boolean)}
  slug={slug}
  lang={pageLang}
  loadAds={true}
  showGlobalAbout={false}
>
  <section class="lcdb-page-hero">
    <div class="lcdb-page-shell lcdb-page-hero-inner">
      <nav class="article-breadcrumb typ-caption" aria-label="Breadcrumb">
        <a href="/" class="article-breadcrumb-link">Accueil</a>
        <span>/</span>
        <span class="article-breadcrumb-current">{title}</span>
      </nav>
      <div class="article-hero-topline">
        <div class="article-hero-copy">
          <p class="lcdb-page-eyebrow typ-caption">{categoryItems[0]?.title || "Recette"}</p>
          <h1 class="lcdb-page-title typ-h2">{title}</h1>
          <div class="article-hero-meta typ-body">
            <span>{authorName}</span>
            {categoryItems[1]?.title && <span>{categoryItems[1].title}</span>}
          </div>
        </div>

        <div class="article-hero-actions">
          <SocialShare url={articleUrl} title={title} class="article-share-inline" />
          <a
            href={`/print/${slug}/?auto=1`}
            target="_blank"
            rel="noopener noreferrer"
            class="article-print-btn typ-button"
          >
            Imprimer la recette
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="lcdb-page-section">
    <div class="lcdb-page-shell lcdb-page-section-inner">
      <div class="article-layout">
        <div class="article-main-column">
          <section class="article-intro-card">
            <div class="article-intro-topbar">
              <nav class="article-breadcrumb typ-caption" aria-label="Breadcrumb">
                <a href="/" class="article-breadcrumb-link">Accueil</a>
                <span>/</span>
                <span>Recettes</span>
                <span>/</span>
                <span class="article-breadcrumb-current">{title}</span>
              </nav>

              <div class="article-intro-actions-bar" aria-label="Actions de l'article">
                <div class="article-toolbar-share-links">
                  {articleShareLinks.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="article-toolbar-link article-toolbar-link--share"
                      aria-label={`Partager sur ${link.label}`}
                    >
                      <i class={link.icon} aria-hidden="true"></i>
                    </a>
                  ))}
                </div>
                <a
                  href={`/print/${slug}/?auto=1`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="article-toolbar-link article-toolbar-link--print"
                  aria-label="Imprimer la recette"
                >
                  <i class="fas fa-print" aria-hidden="true"></i>
                </a>
                <a
                  href="/favoris"
                  class="article-toolbar-link article-toolbar-link--favorite"
                  aria-label="Ajouter aux favoris"
                >
                  <i class="far fa-bookmark" aria-hidden="true"></i>
                </a>
              </div>
            </div>

            <div class="article-intro-topline">
              <div class="article-intro-copy">
                <h1 class="article-intro-title">{title}</h1>
                <div class="article-intro-rating" aria-label={ratingLabel}>
                  <span class="article-intro-stars" aria-hidden="true">
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                  </span>
                  <span class="article-intro-rating-label">{ratingLabel}</span>
                </div>
              </div>

            </div>

            <div class="article-intro-meta">
              <div class="article-intro-meta-item">
                <span class="article-intro-meta-label"><i class="far fa-folder-open"></i> Catégorie</span>
                <span class="article-intro-meta-value">
                  {categoryItems.map((item: any) => item.title).join(", ") || "Recette"}
                </span>
              </div>
              <div class="article-intro-meta-item">
                <span class="article-intro-meta-label"><i class="far fa-user"></i> Auteur</span>
                <span class="article-intro-meta-value">{displayAuthorName}</span>
              </div>
            </div>
          </section>

          {image && !firstContentParagraphHasImage && (
            <figure class="lcdb-surface-card article-hero-image">
              <img src={image} alt={imageAlt} loading="eager" />
            </figure>
          )}

          <article class="lcdb-surface-card article-content-card">
            {(categoryItems.length > 0 || tagItems.length > 0) && (
              <div class="article-chip-groups">
                {categoryItems.map((category: any) => (
                  <a href={category.slug ? `/categories/${category.slug}` : "/categories"} class="lcdb-chip article-chip-link">
                    {category.title}
                  </a>
                ))}
                {tagItems.map((tag: any) => (
                  <a href={tag.slug ? `/tags/${tag.slug}` : "/tags"} class="lcdb-chip article-chip-link article-tag-chip">
                    #{tag.title}
                  </a>
                ))}
              </div>
            )}

            <div
              class="article-content typ-body"
              data-article-title={title}
              data-article-summary={excerptText}
              set:html={content}
            />
          </article>

          <section class="lcdb-surface-card article-newsletter-card">
            <div class="article-newsletter-media" aria-hidden="true">
              <img
                src="/images/bernard-blog.png"
                alt=""
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="article-newsletter-copy">
              <p class="article-newsletter-eyebrow typ-caption">Newsletter</p>
              <h2 class="article-newsletter-title">Abonnez-vous à La Cuisine de Bernard</h2>
              <p class="article-newsletter-text">
                Recevez toute l'actualité de La Cuisine De Bernard, ses dernières publications et plus encore, directement dans votre boîte de réception.
              </p>
              <div class="article-newsletter-form">
                <input
                  id="newsletter-article-email"
                  type="email"
                  class="article-newsletter-input"
                  placeholder="Votre adresse email"
                  aria-label="Votre adresse email"
                />
                <button id="open-newsletter-article" class="article-newsletter-btn typ-button" type="button">
                  S'abonner
                </button>
              </div>
            </div>
          </section>

          <section class="lcdb-surface-card comments-card" id="comments">
            <h2 class="comments-title">Commentaires</h2>
            <DisqusComments
              url={articleUrl}
              identifier={disqusIdentifier}
              title={title}
              showTitle={false}
              showComposerPreview={true}
            />
          </section>

        </div>

        <div class="article-sidebar-column">
          <RecipeSidebar variant="full" stickyPopularRail={true} />
        </div>
      </div>

      {relatedArticles.length > 0 && (
        <section class="article-related-section article-related-section--fullwidth">
          <div class="article-related-header">
            <div>
              <h2 class="article-related-title">Vous aimerez aussi</h2>
            </div>
            <div class="article-related-controls">
              <button class="article-related-arrow" type="button" data-related-prev aria-label="Précédent">
                <img
                  src="/images/client-arrow-circle.svg"
                  alt=""
                  class="article-related-arrow-icon article-related-arrow-icon--prev"
                  loading="lazy"
                  decoding="async"
                />
              </button>
              <button class="article-related-arrow" type="button" data-related-next aria-label="Suivant">
                <img
                  src="/images/client-arrow-circle.svg"
                  alt=""
                  class="article-related-arrow-icon article-related-arrow-icon--next"
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </div>
          </div>

          <div class="article-related-viewport" data-related-viewport>
            <div class="article-related-track" data-related-track>
              {relatedArticles.map((related: any) => (
                <a href={`/${related.slug}/`} class="article-related-card">
                  <div class="article-related-media">
                    <span class="article-related-badge" aria-hidden="true">
                      <span class="article-related-badge-icon">
                        <i class="far fa-bookmark"></i>
                        <span class="article-related-badge-plus"></span>
                      </span>
                    </span>
                    {related.image ? (
                      <img src={related.image} alt={related.title} loading="lazy" />
                    ) : (
                      <div class="article-related-placeholder" aria-hidden="true"></div>
                    )}
                  </div>
                  <div class="article-related-body">
                    <p class="article-related-category typ-caption">{related.category}</p>
                    <h3 class="article-related-card-title">{related.title}</h3>
                    <div class="article-related-footer">
                      <div class="article-related-meta">
                        <span>{related.metaPrimary}</span>
                        {related.metaSecondary && (
                          <>
                            <span class="article-related-meta-divider" aria-hidden="true"></span>
                            <span>{related.metaSecondary}</span>
                          </>
                        )}
                      </div>
                      <div class="article-related-share" aria-hidden="true">
                        <i class="fab fa-facebook-f"></i>
                        <i class="fab fa-pinterest-p"></i>
                        <i class="far fa-envelope"></i>
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
          <div class="article-related-dots" data-related-dots aria-label="Navigation des suggestions"></div>
        </section>
      )}
    </div>
  </section>

  <NewsletterModal triggerId="open-newsletter-article" id="newsletter-modal-article" />
</BaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const normalizeSectionLabel = (text) =>
      String(text || "")
        .replace(/\s+/g, " ")
        .trim()
        .replace(/^pour\s+(les|le|la|l'|des|du)\s+/i, "")
        .replace(/\s+\d+\s*pi(?:è|e)ces?$/i, "")
        .replace(/\s*:\s*$/, "")
        .trim();

    const toSentenceCase = (value) => {
      const cleaned = String(value || "").trim();
      if (!cleaned) return "";
      return cleaned.charAt(0).toUpperCase() + cleaned.slice(1);
    };

    const createServingsNote = (title, servings, unit) => {
      const count = String(servings || "").trim();
      const servingsUnit = String(unit || "").replace(/\s+/g, " ").trim();
      const titleText = String(title || "").toLowerCase();
      if (!count) return "";
      if (titleText.includes("gunkan")) return `Pour environ ${count} gunkan makis`;
      return `Pour environ ${count}${servingsUnit ? ` ${servingsUnit}` : ""}`;
    };

    const createStepTitle = (text, fallbackLabel, index) => {
      const cleaned = String(text || "").replace(/\s+/g, " ").trim();
      const normalizedLabel = String(fallbackLabel || "")
        .replace(/\s+/g, " ")
        .trim()
        .replace(/\s*:\s*$/, "");
      const firstSentence = cleaned.split(/[.!?]/)[0]?.trim() || "";
      const actionMatch = firstSentence.match(
        /\b(?:faire\s+)?(?:mariner|mélanger|couper|laissez?|mettre|placez|égouttez|versez|hachez|prenez|coupez|remplissez|ajoutez|pesez|façonnez|dégustez)\b[^.!?]*/i
      );
      if (actionMatch?.[0]) {
        let actionTitle = actionMatch[0].replace(/^faire\s+/i, "").trim();
        actionTitle = actionTitle.split(/\b(?:dans le cas|avant de|afin de|pendant|avec)\b/i)[0]?.trim() || actionTitle;
        actionTitle = toSentenceCase(actionTitle);
        if (actionTitle) {
          return actionTitle.length > 54 ? `${actionTitle.slice(0, 51).trim()}...` : actionTitle;
        }
      }
      const firstClause = firstSentence.split(/[,:;]/)[0]?.trim() || "";

      if (firstClause) {
        return firstClause.length > 54 ? `${firstClause.slice(0, 51).trim()}...` : firstClause;
      }

      if (firstSentence) {
        return firstSentence.length > 60 ? `${firstSentence.slice(0, 57).trim()}...` : firstSentence;
      }

      if (normalizedLabel) return normalizedLabel;
      return `Étape ${index}`;
    };

    const enhanceRecipeArticle = () => {
      const content = document.querySelector<HTMLElement>(".article-content");
      if (!content || content.dataset.enhanced === "true") return;

      const recipeContainer = content.querySelector<HTMLElement>(".wprm-recipe-container");
      if (!recipeContainer) return;

      content.dataset.enhanced = "true";

      content.querySelectorAll(".xs_social_share_widget, .xs_share_url, .wslu-share-box").forEach((node) => node.remove());

      content.querySelectorAll(":scope > p").forEach((node) => {
        const text = node.textContent?.replace(/\u00a0/g, " ").replace(/\s+/g, " ").trim() || "";
        if (!text && !node.querySelector("img, picture, video, iframe")) {
          node.remove();
        }
      });

      const children = Array.from(content.children) as HTMLElement[];
      const recipeIndex = children.indexOf(recipeContainer);
      const articleTitleNormalized = String(content.dataset.articleTitle || "")
        .replace(/\u00a0/g, " ")
        .replace(/\s+/g, " ")
        .trim()
        .toLowerCase();
      const getNodeText = (node: Element | null) =>
        node?.textContent?.replace(/\u00a0/g, " ").replace(/\s+/g, " ").trim() || "";
      const recipeStartIndex = children.findIndex((node, index) => {
        if (index >= recipeIndex) return false;

        const text = getNodeText(node);
        if (!text) return false;

        if ((node.tagName === "H2" || node.tagName === "H3") && /^(pour environ|ingrédients?|préparation|instructions?)/i.test(text)) {
          return true;
        }

        if ((node.tagName === "H3" || node.tagName === "H4") && /^(pour les?|pour la|pour le|vinaigre|riz|salade)/i.test(text)) {
          return true;
        }

        if ((node.tagName === "UL" || node.tagName === "OL") && index > 0) {
          const previousTag = children[index - 1]?.tagName;
          return previousTag === "H2" || previousTag === "H3" || previousTag === "H4";
        }

        return false;
      });
      const duplicateRecipeStartIndex =
        recipeStartIndex > 0 &&
        children[recipeStartIndex - 1]?.tagName === "P" &&
        getNodeText(children[recipeStartIndex - 1]).replace(/\s*:\s*$/, "").toLowerCase() === articleTitleNormalized
          ? recipeStartIndex - 1
          : recipeStartIndex;
      const stepStartIndex = children.findIndex((node, index) => index >= Math.max(duplicateRecipeStartIndex, 0) && node.tagName === "H4");
      const heroFigure = children.find((node) => node.tagName === "FIGURE");
      const duplicateRecipeNodes =
        duplicateRecipeStartIndex > -1
          ? children.slice(duplicateRecipeStartIndex, stepStartIndex > -1 ? stepStartIndex : recipeIndex).filter((node) => node.isConnected)
          : [];

      if (heroFigure) {
        heroFigure.remove();
      }

      recipeContainer
        .querySelectorAll(
          ".wprm-nutrition-label-text-nutrition-container-empty, .wprm-spacer, .wprm-icon-shortcode, .wprm-icon-shortcode-separate"
        )
        .forEach((node) => node.remove());

      const hasRecipeSideMedia = Boolean(
        recipeContainer.querySelector(".wprm-container-float-right img, .wprm-container-float-right picture, .wprm-container-float-right video")
      );
      if (!hasRecipeSideMedia) {
        recipeContainer.classList.add("article-recipe--no-side-media");
      }

      const ingredientsContainer = recipeContainer.querySelector<HTMLElement>(".wprm-recipe-ingredients-container");
      const servingsCount = recipeContainer.querySelector<HTMLElement>(".wprm-recipe-servings")?.textContent?.trim() || "";
      const servingsUnit = recipeContainer.querySelector<HTMLElement>(".wprm-recipe-servings-unit")?.textContent?.trim() || "";
      if (ingredientsContainer && !ingredientsContainer.querySelector(".article-ingredients-note")) {
        const noteText = createServingsNote(content.dataset.articleTitle, servingsCount, servingsUnit);
        if (noteText) {
          const note = document.createElement("div");
          note.className = "article-ingredients-note";
          note.textContent = noteText;
          const firstGroup = ingredientsContainer.querySelector(".wprm-recipe-ingredient-group");
          if (firstGroup) {
            ingredientsContainer.insertBefore(note, firstGroup);
          } else {
            ingredientsContainer.appendChild(note);
          }
        }
      }

      const nutritionContainer = recipeContainer.querySelector<HTMLElement>(".wprm-nutrition-label-container");
      if (nutritionContainer) {
        const nutritionOrder = [
          "calories",
          "fat",
          "monounsaturated_fat",
          "sodium",
          "sugar",
          "calcium",
          "carbohydrates",
          "saturated_fat",
          "trans_fat",
          "potassium",
          "vitamin_a",
          "iron",
          "protein",
          "polyunsaturated_fat",
          "cholesterol",
          "fiber",
          "vitamin_c",
        ];

        nutritionContainer
          .querySelectorAll<HTMLElement>(".wprm-nutrition-label-text-nutrition-label")
          .forEach((label) => {
            label.textContent = label.textContent?.replace(/\s*:\s*$/, "") || "";
          });

        nutritionContainer
          .querySelectorAll<HTMLElement>(".wprm-nutrition-label-text-nutrition-container")
          .forEach((item) => {
            const value = item.querySelector<HTMLElement>(".wprm-nutrition-label-text-nutrition-value");
            const unit = item.querySelector<HTMLElement>(".wprm-nutrition-label-text-nutrition-unit");
            if (!value || !unit || item.querySelector(".article-nutrition-metric")) return;

            const metric = document.createElement("div");
            metric.className = "article-nutrition-metric";
            metric.appendChild(value);
            metric.appendChild(unit);
            item.appendChild(metric);
          });

        nutritionOrder.forEach((token) => {
          const item = nutritionContainer.querySelector<HTMLElement>(
            `.wprm-nutrition-label-text-nutrition-container-${token}`
          );
          if (item) nutritionContainer.appendChild(item);
        });
      }

      duplicateRecipeNodes.forEach((node) => node.remove());

      if (stepStartIndex > -1 && recipeIndex > stepStartIndex) {
        const manualNodes = children.slice(stepStartIndex, recipeIndex).filter((node) => node.isConnected);
        const journey = document.createElement("section");
        journey.className = "article-visual-journey";

        const journeyHeader = document.createElement("div");
        journeyHeader.className = "article-visual-journey-header";
        journeyHeader.innerHTML = `
          <h2 class="article-visual-title">Préparation</h2>
        `;
        journey.append(journeyHeader);

        const journeyList = document.createElement("div");
        journeyList.className = "article-visual-list";

        let sectionLabel = "";
        let renderedSectionLabel = "";
        let stepIndex = 1;

        for (let i = 0; i < manualNodes.length; i += 1) {
          const node = manualNodes[i];
          if (!node) continue;

          if (node.tagName === "H4") {
            sectionLabel = node.textContent?.trim() || "";
            continue;
          }

          if (node.tagName !== "P") continue;

          const body = node.textContent?.replace(/\s+/g, " ").trim() || "";
          if (!body || body === content.dataset.articleTitle) continue;

          const normalizedSectionLabel = toSentenceCase(normalizeSectionLabel(sectionLabel));
          if (normalizedSectionLabel && normalizedSectionLabel !== renderedSectionLabel) {
            const sectionHeader = document.createElement("div");
            sectionHeader.className = "article-step-group";
            sectionHeader.innerHTML = `
              <h3 class="article-step-group-title">${normalizedSectionLabel}</h3>
              <span class="article-step-group-line" aria-hidden="true"></span>
            `;
            journeyList.appendChild(sectionHeader);
            renderedSectionLabel = normalizedSectionLabel;
          }

          let figureNode: HTMLElement | null = null;
          const nextNode = manualNodes[i + 1];
          if (nextNode?.tagName === "FIGURE") {
            figureNode = nextNode;
            i += 1;
          }

          const card = document.createElement("article");
          card.className = "article-step-card";

          const textWrap = document.createElement("div");
          textWrap.className = "article-step-copy";

          const badge = document.createElement("span");
          badge.className = "article-step-badge";
          badge.textContent = String(stepIndex).padStart(2, "0");
          textWrap.appendChild(badge);

          const contentWrap = document.createElement("div");
          contentWrap.className = "article-step-text";

          const title = document.createElement("h3");
          title.className = "article-step-title";
          title.textContent = createStepTitle(body, sectionLabel, stepIndex);
          contentWrap.appendChild(title);

          const paragraph = document.createElement("p");
          paragraph.className = "article-step-body";
          paragraph.textContent = body;
          contentWrap.appendChild(paragraph);
          textWrap.appendChild(contentWrap);
          card.appendChild(textWrap);

          if (figureNode) {
            const media = document.createElement("div");
            media.className = "article-step-media";
            media.appendChild(figureNode.cloneNode(true));
            card.appendChild(media);
          }

          journeyList.appendChild(card);
          stepIndex += 1;
        }

        if (journeyList.children.length > 0) {
          journey.appendChild(journeyList);
          content.insertBefore(journey, recipeContainer);
        }

        manualNodes.forEach((node) => node.remove());
      }

      const recipeName = recipeContainer.querySelector(".wprm-recipe-name");
      if (recipeName && recipeName.textContent?.trim() === content.dataset.articleTitle?.trim()) {
        recipeName.classList.add("article-recipe-name--matched");
      }
    };

    const setupNewsletterShortcut = () => {
      const trigger = document.getElementById("open-newsletter-article") as HTMLButtonElement | null;
      const quickInput = document.getElementById("newsletter-article-email") as HTMLInputElement | null;
      const modalInput = document.getElementById("newsletter-modal-article-email") as HTMLInputElement | null;

      if (!trigger || !quickInput || !modalInput) return;

      trigger.addEventListener("click", () => {
        const value = quickInput.value.trim();
        if (!value) return;
        modalInput.value = value;
        modalInput.dispatchEvent(new Event("input", { bubbles: true }));
      });
    };

    const setupRelatedSlider = () => {
      const viewport = document.querySelector<HTMLElement>("[data-related-viewport]");
      const track = document.querySelector<HTMLElement>("[data-related-track]");
      const prevButton = document.querySelector<HTMLButtonElement>("[data-related-prev]");
      const nextButton = document.querySelector<HTMLButtonElement>("[data-related-next]");
      const dotsHost = document.querySelector<HTMLElement>("[data-related-dots]");

      if (!viewport || !track) return;

      const cards = Array.from(track.querySelectorAll<HTMLElement>(".article-related-card"));
      if (!cards.length) return;

      let currentIndex = 0;
      let visibleCards = 3;
      let maxIndex = 0;
      let gap = 20;

      const getVisibleCards = () => {
        if (window.innerWidth < 768) return 1;
        if (window.innerWidth < 1180) return 2;
        return 3;
      };

      const buildDots = () => {
        if (!dotsHost) return;

        dotsHost.innerHTML = "";
        const totalDots = Math.max(maxIndex + 1, 1);
        for (let index = 0; index < totalDots; index += 1) {
          const dot = document.createElement("button");
          dot.type = "button";
          dot.className = "article-related-dot";
          dot.setAttribute("aria-label", `Voir le groupe ${index + 1}`);
          if (index === currentIndex) dot.classList.add("is-active");
          dot.addEventListener("click", () => {
            currentIndex = index;
            updateSlider();
          });
          dotsHost.appendChild(dot);
        }
      };

      const updateSlider = () => {
        visibleCards = Math.min(getVisibleCards(), cards.length);
        maxIndex = Math.max(cards.length - visibleCards, 0);
        currentIndex = Math.min(currentIndex, maxIndex);

        const styles = window.getComputedStyle(track);
        gap = Number.parseFloat(styles.columnGap || styles.gap || "20") || 20;

        const viewportWidth = viewport.clientWidth;
        const cardWidth = visibleCards > 0 ? (viewportWidth - gap * (visibleCards - 1)) / visibleCards : viewportWidth;
        const translateX = currentIndex * (cardWidth + gap);

        cards.forEach((card) => {
          card.style.flexBasis = `${cardWidth}px`;
        });

        track.style.transform = `translate3d(${-translateX}px, 0, 0)`;

        if (prevButton) {
          prevButton.disabled = currentIndex === 0;
          prevButton.setAttribute("aria-disabled", String(currentIndex === 0));
        }

        if (nextButton) {
          nextButton.disabled = currentIndex >= maxIndex;
          nextButton.setAttribute("aria-disabled", String(currentIndex >= maxIndex));
        }

        if (dotsHost) {
          const dots = Array.from(dotsHost.querySelectorAll<HTMLElement>(".article-related-dot"));
          if (dots.length !== Math.max(maxIndex + 1, 1)) {
            buildDots();
            return;
          }
          dots.forEach((dot, index) => {
            dot.classList.toggle("is-active", index === currentIndex);
          });
        }
      };

      prevButton?.addEventListener("click", () => {
        if (currentIndex <= 0) return;
        currentIndex -= 1;
        updateSlider();
      });

      nextButton?.addEventListener("click", () => {
        if (currentIndex >= maxIndex) return;
        currentIndex += 1;
        updateSlider();
      });

      buildDots();
      updateSlider();
      window.addEventListener("resize", updateSlider, { passive: true });
    };

    const servingButtons = document.querySelectorAll<HTMLElement>(".wprm-recipe-adjustable-servings");
    const ingredientAmounts = document.querySelectorAll<HTMLElement>(".wprm-recipe-ingredient-amount");

    if (servingButtons.length && ingredientAmounts.length) {
      const originalAmounts = new Map();
      ingredientAmounts.forEach((el, index) => {
        const value = Number.parseFloat(el.textContent || "");
        if (Number.isFinite(value)) {
          originalAmounts.set(index, value);
        }
      });

      servingButtons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.classList.contains("wprm-toggle-active")));
      });

      servingButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const multiplier = Number.parseInt(button.dataset.multiplier || "1", 10);
          if (!Number.isFinite(multiplier) || multiplier <= 0) return;

          servingButtons.forEach((otherButton) => {
            const isActive = otherButton === button;
            otherButton.classList.toggle("wprm-toggle-active", isActive);
            otherButton.setAttribute("aria-pressed", String(isActive));
          });

          ingredientAmounts.forEach((el, index) => {
            const original = originalAmounts.get(index);
            if (!Number.isFinite(original)) return;

            const updated = original * multiplier;
            el.textContent = updated % 1 === 0 ? updated.toString() : updated.toFixed(2);
          });
        });
      });
    }

    enhanceRecipeArticle();
    setupNewsletterShortcut();
    setupRelatedSlider();
  });
</script>


const WORKSHOPS_SOURCE_URL =
  process.env.WORKSHOPS_CACHE_URL ||
  'https://lacuisinedebernard.com/api/workshops-cache';
const WORKSHOPS_FETCH_TIMEOUT_MS = 5000;
const WORKSHOP_FALLBACK_IMAGE = '/images/ateliers-physiques.jpg';

const decodeEntities = (value: string): string =>
  String(value || '')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#039;/g, "'")
    .replace(/&apos;/g, "'")
    .replace(/&rsquo;/g, "'")
    .replace(/&lsquo;/g, "'")
    .replace(/&rdquo;/g, '"')
    .replace(/&ldquo;/g, '"')
    .replace(/&ndash;/g, '-')
    .replace(/&mdash;/g, '-')
    .replace(/&hellip;/g, '...')
    .replace(/<[^>]*>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const toPositiveNumber = (value: any, fallback = 0): number => {
  const numeric = Number(value);
  return Number.isFinite(numeric) && numeric >= 0 ? numeric : fallback;
};

const toWorkshopDate = (value: any): Date | null => {
  if (!value) return null;
  const parsed = new Date(value);
  return Number.isNaN(parsed.getTime()) ? null : parsed;
};

const formatWorkshopDuration = (value: any): string => {
  const minutes = toPositiveNumber(value, 0);
  if (!minutes) return '--';
  const hours = Math.floor(minutes / 60);
  const restMinutes = minutes % 60;
  if (hours && restMinutes) return `${hours}h ${restMinutes}m`;
  if (hours) return `${hours}h`;
  return `${restMinutes}m`;
};

const normalizeWorkshopStatus = (value: any): 'OPEN' | 'LIMITED' | 'SOLD_OUT' => {
  const raw = String(value || '').toUpperCase().trim();
  if (raw === 'SOLD_OUT') return 'SOLD_OUT';
  if (raw === 'LIMITED') return 'LIMITED';
  return 'OPEN';
};

const normalizeWorkshopHref = (value: any): string => {
  const raw = String(value || '').trim();
  if (!raw) return '/ateliers';
  if (/^https?:\/\//i.test(raw)) return raw;
  return raw.startsWith('/') ? raw : `/${raw.replace(/^\/+/, '')}`;
};

const mapWorkshopItem = (item: any, index: number) => {
  if (!item || typeof item !== 'object') return null;

  const parsedDate = toWorkshopDate(item.startAt || item.date);
  if (!parsedDate) return null;

  const title = decodeEntities(item.title || '');
  if (!title) return null;

  const maxParticipants = toPositiveNumber(item.capacity || item.maxParticipants, 0);
  const rawSpotsLeft = toPositiveNumber(item.spotsLeft, Number.NaN);
  const spotsLeft = Number.isFinite(rawSpotsLeft)
    ? rawSpotsLeft
    : maxParticipants > 0
    ? Math.max(maxParticipants - toPositiveNumber(item.currentParticipants, 0), 0)
    : 0;
  const currentParticipants = maxParticipants > 0 ? Math.max(maxParticipants - spotsLeft, 0) : 0;

  return {
    id: String(item.id || item.slug || index + 1),
    title,
    date: parsedDate,
    image: item?.image?.src || WORKSHOP_FALLBACK_IMAGE,
    price: toPositiveNumber(item.price, 0),
    duration: formatWorkshopDuration(item.durationMin || item.duration || 0),
    maxParticipants,
    currentParticipants,
    spotsLeft,
    location: decodeEntities(item.location || ''),
    slug: normalizeWorkshopHref(item.bookingUrl || item.slug || '/ateliers'),
    status: normalizeWorkshopStatus(item.status),
  };
};

const loadUpcomingWorkshops = async () => {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), WORKSHOPS_FETCH_TIMEOUT_MS);

  try {
    const response = await fetch(WORKSHOPS_SOURCE_URL, {
      method: 'GET',
      headers: {
        Accept: 'application/json',
      },
      signal: controller.signal,
    });

    if (!response.ok) {
      throw new Error(`workshops_fetch_http_${response.status}`);
    }

    const payload = await response.json();
    const items = Array.isArray(payload?.items)
      ? payload.items
      : Array.isArray(payload)
      ? payload
      : [];

    const normalized = items
      .map((item: any, index: number) => mapWorkshopItem(item, index))
      .filter(Boolean)
      .sort((a: any, b: any) => a.date.getTime() - b.date.getTime());

    return normalized;
  } catch (error) {
    console.warn('[HOME] Workshops cache fetch failed:', error);
    return [];
  } finally {
    clearTimeout(timeout);
  }
};

const workshops = await loadUpcomingWorkshops();
const featuredWorkshop = workshops[0] || null;

const getWorkshopAvailability = (workshop: any) => {
  if (!workshop || typeof workshop !== 'object') {
    return {
      label: 'Places disponibles',
      className: 'text-status-success',
    };
  }

  const maxParticipants = toPositiveNumber(workshop.maxParticipants, 0);
  const currentParticipants = toPositiveNumber(workshop.currentParticipants, 0);
  const directSpotsLeft = toPositiveNumber(workshop.spotsLeft, Number.NaN);
  const spotsLeft = Number.isFinite(directSpotsLeft)
    ? directSpotsLeft
    : maxParticipants > 0
    ? Math.max(maxParticipants - currentParticipants, 0)
    : Number.NaN;
  const hasSpotsInfo = Number.isFinite(spotsLeft);

  const isFull =
    String(workshop.status || '').toUpperCase() === 'SOLD_OUT' ||
    ((maxParticipants > 0 || hasSpotsInfo) && (spotsLeft || 0) <= 0);

  if (isFull) {
    return {
      label: 'Complet',
      className: 'text-status-error',
    };
  }

  if (hasSpotsInfo) {
    const plural = spotsLeft === 1 ? '' : 's';
    return {
      label: `${spotsLeft} place${plural} disponible${plural}`,
      className:
        String(workshop.status || '').toUpperCase() === 'LIMITED'
          ? 'text-status-error'
          : 'text-status-success',
    };
  }

  if (String(workshop.status || '').toUpperCase() === 'LIMITED') {
    return {
      label: 'Dernieres places',
      className: 'text-status-error',
    };
  }

  return {
    label: 'Places disponibles',
    className: 'text-status-success',
  };
};

const getWorkshopSpotsLabel = (workshop: any): string => {
  if (!workshop || typeof workshop !== 'object') return '--';

  const maxParticipants = toPositiveNumber(workshop.maxParticipants, 0);
  const currentParticipants = toPositiveNumber(workshop.currentParticipants, 0);
  const directSpotsLeft = toPositiveNumber(workshop.spotsLeft, Number.NaN);
  const spotsLeft = Number.isFinite(directSpotsLeft)
    ? directSpotsLeft
    : maxParticipants > 0
    ? Math.max(maxParticipants - currentParticipants, 0)
    : Number.NaN;

  if (Number.isFinite(spotsLeft)) {
    const plural = spotsLeft === 1 ? '' : 's';
    return `${spotsLeft} place${plural} disponible${plural}`;
  }

  const soldOut = String(workshop.status || '').toUpperCase() === 'SOLD_OUT';
  return soldOut ? 'Complet' : '--';
};

const featuredWorkshopAvailability = getWorkshopAvailability(featuredWorkshop);


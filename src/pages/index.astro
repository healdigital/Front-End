  loadAds={true}
>
  <HeroCarousel cards={heroCards} />
  <h1 class="sr-only">La Cuisine de Bernard</h1>


  <section class="relative bg-secondary-cream overflow-hidden home-page-section home-page-section--light section_2">
    <div

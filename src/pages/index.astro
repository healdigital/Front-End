<script>
  // @ts-nocheck
  function setupHomepageFilters() {
    const filterRoot = document.querySelector('[data-homepage-filters]');
    const grid = document.querySelector('[data-recipe-grid]');
    const paginationRoot = document.querySelector('[data-home-pagination]');
    if (!(filterRoot instanceof HTMLElement) || !(grid instanceof HTMLElement) || !(paginationRoot instanceof HTMLElement)) return;
    if (filterRoot.dataset.interactionsReady === 'true') return;
    filterRoot.dataset.interactionsReady = 'true';

    const filterItems = Array.from(filterRoot.querySelectorAll('[data-filter-item]'));
    const paginationPages = paginationRoot.querySelector('[data-pagination-pages]');
    const paginationPrev = paginationRoot.querySelector('[data-pagination-prev]');
    const paginationNext = paginationRoot.querySelector('[data-pagination-next]');
    let cards = Array.from(grid.querySelectorAll('[data-recipe-card]'));
    let activeFilter = 'toutes';
    let activePage = 1;
    const cardsPerPage = 12;

    const createPageItems = (totalPages) => {
      if (totalPages <= 7) return Array.from({ length: totalPages }, (_, index) => index + 1);
      const items = [1];
      const rangeStart = Math.max(2, activePage - 1);
      const rangeEnd = Math.min(totalPages - 1, activePage + 1);
      if (rangeStart > 2) items.push('start-ellipsis');
      for (let page = rangeStart; page <= rangeEnd; page += 1) items.push(page);
      if (rangeEnd < totalPages - 1) items.push('end-ellipsis');
      items.push(totalPages);
      return items;
    };

    const getFilteredCards = () =>
      cards.filter((card) => {
        const category = String(card.getAttribute('data-category') || 'toutes').toLowerCase();
        return activeFilter === 'toutes' || category === activeFilter;
      });

    const renderPagination = (totalPages) => {
      if (!(paginationPages instanceof HTMLElement) || !(paginationPrev instanceof HTMLButtonElement) || !(paginationNext instanceof HTMLButtonElement)) return;
      paginationRoot.classList.toggle('hidden', totalPages <= 1);
      paginationPages.innerHTML = '';

      createPageItems(totalPages).forEach((item) => {
        if (typeof item === 'string') {
          const dot = document.createElement('span');
          dot.className = 'text-text-secondary';
          dot.textContent = '...';
          paginationPages.appendChild(dot);
          return;
        }

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'transition-colors ' + (item === activePage ? 'text-text-primary' : 'text-text-secondary hover:text-text-primary');
        button.textContent = String(item);
        button.setAttribute('data-page', String(item));
        paginationPages.appendChild(button);
      });

      paginationPrev.disabled = activePage <= 1;
      paginationNext.disabled = activePage >= totalPages;
    };

    const applyFilters = (resetPage = false) => {
      cards = Array.from(grid.querySelectorAll('[data-recipe-card]'));
      const filteredCards = getFilteredCards();
      const totalPages = Math.max(1, Math.ceil(filteredCards.length / cardsPerPage));
      activePage = resetPage ? 1 : Math.min(activePage, totalPages);

      const startIndex = (activePage - 1) * cardsPerPage;
      const endIndex = startIndex + cardsPerPage;
      const visibleCards = new Set(filteredCards.slice(startIndex, endIndex));

      cards.forEach((card) => {
        const shell = card instanceof HTMLElement ? card : null;
        if (!shell) return;
        const isVisible = visibleCards.has(shell);
        shell.classList.toggle('hidden', !isVisible);
        shell.setAttribute('aria-hidden', String(!isVisible));
      });

      filterItems.forEach((item) => {
        const value = String(item.getAttribute('data-filter-value') || '').toLowerCase();
        const isActive = value === activeFilter;
        item.setAttribute('aria-current', isActive ? 'true' : 'false');
        const check = item.querySelector('[data-filter-check]');
        const box = item.querySelector('[data-filter-checkbox]');
        if (check instanceof HTMLElement) check.classList.toggle('opacity-0', !isActive);
        if (box instanceof HTMLElement) box.classList.toggle('border-primary-turquoise', isActive);
      });

      renderPagination(totalPages);
    };

    filterItems.forEach((item) => {
      item.addEventListener('click', (event) => {
        event.preventDefault();
        const nextFilter = String(item.getAttribute('data-filter-value') || '').toLowerCase();
        if (!nextFilter) return;
        activeFilter = nextFilter;
        applyFilters(true);
      });
    });

    paginationPrev?.addEventListener('click', () => {
      if (activePage <= 1) return;
      activePage -= 1;
      applyFilters();
    });

    paginationNext?.addEventListener('click', () => {
      const totalPages = Math.max(1, Math.ceil(getFilteredCards().length / cardsPerPage));
      if (activePage >= totalPages) return;
      activePage += 1;
      applyFilters();
    });

    paginationPages?.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const page = Number(target.getAttribute('data-page') || '');
      if (!Number.isFinite(page) || page <= 0) return;
      activePage = page;
      applyFilters();
    });

    applyFilters(true);
  }

  setupHomepageFilters();
  document.addEventListener('astro:page-load', setupHomepageFilters);
</script>

<style>
  .home-sidebar-mobile {
    display: block;
    width: 100%;
    margin-top: 24px;
  }

  .home-recipe-card-shell {
    contain-intrinsic-size: auto 780px;
  }

  .home-render-deferred {
    content-visibility: visible;
    contain-intrinsic-size: auto;
  }

  .home-deferred-block {
    content-visibility: visible;
    contain-intrinsic-size: auto;
  }

  .home-newsletter-card .home-newsletter-copy,
  .home-newsletter-card .home-newsletter-note {
    color: #f2f7ff !important;
  }

  .home-workshops-feature-grid {
    align-items: start;
  }

  .books-section-mobile-only {
    display: block;
    margin-bottom: 32px;
  }

  .books-section-desktop-only {
    display: none;
  }

  @media (min-width: 1024px) {
    .home-sidebar-mobile {
      display: none;
    }

    .books-section-mobile-only {
      display: none;
    }

    .books-section-desktop-only {
      display: block;
    }
  }

</style>




<script define:vars={{ payloadAssetOrigin }}>
  // @ts-nocheck
  function setupHomepageFilters() {
    const filterRoot = document.querySelector('[data-homepage-filters]');
    if (!filterRoot || filterRoot.dataset.interactionsReady === 'true') return;
    filterRoot.dataset.interactionsReady = 'true';

    const filterLabels = {
      toutes: 'Toutes les recettes',
      sucrees: 'Recettes sucr&eacute;es',
      salees: 'Recettes sal&eacute;es',
    };

    const grid = document.querySelector('[data-recipe-grid]');
    let cards = Array.from(document.querySelectorAll('[data-recipe-card]'));
    const filterItems = Array.from(filterRoot.querySelectorAll('[data-filter-item]'));
    const paginationRoot = document.querySelector('[data-home-pagination]');
    const paginationPages = paginationRoot?.querySelector('[data-pagination-pages]');
    const paginationPrev = paginationRoot?.querySelector('[data-pagination-prev]');
    const paginationNext = paginationRoot?.querySelector('[data-pagination-next]');

    let activeFilter = 'toutes';
    let activePage = 1;
    const cardsPerPage = 6;
    const totalRecipeCount = Number(grid.getAttribute('data-recipes-total-count') || '') || cards.length;

    const createPageItems = (totalPages) => {
      if (totalPages <= 7) return Array.from({ length: totalPages }, (_, index) => index + 1);

      const items = [1];
      const rangeStart = Math.max(2, activePage - 1);
      const rangeEnd = Math.min(totalPages - 1, activePage + 1);

      if (rangeStart > 2) items.push('start-ellipsis');
      for (let page = rangeStart; page <= rangeEnd; page += 1) {
        items.push(page);
      }
      if (rangeEnd < totalPages - 1) items.push('end-ellipsis');
      items.push(totalPages);
      return items;
    };

    const renderPagination = (totalPages) => {
      if (!paginationRoot || !paginationPages || !paginationPrev || !paginationNext) return;

      paginationRoot.classList.toggle('hidden', totalPages <= 1);

      paginationPages.innerHTML = '';
      const pageItems = createPageItems(totalPages);
      pageItems.forEach((item) => {
        if (typeof item === 'string') {
          const dot = document.createElement('span');
          dot.className = 'text-text-secondary';
          dot.textContent = '...';
          paginationPages.appendChild(dot);
          return;
        }

        const button = document.createElement('button');
        button.type = 'button';
        button.className = `transition-colors ${item === activePage ? 'text-text-primary' : 'text-text-secondary hover:text-text-primary'}`;
        button.textContent = String(item);
        button.setAttribute('data-page', String(item));
        paginationPages.appendChild(button);
      });

      paginationPrev.disabled = activePage <= 1;
      paginationNext.disabled = activePage >= totalPages;
    };

    const normalizeToken = (value = '') =>
      String(value)
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase();

    const getFilterKey = (categoryLabel = '') => {
      const normalized = normalizeToken(categoryLabel);
      if (normalized.includes('sucre') || normalized.includes('sweet') || normalized.includes('dessert')) return 'sucrees';
      if (normalized.includes('sale') || normalized.includes('savour') || normalized.includes('savory')) return 'salees';
      return 'toutes';
    };

    const normalizeSlug = (value = '') => String(value).replace(/^\/+|\/+$/g, '');
    const toRecipeTagLabel = (value = '', filterKey = '') => {
      const resolvedFilterKey = filterKey || getFilterKey(value);
      if (resolvedFilterKey === 'sucrees') return 'SWEET';
      if (resolvedFilterKey === 'salees') return 'SAVORY';
      return 'RECIPE';
    };
    const formatRecipeTime = (value = '') => {
      const raw = String(value || '').trim();
      if (!raw) return '--';
      const parsed = new Date(raw);
      if (!Number.isNaN(parsed.getTime())) {
        return parsed.toLocaleTimeString('fr-FR', {
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
        });
      }
      if (/^\d+([.,]\d+)?$/.test(raw)) return `${raw} min`;
      if (/[0-9].*(min|h)/i.test(raw)) return raw;
      return '--';
    };

    const toOptimizedCardImage = (value = '') => {
      const raw = replaceCdnUrl(String(value || '').trim());
      if (raw.startsWith('/api/') || raw.startsWith('/media/')) return `${payloadAssetOrigin}${raw}`;
      if (!raw || !/\/wp-content\/uploads\//i.test(raw)) return raw;

      const match = raw.match(/^(.+?)(\.(?:jpe?g|png|webp|avif))(?:\?([^#]+))?(?:#(.+))?$/i);
      if (!match) return raw;

      const base = match[1];
      const ext = match[2];
      const query = match[3] ? `?${match[3]}` : '';
      const hash = match[4] ? `#${match[4]}` : '';

      if (/-\d+x\d+$/i.test(base)) {
        return `${base}${ext}${query}${hash}`;
      }

      const withoutScaled = base.replace(/-scaled$/i, '');
      return `${withoutScaled}-797x1024${ext}${query}${hash}`;
    };

    const clipDescription = (value = '') => {
      const cleaned = String(value || '').replace(/\s+/g, ' ').trim();
      if (!cleaned) return 'Recette a decouvrir.';
      return cleaned.length > 200 ? `${cleaned.slice(0, 200).trim()}...` : cleaned;
    };

    const buildCardElement = (templateCard, recipe, index) => {
      const card = templateCard.cloneNode(true);
      if (!(card instanceof HTMLElement)) return null;

      const slug = `/${normalizeSlug(recipe.slug)}`;
      const absoluteUrl = new URL(slug, window.location.origin).href;
      const encodedUrl = encodeURIComponent(absoluteUrl);
      const encodedTitle = encodeURIComponent(recipe.title || '');

      card.dataset.recipeIndex = String(index);
      card.dataset.category = recipe.filterKey || 'toutes';
      card.dataset.title = String(recipe.title || '').toLowerCase();
      card.dataset.description = String(recipe.description || '').toLowerCase();
      card.dataset.slug = slug;
      card.classList.add('hidden');
      card.setAttribute('aria-hidden', 'true');

      const imageEl = card.querySelector('img');
      if (imageEl instanceof HTMLImageElement) {
        const imageSrc = recipe.image || imageEl.getAttribute('data-fallback-src') || '';
        imageEl.src = imageSrc;
        imageEl.alt = recipe.title || 'Recipe image';
        imageEl.setAttribute('data-fallback-src', recipe.imageFallback || imageSrc);
      }

      const titleLink = card.querySelector('h3 a');
      if (titleLink instanceof HTMLAnchorElement) {
        titleLink.href = slug;
        titleLink.textContent = recipe.title || 'Recette';
      }

      const readMoreLink = card.querySelector('a.typ-button');
      if (readMoreLink instanceof HTMLAnchorElement) {
        readMoreLink.href = slug;
      }

      const descriptionEl = card.querySelector('p.typ-body');
      if (descriptionEl instanceof HTMLElement) {
        descriptionEl.textContent = clipDescription(recipe.description);
      }

      const metaTagEl = card.querySelector('[data-recipe-meta-tag]');
      if (metaTagEl instanceof HTMLElement) {
        metaTagEl.textContent = toRecipeTagLabel(
          recipe.difficulty || recipe.category || '',
          recipe.filterKey || '',
        );
      }

      const metaTimeEl = card.querySelector('[data-recipe-meta-time]');
      if (metaTimeEl instanceof HTMLElement) {
        metaTimeEl.textContent = recipe.prepTime || '--';
      }

      card.querySelectorAll('a[href]').forEach((link) => {
        if (!(link instanceof HTMLAnchorElement)) return;
        const href = link.getAttribute('href') || '';
        if (href.includes('facebook.com/sharer/sharer.php')) {
          link.href = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
        } else if (href.includes('pinterest.com/pin/create/button')) {
          link.href = `https://pinterest.com/pin/create/button/?url=${encodedUrl}&description=${encodedTitle}`;
        } else if (href.startsWith('mailto:')) {
          link.href = `mailto:?subject=${encodedTitle}&body=${encodeURIComponent(absoluteUrl)}`;
        }
      });

      return card;
    };

    const loadCachedIndexRecords = async (sourceUrl) => {
      const globalKey = '__lcdbIndexCachePromises';
      const globalStore = window;
      const cache = (globalStore[globalKey] ||= {});

      if (!cache[sourceUrl]) {
        cache[sourceUrl] = fetch(sourceUrl, { cache: 'force-cache' })
          .then((response) => {
            if (!response.ok) {
              throw new Error(`HTTP ${response.status}`);
            }
            return response.json();
          })
          .then((records) => (Array.isArray(records) ? records : []))
          .catch((error) => {
            delete cache[sourceUrl];
            throw error;
          });
      }

      return cache[sourceUrl];
    };

    let hydrationPromise = null;

    const hydrateCardsFromSearchIndex = async () => {
      if (!(grid instanceof HTMLElement)) return;
      if (grid.dataset.recipesHydrated === 'true') return;
      if (hydrationPromise) {
        await hydrationPromise;
        return;
      }

      const source = grid.getAttribute('data-recipes-source') || '/home-recipes-index.json';
      const templateCard = cards[0];
      if (!(templateCard instanceof HTMLElement)) return;

      hydrationPromise = (async () => {
        grid.dataset.recipesHydrated = 'loading';

        try {
          const records = await loadCachedIndexRecords(source);
          if (!Array.isArray(records) || records.length === 0) {
            grid.dataset.recipesHydrated = 'true';
            return;
          }

          const existingSlugs = new Set(
            cards
              .map((card) => normalizeSlug(card.getAttribute('data-slug') || ''))
              .filter(Boolean),
          );

          const recipes = [];
          records.forEach((record) => {
            const slug = normalizeSlug(record?.slug || record?.url || '');
            const title = String(record?.title || '').trim();
            if (!slug || !title || existingSlugs.has(slug)) return;

            existingSlugs.add(slug);
            const categoryLabel = record?.category || record?.tags || '';
            const timeLabel =
              record?.prepTime ||
              (Number.isFinite(Number(record?.readingTimeMin)) && Number(record?.readingTimeMin) > 0
                ? `${Math.round(Number(record.readingTimeMin))} min`
                : '') ||
              record?.publishedAt ||
              record?.date ||
              record?.modified ||
              record?.updated ||
              record?.updatedAt ||
              record?.createdAt ||
              '';

            const filterKey = getFilterKey(categoryLabel);
            const originalImage = replaceCdnUrl(
              record?.featured_image?.url ||
              record?.featuredImage?.url ||
              record?.image ||
              ''
            );

            recipes.push({
              slug,
              title,
              description: record?.excerpt || record?.content || '',
              image: toOptimizedCardImage(originalImage),
              imageFallback: originalImage,
              filterKey,
              difficulty: toRecipeTagLabel(categoryLabel, filterKey),
              prepTime: formatRecipeTime(timeLabel),
            });
          });

          if (recipes.length === 0) {
            grid.dataset.recipesHydrated = 'true';
            return;
          }

          let pointer = 0;
          const chunkSize = 24;

          await new Promise((resolve) => {
            const pump = () => {
              const fragment = document.createDocumentFragment();
              let appended = 0;

              while (pointer < recipes.length && appended < chunkSize) {
                const card = buildCardElement(templateCard, recipes[pointer], cards.length);
                pointer += 1;
                if (!card) continue;
                cards.push(card);
                fragment.appendChild(card);
                appended += 1;
              }

              if (fragment.childNodes.length > 0) {
                grid.appendChild(fragment);
              }

              if (pointer < recipes.length) {
                if (typeof window.requestIdleCallback === 'function') {
                  window.requestIdleCallback(pump, { timeout: 350 });
                } else {
                  window.setTimeout(pump, 16);
                }
                return;
              }

              resolve(null);
            };

            pump();
          });

          grid.dataset.recipesHydrated = 'true';
          applyFilters();
        } catch (error) {
          console.warn('[HOME] Failed to hydrate additional recipe cards:', error);
          grid.dataset.recipesHydrated = 'error';
        }
      })();

      await hydrationPromise;
      hydrationPromise = null;
    };

    const getFilteredCards = () =>
      cards.filter((card) => {
        const category = (card.dataset.category || 'toutes').toLowerCase();
        return activeFilter === 'toutes' || category === activeFilter;
      });

    const applyFilters = (resetPage = false) => {
      const filteredCards = getFilteredCards();
      const knownTotalCount =
        activeFilter === 'toutes' && grid?.dataset.recipesHydrated !== 'true'
          ? Math.max(totalRecipeCount, filteredCards.length)
          : filteredCards.length;
      const totalPages = Math.max(1, Math.ceil(knownTotalCount / cardsPerPage));
      if (resetPage) {
        activePage = 1;
      } else {
        activePage = Math.min(activePage, totalPages);
      }

      const start = (activePage - 1) * cardsPerPage;
      const end = start + cardsPerPage;
      const visibleCards = new Set(filteredCards.slice(start, end));

      cards.forEach((card) => {
        const isVisible = visibleCards.has(card);
        card.classList.toggle('hidden', !isVisible);
        card.setAttribute('aria-hidden', String(!isVisible));
      });

      renderPagination(totalPages);

      filterItems.forEach((item) => {
        const value = (item.getAttribute('data-filter-value') || '').toLowerCase();
        const isActive = value === activeFilter;
        item.setAttribute('aria-current', isActive ? 'true' : 'false');
        const check = item.querySelector('[data-filter-check]');
        const box = item.querySelector('[data-filter-checkbox]');
        if (check && box) {
          if (isActive) {
            check.classList.remove('opacity-0');
            box.classList.add('border-primary-turquoise');
          } else {
            check.classList.add('opacity-0');
            box.classList.remove('border-primary-turquoise');
          }
        }
      });
    };

    filterItems.forEach((item) => {
      item.addEventListener('click', async (event) => {
        event.preventDefault();
        const nextFilter = (item.getAttribute('data-filter-value') || '').toLowerCase();
        if (!filterLabels[nextFilter]) return;
        if (nextFilter !== 'toutes' && grid?.dataset.recipesHydrated !== 'true') {
          await hydrateCardsFromSearchIndex();
        }
        activeFilter = nextFilter;
        applyFilters(true);
      });
    });

    paginationPrev?.addEventListener('click', () => {
      if (activePage <= 1) return;
      activePage -= 1;
      applyFilters();
    });

    paginationNext?.addEventListener('click', async () => {
      const totalPagesBeforeHydration = Math.max(1, Math.ceil(getFilteredCards().length / cardsPerPage));
      if (activePage >= totalPagesBeforeHydration && grid?.dataset.recipesHydrated !== 'true') {
        await hydrateCardsFromSearchIndex();
      }
      const totalPages = Math.max(1, Math.ceil(getFilteredCards().length / cardsPerPage));
      if (activePage >= totalPages) return;
      activePage += 1;
      applyFilters();
    });

    paginationPages?.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const page = Number(target.getAttribute('data-page') || '');
      if (!Number.isFinite(page) || page <= 0) return;
      const handlePageClick = async () => {
        const totalPagesBeforeHydration = Math.max(1, Math.ceil(getFilteredCards().length / cardsPerPage));
        if (page > totalPagesBeforeHydration && grid?.dataset.recipesHydrated !== 'true') {
          await hydrateCardsFromSearchIndex();
        }
        activePage = page;
        applyFilters();
      };
      handlePageClick();
    });

    applyFilters(true);
  }

  function setupViewToggle() {
    const grid = document.querySelector('[data-recipe-grid]');
    const buttons = Array.from(document.querySelectorAll('[data-view-toggle]'));
    if (!grid || buttons.length === 0) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.getAttribute('data-view-toggle');
        if (!view) return;
        grid.setAttribute('data-view', view);
      });
    });
  }

  function setupWorkshopsLiveData() {
    const grid = document.querySelector('[data-workshops-grid]');
    if (!(grid instanceof HTMLElement)) return;
    if (grid.dataset.workshopsHydrated === 'loading' || grid.dataset.workshopsHydrated === 'true') return;

    const apiUrl = String(grid.dataset.workshopsApi || '').trim();
    if (!apiUrl) return;

    const capacityEl = document.querySelector('[data-workshops-feature-capacity]');
    const durationEl = document.querySelector('[data-workshops-feature-duration]');
    const priceEl = document.querySelector('[data-workshops-feature-price]');
    const featureCtaEl = document.querySelector('[data-workshops-feature-cta]');
    const featureImageEl = document.querySelector('[data-workshops-feature-image]');
    const featureTitleEl = document.querySelector('[data-workshops-feature-title]');
    const featureLocationEl = document.querySelector('[data-workshops-feature-location]');
    const featureAvailabilityEl = document.querySelector('[data-workshops-feature-availability]');

    const limitValue = Number(grid.dataset.workshopsLimit || '');
    const hasLimit = Number.isFinite(limitValue) && limitValue > 0;
    const parser = new DOMParser();
    const dateFormatter = new Intl.DateTimeFormat('fr-FR', {
      day: 'numeric',
      month: 'short',
    });

    const decodeEntities = (value = '') =>
      parser.parseFromString(`<!doctype html><body>${String(value || '')}`, 'text/html').body.textContent || '';

    const escapeHtml = (value = '') =>
      String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    const toPositiveNumber = (value, fallback = 0) => {
      const numeric = Number(value);
      return Number.isFinite(numeric) && numeric >= 0 ? numeric : fallback;
    };

    const formatDuration = (value) => {
      const minutes = toPositiveNumber(value, 0);
      if (!minutes) return '--';
      const hours = Math.floor(minutes / 60);
      const restMinutes = minutes % 60;
      if (hours && restMinutes) return `${hours}h ${restMinutes}m`;
      if (hours) return `${hours}h`;
      return `${restMinutes}m`;
    };

    const normalizeStatus = (value) => {
      const raw = String(value || '').toUpperCase().trim();
      if (raw === 'SOLD_OUT') return 'SOLD_OUT';
      if (raw === 'LIMITED') return 'LIMITED';
      return 'OPEN';
    };

    const normalizeHref = (value = '') => {
      const raw = String(value || '').trim();
      if (!raw) return '/ateliers';
      if (/^https?:\/\//i.test(raw)) return raw;
      return raw.startsWith('/') ? raw : `/${raw.replace(/^\/+/, '')}`;
    };

    const mapWorkshopItem = (item, index) => {
      if (!item || typeof item !== 'object') return null;

      const parsedDate = new Date(item.startAt || item.date || '');
      if (Number.isNaN(parsedDate.getTime())) return null;

      const title = decodeEntities(item.title || '').replace(/\s+/g, ' ').trim();
      if (!title) return null;

      const maxParticipants = toPositiveNumber(item.capacity || item.maxParticipants, 0);
      const rawSpotsLeft = toPositiveNumber(item.spotsLeft, Number.NaN);
      const spotsLeft = Number.isFinite(rawSpotsLeft)
        ? rawSpotsLeft
        : maxParticipants > 0
        ? Math.max(maxParticipants - toPositiveNumber(item.currentParticipants, 0), 0)
        : 0;
      const currentParticipants = maxParticipants > 0 ? Math.max(maxParticipants - spotsLeft, 0) : 0;

      return {
        id: String(item.id || item.slug || index + 1),
        title,
        date: parsedDate,
        image: String(item?.image?.src || '/images/ateliers-physiques.jpg'),
        price: toPositiveNumber(item.price, 0),
        duration: formatDuration(item.durationMin || item.duration || 0),
        maxParticipants,
        currentParticipants,
        spotsLeft,
        location: decodeEntities(item.location || ''),
        status: normalizeStatus(item.status),
        slug: normalizeHref(item.bookingUrl || item.slug || '/ateliers'),
      };
    };

    const formatDateParts = (date) => {
      const parts = dateFormatter.formatToParts(date);
      return {
        day: parts.find((part) => part.type === 'day')?.value || '',
        month: parts.find((part) => part.type === 'month')?.value || '',
      };
    };

    const usersIcon = '<svg viewBox="0 0 24 24" fill="none" class="w-5 h-5 inline-block flex-shrink-0 " aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></circle><path d="M23 21v-2a4 4 0 00-3-3.87" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
    const clockIcon = '<svg viewBox="0 0 24 24" fill="none" class="w-5 h-5 inline-block flex-shrink-0 " aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></circle><polyline points="12 6 12 12 16 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polyline></svg>';

    const getAvailability = (workshop) => {
      if (!workshop || typeof workshop !== 'object') {
        return { label: 'Places disponibles', tone: 'success' };
      }

      const maxParticipants = toPositiveNumber(workshop.maxParticipants, 0);
      const currentParticipants = toPositiveNumber(workshop.currentParticipants, 0);
      const directSpotsLeft = toPositiveNumber(workshop.spotsLeft, Number.NaN);
      const spotsLeft = Number.isFinite(directSpotsLeft)
        ? directSpotsLeft
        : maxParticipants > 0
        ? Math.max(maxParticipants - currentParticipants, 0)
        : Number.NaN;
      const hasSpotsInfo = Number.isFinite(spotsLeft);
      const isFull =
        workshop.status === 'SOLD_OUT' ||
        ((maxParticipants > 0 || hasSpotsInfo) && (spotsLeft || 0) <= 0);

      if (isFull) {
        return { label: 'Complet', tone: 'error' };
      }

      if (hasSpotsInfo) {
        const plural = spotsLeft === 1 ? '' : 's';
        return {
          label: `${spotsLeft} place${plural} disponible${plural}`,
          tone: workshop.status === 'LIMITED' ? 'error' : 'success',
        };
      }

      if (workshop.status === 'LIMITED') {
        return { label: 'Dernieres places', tone: 'error' };
      }

      return { label: 'Places disponibles', tone: 'success' };
    };

    const getSpotsLabel = (workshop) => {
      if (!workshop || typeof workshop !== 'object') return '--';

      const maxParticipants = toPositiveNumber(workshop.maxParticipants, 0);
      const currentParticipants = toPositiveNumber(workshop.currentParticipants, 0);
      const directSpotsLeft = toPositiveNumber(workshop.spotsLeft, Number.NaN);
      const spotsLeft = Number.isFinite(directSpotsLeft)
        ? directSpotsLeft
        : maxParticipants > 0
        ? Math.max(maxParticipants - currentParticipants, 0)
        : Number.NaN;

      if (Number.isFinite(spotsLeft)) {
        const plural = spotsLeft === 1 ? '' : 's';
        return `${spotsLeft} place${plural} disponible${plural}`;
      }

      return workshop.status === 'SOLD_OUT' ? 'Complet' : '--';
    };

    const renderWorkshopCard = (workshop) => {
      const { day, month } = formatDateParts(workshop.date);
      const availability = getAvailability(workshop);
      const statusClass = availability.tone === 'error' ? 'text-status-error' : 'text-status-success';
      const isFull = availability.label === 'Complet';
      const isExternal = /^https?:\/\//i.test(workshop.slug);
      const cta = isFull
        ? '<button type="button" class="inline-flex items-center justify-center font-button rounded border border-transparent btn-hover-transition btn-state-transition focus:outline-none focus:ring-2 focus:ring-offset-2 bg-status-disabled text-primary-white cursor-not-allowed opacity-70 px-3 py-1.5 text-sm " disabled aria-disabled="true">Complet</button>'
        : `<a href="${escapeHtml(workshop.slug)}" class="inline-flex items-center justify-center font-button rounded border border-transparent btn-hover-transition btn-state-transition focus:outline-none focus:ring-2 focus:ring-offset-2 bg-primary-turquoise text-primary-white hover:bg-opacity-90 active:scale-95 focus:ring-primary-turquoise px-3 py-1.5 text-sm " ${isExternal ? 'target="_blank" rel="noopener noreferrer"' : ''}>R&eacute;server</a>`;

      const capacityLabel = getSpotsLabel(workshop);
      const priceLabel = workshop.price > 0 ? `${Math.round(workshop.price)}&euro;` : '--';
      const imageSrc = workshop.image || '/images/ateliers-physiques.jpg';

      return `<article class="w-full max-w-[388px] rounded-[10px] bg-[#F7F5EF] overflow-hidden border border-[#D8D2C2] shadow-[0_16px_44px_rgba(6,18,40,0.26)]"><div class="relative aspect-[0.98] max-h-[386px]"><img src="${escapeHtml(imageSrc)}" alt="${escapeHtml(workshop.title)}" class="w-full h-full object-cover" loading="lazy" decoding="async" sizes="(min-width: 1280px) 28vw, (min-width: 768px) 44vw, 92vw"><div class="absolute bottom-4 left-4 bg-white rounded-[14px] p-2 text-center min-w-[63px] shadow-sm"><span class="block text-[14px] uppercase text-[#8D8C86] font-mono leading-none">${escapeHtml(month)}</span><span class="block text-[50px] leading-none font-heading text-[#111111]">${escapeHtml(day)}</span></div></div><div class="p-6"><p class="text-[13px] uppercase tracking-[0.14em] font-mono ${statusClass} typ-meta">${availability.label}</p><h3 class="font-heading text-[43px] leading-[1] text-text-primary mt-2">${escapeHtml(workshop.title)}</h3><div class="flex items-center gap-6 text-[#2F3642] text-[13px] uppercase tracking-[0.08em] mt-4 border-b border-[#D8D2C2] pb-4"><span class="flex items-center gap-2">${usersIcon} ${capacityLabel}</span><span class="flex items-center gap-2">${clockIcon} ${escapeHtml(workshop.duration)}</span></div><p class="text-[16px] text-text-secondary mt-5 leading-[1.7] typ-body">Apprenez directement &agrave; mes c&ocirc;t&eacute;s dans un atelier intimiste.</p><div class="flex items-center justify-between mt-8"><div><span class="text-[13px] uppercase tracking-[0.14em] text-text-secondary typ-meta">&Agrave; partir de</span><div class="font-heading text-[60px] leading-none text-text-primary">${priceLabel}</div></div>${cta}</div></div></article>`;
    };

    const updateFeatureCard = (workshopList) => {
      if (!Array.isArray(workshopList) || workshopList.length === 0) return;

      const firstWorkshop = workshopList[0];
      const firstPrice = toPositiveNumber(firstWorkshop.price, 0);

      if (capacityEl instanceof HTMLElement) {
        capacityEl.textContent = getSpotsLabel(firstWorkshop);
      }

      if (durationEl instanceof HTMLElement) {
        durationEl.textContent = firstWorkshop.duration || '--';
      }

      if (priceEl instanceof HTMLElement) {
        priceEl.textContent = firstPrice > 0 ? `${Math.round(firstPrice)}\u20AC` : '--';
      }

      if (featureAvailabilityEl instanceof HTMLElement) {
        const availability = getAvailability(firstWorkshop);
        featureAvailabilityEl.textContent = availability.label;
        featureAvailabilityEl.classList.remove('text-status-success', 'text-status-error');
        featureAvailabilityEl.classList.add(availability.tone === 'error' ? 'text-status-error' : 'text-status-success');
      }

      if (featureCtaEl instanceof HTMLAnchorElement && firstWorkshop.slug) {
        featureCtaEl.href = firstWorkshop.slug;
        if (/^https?:\/\//i.test(firstWorkshop.slug)) {
          featureCtaEl.target = '_blank';
          featureCtaEl.rel = 'noopener noreferrer';
        } else {
          featureCtaEl.removeAttribute('target');
          featureCtaEl.removeAttribute('rel');
        }
      }

      if (featureImageEl instanceof HTMLImageElement) {
        featureImageEl.src = firstWorkshop.image || '/images/ateliers-physiques.jpg';
        featureImageEl.alt = firstWorkshop.title || 'Atelier';
      }

      if (featureTitleEl instanceof HTMLElement) {
        featureTitleEl.textContent = firstWorkshop.title || 'Ateliers Physiques';
      }

      if (featureLocationEl instanceof HTMLElement) {
        featureLocationEl.textContent = firstWorkshop.location || 'Paris';
      }
    };

    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 5000);
    grid.dataset.workshopsHydrated = 'loading';

    fetch(apiUrl, {
      method: 'GET',
      headers: { Accept: 'application/json' },
      cache: 'no-store',
      signal: controller.signal,
    })
      .then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then((payload) => {
        const items = Array.isArray(payload?.items) ? payload.items : Array.isArray(payload) ? payload : [];
        let normalized = items
          .map((item, index) => mapWorkshopItem(item, index))
          .filter(Boolean)
          .sort((a, b) => a.date.getTime() - b.date.getTime());

        if (hasLimit) {
          normalized = normalized.slice(0, Math.floor(limitValue));
        }

        if (normalized.length === 0) {
          grid.dataset.workshopsHydrated = 'empty';
          return;
        }

        grid.innerHTML = normalized.map((workshop) => renderWorkshopCard(workshop)).join('');
        updateFeatureCard(normalized);
        grid.dataset.workshopsHydrated = 'true';
      })
      .catch((error) => {
        console.warn('[HOME] Live workshops fetch failed, keeping prerendered cards:', error);
        grid.dataset.workshopsHydrated = 'error';
      })
      .finally(() => {
        window.clearTimeout(timeout);
      });
  }

  function scheduleWorkshopsLiveData() {
    const grid = document.querySelector('[data-workshops-grid]');
    if (!(grid instanceof HTMLElement)) return;
    if (grid.dataset.workshopsObserverBound === 'true') return;
    grid.dataset.workshopsObserverBound = 'true';

    const start = () => {
      if (grid.dataset.workshopsHydrated === 'loading' || grid.dataset.workshopsHydrated === 'true') return;
      setupWorkshopsLiveData();
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        start();
      }, {
        rootMargin: '320px 0px',
        threshold: 0.01,
      });

      observer.observe(grid);
      return;
    }

    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(() => start(), { timeout: 2000 });
    } else {
      window.setTimeout(() => start(), 600);
    }
  }

  scheduleWorkshopsLiveData();
  setupHomepageFilters();
  setupViewToggle();
  document.addEventListener('astro:page-load', () => {
    scheduleWorkshopsLiveData();
    setupHomepageFilters();
    setupViewToggle();
  });
</script>


<script>
  function setupHomepageInteractions() {
    const filterRoot = document.querySelector<HTMLElement>('[data-homepage-filters]');
    if (!filterRoot || filterRoot.dataset.interactionsReady === 'true') return;
    filterRoot.dataset.interactionsReady = 'true';

    const filterLabels: Record<string, string> = {
      toutes: 'Toutes',
      sucrees: 'Sucrées',
      salees: 'Salées',
    };

    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-recipe-card]'));
    const searchInput = document.getElementById('recipe-search-input') as HTMLInputElement | null;
    const searchForm = document.getElementById('recipe-search-form') as HTMLFormElement | null;
    const clearSearchButton = filterRoot.querySelector<HTMLButtonElement>('[data-clear-search]');
    const resultCounter = filterRoot.querySelector<HTMLElement>('[data-recipe-results]');
    const noResultState = document.querySelector<HTMLElement>('[data-no-recipe]');
    const filterItems = Array.from(filterRoot.querySelectorAll<HTMLElement>('[data-filter-item]'));
    const activeFilterLabel = filterRoot.querySelector<HTMLElement>('[data-active-filter-label]');

    const normalize = (value: string) =>
      value
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLocaleLowerCase('fr')
        .trim();

    const params = new URLSearchParams(window.location.search);
    let activeFilter = (params.get('filter') || 'toutes').toLowerCase();
    if (!filterLabels[activeFilter]) activeFilter = 'toutes';
    let searchTerm = (params.get('q') || '').trim();

    if (searchInput) searchInput.value = searchTerm;

    const updateQueryString = () => {
      const nextParams = new URLSearchParams(window.location.search);

      if (activeFilter === 'toutes') nextParams.delete('filter');
      else nextParams.set('filter', activeFilter);

      if (searchTerm.trim()) nextParams.set('q', searchTerm.trim());
      else nextParams.delete('q');

      const nextUrl = nextParams.toString()
        ? `${window.location.pathname}?${nextParams.toString()}`
        : window.location.pathname;
      window.history.replaceState({}, '', nextUrl);
    };

    const updateFilterUi = () => {
      filterItems.forEach((item) => {
        const value = (item.getAttribute('data-filter-value') || '').toLowerCase();
        const isActive = value === activeFilter;
        item.setAttribute('aria-current', isActive ? 'true' : 'false');
        item.classList.toggle('font-semibold', isActive);
      });

      if (activeFilterLabel) activeFilterLabel.textContent = filterLabels[activeFilter];
    };

    const applyFilters = () => {
      const normalizedSearch = normalize(searchTerm);
      let visibleCards = 0;

      cards.forEach((card) => {
        const category = (card.dataset.category || 'toutes').toLowerCase();
        const searchableContent = `${card.dataset.title || ''} ${card.dataset.description || ''}`;
        const matchesFilter = activeFilter === 'toutes' || category === activeFilter;
        const matchesSearch = !normalizedSearch || normalize(searchableContent).includes(normalizedSearch);
        const shouldShow = matchesFilter && matchesSearch;

        card.classList.toggle('hidden', !shouldShow);
        card.setAttribute('aria-hidden', String(!shouldShow));
        if (shouldShow) visibleCards += 1;
      });

      if (resultCounter) {
        resultCounter.textContent = `${visibleCards} recette${visibleCards > 1 ? 's' : ''}`;
      }

      if (noResultState) noResultState.classList.toggle('hidden', visibleCards !== 0);

      updateFilterUi();
      updateQueryString();
    };

    filterItems.forEach((item) => {
      item.addEventListener('click', (event) => {
        event.preventDefault();
        const nextFilter = (item.getAttribute('data-filter-value') || '').toLowerCase();
        if (!filterLabels[nextFilter]) return;
        activeFilter = nextFilter;
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', () => {
      searchTerm = searchInput.value;
      applyFilters();
    });

    searchForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      searchTerm = searchInput?.value || '';
      applyFilters();
    });

    clearSearchButton?.addEventListener('click', () => {
      searchTerm = '';
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
      }
      applyFilters();
    });

    applyFilters();
  }

  setupHomepageInteractions();
  document.addEventListener('astro:page-load', setupHomepageInteractions);
</script>

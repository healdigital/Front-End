    difficulty: 'Facile',
    slug: '/tarte-poire-foie-gras',
  },
  {
    title: 'Entremet praline dubai, chantilly et ganache lactee',
    description: 'Un entremet raffine aux saveurs intenses de praline, surmonte d\'une chantilly aerienne.',
    image: '/images/recipe-lemon-pie.jpg',
    category: 'SUCRE',
    prepTime: '3h30',
    difficulty: 'Moyen',
    slug: '/entremet-praline-dubai',
  },
  {
    title: 'Tarte figue sechee, orange et noix',
    description: 'Une tarte automnale aux figues sechees confites, zestes d\'orange et noix caramelisees.',
    image: '/images/recipe-salmon.jpg',
    category: 'SUCRE',
    prepTime: '2h30',
    difficulty: 'Facile',
    slug: '/tarte-figue-orange-noix',
  },
];

const toText = (value: any): string => {
  if (!value) return '';
  if (typeof value === 'string') return value;
  if (Array.isArray(value)) return value.map((item) => toText(item)).join(' ');
  if (typeof value === 'object') {
    if (typeof value.rendered === 'string') return value.rendered;
    if (typeof value.text === 'string') return value.text;
    if (Array.isArray(value.children)) return value.children.map((child: any) => toText(child)).join(' ');
    if (value.content) return toText(value.content);
  }
  return '';
};

const normalizeToken = (value: string): string =>
  value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim();

const getSlug = (article: any): string => {
  const raw = typeof article?.slug === 'string' ? article.slug : article?.slug?.current;
  if (!raw) return '';
  return raw.replace(/^\/+|\/+$/g, '');
};

const getTitle = (article: any): string => {
  const raw = toText(article?.title) || toText(article?.title?.rendered);
  return stripHtml(raw);
};

const getDescription = (article: any): string => {
  const raw = toText(article?.excerpt) || toText(article?.content) || toText(article?.contentV2);
  const cleaned = stripHtml(raw);
  if (!cleaned) return 'Recette a decouvrir.';
  const trimmed = cleaned.slice(0, 160);
  return cleaned.length > 160 ? `${trimmed}...` : trimmed;
};

const extractLabels = (value: any): string[] => {
  if (!value) return [];
  if (typeof value === 'string') return [value];
  if (Array.isArray(value)) return value.flatMap((item) => extractLabels(item));
  if (typeof value === 'object') {
    const possible = [value.name, value.title, value.slug, value.label];
    return possible.filter((item) => typeof item === 'string') as string[];
  }
  return [];
};

const getPrimaryRecipeBlock = (article: any) => {
  const blocks = Array.isArray(article?.recipeBlocks) ? article.recipeBlocks : [];
  if (blocks.length === 0) return null;
  return blocks.find((block: any) => block?.blockType === 'recipeCard') || blocks[0];
};

const getCategoryLabel = (article: any): string => {
  const recipeBlock = getPrimaryRecipeBlock(article);
  const labels = [
    ...extractLabels(recipeBlock?.recipeType),
    ...extractLabels(recipeBlock?.dishType),
    ...extractLabels(article?.categories),
    ...extractLabels(article?.category),
    ...extractLabels(article?.tags),
  ].filter(Boolean);

  const candidate = labels.find((label) => !/^[0-9a-f]{24}$/i.test(label));
  return candidate || '';
};

const getFilterKey = (categoryLabel: string): string => {
  const normalized = normalizeToken(categoryLabel);
  if (normalized.includes('sucre') || normalized.includes('sweet') || normalized.includes('dessert')) return 'sucrees';
  if (normalized.includes('sale') || normalized.includes('savour') || normalized.includes('savory')) return 'salees';
  return 'toutes';
};

const getRecipeTagLabel = (categoryLabel: string, filterKeyHint = ''): string => {
  const filterKey = filterKeyHint || getFilterKey(categoryLabel);
  if (filterKey === 'sucrees') return 'SUCRÉ';
  if (filterKey === 'salees') return 'SALÉ';
  return 'RECETTE';
};

const getRecipeTimeLabel = (article: any): string => {
  const recipeBlock = getPrimaryRecipeBlock(article);
  const prepTimeRaw =
    recipeBlock?.preparationTimeMinutes ??
    article?.recipe?.prepTime ??
    article?.prepTime ??
    article?.preparationTimeMinutes ??
    article?.preparationTime;
  const prepTimeFormat = String(article?.recipe?.prepTimeFormat || '').trim();
  const prepTimeLabel = String(prepTimeRaw ?? '').trim();
  if (prepTimeLabel) {
    if (/[0-9].*(min|h)/i.test(prepTimeLabel)) return prepTimeLabel;
    if (prepTimeFormat) return `${prepTimeLabel} ${prepTimeFormat}`.trim();
    if (/^\d+([.,]\d+)?$/.test(prepTimeLabel)) return `${prepTimeLabel} min`;
  }

  const candidate =
    article?.date ||
    article?.publishedAt ||
    article?.modified ||
    article?.updated ||
    article?.updatedAt ||
    article?.createdAt;
  if (!candidate) return '--';

  const parsed = new Date(candidate);
  if (Number.isNaN(parsed.getTime())) {
    const contentText = stripHtml(toText(article?.content) || toText(article?.excerpt) || '');
    const wordCount = contentText
      .split(/\s+/)
      .map((token) => token.trim())
      .filter(Boolean).length;
    if (wordCount > 0) {
      return `${Math.max(1, Math.round(wordCount / 200))} min`;
    }
    return '--';
  }

  return parsed.toLocaleTimeString('fr-FR', {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
};

const buildRecipeFromArticle = (article: any, index: number) => {
  const title = getTitle(article);
  const slug = getSlug(article);
  if (!title || !slug) return null;

  const categoryLabel = getCategoryLabel(article);
  const filterKey = getFilterKey(categoryLabel);
  const fallbackImage = processArticleImageUrl(article) || fallbackImages[index % fallbackImages.length];
  const image = buildWpPortraitVariantUrl(fallbackImage) || fallbackImage;
  const tagLabel = getRecipeTagLabel(categoryLabel, filterKey);
  const timeLabel = getRecipeTimeLabel(article);

  return {
    id: article?._id?.toString?.() || article?.id?.toString?.() || `${index + 1}`,
    title,
    description: getDescription(article),
    image,
    imageFallback: fallbackImage,
    category: tagLabel,
    filterKey,
    prepTime: timeLabel,
    difficulty: tagLabel,
    slug: `/${slug}`,
  };
};

const getHomeRecipeLimit = () => {
  const homeLimit = Number(process.env.HOME_RECIPE_LIMIT);
  if (Number.isFinite(homeLimit) && homeLimit > 0) return homeLimit;

  const globalLimit = Number(process.env.MAX_SSG_ARTICLES);
  if (Number.isFinite(globalLimit) && globalLimit > 0) return globalLimit;

  return 6000;
};

const payloadAssetOrigin = (() => {
  try {
    return new URL(import.meta.env.PUBLIC_PAYLOAD_API_URL || 'https://admin.lacuisinedebernard.com/api').origin;
  } catch {
    return 'https://admin.lacuisinedebernard.com';
  }
})();

let allArticles = await getArticlesFromMongo(1, getHomeRecipeLimit());
if (!Array.isArray(allArticles) || allArticles.length === 0) {
  allArticles = await getAllArticlesFromMongo();
}
const normalizedArticles = Array.isArray(allArticles)
  ? allArticles
      .map(buildRecipeFromArticle)
      .filter((recipe): recipe is NonNullable<ReturnType<typeof buildRecipeFromArticle>> => Boolean(recipe))
  : [];

const heroCards = normalizedArticles.length
  ? normalizedArticles.slice(0, 10).map((recipe) => ({
      title: recipe.title,
      image: recipe.image,
      imageFallback: recipe.imageFallback,
      filterKey: recipe.filterKey,
      category: recipe.category,
      slug: recipe.slug,
    }))
  : fallbackHeroCards;

const recipePool = normalizedArticles.length ? normalizedArticles : fallbackRecipes;
const featuredRecipe = recipePool[0] || fallbackRecipes[0];
const HOME_VISIBLE_PAGE_SIZE = 12;
const getHomeInitialRenderCount = () => {
  const envCount = Number(process.env.HOME_INITIAL_RENDER_COUNT);
  return Number.isFinite(envCount) && envCount > 0 ? envCount : 48;
};
const browseRecipes = recipePool.slice(1, 1 + getHomeInitialRenderCount());
const totalBrowseRecipeCount = Math.max(recipePool.length - 1, browseRecipes.length);
const SUGGESTED_VISIBLE_PAGE_SIZE = 4;
const getSuggestedInitialRenderCount = () => {
  const envCount = Number(process.env.SUGGESTED_INITIAL_RENDER_COUNT);
  return Number.isFinite(envCount) && envCount > 0 ? envCount : 30;
};
const suggestedRecipesPool = normalizedArticles.length > 10
  ? normalizedArticles.slice(10)
  : fallbackSuggestedRecipes;
const suggestedRecipes = suggestedRecipesPool.slice(0, getSuggestedInitialRenderCount());
---


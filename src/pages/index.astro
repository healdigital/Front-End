      <div class="home-two-column">
        <div class="home-main-column">
          <BooksSection embedded />
          <SuggestedRecipes recipes={suggestedRecipes} embedded />
        </div>
        <div class="home-sidebar-column">
          <div class="home-sidebar-sticky">

<script>
  // @ts-nocheck
  function setupHomepageFilters() {
    const filterRoot = document.querySelector('[data-homepage-filters]');
    if (!filterRoot || filterRoot.dataset.interactionsReady === 'true') return;
    filterRoot.dataset.interactionsReady = 'true';

    const filterLabels = {
      toutes: 'Toutes les recettes',
      sucrees: 'Recettes sucr&eacute;es',
      salees: 'Recettes sal&eacute;es',
    };

    const cards = Array.from(document.querySelectorAll('[data-recipe-card]'));
    const filterItems = Array.from(filterRoot.querySelectorAll('[data-filter-item]'));
    const paginationRoot = document.querySelector('[data-home-pagination]');
    const paginationPages = paginationRoot?.querySelector('[data-pagination-pages]');
    const paginationPrev = paginationRoot?.querySelector('[data-pagination-prev]');
    const paginationNext = paginationRoot?.querySelector('[data-pagination-next]');

    let activeFilter = 'toutes';
    let activePage = 1;
    const cardsPerPage = 6;

    const createPageItems = (totalPages) => {
      if (totalPages <= 7) return Array.from({ length: totalPages }, (_, index) => index + 1);

      const items = [1];
      const rangeStart = Math.max(2, activePage - 1);
      const rangeEnd = Math.min(totalPages - 1, activePage + 1);

      if (rangeStart > 2) items.push('start-ellipsis');
      for (let page = rangeStart; page <= rangeEnd; page += 1) {
        items.push(page);
      }
      if (rangeEnd < totalPages - 1) items.push('end-ellipsis');
      items.push(totalPages);
      return items;
    };

    const renderPagination = (totalPages) => {
      if (!paginationRoot || !paginationPages || !paginationPrev || !paginationNext) return;

      paginationRoot.classList.toggle('hidden', totalPages <= 1);

      paginationPages.innerHTML = '';
      const pageItems = createPageItems(totalPages);
      pageItems.forEach((item) => {
        if (typeof item === 'string') {
          const dot = document.createElement('span');
          dot.className = 'text-text-secondary';
          dot.textContent = '...';
          paginationPages.appendChild(dot);
          return;
        }

        const button = document.createElement('button');
        button.type = 'button';
        button.className = `transition-colors ${item === activePage ? 'text-text-primary' : 'text-text-secondary hover:text-text-primary'}`;
        button.textContent = String(item);
        button.setAttribute('data-page', String(item));
        paginationPages.appendChild(button);
      });

      paginationPrev.disabled = activePage <= 1;
      paginationNext.disabled = activePage >= totalPages;
    };

    const applyFilters = (resetPage = false) => {
      const filteredCards = cards.filter((card) => {
        const category = (card.dataset.category || 'toutes').toLowerCase();
        return activeFilter === 'toutes' || category === activeFilter;
      });

      const totalPages = Math.max(1, Math.ceil(filteredCards.length / cardsPerPage));
      if (resetPage) {
        activePage = 1;
      } else {
        activePage = Math.min(activePage, totalPages);
      }

      const start = (activePage - 1) * cardsPerPage;
      const end = start + cardsPerPage;
      const visibleCards = new Set(filteredCards.slice(start, end));

      cards.forEach((card) => {
        const isVisible = visibleCards.has(card);
        card.classList.toggle('hidden', !isVisible);
        card.setAttribute('aria-hidden', String(!isVisible));
      });

      renderPagination(totalPages);

      filterItems.forEach((item) => {
        const value = (item.getAttribute('data-filter-value') || '').toLowerCase();
        const isActive = value === activeFilter;
        item.setAttribute('aria-current', isActive ? 'true' : 'false');
        const check = item.querySelector('[data-filter-check]');
        const box = item.querySelector('[data-filter-checkbox]');
        if (check && box) {
          if (isActive) {
            check.classList.remove('opacity-0');
            box.classList.add('border-primary-turquoise');
          } else {
            check.classList.add('opacity-0');
            box.classList.remove('border-primary-turquoise');
          }
        }
      });
    };

    filterItems.forEach((item) => {
      item.addEventListener('click', (event) => {
        event.preventDefault();
        const nextFilter = (item.getAttribute('data-filter-value') || '').toLowerCase();
        if (!filterLabels[nextFilter]) return;
        activeFilter = nextFilter;
        applyFilters(true);
      });
    });

    paginationPrev?.addEventListener('click', () => {
      if (activePage <= 1) return;
      activePage -= 1;
      applyFilters();
    });

    paginationNext?.addEventListener('click', () => {
      activePage += 1;
      applyFilters();
    });

    paginationPages?.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const page = Number(target.getAttribute('data-page') || '');
      if (!Number.isFinite(page) || page <= 0) return;
      activePage = page;
      applyFilters();
    });

    applyFilters(true);
  }

  function setupViewToggle() {
    const grid = document.querySelector('[data-recipe-grid]');
    const buttons = Array.from(document.querySelectorAll('[data-view-toggle]'));
    if (!grid || buttons.length === 0) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.getAttribute('data-view-toggle');
        if (!view) return;
        grid.setAttribute('data-view', view);
      });
    });
  }

  setupHomepageFilters();
  setupViewToggle();
  document.addEventListener('astro:page-load', () => {
    setupHomepageFilters();
    setupViewToggle();
  });
</script>

<style>
  .recipe-grid-home[data-view='list'] {
    grid-template-columns: 1fr;
  }
</style>



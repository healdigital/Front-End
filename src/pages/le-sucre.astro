---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticPage from "../components/StaticPage.astro";
import StaticPageContent from "../components/StaticPageContent.astro";

const navLinks = [
  {
    label: "Index des recettes sucrées avec photo",
    description: "Version illustrée, idéale pour parcourir les desserts.",
    href: "/recettes-sucrees/",
  },
  {
    label: "Index des recettes sucrées sans photo",
    description: "Version compacte, centrée sur les titres des recettes.",
    active: true,
  },
];
---

<BaseLayout title="Le sucré">
  <StaticPage
    title="Le sucré"
    subtitle="Index des recettes sucrées sans photo."
    className="menu-page menu-page--recipe-list"
    navLinks={navLinks}
  >
    <StaticPageContent
      slug="le-sucre"
      sourceUrl="https://lacuisinedebernard.com/le-sucre/"
    />
  </StaticPage>
</BaseLayout>

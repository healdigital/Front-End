---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticPage from "../components/StaticPage.astro";
import { getRecipeFeedBatch } from "../lib/recipeFeed.server";

const normalizeLanguageCode = (value: unknown): "fr" | "en" | "es" | "pt-br" | "ar" => {
  const raw = String(value || "").trim().toLowerCase();
  if (raw === "pt" || raw === "pt_br" || raw === "ptbr" || raw === "pt-pt") return "pt-br";
  if (raw === "en" || raw === "es" || raw === "pt-br" || raw === "ar") return raw;
  return "fr";
};

const navLinks = [
  {
    label: "Index des recettes sucrées avec photo",
    description: "Version illustrée, idéale pour parcourir les desserts.",
    href: "/recettes-sucrees/",
  },
  {
    label: "Index des recettes sucrées sans photo",
    description: "Version compacte, centrée sur les titres des recettes.",
    active: true,
  },
];

const preferredLanguage = normalizeLanguageCode(Astro.cookies.get("lcdb_lang")?.value || "fr");
const INITIAL_SIZE = 20;
const initial = await getRecipeFeedBatch("sucrees", 1, INITIAL_SIZE, preferredLanguage);
const rows = initial.cards.map((card) => ({
  href: card.href,
  title: card.title,
  preparation: card.prepTime || "—",
  difficulty: card.difficulty || "—",
}));

---

<BaseLayout title="Le sucré">
  <StaticPage
    title="Le sucré"
    subtitle="Index des recettes sucrées sans photo."
    className="menu-page menu-page--recipe-table menu-page--le-sucre"
    navLinks={navLinks}
  >
    <div class="menu-table" role="table" aria-label="Index des recettes sucrées">
      <div class="menu-table-head" role="rowgroup">
        <div class="menu-table-row menu-table-row--head" role="row">
          <span class="menu-table-cell menu-table-cell--recipe" role="columnheader">Recette</span>
          <span class="menu-table-cell menu-table-cell--prep" role="columnheader">Préparation</span>
          <span class="menu-table-cell menu-table-cell--difficulty" role="columnheader">Difficulté</span>
        </div>
      </div>

      <div class="menu-table-body" role="rowgroup">
        {rows.map((row) => (
          <a class="menu-table-row menu-table-row--item lcdb-archive-recipe-card" role="row" href={row.href}>
            <span class="menu-table-cell menu-table-cell--recipe" role="cell">{row.title}</span>
            <span class="menu-table-cell menu-table-cell--prep" role="cell">{row.preparation}</span>
            <span class="menu-table-cell menu-table-cell--difficulty" role="cell">{row.difficulty}</span>
          </a>
        ))}
      </div>
      <div class="infinite-grid-sentinel" id="le-sucre-sentinel" aria-hidden="true"></div>
      <p class="infinite-grid-loading hidden" id="le-sucre-loading" aria-live="polite">
        <span class="infinite-grid-spinner" aria-hidden="true"></span>
        <span>Chargement des recettes...</span>
      </p>
    </div>
  </StaticPage>
</BaseLayout>

<script define:vars={{ nextPage: initial.nextPage, preferredLanguage }}>
  (() => {
    const body = document.querySelector('.menu-page--le-sucre .menu-table-body');
    const sentinel = document.getElementById('le-sucre-sentinel');
    const loading = document.getElementById('le-sucre-loading');
    if (!(body instanceof HTMLElement) || !(sentinel instanceof HTMLElement)) return;

    let page = Number(nextPage || 0);
    let busy = false;
    let hasMore = Number.isFinite(page) && page > 0;
    const size = 20;
    const lang = String(preferredLanguage || 'fr');

    const escapeHtml = (value) =>
      String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    const appendRows = (cards) => {
      cards.forEach((card) => {
        const href = escapeHtml(card?.href || '#');
        const title = escapeHtml(card?.title || 'Recette');
        const prep = escapeHtml(card?.prepTime || '—');
        const difficulty = escapeHtml(card?.difficulty || '—');
        body.insertAdjacentHTML(
          'beforeend',
          `<a class="menu-table-row menu-table-row--item lcdb-archive-recipe-card" role="row" href="${href}">
            <span class="menu-table-cell menu-table-cell--recipe" role="cell">${title}</span>
            <span class="menu-table-cell menu-table-cell--prep" role="cell">${prep}</span>
            <span class="menu-table-cell menu-table-cell--difficulty" role="cell">${difficulty}</span>
          </a>`,
        );
      });
    };

    const loadNext = async () => {
      if (!hasMore || busy || !page) return;
      busy = true;
      loading?.classList.remove('hidden');
      try {
        const url = new URL('/api/recipe-feed.json', window.location.origin);
        url.searchParams.set('type', 'sucrees');
        url.searchParams.set('page', String(page));
        url.searchParams.set('size', String(size));
        url.searchParams.set('lang', lang);
        const res = await fetch(url.toString(), { credentials: 'same-origin' });
        if (!res.ok) return;
        const data = await res.json();
        const cards = Array.isArray(data?.cards) ? data.cards : [];
        appendRows(cards);
        page = Number(data?.nextPage || 0);
        hasMore = Boolean(data?.hasMore) && page > 0;
      } finally {
        busy = false;
        loading?.classList.toggle('hidden', !hasMore);
      }
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) void loadNext();
      });
    }, { rootMargin: '0px 0px 320px 0px' });

    observer.observe(sentinel);
  })();
</script>

<style is:global>
  .menu-page--le-sucre .static-page-body {
    padding: clamp(18px, 2.6vw, 30px);
  }

  .menu-page--le-sucre .menu-table {
    display: grid;
    gap: 0.75rem;
  }

  .menu-page--le-sucre .menu-table-row {
    display: grid;
    grid-template-columns: minmax(0, 2.5fr) minmax(120px, 0.9fr) minmax(120px, 0.9fr);
    gap: 1rem;
    align-items: center;
  }

  .menu-page--le-sucre .menu-table-row--head {
    padding: 0 1rem 0.45rem;
    border-bottom: 1px solid rgba(26, 35, 53, 0.12);
    color: #6b7280;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .menu-page--le-sucre .menu-table-row--item {
    padding: 0.95rem 1rem;
    border: 1px solid #d8d2c2;
    border-radius: 14px;
    background: #faf8f2;
    color: #1a2335;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(14, 24, 39, 0.05);
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease,
      background-color 160ms ease;
  }

  .menu-page--le-sucre .menu-table-row--item:hover {
    transform: translateY(-1px);
    border-color: #2ec4b6;
    background: rgba(46, 196, 182, 0.04);
    box-shadow: 0 16px 30px rgba(14, 24, 39, 0.08);
  }

  .menu-page--le-sucre .menu-table-cell {
    min-width: 0;
  }

  .menu-page--le-sucre .menu-table-cell--recipe {
    font-family: var(--font-maison);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .menu-page--le-sucre .menu-table-cell--prep,
  .menu-page--le-sucre .menu-table-cell--difficulty {
    color: #4b5563;
    font-size: 0.94rem;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .menu-page--le-sucre .menu-table-row {
      grid-template-columns: minmax(0, 1.8fr) minmax(100px, 0.9fr) minmax(100px, 0.9fr);
      gap: 0.75rem;
    }
  }

  @media (max-width: 720px) {
    .menu-page--le-sucre .menu-table-row--head {
      display: none;
    }

    .menu-page--le-sucre .menu-table-row--item {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.55rem;
      padding: 1rem;
    }

    .menu-page--le-sucre .menu-table-cell {
      display: grid;
      gap: 0.18rem;
    }

    .menu-page--le-sucre .menu-table-cell--prep::before,
    .menu-page--le-sucre .menu-table-cell--difficulty::before {
      color: #6b7280;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .menu-page--le-sucre .menu-table-cell--prep::before {
      content: "Préparation";
    }

    .menu-page--le-sucre .menu-table-cell--difficulty::before {
      content: "Difficulté";
    }
  }
</style>

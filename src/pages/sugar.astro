---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticPage from "../components/StaticPage.astro";
---

<BaseLayout title="Sugar">
  <StaticPage title="Sugar" subtitle="Sweet recipes and desserts">
    <p>
      From classic French pastries to quick sweets, Sugar gathers the most
      indulgent recipes on the site. You'll find both beginner-friendly
      desserts and more advanced techniques when you want a challenge.
    </p>

    <h2>Sweet highlights</h2>
    <ul>
      <li>Cookies, cakes, and tarts</li>
      <li>Chocolate and caramel creations</li>
      <li>Fruit-forward desserts</li>
      <li>Breakfast pastries and viennoiseries</li>
      <li>Tips for baking success</li>
    </ul>

    <p>
      Looking for inspiration? Start with the latest posts in
      <a href="/articles">Articles</a>.
    </p>

    <p>
      Sweet indexes:
      <a href="/recettes-sucrees">with photos</a>
      and
      <a href="/le-sucre">without photos</a>.
    </p>
  </StaticPage>
</BaseLayout>

---
import SlugPage from "../../[slug].astro";
import { payloadFetch } from "../../../lib/payload.client";
import { getAllArticlesFromMongo } from "../../../lib/mongo.server";

export const prerender = true;

type ContentValue =
  | string
  | number
  | boolean
  | null
  | undefined
  | Record<string, unknown>
  | ContentValue[];

type ArticleEntry = Record<string, unknown> & {
  slug?: string | { current?: string };
  lang?: string;
  language?: string;
  locale?: string;
  featured_img_url?: string;
  featuredImage?: { url?: string };
  featuredMedia?: { url?: string };
  featured_image?: { url?: string };
  wprmId?: string | number;
  wprm_id?: string | number;
  wprmRecipeId?: string | number;
  wprm_recipe_id?: string | number;
  recipeId?: string | number;
  recipe_id?: string | number;
  content?: ContentValue;
};

interface Props {
  article: ArticleEntry;
  languageSlugMap: Record<string, string>;
  fallbackRecipeArticle?: ArticleEntry | null;
}

export async function getStaticPaths() {
  let articles: ArticleEntry[] = [];
  const getBuildLimit = () => {
    const envLimit = Number(process.env.MAX_SSG_ARTICLES);
    return Number.isFinite(envLimit) && envLimit > 0 ? envLimit : 6000;
  };
  const normalizeSlug = (value: ContentValue) =>
    String(value || "").replace(/^\/+|\/+$/g, "");
  const decodeSafeSlug = (value: string) => {
    try {
      return decodeURIComponent(value);
    } catch {
      return value;
    }
  };
  const normalizeLanguageCode = (value: ContentValue) => {
    const raw = String(value || "")
      .trim()
      .toLowerCase();
    if (raw === "pt" || raw === "pt_br" || raw === "ptbr") return "pt-br";
    return raw || "fr";
  };
  const getArticleSlugValue = (item: ArticleEntry): string => {
    const raw =
      typeof item?.slug === "string" ? item.slug : item?.slug?.current || "";
    return normalizeSlug(decodeSafeSlug(raw));
  };
  const normalizeRecipeSlugToken = (value: string): string =>
    normalizeSlug(decodeSafeSlug(value))
      .replace(/^wprm[-_/]+/i, "")
      .replace(/^recipe[-_/]+/i, "");
  const getCoreSlug = (slugValue: string): string => {
    const normalized = normalizeSlug(slugValue);
    const recipePrefixed = normalized.match(
      /^(en|es|ar|pt-br|pt|zh-hans)\/recipe\/(.+)$/i,
    );
    if (recipePrefixed) return normalizeRecipeSlugToken(recipePrefixed[2]);
    const langPrefixed = normalized.match(
      /^(en|es|ar|pt-br|pt|zh-hans)\/(.+)$/i,
    );
    if (langPrefixed) return normalizeRecipeSlugToken(langPrefixed[2]);
    return normalizeRecipeSlugToken(normalized);
  };
  const extractRecipeIdFromContent = (value: ContentValue): string => {
    const text =
      typeof value === "string" ? value : JSON.stringify(value ?? "");
    if (!text) return "";
    const patterns = [
      /wprm[_-]recipe[_-]?(?:id)?\D*(\d{2,})/i,
      /data-recipe-id=["']?(\d{2,})/i,
      /wprm-recipe-container\D*(\d{2,})/i,
      /wprm_print=?(\d{2,})/i,
    ];
    for (const pattern of patterns) {
      const match = pattern.exec(text);
      if (match?.[1]) return String(match[1]).trim().toLowerCase();
    }
    return "";
  };
  const getArticleImageKey = (item: ArticleEntry): string =>
    String(
      item?.featured_img_url ||
        item?.featuredImage?.url ||
        item?.featuredMedia?.url ||
        item?.featured_image?.url ||
        "",
    )
      .trim()
      .toLowerCase();
  const getArticleRecipeKey = (item: ArticleEntry): string => {
    const direct = String(
      item?.wprmId ||
        item?.wprm_id ||
        item?.wprmRecipeId ||
        item?.wprm_recipe_id ||
        item?.recipeId ||
        item?.recipe_id ||
        "",
    )
      .trim()
      .toLowerCase();
    if (direct) return direct;
    return extractRecipeIdFromContent(item?.content);
  };
  const hasRenderableRecipeData = (item: ArticleEntry): boolean => {
    if (!item || typeof item !== "object") return false;

    const recipeBlocks = Array.isArray(item?.recipeBlocks)
      ? (item.recipeBlocks as Array<Record<string, unknown>>)
      : [];
    const hasRecipeBlocks = recipeBlocks.some((block) => {
      if (!block || typeof block !== "object") return false;
      const ingredients = Array.isArray(block.ingredients)
        ? block.ingredients
        : [];
      const steps = Array.isArray(block.steps) ? block.steps : [];
      return ingredients.length > 0 || steps.length > 0;
    });
    if (hasRecipeBlocks) return true;

    const contentText =
      typeof item?.content === "string"
        ? item.content
        : JSON.stringify(item?.content ?? "");
    if (!contentText) return false;

    return /wprm-recipe|content-v2-recipe|recipe-ingredients|recipe-steps/i.test(
      contentText,
    );
  };
  const buildLanguageSlugMapByFullSlug = (items: ArticleEntry[]) => {
    type Descriptor = {
      slug: string;
      coreSlug: string;
      lang: string;
      path: string;
      recipeKey: string;
      imageKey: string;
    };

    const descriptors: Descriptor[] = (Array.isArray(items) ? items : [])
      .map((item) => {
        const slug = getArticleSlugValue(item);
        if (!slug) return null;
        return {
          slug,
          coreSlug: getCoreSlug(slug),
          lang: normalizeLanguageCode(
            item?.lang || item?.language || item?.locale,
          ),
          path: `/${normalizeSlug(slug)}/`,
          recipeKey: getArticleRecipeKey(item),
          imageKey: getArticleImageKey(item),
        };
      })
      .filter((entry): entry is Descriptor => Boolean(entry));

    const bySlug = new Map<string, Descriptor[]>();
    const byCoreSlug = new Map<string, Descriptor[]>();
    const byRecipe = new Map<string, Descriptor[]>();
    const byImage = new Map<string, Descriptor[]>();

    for (const descriptor of descriptors) {
      const slugGroup = bySlug.get(descriptor.slug) || [];
      slugGroup.push(descriptor);
      bySlug.set(descriptor.slug, slugGroup);

      if (descriptor.coreSlug) {
        const coreGroup = byCoreSlug.get(descriptor.coreSlug) || [];
        coreGroup.push(descriptor);
        byCoreSlug.set(descriptor.coreSlug, coreGroup);
      }

      if (descriptor.recipeKey) {
        const recipeGroup = byRecipe.get(descriptor.recipeKey) || [];
        recipeGroup.push(descriptor);
        byRecipe.set(descriptor.recipeKey, recipeGroup);
      }

      if (descriptor.imageKey) {
        const imageGroup = byImage.get(descriptor.imageKey) || [];
        imageGroup.push(descriptor);
        byImage.set(descriptor.imageKey, imageGroup);
      }
    }

    const mapBySlug = new Map<string, Record<string, string>>();
    for (const descriptor of descriptors) {
      const mapping: Record<string, string> = {};
      const addTarget = (candidate: Descriptor) => {
        if (!candidate?.lang || !candidate?.path) return;
        mapping[candidate.lang] = candidate.path;
      };

      (bySlug.get(descriptor.slug) || []).forEach(addTarget);
      if (descriptor.coreSlug) {
        (byCoreSlug.get(descriptor.coreSlug) || []).forEach(addTarget);
      }
      if (descriptor.recipeKey) {
        (byRecipe.get(descriptor.recipeKey) || []).forEach(addTarget);
      }
      if (descriptor.imageKey) {
        (byImage.get(descriptor.imageKey) || []).forEach(addTarget);
      }
      addTarget(descriptor);

      mapBySlug.set(descriptor.slug, mapping);
    }

    return mapBySlug;
  };

  try {
    articles = await getAllArticlesFromMongo();
  } catch (error) {
    console.error("[lang/recipe] getAllArticlesFromMongo failed:", error);
  }

  if (!articles || articles.length === 0) {
    try {
      const payloadResponse = await payloadFetch<ArticleEntry>({
        collection: "articles",
        query: { depth: 2, limit: getBuildLimit() },
      });
      articles = payloadResponse;
    } catch (error) {
      console.error("[lang/recipe] payloadFetch fallback failed:", error);
    }
  }

  if (!Array.isArray(articles)) return [];

  const fallbackByCoreSlug = new Map<string, ArticleEntry>();
  const fallbackByRecipeKey = new Map<string, ArticleEntry>();
  const fallbackByImageKey = new Map<string, ArticleEntry>();
  const upsertFallback = (
    map: Map<string, ArticleEntry>,
    key: string,
    candidate: ArticleEntry,
  ) => {
    if (!key) return;

    const existing = map.get(key);
    if (!existing) {
      map.set(key, candidate);
      return;
    }

    const existingLang = normalizeLanguageCode(
      existing?.lang || existing?.language || existing?.locale,
    );
    const candidateLang = normalizeLanguageCode(
      candidate?.lang || candidate?.language || candidate?.locale,
    );
    if (existingLang !== "fr" && candidateLang === "fr") {
      map.set(key, candidate);
    }
  };

  for (const entry of articles) {
    if (!hasRenderableRecipeData(entry)) continue;

    const slugValue = getArticleSlugValue(entry);
    if (!slugValue) continue;

    const coreSlug = getCoreSlug(slugValue);
    const recipeKey = getArticleRecipeKey(entry);
    const imageKey = getArticleImageKey(entry);

    upsertFallback(fallbackByCoreSlug, coreSlug, entry);
    upsertFallback(fallbackByRecipeKey, recipeKey, entry);
    upsertFallback(fallbackByImageKey, imageKey, entry);
  }

  const languageMapBySlug = buildLanguageSlugMapByFullSlug(articles);
  const routeLanguages = ["en", "es", "ar", "pt-br"] as const;
  const pathsByKey = new Map<
    string,
    {
      params: { lang: string; slug: string };
      props: {
        article: ArticleEntry;
        languageSlugMap: Record<string, string>;
        fallbackRecipeArticle: ArticleEntry | null;
      };
    }
  >();
  const setPath = (langParam: string, slugParam: string, source: ArticleEntry) => {
    const normalizedLang = normalizeLanguageCode(langParam);
    const normalizedSlug = normalizeSlug(slugParam);
    if (!normalizedLang || !normalizedSlug || normalizedSlug.includes("/")) return;

    const pathKey = `${normalizedLang}::${normalizedSlug}`;
    if (pathsByKey.has(pathKey)) return;

    const fullSlug = `${normalizedLang}/recipe/${normalizedSlug}`;
    const fallbackRecipeArticle =
      fallbackByCoreSlug.get(getCoreSlug(fullSlug)) ||
      fallbackByRecipeKey.get(getArticleRecipeKey(source)) ||
      fallbackByImageKey.get(getArticleImageKey(source)) ||
      null;

    const languageSlugMap = {
      ...(languageMapBySlug.get(fullSlug) ||
        languageMapBySlug.get(getArticleSlugValue(source)) ||
        {}),
      [normalizedLang]: `/${fullSlug}/`,
    };
    if (!languageSlugMap.fr && normalizedSlug) {
      languageSlugMap.fr = `/${normalizedSlug}/`;
    }

    pathsByKey.set(pathKey, {
      params: { lang: normalizedLang, slug: normalizedSlug },
      props: {
        article: { ...source, slug: fullSlug },
        languageSlugMap,
        fallbackRecipeArticle,
      },
    });
  };

  for (const article of articles) {
    const fullSlug = getArticleSlugValue(article);
    const match = fullSlug.match(
      /^(en|es|ar|pt-br|pt|zh-hans)\/recipe\/(.+)$/i,
    );
    if (!match) continue;
    setPath(match[1], match[2], article);
  }

  for (const article of articles) {
    const baseSlug = getArticleSlugValue(article);
    if (!baseSlug || baseSlug.includes("/")) continue;
    for (const routeLang of routeLanguages) {
      setPath(routeLang, baseSlug, article);
    }
  }

  return Array.from(pathsByKey.values());
}

const { article, languageSlugMap, fallbackRecipeArticle = null } = Astro.props as Props;
---

<SlugPage
  article={article}
  languageSlugMap={languageSlugMap}
  fallbackRecipeArticle={fallbackRecipeArticle}
/>

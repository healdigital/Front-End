---
/**
 * `/<lang>/` (en, es, pt-br, ar, zh-hans) — language-prefixed homepage.
 * Sets the `lcdb_lang` cookie so downstream components render content in the
 * target language, then 302-redirects to the FR home (the home is prerendered,
 * so we cannot use Astro.rewrite to keep the URL).
 *
 * Trade-off: visiting `/en/` ends up at `/` with EN content, which is OK for
 * staging. To preserve the URL prefix permanently we'd need to convert the
 * homepage to SSR — leaving that for a follow-up.
 */
const SUPPORTED_LANGS = new Set(['en', 'es', 'pt-br', 'ar', 'zh-hans']);
const lang = String(Astro.params.lang || '').toLowerCase();
if (!SUPPORTED_LANGS.has(lang)) {
  return new Response(null, { status: 404 });
}

Astro.cookies.set('lcdb_lang', lang, {
  path: '/',
  maxAge: 60 * 60 * 24 * 365,
  sameSite: 'lax',
});
return Astro.redirect('/', 302);
---

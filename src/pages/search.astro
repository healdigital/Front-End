---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t as translate } from "../i18n";

export const prerender = true;

const lang = 'fr';
const title = translate('nav.search', lang);
const fixedPageSubtitle = "Utilisez la barre de recherche dans l'en-tête pour trouver des articles.";
const fixedNoResultsMessage = "Aucun résultat trouvé. Essayez un autre terme de recherche.";
const pageEyebrow = 'Recherche';
const pageHeading = 'Rechercher des articles';
const pageSubtitle = "Utilisez la barre de recherche dans l'en-tête pour trouver des articles.";
const noResultsMessage = "Aucun résultat trouvé. Essayez un autre terme de recherche.";
const noImageLabel = 'Aucune image';
---

<BaseLayout title={title} lang={lang}>
  <section class="lcdb-page-hero">
    <div class="lcdb-page-shell lcdb-page-hero-inner">
      <p class="lcdb-page-eyebrow typ-caption">{pageEyebrow}</p>
      <h1 class="lcdb-page-title typ-h2">{pageHeading}</h1>
      <p id="search-subtitle" class="lcdb-page-description typ-body">
        {fixedPageSubtitle}
      </p>
    </div>
  </section>

  <section class="lcdb-page-section">
    <div class="lcdb-page-shell lcdb-page-section-inner">
      <div id="no-results" class="hidden lcdb-empty-state space-y-4">
        <p class="text-lg font-medium">{fixedNoResultsMessage}</p>
        <a href="/articles/" class="inline-flex text-primary-turquoise typ-button">Parcourir tous les articles</a>
      </div>

      <div id="results-grid" class="lcdb-grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Results populated by JS -->
      </div>
    </div>
  </section>
</BaseLayout>

<script type="module" is:inline define:vars={{
  algoliaAppId: import.meta.env.PUBLIC_ALGOLIA_APP_ID,
  algoliaSearchKey: import.meta.env.PUBLIC_ALGOLIA_SEARCH_KEY,
  algoliaIndexPrefix: import.meta.env.PUBLIC_ALGOLIA_INDEX_PREFIX || 'lcdb_recipes',
  defaultSubtitle: fixedPageSubtitle,
  noImageLabelText: noImageLabel,
  payloadAssetOrigin: (() => {
    try {
      return new URL(import.meta.env.PUBLIC_PAYLOAD_API_URL || 'https://admin.lacuisinedebernard.com/api').origin;
    } catch {
      return 'https://admin.lacuisinedebernard.com';
    }
  })(),
}}>
  // Inline module scripts in Astro pages are not bundled, so we must use a fully
// resolved URL for the Algolia client to avoid runtime resolution errors.
import algoliasearch from 'https://cdn.jsdelivr.net/npm/algoliasearch/dist/algoliasearch-lite.esm.browser.js';

  const subtitleEl = document.getElementById('search-subtitle');
  const resultsGrid = document.getElementById('results-grid');
  const noResultsEl = document.getElementById('no-results');
  const noImageLabel = noImageLabelText;
  const entityDecoder = document.createElement('textarea');

  const urlParams = new URLSearchParams(window.location.search);
  const searchQuery = urlParams.get('q') || '';

  const normalizeLang = (value) =>
    String(value || 'fr')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '_')
      .replace(/^_+|_+$/g, '') || 'fr';

  const getCurrentLanguage = () => {
    const htmlLang = document.documentElement.getAttribute('data-lang') || document.documentElement.lang;
    const stored = localStorage.getItem('preferred-language');
    return htmlLang || stored || 'fr';
  };

  const getCurrentIndexName = () => {
    const preferred = normalizeLang(getCurrentLanguage());
    return `${algoliaIndexPrefix}_${preferred}`;
  };

  const resolveHitLanguage = (hit) => normalizeLang(hit?.language || hit?.lang || '');

  const repairMojibake = (value) => {
    const text = String(value || '');
    if (!/(Ã.|Â.|â€|â€™|â€œ|â€|â€“|â€”|â€¦)/.test(text)) return text;

    try {
      const bytes = Uint8Array.from(text, (char) => char.charCodeAt(0) & 0xff);
      const repaired = new TextDecoder('utf-8').decode(bytes);
      return repaired.includes('\uFFFD') ? text : repaired;
    } catch {
      return text;
    }
  };

  const decodeHtmlEntities = (value) => {
    entityDecoder.innerHTML = String(value || '');
    return entityDecoder.value;
  };

  const stripMarkup = (value) =>
    repairMojibake(
      decodeHtmlEntities(String(value || '').replace(/<[^>]*>/g, ' ')),
    ).replace(/\s+/g, ' ').trim();

  const toText = (value) => {
    if (!value) return '';
    if (typeof value === 'string') return stripMarkup(value);
    if (Array.isArray(value)) return value.map((item) => toText(item)).filter(Boolean).join(' ');
    if (typeof value === 'object') {
      const directCandidates = [value.rendered, value.value, value.text, value.title, value.name, value.label];
      for (const candidate of directCandidates) {
        const text = toText(candidate);
        if (text) return text;
      }
      if (Array.isArray(value.children)) {
        return value.children.map((child) => toText(child)).filter(Boolean).join(' ');
      }
      const objectValues = Object.values(value);
      for (const nested of objectValues) {
        const text = toText(nested);
        if (text) return text;
      }
    }
    return '';
  };

  const escapeHtml = (value) =>
    String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

  const resolveTitle = (hit) => {
    const options = [
      toText(hit?.title),
      toText(hit?.post_title),
      toText(hit?.name),
      toText(hit?._highlightResult?.title?.value),
      toText(hit?._highlightResult?.post_title?.value),
      toText(hit?._highlightResult?.name?.value),
    ];
    return options.find((value) => value.length > 0) || 'Article sans titre';
  };

  const normalizeImageUrl = (value) => {
    if (!value) return '';
    if (typeof value === 'object') {
      const nestedOptions = [value.url, value.src, value.href, value.value, value.original];
      for (const candidate of nestedOptions) {
        const nested = normalizeImageUrl(candidate);
        if (nested) return nested;
      }
      return '';
    }
    if (typeof value !== 'string') return '';
    const normalized = value.trim();
    if (!normalized) return '';
    if (normalized.startsWith('//')) return `https:${normalized}`;
    if (normalized.startsWith('/api/') || normalized.startsWith('/media/')) {
      return `${payloadAssetOrigin}${normalized}`;
    }
    if (normalized.startsWith('http://') || normalized.startsWith('https://') || normalized.startsWith('/')) {
      return normalized;
    }
    if (normalized.startsWith('images/') || normalized.startsWith('uploads/')) {
      return `/${normalized.replace(/^\/+/, '')}`;
    }
    return '';
  };

  const resolveImageUrl = (hit) => {
    const candidates = [
      hit?.image_url,
      hit?.imageUrl,
      hit?.featuredMedia?.sizes?.articleHero?.url,
      hit?.featuredMedia?.sizes?.gallery?.url,
      hit?.featuredMedia?.url,
      hit?.featuredMedia?.value?.url,
      hit?.featured_image?.url,
      hit?.featured_image?.asset?.url,
      hit?.featured_image?.src,
      hit?.featured_image?.sizes?.medium,
      hit?.featured_image?.sizes?.large,
      hit?.featured_image_url,
      hit?.featured_img_url,
      hit?.featuredImageUrl,
      hit?.featuredImage?.sizes?.articleHero?.url,
      hit?.featuredImage?.sizes?.gallery?.url,
      hit?.featuredImage?.url,
      hit?.featuredImage?.src,
      hit?.featuredImage?.node?.sourceUrl,
      hit?.featuredImage,
      hit?.featureImage,
      hit?.image?.url,
      hit?.image?.src,
      hit?.image?.sizes?.medium,
      hit?.image,
      hit?.media?.url,
      hit?.media?.src,
      hit?.media?.thumbnail,
      hit?._highlightResult?.featured_image?.url?.value,
      hit?._highlightResult?.image_url?.value,
      hit?._snippetResult?.featured_image?.value,
      hit?.images?.[0]?.url,
      hit?.images?.[0]?.src,
      hit?.images?.[0],
      hit?.thumbnail,
      hit?.heroImage,
      hit?.coverImage,
    ];
    for (const candidate of candidates) {
      const url = normalizeImageUrl(candidate);
      if (url) return url;
    }
    return '';
  };

  const resolveCategory = (hit) => {
    const options = [toText(hit?.category), toText(hit?.categories), toText(hit?.tags), toText(hit?.cuisine)];
    return options.find((value) => value.length > 0) || '';
  };

  const normalizeArticlePath = (path) => {
    if (!path) return '';
    const clean = String(path).trim();
    if (!clean.startsWith('/')) return clean;

    const normalized = clean.replace(/^\/articles\/+/i, '/');
    const match = normalized.match(/^([^?#]*)(.*)$/);
    const pathname = match ? match[1] : normalized;
    const suffix = match ? match[2] : '';

    if (!pathname || pathname === '/' || pathname.endsWith('/')) return normalized;
    if (/\.[a-z0-9]+$/i.test(pathname)) return normalized;
    return `${pathname}/${suffix}`;
  };

  const resolveHref = (hit) => {
    const directUrl = typeof hit?.url === 'string' ? hit.url.trim() : '';
    if (directUrl) {
      if (directUrl.startsWith('/')) return normalizeArticlePath(directUrl);
      if (directUrl.startsWith('http://') || directUrl.startsWith('https://')) {
        try {
          const parsed = new URL(directUrl);
          const normalizedPath = normalizeArticlePath(parsed.pathname);
          return `${normalizedPath}${parsed.search}${parsed.hash}`;
        } catch {
          return directUrl;
        }
      }
    }

    const slugRaw = typeof hit?.slug === 'string' ? hit.slug : '';
    const slug = slugRaw.trim().replace(/^\/+|\/+$/g, '').replace(/^articles\/+/i, '');
    return slug ? `/${slug}/` : '#';
  };

  const renderCard = (hit) => {
    const imageUrl = resolveImageUrl(hit);
    const title = resolveTitle(hit);
    const imageAlt = toText(hit?.featured_image?.alt) || title || 'Article';
    const category = resolveCategory(hit);
    const href = resolveHref(hit);
    const safeTitle = escapeHtml(title);
    const safeAlt = escapeHtml(imageAlt);
    const safeCategory = escapeHtml(category);
    const safeHref = escapeHtml(href);
    const safeImageUrl = escapeHtml(imageUrl);

    return `
      <a href="${safeHref}" class="lcdb-article-card">
        <div class="lcdb-article-card-media">
          ${safeImageUrl ? `<img src="${safeImageUrl}" alt="${safeAlt}" loading="lazy" />` : `<div class="w-full h-full bg-[#ECEBE4] flex items-center justify-center"><span class="font-mono text-[11px] tracking-[0.18em] uppercase text-[#7B7B6F]">${escapeHtml(noImageLabel)}</span></div>`}
        </div>
        <div class="lcdb-article-card-content">
          ${safeCategory ? `<span class="lcdb-chip">${safeCategory}</span>` : ''}
          <h3 class="lcdb-article-card-title">
            ${safeTitle}
          </h3>
        </div>
      </a>
    `;
  };

  const updateUI = (query, hits) => {
    if (!subtitleEl || !resultsGrid || !noResultsEl) return;

    if (!query.trim()) {
      subtitleEl.textContent = defaultSubtitle;
      resultsGrid.innerHTML = '';
      noResultsEl.classList.add('hidden');
      return;
    }

    subtitleEl.innerHTML = hits.length
      ? `${hits.length} article${hits.length !== 1 ? 's' : ''} trouvé${hits.length !== 1 ? 's' : ''} pour "<strong>${escapeHtml(query)}</strong>"`
      : `Aucun résultat trouvé pour "<strong>${escapeHtml(query)}</strong>"`;

    if (hits.length === 0) {
      noResultsEl.classList.remove('hidden');
      resultsGrid.innerHTML = '';
      return;
    }

    noResultsEl.classList.add('hidden');
    resultsGrid.innerHTML = hits.map(renderCard).join('');
  };

  const runLocalSearch = async (query) => {
    const currentLangKey = normalizeLang(getCurrentLanguage());
    const normalizedQuery = String(query || '').trim().toLowerCase();
    if (!normalizedQuery) {
      updateUI('', []);
      return;
    }

    try {
      const response = await fetch('/search-index.json', { cache: 'force-cache' });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const records = await response.json();
      if (!Array.isArray(records)) {
        updateUI(query, []);
        return;
      }

      const hits = records
        .filter((hit) => resolveHitLanguage(hit) === currentLangKey)
        .filter((hit) => {
          const searchable = [
            toText(hit?.title),
            toText(hit?.excerpt),
            toText(hit?.content),
            toText(hit?.searchableText),
            toText(hit?.category),
            toText(hit?.tags),
          ]
            .join(' ')
            .toLowerCase();
          return searchable.includes(normalizedQuery);
        })
        .slice(0, 50);

      updateUI(query, hits);
    } catch (error) {
      console.error('Local search fallback failed:', error);
      if (subtitleEl) {
        subtitleEl.textContent = "La recherche est temporairement indisponible. Veuillez réessayer plus tard.";
      }
    }
  };

  const runAlgoliaSearch = async (query) => {
    if (!algoliaAppId || !algoliaSearchKey) {
      console.warn('Algolia keys missing at build-time; using local search-index fallback.');
      await runLocalSearch(query);
      return;
    }

    const client = algoliasearch(algoliaAppId, algoliaSearchKey);

    try {
      const searchInIndex = async (indexName) => {
        if (typeof client.initIndex === 'function') {
          const index = client.initIndex(indexName);
          const result = await index.search(query, { hitsPerPage: 50 });
          return result?.hits || [];
        }

        if (typeof client.searchSingleIndex === 'function') {
          const result = await client.searchSingleIndex({
            indexName,
            searchParams: { query, hitsPerPage: 50 },
          });
          return result?.hits || [];
        }

        if (typeof client.search === 'function') {
          const result = await client.search([
            {
              indexName,
              query,
              params: { hitsPerPage: 50 },
            },
          ]);
          return result?.results?.[0]?.hits || [];
        }

        return [];
      };

      const indexName = getCurrentIndexName();
      const currentLangKey = normalizeLang(getCurrentLanguage());
      const hits = (await searchInIndex(indexName)).filter(
        (hit) => resolveHitLanguage(hit) === currentLangKey,
      );
      updateUI(query, hits);
    } catch (error) {
      console.error('Algolia search failed:', error);
      if (subtitleEl) {
        subtitleEl.textContent = "La recherche est temporairement indisponible. Veuillez réessayer plus tard.";
      }
    }
  };

  const performSearch = () => {
    if (searchQuery.trim()) {
      runAlgoliaSearch(searchQuery.trim());
    } else {
      updateUI('', []);
    }
  };

  performSearch();

  window.addEventListener('page-translated', () => {
    if (searchQuery.trim()) runAlgoliaSearch(searchQuery.trim());
  });

  window.addEventListener('language-changed', () => {
    if (searchQuery.trim()) runAlgoliaSearch(searchQuery.trim());
  });

  window.addEventListener('storage', (e) => {
    if (e.key === 'preferred-language' && searchQuery.trim()) {
      runAlgoliaSearch(searchQuery.trim());
    }
  });
</script>




---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { payloadFetch } from '../../lib/payload.client';
import { BUILD_ONLY_ARTICLE_PAGES } from '../../utils/buildFlags';

let tagsWithCounts: any[] = [];

if (!BUILD_ONLY_ARTICLE_PAGES) {
  tagsWithCounts = await payloadFetch({
    collection: 'tags',
    query: { limit: 1000 },
  });
}

const normalizeSlug = (value: any) => String(value || '').replace(/^\/+|\/+$/g, '');

const tags = (Array.isArray(tagsWithCounts) ? tagsWithCounts : [])
  .map((tag: any) => {
    const slug = normalizeSlug(typeof tag?.slug === 'string' ? tag.slug : tag?.slug?.current);
    if (!slug) return null;

    return {
      slug,
      title: tag?.title || tag?.name || slug,
      description: tag?.description || '',
      articleCount: Number(tag?.articleCount || 0),
    };
  })
  .filter(Boolean)
  .sort((a: any, b: any) => b.articleCount - a.articleCount);
---

<BaseLayout title="Mots-clés" description="Parcourir les articles par mot-clé">
  <section class="lcdb-page-hero">
    <div class="lcdb-page-shell lcdb-page-hero-inner">
      <p class="lcdb-page-eyebrow typ-caption">Explorer</p>
      <h1 class="lcdb-page-title typ-h2">Mots-clés</h1>
      <p class="lcdb-page-description typ-body">{tags.length} mots-clés disponibles.</p>
    </div>
  </section>

  <section class="lcdb-page-section">
    <div class="lcdb-page-shell lcdb-page-section-inner">
      {BUILD_ONLY_ARTICLE_PAGES && (
        <div class="mb-8 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-amber-800">
          Les pages de mots-clés sont exclues en mode de build réservé aux articles (`BUILD_ONLY_ARTICLE_PAGES=1`).
        </div>
      )}

      {tags.length > 0 ? (
        <div class="lcdb-grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
          {tags.map((tag: any) => (
            <a href={`/tags/${tag.slug}`} class="lcdb-surface-card p-6 transition-shadow hover:shadow-lg">
              <p class="text-[#8B7A4E] mb-3 typ-caption">{tag.articleCount} article{tag.articleCount !== 1 ? 's' : ''}</p>
              <h2 class="lcdb-article-card-title mb-3">#{tag.title}</h2>
              {tag.description && <p class="text-[#4B5563] typ-body">{tag.description}</p>}
            </a>
          ))}
        </div>
      ) : (
        <div class="lcdb-empty-state"><p class="typ-body">Aucun mot-clé disponible.</p></div>
      )}
    </div>
  </section>
</BaseLayout>


---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { payloadFetch } from '../../lib/payload.client';
import { BUILD_ONLY_ARTICLE_PAGES } from '../../utils/buildFlags';

let tagsWithCounts: any[] = [];

if (!BUILD_ONLY_ARTICLE_PAGES) {
  tagsWithCounts = await payloadFetch({
    collection: 'tags',
    query: { limit: 1000 },
  });
}

const normalizeSlug = (value: any) => String(value || '').replace(/^\/+|\/+$/g, '');

const tags = (Array.isArray(tagsWithCounts) ? tagsWithCounts : [])
  .map((tag: any) => {
    const slug = normalizeSlug(typeof tag?.slug === 'string' ? tag.slug : tag?.slug?.current);
    if (!slug) return null;

    return {
      slug,
      title: tag?.title || tag?.name || slug,
      description: tag?.description || '',
      articleCount: Number(tag?.articleCount || 0),
    };
  })
  .filter(Boolean)
  .sort((a: any, b: any) => b.articleCount - a.articleCount);
---

<BaseLayout title="Tags" description="Browse articles by tag">
  <section class="relative bg-[#F5F1E8] border-b border-[#E2DAC8] overflow-hidden">
    <div
      class="absolute inset-0 pointer-events-none opacity-30"
      aria-hidden="true"
      style="background-image: url('/images/noise.webp'); background-size: 180px 180px;"
    ></div>
    <div class="max-w-[1440px] mx-auto px-5 md:px-10 lg:px-[90px] py-12 relative z-10">
      <p class="text-[#8B7A4E] mb-3 typ-caption">Explore</p>
      <h1 class="text-[#1A2335] typ-h2">Tags</h1>
      <p class="text-[#4B5563] mt-3 typ-body">{tags.length} tags disponibles.</p>
    </div>
  </section>

  <section class="bg-secondary-cream py-12 md:py-16">
    <div class="max-w-[1440px] mx-auto px-5 md:px-10 lg:px-[90px]">
      {BUILD_ONLY_ARTICLE_PAGES && (
        <div class="mb-8 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-amber-800">
          Tag pages are excluded in article-only build mode (`BUILD_ONLY_ARTICLE_PAGES=1`).
        </div>
      )}

      {tags.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {tags.map((tag: any) => (
            <a href={`/tags/${tag.slug}`} class="group rounded-lg border border-[#DDD8CA] bg-[#F7F5EF] p-6 hover:shadow-lg transition-shadow">
              <p class="text-[#8B7A4E] mb-3 typ-caption">{tag.articleCount} article{tag.articleCount !== 1 ? 's' : ''}</p>
              <h2 class="text-[#1A2335] mb-3 typ-feature-title group-hover:text-primary-turquoise transition-colors">#{tag.title}</h2>
              {tag.description && <p class="text-[#4B5563] typ-body">{tag.description}</p>}
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-[#6B7280] typ-body">Aucun tag disponible.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>


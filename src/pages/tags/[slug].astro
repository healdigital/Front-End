---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTagsFromMongo, getArticlesByTagFromMongo } from '../../lib/mongo.server';
import { processArticleImageUrl } from '../../utils/cdnUrlReplacer';
import { BUILD_ONLY_ARTICLE_PAGES } from '../../utils/buildFlags';

export const prerender = true;

const stripHtml = (value: string) =>
  String(value || '')
    .replace(/<[^>]*>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const toText = (value: any): string => {
  if (!value) return '';
  if (typeof value === 'string') return stripHtml(value);
  if (Array.isArray(value)) return value.map((item) => toText(item)).filter(Boolean).join(' ');
  if (typeof value === 'object') {
    const directCandidates = [value.rendered, value.value, value.text, value.title, value.name, value.label];
    for (const candidate of directCandidates) {
      const text = toText(candidate);
      if (text) return text;
    }
    if (Array.isArray(value.children)) {
      return value.children.map((child: any) => toText(child)).filter(Boolean).join(' ');
    }
  }
  return '';
};

const normalizeSlug = (value: any) => String(value || '').replace(/^\/+|\/+$/g, '');

const articleSlug = (article: any) =>
  normalizeSlug(typeof article?.slug === 'string' ? article.slug : article?.slug?.current);

const getExcerpt = (article: any) => {
  const raw = toText(article?.excerpt) || toText(article?.content) || toText(article?.contentV2);
  if (!raw) return 'Recette a decouvrir.';
  return raw.length > 180 ? `${raw.slice(0, 180).trim()}...` : raw;
};

const getDate = (article: any) => {
  const candidate = article?.publishedAt || article?.date || article?.modified;
  if (!candidate) return '';
  const parsed = new Date(candidate);
  if (Number.isNaN(parsed.getTime())) return '';
  return parsed.toLocaleDateString('fr-FR', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};

export async function getStaticPaths() {
  if (BUILD_ONLY_ARTICLE_PAGES) {
    return [];
  }

  const tags = await getAllTagsFromMongo();
  return tags
    .map((tag: any) => {
      const slug = normalizeSlug(typeof tag?.slug === 'string' ? tag.slug : tag?.slug?.current);
      if (!slug) return null;
      return { params: { slug }, props: { tag } };
    })
    .filter(Boolean);
}

interface Props {
  tag: any;
}

const { tag } = Astro.props as Props;
if (!tag) {
  return new Response('Tag not found', { status: 404 });
}

const tagTitle = toText(tag?.title || tag?.name || tag?.label || Astro.params.slug);
const tagName = toText(tag?.name || tag?.title || tag?.slug || Astro.params.slug);
const fetchedArticles = await getArticlesByTagFromMongo(tagName, 1000);

const articles = (Array.isArray(fetchedArticles) ? fetchedArticles : [])
  .map((article: any) => {
    const slug = articleSlug(article);
    const title = toText(article?.title);
    if (!slug || !title) return null;

    return {
      slug,
      title,
      excerpt: getExcerpt(article),
      date: getDate(article),
      image: processArticleImageUrl(article),
    };
  })
  .filter(Boolean);
---

<BaseLayout title={`#${tagTitle}`} description={`Articles tagged with ${tagTitle}`}>
  <section class="relative bg-[#F5F1E8] border-b border-[#E2DAC8] overflow-hidden">
    <div
      class="absolute inset-0 pointer-events-none opacity-30"
      aria-hidden="true"
      style="background-image: url('/images/noise.png'); background-size: 180px 180px;"
    ></div>
    <div class="max-w-[1440px] mx-auto px-5 md:px-10 lg:px-[90px] py-12 relative z-10">
      <p class="text-[#8B7A4E] mb-3 typ-caption">Tag</p>
      <h1 class="text-[#1A2335] typ-h2">#{tagTitle}</h1>
      <p class="text-[#4B5563] mt-3 typ-body">{articles.length} article{articles.length !== 1 ? 's' : ''} trouv&eacute;s.</p>
    </div>
  </section>

  <section class="bg-secondary-cream py-12 md:py-16">
    <div class="max-w-[1440px] mx-auto px-5 md:px-10 lg:px-[90px]">
      {articles.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-7">
          {articles.map((article: any) => (
            <a href={`/${article.slug}`} class="group rounded-lg border border-[#DDD8CA] bg-[#F7F5EF] overflow-hidden hover:shadow-lg transition-shadow">
              <div class="relative h-[230px] bg-[#ECE9DD] overflow-hidden">
                {article.image ? (
                  <img
                    src={article.image}
                    alt={article.title}
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <span class="text-[#8A8578] typ-caption">No image</span>
                  </div>
                )}
              </div>
              <div class="p-5">
                {article.date && <p class="text-[#777] mb-2 typ-caption">{article.date}</p>}
                <h2 class="text-[#1A2335] mb-3 typ-card-title">{article.title}</h2>
                <p class="text-[#4B5563] mb-5 typ-body">{article.excerpt}</p>
                <span class="inline-flex text-primary-turquoise typ-button">Lire la suite</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-[#6B7280] typ-body">Aucun article trouv&eacute; pour ce tag.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

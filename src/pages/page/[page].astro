---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleSlider from "../../components/ArticleSlider.astro";
import MainContent from "../../components/MainContent.astro";
import RecipesSections from "../../components/RecipesSections.astro";
import VideoSection from "../../components/VideoSection.astro";
import AboutSection from "../../components/AboutSection.astro";
import MediavineSlot from "../../components/MediavineSlot.astro";
import { getArticlesPageWithMeta } from "../../lib/payload.client";

export const prerender = false;

const { page } = Astro.params;
const currentPage = parseInt(String(page || ''), 10);
const articlesPerPage = 10;

if (!Number.isFinite(currentPage)) {
  return new Response(null, { status: 404 });
}

const { docs: articles, totalPages } = await getArticlesPageWithMeta(currentPage, articlesPerPage);

if (currentPage < 2 || currentPage > totalPages) {
  return new Response(null, { status: 404 });
}

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=300, stale-while-revalidate=86400',
);

const paginatedArticles = (Array.isArray(articles) ? articles : []).filter((a: any) => a && a.title);
---

<BaseLayout title={`Home - Page ${currentPage}`} loadAds={true}>
  <!-- Article Slider -->
  <ArticleSlider articles={paginatedArticles} />

  <!-- Main Content (Latest Articles + Sidebar) - Same as homepage -->
  <MainContent latestArticles={paginatedArticles} currentLang="fr" currentPage={currentPage} totalPages={totalPages} />
  <div class="lcdb-page-shell mt-10" data-mediavine>
    <MediavineSlot slot="homepage-page-inline" minHeight={280} className="rounded-[10px] bg-primary-white" />
  </div>

  <!-- Sweet & Savory Recipes Sections -->
  <RecipesSections allArticles={paginatedArticles} />

  <!-- YouTube Videos Section  -->
  <VideoSection />

  <!-- About Section -->
  <AboutSection />

</BaseLayout>

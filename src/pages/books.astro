---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticPage from "../components/StaticPage.astro";
import StaticPageContent from "../components/StaticPageContent.astro";
---

<BaseLayout title="My Books">
  <StaticPage title="My Books" subtitle="Mes Livres">
    <div class="books-page">
      <StaticPageContent
        slug="mes-livres"
        sourceUrl="https://lacuisinedebernard.com/mes-livres/"
      />
    </div>
  </StaticPage>
</BaseLayout>

<style is:global>
  .books-page .wp-content {
    display: block;
  }

  .books-page .wp-content figure,
  .books-page .wp-content .separator {
    margin: 1.75rem 0;
  }

  .books-page .wp-content img,
  .books-page .wp-content iframe {
    max-width: 100%;
    border-radius: 16px;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.12);
    margin: 0 auto;
    height: auto;
  }

  .books-page .wp-content iframe {
    width: 100%;
    min-height: 360px;
  }

  .books-page .wp-content p {
    font-size: 1.05rem;
    line-height: 1.75;
  }
</style>

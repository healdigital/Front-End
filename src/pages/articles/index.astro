---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { payloadFetch } from '../../lib/payload.client';
import { getAllArticlesFromMongo } from '../../lib/mongo.server';
import { processArticleImageUrl } from '../../utils/cdnUrlReplacer';

const lang = 'fr';
const currentPage = 1;
const articlesPerPage = 12;

const getBuildLimit = () => {
  const envLimit = Number(process.env.MAX_SSG_ARTICLES);
  return Number.isFinite(envLimit) && envLimit > 0 ? envLimit : 6000;
};

const stripHtml = (value: string) =>
  String(value || '')
    .replace(/<[^>]*>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const toText = (value: any): string => {
  if (!value) return '';
  if (typeof value === 'string') return stripHtml(value);
  if (Array.isArray(value)) return value.map((item) => toText(item)).filter(Boolean).join(' ');
  if (typeof value === 'object') {
    const directCandidates = [value.rendered, value.value, value.text, value.title, value.name, value.label];
    for (const candidate of directCandidates) {
      const text = toText(candidate);
      if (text) return text;
    }
    if (Array.isArray(value.children)) {
      return value.children.map((child: any) => toText(child)).filter(Boolean).join(' ');
    }
    if (value.content) return toText(value.content);
  }
  return '';
};

const articleSlug = (article: any) => {
  if (!article) return '';
  const raw = typeof article.slug === 'string' ? article.slug : article.slug?.current;
  return String(raw || '').replace(/^\/+|\/+$/g, '');
};

const getTitle = (article: any) => toText(article?.title) || 'Untitled article';

const getExcerpt = (article: any) => {
  const raw = toText(article?.excerpt) || toText(article?.content) || toText(article?.contentV2);
  if (!raw) return 'Recette a decouvrir.';
  return raw.length > 180 ? `${raw.slice(0, 180).trim()}...` : raw;
};

const getDate = (article: any) => {
  const candidate = article?.publishedAt || article?.date || article?.modified;
  if (!candidate) return '';
  const parsed = new Date(candidate);
  if (Number.isNaN(parsed.getTime())) return '';
  return parsed.toLocaleDateString('fr-FR', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};

const getCategories = (article: any): string[] => {
  if (!Array.isArray(article?.categories)) return [];
  return article.categories
    .map((category: any) => toText(category?.title || category?.name || category?.label || category))
    .filter(Boolean)
    .slice(0, 2);
};

let allArticles = await getAllArticlesFromMongo();

if (!allArticles || allArticles.length === 0) {
  const result: any = await payloadFetch({
    collection: 'articles',
    query: { depth: 2, limit: getBuildLimit() },
  });
  allArticles = result?.docs || result || [];
}

const normalizedArticles = (Array.isArray(allArticles) ? allArticles : [])
  .map((article: any) => {
    const slug = articleSlug(article);
    const title = getTitle(article);
    if (!slug || !title) return null;
    return {
      slug,
      title,
      excerpt: getExcerpt(article),
      date: getDate(article),
      image: processArticleImageUrl(article),
      categories: getCategories(article),
    };
  })
  .filter(Boolean);

const totalPages = Math.ceil(normalizedArticles.length / articlesPerPage);
const startIdx = (currentPage - 1) * articlesPerPage;
const endIdx = startIdx + articlesPerPage;
const paginatedArticles = normalizedArticles.slice(startIdx, endIdx);

const paginationItems = (() => {
  if (totalPages <= 7) return Array.from({ length: totalPages }, (_, index) => index + 1);

  const items: Array<number | string> = [1];
  const rangeStart = Math.max(2, currentPage - 1);
  const rangeEnd = Math.min(totalPages - 1, currentPage + 1);

  if (rangeStart > 2) items.push('start-ellipsis');
  for (let page = rangeStart; page <= rangeEnd; page += 1) {
    items.push(page);
  }
  if (rangeEnd < totalPages - 1) items.push('end-ellipsis');

  items.push(totalPages);
  return items;
})();
---

<BaseLayout title="Articles" lang={lang}>
  <section class="lcdb-page-hero">
    <div class="lcdb-page-shell lcdb-page-hero-inner">
      <p class="lcdb-page-eyebrow typ-caption">Archive</p>
      <h1 class="lcdb-page-title typ-h2">Articles</h1>
      <p class="lcdb-page-description typ-body">
        D&eacute;couvrez {normalizedArticles.length} articles publi&eacute;s.
      </p>
    </div>
  </section>

  <section class="lcdb-page-section">
    <div class="lcdb-page-shell lcdb-page-section-inner">
      {paginatedArticles.length > 0 ? (
        <>
          <div class="lcdb-grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3">
            {paginatedArticles.map((article: any) => (
              <a href={`/${article.slug}`} class="lcdb-article-card">
                <div class="lcdb-article-card-media">
                  {article.image ? (
                    <img
                      src={article.image}
                      alt={article.title}
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center">
                      <span class="text-[#8A8578] typ-caption">No image</span>
                    </div>
                  )}

                  {article.categories[0] && (
                    <span class="absolute top-4 left-4 lcdb-chip">
                      {article.categories[0]}
                    </span>
                  )}
                </div>
                <div class="lcdb-article-card-content">
                  {article.date && <p class="text-[#777] mb-2 typ-caption">{article.date}</p>}
                  <h2 class="lcdb-article-card-title">{article.title}</h2>
                  <p class="lcdb-article-card-excerpt typ-body">{article.excerpt}</p>
                  <span class="inline-flex text-primary-turquoise typ-button">Lire la suite</span>
                </div>
              </a>
            ))}
          </div>

          {totalPages > 1 && (
            <nav class="lcdb-pagination">
              {currentPage > 1 ? (
                <a href="/articles" class="text-[#4B5563] hover:text-[#1A2335] typ-caption">
                  Pr&eacute;c&eacute;dent
                </a>
              ) : (
                <span class="text-[#AAA] typ-caption">Pr&eacute;c&eacute;dent</span>
              )}

              <div class="flex items-center gap-4">
                {paginationItems.map((item) =>
                  typeof item === 'string' ? (
                    <span class="text-[#999] typ-caption">...</span>
                  ) : (
                    <a
                      href={item === 1 ? '/articles' : `/articles/${item}`}
                      class={`text-[14px] ${item === currentPage ? 'text-[#1A2335] font-semibold' : 'text-[#707070] hover:text-[#1A2335]'}`}
                    >
                      {item}
                    </a>
                  )
                )}
              </div>

              {currentPage < totalPages ? (
                <a href={`/articles/${currentPage + 1}`} class="text-[#4B5563] hover:text-[#1A2335] typ-caption">
                  Suivant
                </a>
              ) : (
                <span class="text-[#AAA] typ-caption">Suivant</span>
              )}
            </nav>
          )}
        </>
      ) : (
        <div class="lcdb-empty-state"><p class="typ-body">Aucun article trouv&eacute;.</p></div>
      )}
    </div>
  </section>
</BaseLayout>


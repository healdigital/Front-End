---
import { payloadFetch } from '../../lib/payload.client';
import { getAllArticlesFromMongo } from '../../lib/mongo.server';

export const prerender = !import.meta.env.DEV;

const getBuildLimit = () => {
  const envLimit = Number(process.env.MAX_SSG_ARTICLES);
  return Number.isFinite(envLimit) && envLimit > 0 ? envLimit : 6000;
};

export async function getStaticPaths() {
  if (import.meta.env.DEV) {
    return [];
  }

  const normalizeSlug = (value: any) => String(value || '').replace(/^\/+|\/+$/g, '');

  let articles = await getAllArticlesFromMongo();
  if (!articles || articles.length === 0) {
    const response: any = await payloadFetch({
      collection: 'articles',
      query: { depth: 0, limit: getBuildLimit() },
    });
    articles = response?.docs || response || [];
  }

  if (!Array.isArray(articles)) {
    return [];
  }

  return articles
    .map((article: any) => {
      const slug = normalizeSlug(typeof article?.slug === 'string' ? article.slug : article?.slug?.current);
      if (!slug) return null;
      return {
        params: { slug },
        props: {
          slug,
          title: typeof article?.title === 'string' ? article.title : 'Article',
        },
      };
    })
    .filter(Boolean);
}

interface Props {
  slug?: string;
  title?: string;
}

const normalizeSlug = (value: any) => String(value || '').replace(/^\/+|\/+$/g, '');

const { slug: propSlug = '', title = 'Article' } = Astro.props as Props;
const slug = normalizeSlug(propSlug || Astro.params.slug);

if (!slug) {
  return new Response('Article not found', { status: 404 });
}

const targetPath = `/${slug}/`;
const targetUrl = `https://lacuisinedebernard.com${targetPath}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="canonical" href={targetUrl} />
    <meta http-equiv="refresh" content={`0;url=${targetPath}`} />
    <script is:inline>
      {`window.location.replace(${JSON.stringify(targetPath)});`}
    </script>
  </head>
  <body>
    <p>Redirecting to <a href={targetPath}>{title}</a>...</p>
  </body>
</html>

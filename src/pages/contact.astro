---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticPage from "../components/StaticPage.astro";
import StaticPageContent from "../components/StaticPageContent.astro";
---

<BaseLayout title="Contact" description="Contactez La Cuisine de Bernard">
  <StaticPage title="Contact" subtitle="Restons en contact">
    <StaticPageContent
      slug="contact"
      sourceUrl="https://lacuisinedebernard.com/contact/"
    >
      <p>
        Vous pouvez utiliser l'adresse email ci-dessous pour les demandes générales,
        les retours sur les recettes, les partenariats ou toute autre prise de contact.
      </p>

      <h2>Contact</h2>
      <p>
        Email :
        <a href="mailto:contact@lacuisinedebernard.com">contact@lacuisinedebernard.com</a>
      </p>

      <h2>Que préciser dans votre message</h2>
      <ul>
        <li>Votre nom et l'objet de votre demande</li>
        <li>Les liens ou références utiles</li>
        <li>Les délais ou dates importantes si besoin</li>
      </ul>

      <p>
        Un formulaire de contact pourra être ajouté ensuite si vous souhaitez
        centraliser ces demandes sur le site.
      </p>
    </StaticPageContent>
  </StaticPage>
</BaseLayout>

---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import GlobalFooter from '../components/GlobalFooter.astro';
import ClubLoginModal from '../components/ClubLoginModal.astro';
import NewsletterModal from '../components/organisms/NewsletterModal.astro';
import '../styles/global.css';
import '@fortawesome/fontawesome-free/css/all.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
}

const { title, description, image, lang = 'fr' } = Astro.props;
---

<!doctype html>
<html lang={lang} data-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO title={title} description={description} image={image} lang={lang} />
    <link rel="preconnect" href="https://lcdb.fra1.digitaloceanspaces.com" crossorigin />
    <link rel="dns-prefetch" href="//lcdb.fra1.digitaloceanspaces.com" />
  </head>
  <body class="bg-primary-white text-text-primary antialiased min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 px-4 py-2 bg-primary-white text-primary-black border border-primary-black rounded-md shadow-lg">
      Skip to main content
    </a>
    <Header lang={lang} />
    <div class="lcdb-translation-status" data-translation-status hidden role="status" aria-live="polite" aria-atomic="true">
      <div class="lcdb-translation-status__inner">
        <span class="lcdb-translation-status__dot" aria-hidden="true"></span>
        <p class="lcdb-translation-status__text" data-translation-status-text></p>
      </div>
    </div>
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <NewsletterModal triggerId="open-newsletter-footer" id="newsletter-modal-footer" />
    <ClubLoginModal />
    <GlobalFooter currentLang={lang} />
  </body>
</html>

<script>
  import { initializeTranslations, setupLanguageSwitcher, watchLanguageChanges, changeLanguage, getCurrentLanguage } from '../utils/dynamicTranslate';
  const LANGUAGE_STORAGE_KEY = 'preferred-language';

  async function init() {
    await initializeTranslations();
    setupLanguageSwitcher();
    watchLanguageChanges();

    const currentLang = String(getCurrentLanguage() || '').toLowerCase();
    const htmlLang = String(
      document.documentElement.getAttribute('data-lang') ||
      document.documentElement.lang ||
      'fr',
    ).toLowerCase();
    const pendingLang = String((window as any).__lcdbPendingLanguage || '').toLowerCase();

    if (pendingLang || (currentLang && currentLang !== htmlLang)) {
      await changeLanguage(currentLang);
    }
  }

  const htmlLang = String(
    document.documentElement.getAttribute('data-lang') ||
    document.documentElement.lang ||
    'fr',
  ).toLowerCase();
  const pendingLang = String((window as any).__lcdbPendingLanguage || '').toLowerCase();
  let storedLang = '';
  try {
    storedLang = String(localStorage.getItem(LANGUAGE_STORAGE_KEY) || '').toLowerCase();
  } catch {
    storedLang = '';
  }

  const needsImmediateTranslationBoot =
    Boolean(pendingLang) || (storedLang && storedLang !== htmlLang);

  const startTranslationInit = () =>
    init().catch(error => console.error('Failed to initialize translations:', error));

  const translationStatusEl = document.querySelector<HTMLElement>('[data-translation-status]');
  const translationStatusTextEl = translationStatusEl?.querySelector<HTMLElement>('[data-translation-status-text]');
  let translationStatusTimeout: number | null = null;

  const showTranslationStatus = (state: 'loading' | 'success' | 'warning' | 'error', message: string) => {
    if (!translationStatusEl || !translationStatusTextEl || !message) return;
    if (translationStatusTimeout) {
      window.clearTimeout(translationStatusTimeout);
      translationStatusTimeout = null;
    }

    translationStatusEl.hidden = false;
    translationStatusEl.dataset.state = state;
    translationStatusTextEl.textContent = message;

    if (state !== 'loading') {
      translationStatusTimeout = window.setTimeout(() => {
        translationStatusEl.hidden = true;
      }, state === 'error' ? 5200 : 3200);
    }
  };

  window.addEventListener('lcdb:translation-status', ((event: Event) => {
    const customEvent = event as CustomEvent<{ state?: 'loading' | 'success' | 'warning' | 'error'; message?: string }>;
    const state = customEvent?.detail?.state;
    const message = customEvent?.detail?.message;
    if (!state || !message) return;
    showTranslationStatus(state, message);
  }) as EventListener);

  if (needsImmediateTranslationBoot) {
    startTranslationInit();
  } else if (typeof window.requestIdleCallback === 'function') {
    window.requestIdleCallback(() => startTranslationInit(), { timeout: 1200 });
  } else {
    window.setTimeout(() => startTranslationInit(), 180);
  }
</script>

<script>
  import '../scripts/clubAuth';
</script>

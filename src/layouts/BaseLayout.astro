---
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import GlobalAbout from "../components/GlobalAbout.astro";
import GlobalFooter from "../components/GlobalFooter.astro";
import '../styles/global.css';
import '@fortawesome/fontawesome-free/css/all.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  slug?: string;
  lang?: string;
  image?: string;
  jsonLd?: any[];
  loadAds?: boolean;
}

const { title, description, canonical, slug, lang = 'fr', image, jsonLd = [], loadAds = false } = Astro.props;
const mediavineScriptSrc = import.meta.env.PUBLIC_MEDIAVINE_SCRIPT_SRC;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang={lang} data-lang={lang}>
  <head>
    <script is:inline>
      (function () {
        const { pathname, search, hash } = window.location;
        if (!pathname || pathname === '/' || pathname.endsWith('/')) return;
        if (/\.[a-z0-9]+$/i.test(pathname)) return;
        window.location.replace(`${pathname}/${search}${hash}`);
      })();
    </script>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      slug={slug}
      image={image}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://lcdb.fra1.digitaloceanspaces.com" crossorigin />
    <link rel="dns-prefetch" href="//lcdb.fra1.digitaloceanspaces.com" />
    
    {jsonLd && jsonLd.length > 0 && jsonLd.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    {loadAds && mediavineScriptSrc && (
      <script async src={mediavineScriptSrc}></script>
    )}
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}
  </head>
  <body>
    <Header lang={lang} />
    <slot />
    <GlobalAbout />
    <GlobalFooter currentLang={lang} />
  </body>
</html>

<script>
  import { initializeTranslations, setupLanguageSwitcher, watchLanguageChanges, changeLanguage, getCurrentLanguage } from '../utils/dynamicTranslate';
  const LANGUAGE_STORAGE_KEY = 'preferred-language';

  // Initialize translations on page load
  async function init() {
    await initializeTranslations();
    setupLanguageSwitcher();
    watchLanguageChanges();

    const currentLang = String(getCurrentLanguage() || '').toLowerCase();
    const htmlLang = String(
      document.documentElement.getAttribute('data-lang') ||
      document.documentElement.lang ||
      'fr',
    ).toLowerCase();
    const pendingLang = String((window as any).__lcdbPendingLanguage || '').toLowerCase();

    if (pendingLang || (currentLang && currentLang !== htmlLang)) {
      await changeLanguage(currentLang);
    }
  }

  const htmlLang = String(
    document.documentElement.getAttribute('data-lang') ||
    document.documentElement.lang ||
    'fr',
  ).toLowerCase();
  const pendingLang = String((window as any).__lcdbPendingLanguage || '').toLowerCase();
  let storedLang = '';
  try {
    storedLang = String(localStorage.getItem(LANGUAGE_STORAGE_KEY) || '').toLowerCase();
  } catch {
    storedLang = '';
  }

  const needsImmediateTranslationBoot =
    Boolean(pendingLang) || (storedLang && storedLang !== htmlLang);

  const startTranslationInit = () =>
    init().catch(error => console.error('Failed to initialize translations:', error));

  if (needsImmediateTranslationBoot) {
    startTranslationInit();
  } else if (typeof window.requestIdleCallback === 'function') {
    window.requestIdleCallback(() => startTranslationInit(), { timeout: 1200 });
  } else {
    window.setTimeout(() => startTranslationInit(), 180);
  }
</script>

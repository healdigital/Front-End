# Algolia Configuration
# Get these from https://www.algolia.com

# Backend (PRIVATE - never expose)
ALGOLIA_APP_ID=your_app_id_here
ALGOLIA_ADMIN_KEY=your_admin_key_here

# Frontend (PUBLIC - safe to expose, search-only)
PUBLIC_ALGOLIA_APP_ID=your_app_id_here
PUBLIC_ALGOLIA_SEARCH_KEY=your_search_only_key_here

# GitHub Repository Dispatch for ISR
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your-username/your-repo-name

# Runtime-only secrets (never expose as Docker build args)
# In Coolify keep these as runtime variables only (not build-time variables).
DEEPL_API_KEY=
PAYLOAD_SECRET=
DATABASE_URL=
GITHUB_DISPATCH_TOKEN=

# Build knobs for SSG/ISR
# Set to 1 for a one-time build from prepared-articles.json instead of Mongo.
USE_LOCAL_JSON=1
# Snapshot source used by build (prepared-snapshot release asset)
PREPARED_JSON_URL=https://github.com/lcdb-dev/Front-End/releases/download/prepared-snapshot/prepared-articles.json
# How many articles to prebuild (applies to Mongo and prepared JSON builds)
MAX_SSG_ARTICLES=50
# Optional: override search index size without increasing SSG build count
SEARCH_INDEX_LIMIT=5000
# Set to 1 to exclude category/tag/search/author/test pages from deploy builds
BUILD_ONLY_ARTICLE_PAGES=0
# Optional: disable search page + search index generation during build
BUILD_DISABLE_SEARCH=0
# Optional dev-only cap (keeps `npm run dev` snappy even when MAX_SSG_ARTICLES is high)
DEV_MAX_SSG_ARTICLES=50
# Optional dev-only override to include INCLUDE_SLUGS during local dev (off by default)
DEV_INCLUDE_SLUGS=0
# Comma-separated slugs that must be included even if above the cap (URL-encoded OK)
INCLUDE_SLUGS=

# Disqus (public)
PUBLIC_DISQUS_SHORTNAME=your_disqus_shortname

# Translation endpoint (public)
# Set to your Payload API base so client can call /translate
PUBLIC_TRANSLATE_API_URL=https://your-payload-domain.com/api

# Club member authentication - ad-free navigation
PUBLIC_CLUB_AUTH_API=https://atelier-lacuisinedebernard.com/wp-json/lcdb/v1/blog-auth

# Mediavine / ads (public)
PUBLIC_MEDIAVINE_SCRIPT_SRC=//scripts.mediavine.com/tags/la-cuisine-de-bernard.js

# Axceptio consent (public, optional)
PUBLIC_AXEPTIO_CLIENT_ID=
PUBLIC_AXEPTIO_COOKIES_VERSION=
PUBLIC_AXEPTIO_COOKIE_DOMAIN=lacuisinedebernard.com
PUBLIC_AXEPTIO_SCRIPT_SRC=//static.axept.io/sdk.js
# Optional: override Axeptio vendor names if your widget uses custom names
PUBLIC_AXEPTIO_GA_VENDOR=google_analytics
PUBLIC_AXEPTIO_MEDIAVINE_VENDOR=mediavine

# Google Analytics (public)
PUBLIC_GA_MEASUREMENT_ID=

# Google Analytics Data API (server-side, for popular articles)
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
GA4_POPULAR_LOOKBACK_DAYS=90

# Workshops cache endpoint (server-side homepage fetch)
# Temporary example: https://<your-worker>.workers.dev/
WORKSHOPS_CACHE_URL=https://lacuisinedebernard.com/api/workshops-cache

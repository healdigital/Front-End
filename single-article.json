          },
          {
            "children": [
              {
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "text": "Chocolate lava cake is perfect for dinner parties, special occasions, or whenever you crave a rich and indulgent dessert.",
                "type": "text",
                "version": 1
              }
            ],
            "direction": null,
            "format": "",
